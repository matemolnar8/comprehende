{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matemolnar8/comprehende/src/schema/review.schema.json",
  "title": "Comprehende ReviewDocument",
  "description": "Interpretation only: title, groups, summaries, and hunk pointers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "size",
    "title",
    "summary",
    "groups"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "size": {
      "type": "string",
      "enum": [
        "trivial",
        "small",
        "medium",
        "large",
        "very-large"
      ],
      "description": "Human review burden of this change."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseRef",
        "headRef"
      ],
      "properties": {
        "baseRef": {
          "type": "string",
          "minLength": 1
        },
        "headRef": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Short name of the whole change. Prefer a user-created title when it names this change."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Short what of the whole change. Name the stories."
    },
    "why": {
      "type": "string",
      "minLength": 1,
      "description": "Generated why for the whole change, from tickets, issues, a request description, or a transcript."
    },
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "part": {
            "type": "string",
            "minLength": 1,
            "description": "Short name of the independent story this ticket belongs to. Same name as the groups in that story."
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "why",
          "summary",
          "suggestedOrder",
          "hunkRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "description": "Generated why this group exists. From a source when one applies, or that it enables later groups in the same story."
          },
          "summary": {
            "type": "string",
            "description": "One sentence: what this group is."
          },
          "lookFor": {
            "type": "array",
            "description": "Scannable bullets of what to inspect.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependsOn": {
            "type": "array",
            "description": "Ids of earlier groups this one depends on. Same story only.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "part": {
            "type": "string",
            "minLength": 1,
            "description": "Short name of the independent story this group belongs to. Same name = same story. Different names could have been separate PRs."
          },
          "suggestedOrder": {
            "type": "number"
          },
          "hunkRefs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/hunkRef"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hunkRef": {
      "type": "object",
      "description": "Copy from comprehende index. Identity is (path, oldStart, newStart), plus oldPath when renamed.",
      "additionalProperties": false,
      "required": [
        "path",
        "oldStart",
        "oldLines",
        "newStart",
        "newLines"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "oldPath": {
          "type": "string",
          "minLength": 1
        },
        "oldStart": {
          "type": "integer",
          "minimum": 0
        },
        "oldLines": {
          "type": "integer",
          "minimum": 0
        },
        "newStart": {
          "type": "integer",
          "minimum": 0
        },
        "newLines": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}