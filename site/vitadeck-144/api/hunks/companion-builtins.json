gin.id, commands: [...plugin.commands.keys()] })),\n+    }),\n+    echo: ({ text }) => ({ text }),\n+    events: ({ plugin, after }) => {\n+      if (plugin !== corePlugin.id && !loadedPlugins().some((loaded) => loaded.id === plugin)) {\n+        throw new HostCommandError(\"unknown_plugin\", `This Host Companion has no plugin ${plugin}.`);\n+      }\n+      return events.wait(plugin, after);\n+    },\n+    notify: ({ text }) => {\n+      events.emit(corePlugin.id, \"notice\", { text });\n+      return {};\n+    },\n+  });\n+}\n","complete":true,"hunks":[{"path":"js/packages/host-companion/src/core.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":35,"header":"@@ -0,0 +1,35 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import {"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"  HOST_CONTROL_PROTOCOL_VERSION,"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"  HostCommandError,"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"  corePlugin,"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"  implementHostPlugin,"},{"kind":"add","oldNumber":null,"newNumber":6,"text":"  type ImplementedHostPlugin,"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"} from \"@vitadeck/sdk/host-control\";"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"import type { EventLog } from \"./events\";"},{"kind":"add","oldNumber":null,"newNumber":9,"text":""},{"kind":"add","oldNumber":null,"newNumber":10,"text":"export function implementCorePlugin("},{"kind":"add","oldNumber":null,"newNumber":11,"text":"  name: string,"},{"kind":"add","oldNumber":null,"newNumber":12,"text":"  platform: string,"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"  loadedPlugins: () => readonly ImplementedHostPlugin[],"},{"kind":"add","oldNumber":null,"newNumber":14,"text":"  events: EventLog,"},{"kind":"add","oldNumber":null,"newNumber":15,"text":"): ImplementedHostPlugin {"},{"kind":"add","oldNumber":null,"newNumber":16,"text":"  return implementHostPlugin(corePlugin, {"},{"kind":"add","oldNumber":null,"newNumber":17,"text":"    capabilities: () => ({"},{"kind":"add","oldNumber":null,"newNumber":18,"text":"      protocolVersion: HOST_CONTROL_PROTOCOL_VERSION,"},{"kind":"add","oldNumber":null,"newNumber":19,"text":"      name,"},{"kind":"add","oldNumber":null,"newNumber":20,"text":"      platform,"},{"kind":"add","oldNumber":null,"newNumber":21,"text":"      plugins: loadedPlugins().map((plugin) => ({ id: plugin.id, commands: [...plugin.commands.keys()] })),"},{"kind":"add","oldNumber":null,"newNumber":22,"text":"    }),"},{"kind":"add","oldNumber":null,"newNumber":23,"text":"    echo: ({ text }) => ({ text }),"},{"kind":"add","oldNumber":null,"newNumber":24,"text":"    events: ({ plugin, after }) => {"},{"kind":"add","oldNumber":null,"newNumber":25,"text":"      if (plugin !== corePlugin.id && !loadedPlugins().some((loaded) => loaded.id === plugin)) {"},{"kind":"add","oldNumber":null,"newNumber":26,"text":"        throw new HostCommandError(\"unknown_plugin\", `This Host Companion has no plugin ${plugin}.`);"},{"kind":"add","oldNumber":null,"newNumber":27,"text":"      }"},{"kind":"add","oldNumber":null,"newNumber":28,"text":"      return events.wait(plugin, after);"},{"kind":"add","oldNumber":null,"newNumber":29,"text":"    },"},{"kind":"add","oldNumber":null,"newNumber":30,"text":"    notify: ({ text }) => {"},{"kind":"add","oldNumber":null,"newNumber":31,"text":"      events.emit(corePlugin.id, \"notice\", { text });"},{"kind":"add","oldNumber":null,"newNumber":32,"text":"      return {};"},{"kind":"add","oldNumber":null,"newNumber":33,"text":"    },"},{"kind":"add","oldNumber":null,"newNumber":34,"text":"  });"},{"kind":"add","oldNumber":null,"newNumber":35,"text":"}"}]}]},{"path":"js/packages/host-companion/src/system-stats.ts","kind":"text","status":"added","patch":"diff --git a/js/packages/host-companion/src/system-stats.ts b/js/packages/host-companion/src/system-stats.ts\nnew file mode 100644\nindex 00000000..5a0baa35\n--- /dev/null\n+++ b/js/packages/host-companion/src/system-stats.ts\n@@ -0,0 +1,60 @@\n+import { execFile } from \"node:child_process\";\n+import os from \"node:os\";\n+import { setTimeout as sleep } from \"node:timers/promises\";\n+import { implementHostPlugin, systemStatsPlugin } from \"@vitadeck/sdk/host-control\";\n+\n+type CpuSample = { idle: number; total: number };\n+\n+function sampleCpus(): CpuSample {\n+  let idle = 0;\n+  let total = 0;\n+  for (const { times } of os.cpus()) {\n+    idle += times.idle;\n+    total += times.user + times.nice + times.sys + times.idle + times.irq;\n+  }\n+  return { idle, total };\n+}\n+\n+const roundTenth = (value: number) => Math.round(value * 10) / 10;\n+\n+let previous: CpuSample | undefined;\n+\n+/** Busy share of CPU time since the previous read; the first read samples twice, 200 ms apart. */\n+async function cpuPercent(): Promise<number> {\n+  if (!previous) {\n+    previous = sampleCpus();\n+    await sleep(200);\n+  }\n+  const current = sampleCpus();\n+  const total = current.total - previous.total;\n+  const idle = current.idle - previous.idle;\n+  previous = current;\n+  return total > 0 ? roundTenth(((total - idle) / total) * 100) : 0;\n+}\n+\n+// Node counts macOS's reclaimable file cache as used, so a Mac would always read near 100%. vm_stat's free, inactive\n+// and speculative pages are what Activity Monitor treats as available.\n+async function availableMemoryBytes(): Promise<number> {\n+  if (process.platform !== \"darwin\") return os.freemem();\n+  const stdout = await new Promise<string>((resolve, reject) => {\n+    execFile(\"vm_stat\", (error, output) => {\n+      if (error) reject(new Error(`vm_stat failed: ${error.message}`));\n+      else resolve(output);\n+    });\n+  });\n+  const pageSize = Number(/page size of (\\d+) bytes/u.exec(stdout)?.[1] ?? 4096);\n+  const pages = (label: string) => Number(new RegExp(`${label}:\\\\s+(\\\\d+)`, \"u\").exec(stdout)?.[1] ?? 0);\n+  return (pages(\"Pages free\") + pages(\"Pages inactive\") + pages(\"Pages speculative\")) * pageSize;\n+}\n+\n+export const systemStats = implementHostPlugin(systemStatsPlugin, {\n+  read: async () => {\n+    const memoryTotalBytes = os.totalmem();\n+    return {\n+      cpuPercent: await cpuPercent(),\n+      memoryUsedPercent: roundTenth(((memoryTotalBytes - (await availableMemoryBytes())) / memoryTotalBytes) * 100),\n+      memoryTotalBytes,\n+      uptimeSeconds: Math.floor(os.uptime()),\n+    };\n+  },\n+});\n","complete":true,"hunks":[{"path":"js/packages/host-companion/src/system-stats.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":60,"header":"@@ -0,0 +1,60 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import { execFile } from \"node:child_process\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import os from \"node:os\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import { setTimeout as sleep } from \"node:timers/promises\";"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"import { implementHostPlugin, systemStatsPlugin } from \"@vitadeck/sdk/host-control\";"},{"kind":"add","oldNumber":null,"newNumber":5,"text":""},{"kind":"add","oldNumber":null,"newNumber":6,"text":"type CpuSample = { idle: number; total: number };"},{"kind":"add","oldNumber":null,"newNumber":7,"text":""},{"kind":"add","oldNumber":null,"newNumber":8,"text":"function sampleCpus(): CpuSample {"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"  let idle = 0;"},{"kind":"add","oldNumber":null,"newNumber":10,"text":"  let total = 0;"},{"kind":"add","oldNumber":null,"newNumber":11,"text":"  for (const { times } of os.cpus()) {"},{"kind":"add","oldNumber":null,"newNumber":12,"text":"    idle += times.idle;"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"    total += times.user + times.nice + times.sys + times.idle + times.irq;"},{"kind":"add","oldNumber":null,"newNumber":14,"text":"  }"},{"kind":