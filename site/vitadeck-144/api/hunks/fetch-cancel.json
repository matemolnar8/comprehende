ding) return;\n+    // A Host Control event wait holds its request open for up to 25 s; stopping must not wait for it.\n+    vd_mutex_lock(fetch_mutex);\n+    for (ptrdiff_t i = 0; i < arrlen(fetch_pending); i++)\n+        fetch_pending[i]->cancelled = true;\n+    vd_mutex_unlock(fetch_mutex);\n     for (ptrdiff_t i = 0; i < arrlen(fetch_pending); i++) {\n         FetchRequest *req = fetch_pending[i];\n         vd_thread_join(req->thread);\n","complete":true,"hunks":[{"path":"src/jslib/fetch.c","oldStart":39,"oldLines":6,"newStart":39,"newLines":8,"header":"@@ -39,6 +39,8 @@ typedef struct {","language":"plaintext","lines":[{"kind":"ctx","oldNumber":39,"newNumber":39,"text":"    char error[CURL_ERROR_SIZE];"},{"kind":"ctx","oldNumber":40,"newNumber":40,"text":""},{"kind":"ctx","oldNumber":41,"newNumber":41,"text":"    bool done;"},{"kind":"add","oldNumber":null,"newNumber":42,"text":"    // Set when the Deck App stops; the transfer aborts at curl's next progress call, about once a second."},{"kind":"add","oldNumber":null,"newNumber":43,"text":"    bool cancelled;"},{"kind":"ctx","oldNumber":42,"newNumber":44,"text":"    vd_thread *thread;"},{"kind":"ctx","oldNumber":43,"newNumber":45,"text":""},{"kind":"ctx","oldNumber":44,"newNumber":46,"text":"    JSValue resolve;"}]},{"path":"src/jslib/fetch.c","oldStart":90,"oldLines":6,"newStart":92,"newLines":19,"header":"@@ -90,6 +92,19 @@ static size_t fetch_header_cb(char *buffer, size_t size, size_t nitems, void *us","language":"plaintext","lines":[{"kind":"ctx","oldNumber":90,"newNumber":92,"text":"    return total;"},{"kind":"ctx","oldNumber":91,"newNumber":93,"text":"}"},{"kind":"ctx","oldNumber":92,"newNumber":94,"text":""},{"kind":"add","oldNumber":null,"newNumber":95,"text":"static int fetch_progress_cb(void *userdata, curl_off_t dltotal, curl_off_t dlnow, curl_off_t ultotal, curl_off_t ulnow)"},{"kind":"add","oldNumber":null,"newNumber":96,"text":"{"},{"kind":"add","oldNumber":null,"newNumber":97,"text":"    (void)d