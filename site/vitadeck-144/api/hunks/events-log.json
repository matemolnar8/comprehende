       throw new HostCommandError(\"unknown_plugin\", `This Host Companion has no plugin ${plugin}.`);\n+      }\n+      return events.wait(plugin, after);\n+    },\n+    notify: ({ text }) => {\n+      events.emit(corePlugin.id, \"notice\", { text });\n+      return {};\n+    },\n+  });\n+}\n","complete":true,"hunks":[{"path":"js/packages/host-companion/src/core.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":35,"header":"@@ -0,0 +1,35 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import {"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"  HOST_CONTROL_PROTOCOL_VERSION,"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"  HostCommandError,"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"  corePlugin,"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"  implementHostPlugin,"},{"kind":"add","oldNumber":null,"newNumber":6,"text":"  type ImplementedHostPlugin,"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"} from \"@vitadeck/sdk/host-control\";"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"import type { EventLog } from \"./events\";"},{"kind":"add","oldNumber":null,"newNumber":9,"text":""},{"kind":"add","oldNumber":null,"newNumber":10,"text":"export function implementCorePlugin("},{"kind":"add","oldNumber":null,"newNumber":11,"text":"  name: string,"},{"kind":"add","oldNumber":null,"newNumber":12,"text":"  platform: string,"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"  loadedPlugins: () => readonly ImplementedHostPlugin[],"},{"kind":"add","oldNumber":null,"newNumber":14,"text":"  events: EventLog,"},{"kind":"add","oldNumber":null,"newNumber":15,"text":"): ImplementedHostPlugin {"},{"kind":"add","oldNumber":null,"newNumber":16,"text":"  return implementHostPlugin(corePlugin, {"},{"kind":"add","oldNumber":null,"newNumber":17,"text":"    capabilities: () => ({"},{"kind":"add","oldNumber":null,"newNumber":18,"text":"      protocolVersion: HOST_CONTROL_PROTOCOL_VERSION,"},{"k