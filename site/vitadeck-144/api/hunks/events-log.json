nt. The Vita's native fetch gives up at 30 s. */\n+export const EVENT_WAIT_MS = 25_000;\n+const KEPT_EVENTS_PER_PLUGIN = 100;\n+\n+type Waiter = { plugin: string; wake: () => void };\n+\n+/**\n+ * The companion's recent events, numbered in order with up to 100 per plugin, so a chatty plugin cannot push out\n+ * another's, and the requests waiting for the next one of a plugin.\n+ */\n+export function createEventLog(waitMs = EVENT_WAIT_MS) {\n+  const events: { seq: number; plugin: string; name: string; data: unknown }[] = [];\n+  const waiters = new Set<Waiter>();\n+  let seq = 0;\n+  let closed = false;\n+\n+  const pick = (plugin: string, after: number) =>\n+    events\n+      .filter((event) => event.plugin === plugin && event.seq > after)\n+      .map(({ seq: n, name, data }) => ({ seq: n, name, data }));\n+\n+  return {\n+    emit(plugin: string, name: string, data: unknown): void {\n+      events.push({ seq: ++seq, plugin, name, data });\n+      if (events.filter((event) => event.plugin === plugin).length > KEPT_EVENTS_PER_PLUGIN) {\n+        events.splice(\n+          events.findIndex((event) => event.plugin === plugin),\n+          1,\n+        );\n+      }\n+      for (const waiter of waiters) if (waiter.plugin === plugin) waiter.wake();\n+    },\n+\n+    /** Answers at once with events after `after`, or waits for the plugin's next one, up to `waitMs`. */\n+    async wait(plugin: string, after: number | undefined): Promise<HostEventBatch> {\n+      // Without `after`, or with one from before this companion started, watching starts now.\n+      if (after === undefined || after > seq) return { events: [], next: seq };\n+      if (pick(plugin, after).length === 0 && !closed) {\n+        await new Promise<void>((resolve) => {\n+          let timer: NodeJS.Timeout | undefined;\n+          const waiter: Waiter = {\n+            plugin,\n+            wake: () => {\n+              clearTimeout(timer);\n+              waiters.delete(waiter);\n+              resolve();\n+            },\n+          };\n+          timer = setTimeout(waiter.wake, waitMs);\n+          waiters.add(waiter);\n+        });\n+      }\n+      return { events: pick(plugin, after), next: seq };\n+    },\n+\n+    /** Answers every waiting request, so the server can close. */\n+    close(): void {\n+      closed = true;\n+      for (const waiter of waiters) waiter.wake();\n+    },\n+  };\n+}\n+\n+export type EventLog = ReturnType<typeof createEventLog>;\n","complete":true,"hunks":[{"path":"js/packages/host-companion/src/events.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":66,"header":"@@ -0,0 +1,66 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import type { HostEventBatch } from \"@vitadeck/sdk/host-control\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":""},{"kind":"add","oldNumber":null,"newNumber":3,"text":"/** How long a `core.events` request waits for an event. The Vita's native fetch gives up at 30 s. */"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"export const EVENT_WAIT_MS = 25_000;"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"const KEPT_EVENTS_PER_PLUGIN = 100;"},{"kind":"add","oldNumber":null,"newNumber":6,"text":""},{"kind":"add","oldNumber":null,"newNumber":7,"text":"type Waiter = { plugin: string; wake: () => void };"},{"kind":"add","oldNumber":null,"newNumber":8,"text":""},{"kind":"add","oldNumber":null,"newNumber":9,"text":"/**"},{"kind":"add","oldNumber":null,"newNumber":10,"text":" * The companion's recent events, numbered in order with up to 100 per plugin, so a chatty plugin cannot push out"},{"kind":"add","oldNumber":null,"newNumber":11,"text":" * another's, and the requests waiting for the next one of a plugin."},{"kind":"add","oldNumber":null,"newNumber":12,"text":" */"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"export function createEventLog(waitMs = EVENT_WAIT_MS) {"},{"kind":"add","oldNumber":null,"newNumber":14,"text":"  const events: { seq: 