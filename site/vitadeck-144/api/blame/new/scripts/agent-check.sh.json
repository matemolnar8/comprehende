): agent-check also checks the engines.node minimum","line":31,"text":""},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"summary":"fix(scripts): agent-check also checks the engines.node minimum","line":32,"text":"# A fresh worktree often starts on the shell's default Node. Node needs the .nvmrc major and at least the"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"summary":"fix(scripts): agent-check also checks the engines.node minimum","line":33,"text":"# engines.node minimum in js/package.json."},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"summary":"fix(scripts): agent-check runs on the pinned Node and builds JS before tsc","line":34,"text":"use_pinned_node() {"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"summary":"fix(scripts): agent-check also checks the engines.node minimum","line":35,"text":"    major=$(cat .nvmrc)"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"summary":"fix(scripts): agent-check also checks the engines.node minimum","line":36,"text":"    min=$(sed -n 's/.*\"node\": *\">=\\([0-9.]*\\)\".*/\\1/p' js/package.json)"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"summary":"fix(scripts): agent-check also checks the engines.node minimum","line":37,"text":"    have=$(node -p 'process.versions.node' 2>/dev/null || echo none)"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"summary":"fix(scripts): agent-check also checks the engines.node minimum","line":38,"text":"    if [ \"${have%%.*}\" = \"$major\" ] && version_at_least \"$have\" \"$min\"; then"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"summary":"fix(scripts): agent-check also checks the engines.node minimum","line":39,"text":"        return"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"summary":"fix(scripts): agent-check also checks the engines.node minimum","line":40,"text":"    fi"},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"summary":"fix(scripts): agent-check runs on the pinned Node and builds JS before tsc","line":41,"text":"    if [ -z \"${VITADECK_PINNED_NODE:-}\" ] && command -v fnm >/dev/null 2>&1; then"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"summary":"fix(scripts): agent-check also checks the engines.node minimum","line":42,"text":"        printf 'Node %s is active; rerunning on Node %s from .nvmrc with fnm.\\n' \"$have\" \"$major\" >&2"},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"summary":"fix(scripts): agent-check runs on the pinned Node and builds JS before tsc","line":43,"text":"        VITADECK_PINNED_NODE=1 exec fnm exec --using=\"$ROOT_DIR/.nvmrc\" -- \"$ROOT_DIR/scripts/agent-check.sh\" \"$@\""},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"summary":"fix(scripts): agent-check runs on the pinned Node and builds JS before tsc","line":44,"text":"    fi"},{"sha":"020c1b5aa8c4c768b9d6dc4ee22216112a84b5cb","author":"Máté Molnár","timestamp":1793076465,"summary":"fix(scripts): agent-check also checks the engines.node minimum","line":45,"text":"    die \"Node $have is active, but VitaDeck needs Node $major at $min or newer. Install it with fnm install $major, run fnm use, then rerun.\""},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":1793074844,"summary":"fix(scripts): agent-check runs on the pinned Node and builds JS before tsc","line":46,"text":"}"},{"sha":"d6edb09cfe8f79d79fd4782ff75a48db7f7ee98c","author":"Máté Molnár","timestamp":179