{"path":".cursor/install.sh","ref":"faffb06a46ff492182596dbb26b16485f45b27a0","side":"old","lines":[{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":1,"text":"#!/usr/bin/env bash"},{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":2,"text":"# Idempotent Cloud Agent bootstrap for comprehende."},{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":3,"text":"# Pins the Node version the repo requires (.nvmrc / package.json engines) via nvm,"},{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":4,"text":"# then installs dependencies with the pinned pnpm from package.json (via corepack)."},{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":5,"text":"set -euo pipefail"},{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":6,"text":""},{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":7,"text":"export NVM_DIR=\"${NVM_DIR:-$HOME/.nvm}\""},{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":8,"text":"# shellcheck disable=SC1091"},{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":9,"text":". \"$NVM_DIR/nvm.sh\""},{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":10,"text":""},{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":11,"text":"node_version=\"$(tr -d '[:space:]' < .nvmrc)\""},{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":12,"text":"nvm install \"$node_version\""},{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":13,"text":"nvm alias default \"$node_version\""},{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":14,"text":"nvm use default"},{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":15,"text":""},{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":16,"text":"corepack enable"},{"sha":"ce8587ef8dcfc890d118fed9ccdddc17723a0fda","author":"Cursor Agent","timestamp":1787031543,"line":17,"text":""},{"sha":"d61b730ab5b0e8d56eb70ba625ad4a254b829c61","author":"Cursor Agent","timestamp":1787032920,"line":18,"text":"# The Cloud runtime pre-seeds nvm's bin dir behind its own Node shim (/exec-daemon)"},{"sha":"d61b730ab5b0e8d56eb70ba625ad4a254b829c61","author":"Cursor Agent","timestamp":1787032920,"line":19,"text":"# on PATH, so nvm leaves it there and the shim's older Node wins in the agent's"},{"sha":"d61b730ab5b0e8d56eb70ba625ad4a254b829c61","author":"Cursor Agent","timestamp":1787032920,"line":20,"text":"# shells. Prepend nvm's active bin in ~/.bashrc (which the shells source, after"},{"sha":"d61b730ab5b0e8d56eb70ba625ad4a254b829c61","author":"Cursor Agent","timestamp":1787032920,"line":21,"text":"# nvm is loaded and NVM_BIN is set) so the pinned Node wins. Version-agnostic and"},{"sha":"d61b730ab5b0e8d56eb70ba625ad4a254b829c61","author":"Cursor Agent","timestamp":1787032920,"line":22,"text":"# idempotent."},{"sha":"d61b730ab5b0e8d56eb70ba625ad4a254b829c61","author":"Cursor Agent","timestamp":1787032920,"line":23,"text":"bashrc=\"$HOME/.bashrc\""},{"sha":"d61b730ab5b0e8d56eb70ba625ad4a254b829c61","author":"Cursor Agent","timestamp":1787032920,"line":24,"text":"marker=\"# comprehende: prefer nvm's Node over the runtime Node shim\""},{"sha":"d61b730ab5b0e8d56eb70ba625ad4a254b829c61","author":"Cursor Agent","timestamp":1787032920,"line":25,"text":"if [ -f \"$bashrc\" ] && ! grep -qF \"$marker\" \"$bashrc\"; then"},{"sha":"d61b730ab5b0e8d56eb70ba625ad4a254b829c61","author":"Cursor Agent","timestamp":1787032920,"line":26,"text":"  {"},{"sha":"d61b730ab5b0e8d56eb70ba625ad4a254b829c61","author":"Cursor Agent","timestamp":1787032920,"line":27,"text":"    echo \"\""},{"sha":"d61b730ab5b0e8d56eb70ba625ad4a254b829c61","author":"Cursor Agent","timestamp":1787032920,"line":28,"text":"    echo \"$marker\""},{"sha":"d61b730ab5b0e8d56eb70ba625ad4a254b829c61","author":"Cursor Agent","timestamp":1787032920,"line":29,"text":"    echo '[ -n \"${NVM_BIN:-}\" ] && export PATH=\"$NVM_BIN:$PATH\"'"},{"sha":"d61b730ab5b0e8d56eb70ba625ad4a254b829c61","author":"Cursor Agent","timestamp":1787032920,"line":30,"text":"  } >> \"$bashrc\""},{"sha":"ce8587ef8dcfc890d118fed9ccdddc17723a0fda","author":"Cursor Agent","timestamp":1787031543,"line":31,"text":"fi"},{"sha":"ce8587ef8dcfc890d118fed9ccdddc17723a0fda","author":"Cursor Agent","timestamp":1787031543,"line":32,"text":""},{"sha":"caaf109b7421ef2819303574cc8c808c00366bc6","author":"Cursor Agent","timestamp":1787030656,"line":33,"text":"pnpm install --frozen-lockfile"}]}
