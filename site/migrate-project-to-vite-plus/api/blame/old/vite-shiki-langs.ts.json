{"path":"vite-shiki-langs.ts","ref":"faffb06a46ff492182596dbb26b16485f45b27a0","side":"old","lines":[{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":1,"text":"import { EXTENSION_TO_FILE_FORMAT } from \"@pierre/diffs\";"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":2,"text":"import type { Plugin } from \"vite\";"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":3,"text":"import { SHIKI_LANGS_FILE, shikiLangId, type ShikiLangsManifest } from \"./src/api/shiki-langs.ts\";"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":4,"text":""},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":5,"text":"export function shikiLangChunks(): Plugin {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":6,"text":"  return {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":7,"text":"    name: \"shiki-lang-chunks\","},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":8,"text":"    outputOptions(options) {"},{"sha":"878b3d266c10e65fcd8fe44cb62689657a56ea12","author":"Máté Molnár","timestamp":1788716155,"line":9,"text":"      const previous = options.codeSplitting;"},{"sha":"878b3d266c10e65fcd8fe44cb62689657a56ea12","author":"Máté Molnár","timestamp":1788716155,"line":10,"text":"      const previousGroups = typeof previous === \"object\" && previous !== null ? (previous.groups ?? []) : [];"},{"sha":"878b3d266c10e65fcd8fe44cb62689657a56ea12","author":"Máté Molnár","timestamp":1788716155,"line":11,"text":"      options.codeSplitting = {"},{"sha":"878b3d266c10e65fcd8fe44cb62689657a56ea12","author":"Máté Molnár","timestamp":1788716155,"line":12,"text":"        ...(typeof previous === \"object\" && previous !== null ? previous : {}),"},{"sha":"878b3d266c10e65fcd8fe44cb62689657a56ea12","author":"Máté Molnár","timestamp":1788716155,"line":13,"text":"        includeDependenciesRecursively: false,"},{"sha":"878b3d266c10e65fcd8fe44cb62689657a56ea12","author":"Máté Molnár","timestamp":1788716155,"line":14,"text":"        groups: ["},{"sha":"878b3d266c10e65fcd8fe44cb62689657a56ea12","author":"Máté Molnár","timestamp":1788716155,"line":15,"text":"          {"},{"sha":"878b3d266c10e65fcd8fe44cb62689657a56ea12","author":"Máté Molnár","timestamp":1788716155,"line":16,"text":"            test: (id) => shikiLangId(id) !== undefined,"},{"sha":"878b3d266c10e65fcd8fe44cb62689657a56ea12","author":"Máté Molnár","timestamp":1788716155,"line":17,"text":"            name(id) {"},{"sha":"878b3d266c10e65fcd8fe44cb62689657a56ea12","author":"Máté Molnár","timestamp":1788716155,"line":18,"text":"              const lang = shikiLangId(id);"},{"sha":"878b3d266c10e65fcd8fe44cb62689657a56ea12","author":"Máté Molnár","timestamp":1788716155,"line":19,"text":"              return lang === undefined ? undefined : `shiki-lang-${lang}`;"},{"sha":"878b3d266c10e65fcd8fe44cb62689657a56ea12","author":"Máté Molnár","timestamp":1788716155,"line":20,"text":"            },"},{"sha":"878b3d266c10e65fcd8fe44cb62689657a56ea12","author":"Máté Molnár","timestamp":1788716155,"line":21,"text":"          },"},{"sha":"878b3d266c10e65fcd8fe44cb62689657a56ea12","author":"Máté Molnár","timestamp":1788716155,"line":22,"text":"          ...previousGroups,"},{"sha":"878b3d266c10e65fcd8fe44cb62689657a56ea12","author":"Máté Molnár","timestamp":1788716155,"line":23,"text":"        ],"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":24,"text":"      };"},{"sha":"878b3d266c10e65fcd8fe44cb62689657a56ea12","author":"Máté Molnár","timestamp":1788716155,"line":25,"text":"      return options;"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":26,"text":"    },"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":27,"text":"    generateBundle(_options, bundle) {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":28,"text":"      const chunkImports = new Map<string, string[]>();"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":29,"text":"      const langFiles = new Map<string, string>();"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":30,"text":"      for (const [fileName, item] of Object.entries(bundle)) {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":31,"text":"        if (item.type !== \"chunk\") {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":32,"text":"          continue;"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":33,"text":"        }"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":34,"text":"        chunkImports.set(fileName, [...item.imports]);"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":35,"text":"        for (const moduleId of item.moduleIds) {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":36,"text":"          const lang = shikiLangId(moduleId);"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":37,"text":"          if (lang !== undefined) {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":38,"text":"            langFiles.set(lang, fileName);"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":39,"text":"          }"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":40,"text":"        }"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":41,"text":"      }"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":42,"text":""},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":43,"text":"      const chunks = [...new Set(langFiles.values())];"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":44,"text":"      if (chunks.length === 0) {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":45,"text":"        return;"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":46,"text":"      }"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":47,"text":"      const langChunkSet = new Set(chunks);"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":48,"text":"      const files: Record<string, string[]> = {};"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":49,"text":"      for (const [lang, fileName] of langFiles) {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":50,"text":"        files[lang] = langChunkClosure(fileName, chunkImports, langChunkSet);"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":51,"text":"      }"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":52,"text":""},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":53,"text":"      const manifest: ShikiLangsManifest = {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":54,"text":"        version: 1,"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":55,"text":"        chunks,"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":56,"text":"        files,"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":57,"text":"        lookup: { ...EXTENSION_TO_FILE_FORMAT },"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":58,"text":"      };"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":59,"text":"      this.emitFile({"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":60,"text":"        type: \"asset\","},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":61,"text":"        fileName: SHIKI_LANGS_FILE,"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":62,"text":"        source: `${JSON.stringify(manifest)}\\n`,"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":63,"text":"      });"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":64,"text":"    },"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":65,"text":"  };"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":66,"text":"}"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":67,"text":""},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":68,"text":"function langChunkClosure("},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":69,"text":"  start: string,"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":70,"text":"  chunkImports: Map<string, string[]>,"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":71,"text":"  langChunks: Set<string>,"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":72,"text":"): string[] {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":73,"text":"  const kept: string[] = [];"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":74,"text":"  const seen = new Set<string>();"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":75,"text":"  const stack = [start];"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":76,"text":"  while (stack.length > 0) {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":77,"text":"    const current = stack.pop();"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":78,"text":"    if (current === undefined || seen.has(current)) {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":79,"text":"      continue;"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":80,"text":"    }"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":81,"text":"    seen.add(current);"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":82,"text":"    if (langChunks.has(current)) {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":83,"text":"      kept.push(current);"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":84,"text":"    }"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":85,"text":"    for (const imported of chunkImports.get(current) ?? []) {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":86,"text":"      stack.push(imported);"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":87,"text":"    }"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":88,"text":"  }"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":89,"text":"  return kept;"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":90,"text":"}"}]}
