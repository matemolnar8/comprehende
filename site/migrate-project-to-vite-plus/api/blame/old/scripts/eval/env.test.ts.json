{"path":"scripts/eval/env.test.ts","ref":"faffb06a46ff492182596dbb26b16485f45b27a0","side":"old","lines":[{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":1,"text":"import assert from \"node:assert/strict\";"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":2,"text":"import { mkdtemp, writeFile } from \"node:fs/promises\";"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":3,"text":"import { tmpdir } from \"node:os\";"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":4,"text":"import { join } from \"node:path\";"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":5,"text":"import { describe, it } from \"node:test\";"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":6,"text":"import { loadDotEnv } from \"./env.ts\";"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":7,"text":""},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":8,"text":"const KEYS = [\"COMPREHENDE_EVAL_DOTENV_A\", \"COMPREHENDE_EVAL_DOTENV_B\", \"COMPREHENDE_EVAL_DOTENV_C\"] as const;"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":9,"text":""},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":10,"text":"function save(): Map<string, string | undefined> {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":11,"text":"  return new Map(KEYS.map((key) => [key, process.env[key]]));"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":12,"text":"}"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":13,"text":""},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":14,"text":"function restore(saved: Map<string, string | undefined>): void {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":15,"text":"  for (const [key, value] of saved) {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":16,"text":"    if (value === undefined) {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":17,"text":"      delete process.env[key];"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":18,"text":"    } else {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":19,"text":"      process.env[key] = value;"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":20,"text":"    }"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":21,"text":"  }"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":22,"text":"}"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":23,"text":""},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":24,"text":"describe(\"loadDotEnv\", () => {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":25,"text":"  it(\"loads keys, strips quotes, skips comments, and leaves real env alone\", async () => {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":26,"text":"    const saved = save();"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":27,"text":"    try {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":28,"text":"      const dir = await mkdtemp(join(tmpdir(), \"comprehende-dotenv-\"));"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":29,"text":"      await writeFile("},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":30,"text":"        join(dir, \".env\"),"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":31,"text":"        ["},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":32,"text":"          \"# comment\","},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":33,"text":"          \"\","},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":34,"text":"          \"COMPREHENDE_EVAL_DOTENV_A=abc\","},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":35,"text":"          'COMPREHENDE_EVAL_DOTENV_B=\"x y\"',"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":36,"text":"          \"COMPREHENDE_EVAL_DOTENV_C=from-file\","},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":37,"text":"          \"NOEQUALS\","},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":38,"text":"        ].join(\"\\n\"),"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":39,"text":"      );"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":40,"text":"      process.env.COMPREHENDE_EVAL_DOTENV_C = \"real-env\";"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":41,"text":"      await loadDotEnv(dir);"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":42,"text":"      assert.equal(process.env.COMPREHENDE_EVAL_DOTENV_A, \"abc\");"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":43,"text":"      assert.equal(process.env.COMPREHENDE_EVAL_DOTENV_B, \"x y\");"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":44,"text":"      assert.equal(process.env.COMPREHENDE_EVAL_DOTENV_C, \"real-env\");"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":45,"text":"    } finally {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":46,"text":"      restore(saved);"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":47,"text":"    }"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":48,"text":"  });"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":49,"text":""},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":50,"text":"  it(\"ignores a missing file\", async () => {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":51,"text":"    const dir = await mkdtemp(join(tmpdir(), \"comprehende-dotenv-empty-\"));"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":52,"text":"    await loadDotEnv(dir);"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":53,"text":"  });"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":54,"text":"});"}]}
