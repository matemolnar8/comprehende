{"path":"scripts/eval/env.ts","ref":"faffb06a46ff492182596dbb26b16485f45b27a0","side":"old","lines":[{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":1,"text":"import { readFile } from \"node:fs/promises\";"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":2,"text":"import { join } from \"node:path\";"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":3,"text":""},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":4,"text":"/** Load KEY=VALUE lines from <packageRoot>/.env. Real environment wins. Missing file is fine. */"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":5,"text":"export async function loadDotEnv(packageRoot: string): Promise<void> {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":6,"text":"  let text: string;"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":7,"text":"  try {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":8,"text":"    text = await readFile(join(packageRoot, \".env\"), \"utf8\");"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":9,"text":"  } catch {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":10,"text":"    return;"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":11,"text":"  }"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":12,"text":"  for (const line of text.split(\"\\n\")) {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":13,"text":"    const trimmed = line.trim();"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":14,"text":"    if (trimmed === \"\" || trimmed.startsWith(\"#\")) {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":15,"text":"      continue;"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":16,"text":"    }"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":17,"text":"    const assignment = trimmed.startsWith(\"export \") ? trimmed.slice(\"export \".length).trim() : trimmed;"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":18,"text":"    const eq = assignment.indexOf(\"=\");"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":19,"text":"    if (eq === -1) {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":20,"text":"      continue;"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":21,"text":"    }"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":22,"text":"    const key = assignment.slice(0, eq).trim();"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":23,"text":"    if (key === \"\" || process.env[key] !== undefined) {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":24,"text":"      continue;"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":25,"text":"    }"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":26,"text":"    process.env[key] = unquote(assignment.slice(eq + 1).trim());"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":27,"text":"  }"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":28,"text":"}"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":29,"text":""},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":30,"text":"function unquote(value: string): string {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":31,"text":"  if (value.length >= 2) {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":32,"text":"    const first = value.at(0);"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":33,"text":"    if ((first === '\"' || first === \"'\") && value.endsWith(first)) {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":34,"text":"      return value.slice(1, -1);"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":35,"text":"    }"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":36,"text":"  }"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":37,"text":"  return value;"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":38,"text":"}"}]}
