sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":102,"text":"    await replaceDir(paths.nextSkill, paths.publishedSkill);"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":103,"text":"    logs.push(`copied ${paths.nextSkill} -> ${paths.publishedSkill}`);"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":104,"text":"  }"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":105,"text":"  return logs;"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":106,"text":"}"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":107,"text":""},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":108,"text":"async function replaceDir(from: string, to: string): Promise<void> {"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":109,"text":"  await rm(to, { recursive: true, force: true });"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":110,"text":"  await cp(from, to, { recursive: true });"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":111,"text":"}"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":112,"text":""},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":113,"text":"async function readTree(dir: string): Promise<Map<string, string>> {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":114,"text":"  const out = new Map<string, string>();"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":115,"text":"  const walk = async (current: string): Promise<void> => {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":116,"text":"    for (const entry of await readdir(current, { withFileTypes: true })) {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":117,"text":"      const full = join(current, entry.name);"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":118,"text":"      if (entry.isDirectory()) {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":119,"text":"        await walk(full);"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":120,"text":"        continue;"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":121,"text":"      }"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":122,"text":"      out.set(relative(dir, full), await readFile(full, \"utf8\"));"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":123,"text":"    }"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":124,"text":"  };"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":125,"text":"  await walk(dir);"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":126,"text":"  return out;"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":127,"text":"}"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":128,"text":""},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":129,"text":"function gitStagedTree(root: string, prefix: string): Map<string, string> {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":130,"text":"  const listing = execFileSync(\"git\", [\"ls-files\", \"-z\", \"--\", prefix], {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":131,"text":"    cwd: root,"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":132,"text":"    encoding: \"utf8\","},{"sha":"83c2b3f857fbf459921d1a3f57971090b0b9e4a2","author":"Máté Molnár","timestamp":1787858752,"line":133,"text":"    env: gitEnv(),"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":134,"text":"  });"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":135,"text":"  const out = new Map<string, string>();"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":136,"text":"  for (const full of listing.split(\"\\0\").filter(Boolean)) {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":137,"text":"    out.set(relative(prefix, full), gitShowStaged(root, full));"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":138,"text":"  }"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":139,"text":"  return out;"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":140,"text":"}"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":141,"text":""},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":142,"text":"function gitShowStaged(root: string, path: string): string {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":143,"text":"  try {"},{"sha":"83c2b3f857fbf459921d1a3f57971090b0b9e4a2","author":"Máté Molnár","timestamp":1787858752,"line":144,"text":"    return execFileSync(\"git\", [\"show\", `:${path}`], { cwd: root, encoding: \"utf8\", env: gitEnv() });"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":145,"text":"  } catch {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":146,"text":"    throw new Error(`staged file missing: ${path}`);"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":147,"text":"  }"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":148,"text":"}"}]}
