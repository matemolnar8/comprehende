ned && !names.includes(name)) {"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":13,"text":"      names.push(name);"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":14,"text":"    }"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":15,"text":"  }"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":16,"text":"  return names;"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":17,"text":"}"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":18,"text":""},{"sha":"e60b884f4660a0ae2c4860a96da8fdd52d815de2","author":"Cursor Agent","timestamp":1786688031,"line":19,"text":"export type HunkLineKind = \"ctx\" | \"add\" | \"del\";"},{"sha":"e60b884f4660a0ae2c4860a96da8fdd52d815de2","author":"Cursor Agent","timestamp":1786688031,"line":20,"text":""},{"sha":"e60b884f4660a0ae2c4860a96da8fdd52d815de2","author":"Cursor Agent","timestamp":1786688031,"line":21,"text":"export function lineDelta(lines: { kind: HunkLineKind }[]): { added: number; removed: number } {"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":22,"text":"  let added = 0;"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":23,"text":"  let removed = 0;"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":24,"text":"  for (const line of lines) {"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":25,"text":"    if (line.kind === \"add\") {"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":26,"text":"      added += 1;"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":27,"text":"    } else if (line.kind === \"del\") {"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":28,"text":"      removed += 1;"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":29,"text":"    }"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":30,"text":"  }"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":31,"text":"  return { added, removed };"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":32,"text":"}"}]}
