{"path":"src/schema/image.ts","ref":"faffb06a46ff492182596dbb26b16485f45b27a0","side":"old","lines":[{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":1,"text":"import { basename } from \"./types.ts\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":2,"text":""},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":3,"text":"export const IMAGE_EXTENSIONS = [\"png\", \"jpg\", \"jpeg\", \"gif\", \"webp\", \"bmp\", \"avif\", \"ico\"] as const;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":4,"text":""},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":5,"text":"const IMAGE_EXT = new Set<string>(IMAGE_EXTENSIONS);"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":6,"text":""},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":7,"text":"export const LFS_POINTER_VERSION = \"version https://git-lfs.github.com/spec/v1\";"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":8,"text":""},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":9,"text":"const MEDIA: Record<(typeof IMAGE_EXTENSIONS)[number], string> = {"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":10,"text":"  png: \"image/png\","},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":11,"text":"  jpg: \"image/jpeg\","},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":12,"text":"  jpeg: \"image/jpeg\","},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":13,"text":"  gif: \"image/gif\","},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":14,"text":"  webp: \"image/webp\","},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":15,"text":"  bmp: \"image/bmp\","},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":16,"text":"  avif: \"image/avif\","},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":17,"text":"  ico: \"image/x-icon\","},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":18,"text":"};"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":19,"text":""},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":20,"text":"export function imageExtension(path: string): (typeof IMAGE_EXTENSIONS)[number] | undefined {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":21,"text":"  const base = basename(path);"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":22,"text":"  const dot = base.lastIndexOf(\".\");"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":23,"text":"  if (dot <= 0) {"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":24,"text":"    return undefined;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":25,"text":"  }"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":26,"text":"  const ext = base.slice(dot + 1).toLowerCase();"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":27,"text":"  return IMAGE_EXT.has(ext) ? (ext as (typeof IMAGE_EXTENSIONS)[number]) : undefined;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":28,"text":"}"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":29,"text":""},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":30,"text":"export function isImagePath(path: string): boolean {"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":31,"text":"  return imageExtension(path) !== undefined;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":32,"text":"}"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":33,"text":""},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":34,"text":"export function imageMediaType(path: string): string {"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":35,"text":"  const ext = imageExtension(path);"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":36,"text":"  return ext === undefined ? \"application/octet-stream\" : MEDIA[ext];"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":37,"text":"}"}]}
