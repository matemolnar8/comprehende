{"path":"src/cli/args.ts","ref":"faffb06a46ff492182596dbb26b16485f45b27a0","side":"old","lines":[{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":1,"text":"export type CommandName = \"review\" | \"validate\" | \"serve\" | \"export\" | \"digest\" | \"show\" | \"pregroup\";"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":2,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":3,"text":"export type CliRequest ="},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":4,"text":"  | { kind: \"help\" }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":5,"text":"  | { kind: \"version\" }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":6,"text":"  | { kind: \"error\"; message: string }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":7,"text":"  | {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":8,"text":"      kind: \"command\";"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":9,"text":"      command: CommandName;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":10,"text":"      cwd: string;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":11,"text":"      base?: string;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":12,"text":"      head?: string;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":13,"text":"      data?: string;"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":14,"text":"      out?: string;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":15,"text":"      hunk?: string;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":16,"text":"      file?: string;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":17,"text":"      port: number;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":18,"text":"      open: boolean;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":19,"text":"    };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":20,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":21,"text":"const COMMANDS: ReadonlySet<string> = new Set<CommandName>(["},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":22,"text":"  \"review\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":23,"text":"  \"validate\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":24,"text":"  \"serve\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":25,"text":"  \"export\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":26,"text":"  \"digest\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":27,"text":"  \"show\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":28,"text":"  \"pregroup\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":29,"text":"]);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":30,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":31,"text":"export const DEFAULT_PORT = 4567;"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":32,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":33,"text":"export class ArgError extends Error {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":34,"text":"  constructor(message: string) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":35,"text":"    super(message);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":36,"text":"    this.name = \"ArgError\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":37,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":38,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":39,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":40,"text":"export const USAGE = `Usage: comprehende <command> [options]"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":41,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":42,"text":"Run inside the git repository under review. Cwd is the repo."},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":43,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":44,"text":"Commands:"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":45,"text":"  review    [--base <ref>] [--head <ref>] --data <review.json>"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":46,"text":"            Write a covering skeleton (every hunk ref, stub prose). Does not"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":47,"text":"            invent a review. Fill title, groups, and summaries, then validate."},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":48,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":49,"text":"  digest    [--base <ref>] [--head <ref>]"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":50,"text":"            Print one line per changed file (kind, hunks, symbols). No patch"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":51,"text":"            text. Group from this; fetch patch with show."},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":52,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":53,"text":"  show      [--base <ref>] [--head <ref>] --hunk <ref> | --file <path>"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":54,"text":"            Print the patch for one hunk (path@oldStart+newStart) or one file."},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":55,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":56,"text":"  pregroup  [--base <ref>] [--head <ref>] --data <review.json>"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":57,"text":"            Write a draft review: identical copies, mechanical files, and one"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":58,"text":"            change group for the rest. Accept, split, and write the prose."},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":59,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":60,"text":"  validate  --data <review.json>"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":61,"text":"            Check schema, ref resolution, hunk coverage, and source citations"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":62,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":63,"text":"  serve     --data <review.json> [--port <n>] [--open]"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":64,"text":"            Serve the local UI on 127.0.0.1 (pins commit SHAs at start)"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":65,"text":""},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":66,"text":"  export    --data <review.json> --out <dir>"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":67,"text":"            Write a static site (same UI + frozen git payloads). Highlighters only"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":68,"text":"            for languages in the review. No server after that."},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":69,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":70,"text":"Options:"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":71,"text":"  --base <ref>     Base ref (default: origin/HEAD or main/master)"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":72,"text":"  --head <ref>     Head ref (default: HEAD)"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":73,"text":"  --data <path>    Review document path"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":74,"text":"  --out <dir>      Output directory for export"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":75,"text":"  --port <n>       Listen port (default: ${DEFAULT_PORT}, 0 for ephemeral)"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":76,"text":"  --open           Open the UI in a browser"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":77,"text":"  -h, --help       Show this help"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":78,"text":"  -v, --version    Show version"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":79,"text":""},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":80,"text":"Diffs come from git objects at the pinned SHAs. The review document is interpretation only."},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":81,"text":"Serve resolves refs when it starts. A later checkout does not change that review."},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":82,"text":"`;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":83,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":84,"text":"export function parseArgv(argv: string[], cwd = process.cwd()): CliRequest {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":85,"text":"  const args = argv[0] === \"--\" ? argv.slice(1) : [...argv];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":86,"text":"  if (args.length === 0 || args.includes(\"-h\") || args.includes(\"--help\")) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":87,"text":"    return { kind: \"help\" };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":88,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":89,"text":"  if (args.includes(\"-v\") || args.includes(\"--version\")) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":90,"text":"    return { kind: \"version\" };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":91,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":92,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":93,"text":"  const command = args[0];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":94,"text":"  if (command === undefined) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":95,"text":"    return { kind: \"help\" };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":96,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":97,"text":"  if (!isCommand(command)) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":98,"text":"    return { kind: \"error\", message: `Unknown command: ${command}\\n\\n${USAGE}` };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":99,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":100,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":101,"text":"  const rest = args.slice(1);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":102,"text":"  try {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":103,"text":"    const port = Number(flag(rest, \"--port\") ?? String(DEFAULT_PORT));"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":104,"text":"    if (!Number.isInteger(port) || port < 0) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":105,"text":"      throw new ArgError(\"--port must be a non-negative integer\");"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":106,"text":"    }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":107,"text":"    return {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":108,"text":"      kind: \"command\","},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":109,"text":"      command,"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":110,"text":"      cwd,"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":111,"text":"      base: flag(rest, \"--base\"),"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":112,"text":"      head: flag(rest, \"--head\"),"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":113,"text":"      data: flag(rest, \"--data\"),"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":114,"text":"      out: flag(rest, \"--out\"),"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":115,"text":"      hunk: flag(rest, \"--hunk\"),"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":116,"text":"      file: flag(rest, \"--file\"),"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":117,"text":"      port,"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":118,"text":"      open: rest.includes(\"--open\"),"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":119,"text":"    };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":120,"text":"  } catch (error) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":121,"text":"    return { kind: \"error\", message: error instanceof Error ? error.message : String(error) };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":122,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":123,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":124,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":125,"text":"function isCommand(value: string): value is CommandName {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":126,"text":"  return COMMANDS.has(value);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":127,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":128,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":129,"text":"function flag(args: string[], name: string): string | undefined {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":130,"text":"  const prefix = `${name}=`;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":131,"text":"  for (let i = 0; i < args.length; i += 1) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":132,"text":"    const arg = args[i];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":133,"text":"    if (arg === undefined) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":134,"text":"      continue;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":135,"text":"    }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":136,"text":"    if (arg === name) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":137,"text":"      const value = args[i + 1];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":138,"text":"      if (value === undefined || value.startsWith(\"-\")) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":139,"text":"        throw new ArgError(`${name} requires a value`);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":140,"text":"      }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":141,"text":"      return value;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":142,"text":"    }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":143,"text":"    if (arg.startsWith(prefix)) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":144,"text":"      const value = arg.slice(prefix.length);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":145,"text":"      if (value === \"\") {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":146,"text":"        throw new ArgError(`${name} requires a value`);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":147,"text":"      }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":148,"text":"      return value;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":149,"text":"    }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":150,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":151,"text":"  return undefined;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":152,"text":"}"}]}
