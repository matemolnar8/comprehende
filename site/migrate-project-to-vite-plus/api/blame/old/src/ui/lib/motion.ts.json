{"path":"src/ui/lib/motion.ts","ref":"faffb06a46ff492182596dbb26b16485f45b27a0","side":"old","lines":[{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":1,"text":"import { flushSync } from \"react-dom\";"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":2,"text":""},{"sha":"e9b20d5d583fc4d220337a9ff22e1e6bcf6373e7","author":"Cursor Agent","timestamp":1787413230,"line":3,"text":"export type MotionKind = \"group\" | \"scene\";"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":4,"text":""},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":5,"text":"let motionGeneration = 0;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":6,"text":""},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":7,"text":"export function prefersReducedMotion(): boolean {"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":8,"text":"  return typeof matchMedia === \"function\" && matchMedia(\"(prefers-reduced-motion: reduce)\").matches;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":9,"text":"}"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":10,"text":""},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":11,"text":"export function shouldViewTransition(options?: {"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":12,"text":"  reducedMotion?: boolean;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":13,"text":"  startViewTransition?: unknown;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":14,"text":"}): boolean {"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":15,"text":"  const reduced = options?.reducedMotion ?? prefersReducedMotion();"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":16,"text":"  const start ="},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":17,"text":"    options?.startViewTransition ?? (typeof document === \"undefined\" ? undefined : document.startViewTransition);"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":18,"text":"  return !reduced && typeof start === \"function\";"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":19,"text":"}"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":20,"text":""},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":21,"text":"export function runViewTransition(update: () => void, kind: MotionKind): void {"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":22,"text":"  if (!shouldViewTransition()) {"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":23,"text":"    update();"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":24,"text":"    return;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":25,"text":"  }"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":26,"text":"  const start = document.startViewTransition;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":27,"text":"  if (typeof start !== \"function\") {"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":28,"text":"    update();"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":29,"text":"    return;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":30,"text":"  }"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":31,"text":"  const root = document.documentElement;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":32,"text":"  const token = ++motionGeneration;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":33,"text":"  root.dataset.motion = kind;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":34,"text":"  try {"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":35,"text":"    const done = start.call(document, () => {"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":36,"text":"      flushSync(update);"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":37,"text":"    });"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":38,"text":"    void done.finished.finally(() => {"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":39,"text":"      if (token === motionGeneration) {"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":40,"text":"        delete root.dataset.motion;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":41,"text":"      }"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":42,"text":"    });"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":43,"text":"  } catch {"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":44,"text":"    if (token === motionGeneration) {"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":45,"text":"      delete root.dataset.motion;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":46,"text":"    }"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":47,"text":"    update();"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":48,"text":"  }"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":49,"text":"}"}]}
