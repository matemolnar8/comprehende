62002aac7eec","author":"matemolnar8","timestamp":1786830671,"line":25,"text":"  it(\"adds and removes a path without mutating the original set\", () => {"},{"sha":"3b77d511f1410e07ce5ec89f2b3562002aac7eec","author":"matemolnar8","timestamp":1786830671,"line":26,"text":"    const original = new Set([\"src/a.ts\"]);"},{"sha":"3b77d511f1410e07ce5ec89f2b3562002aac7eec","author":"matemolnar8","timestamp":1786830671,"line":27,"text":"    const added = setPathViewed(original, \"src/b.ts\", true);"},{"sha":"3b77d511f1410e07ce5ec89f2b3562002aac7eec","author":"matemolnar8","timestamp":1786830671,"line":28,"text":"    const removed = setPathViewed(original, \"src/a.ts\", false);"},{"sha":"3b77d511f1410e07ce5ec89f2b3562002aac7eec","author":"matemolnar8","timestamp":1786830671,"line":29,"text":"    assert.deepEqual([...original], [\"src/a.ts\"]);"},{"sha":"3b77d511f1410e07ce5ec89f2b3562002aac7eec","author":"matemolnar8","timestamp":1786830671,"line":30,"text":"    assert.equal(added.has(\"src/a.ts\"), true);"},{"sha":"3b77d511f1410e07ce5ec89f2b3562002aac7eec","author":"matemolnar8","timestamp":1786830671,"line":31,"text":"    assert.equal(added.has(\"src/b.ts\"), true);"},{"sha":"3b77d511f1410e07ce5ec89f2b3562002aac7eec","author":"matemolnar8","timestamp":1786830671,"line":32,"text":"    assert.equal(removed.has(\"src/a.ts\"), false);"},{"sha":"3b77d511f1410e07ce5ec89f2b3562002aac7eec","author":"matemolnar8","timestamp":1786830671,"line":33,"text":"  });"},{"sha":"3b77d511f1410e07ce5ec89f2b3562002aac7eec","author":"matemolnar8","timestamp":1786830671,"line":34,"text":"});"}]}
