{"path":"src/ui/lib/look-for.ts","ref":"faffb06a46ff492182596dbb26b16485f45b27a0","side":"old","lines":[{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":1,"text":"import { padIndex } from \"../../schema/types.ts\";"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":2,"text":"import { citationIds, groupIdForPinnedSource, groupSourceIds, isLinePinned } from \"../../schema/source.ts\";"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":3,"text":"import type { ReviewDocument, Source } from \"../../schema/types.ts\";"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":4,"text":"import { groupOrderIndex, groupParts, type PartGroup } from \"./parts.ts\";"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":5,"text":"import type { Selection } from \"./selection.ts\";"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":6,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":7,"text":"export const LOOK_FOR_TAGS = [\"Subtle\", \"Breaking\", \"Race\", \"Perf\"] as const;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":8,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":9,"text":"export type LookForTag = (typeof LOOK_FOR_TAGS)[number];"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":10,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":11,"text":"const LOOK_FOR_TAG_RE = /^(Subtle|Breaking|Race|Perf)\\.\\s+(.*)$/;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":12,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":13,"text":"export type LookForOwner ="},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":14,"text":"  | { kind: \"document\" }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":15,"text":"  | { kind: \"group\"; id: string; title: string; index: number; part?: string };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":16,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":17,"text":"export type LookForClaim = {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":18,"text":"  key: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":19,"text":"  owner: LookForOwner;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":20,"text":"  index: number;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":21,"text":"  tag?: LookForTag;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":22,"text":"  text: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":23,"text":"  body: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":24,"text":"  sourceIds: string[];"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":25,"text":"};"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":26,"text":""},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":27,"text":"export type LookForGroup = PartGroup & {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":28,"text":"  title: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":29,"text":"  lookFor?: readonly string[];"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":30,"text":"};"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":31,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":32,"text":"export function parseLookForBullet(text: string): { tag?: LookForTag; body: string } {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":33,"text":"  const match = LOOK_FOR_TAG_RE.exec(text);"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":34,"text":"  if (match === null) {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":35,"text":"    return { body: text };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":36,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":37,"text":"  const tag = match[1];"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":38,"text":"  const body = match[2];"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":39,"text":"  if (tag === undefined || body === undefined || body === \"\") {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":40,"text":"    return { body: text };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":41,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":42,"text":"  return { tag: tag as LookForTag, body };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":43,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":44,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":45,"text":"export function lookForKey(owner: LookForOwner, index: number): string {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":46,"text":"  return owner.kind === \"document\" ? `document:${index}` : `group:${owner.id}:${index}`;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":47,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":48,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":49,"text":"export function lookForOwnerLabel(owner: LookForOwner): string {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":50,"text":"  if (owner.kind === \"document\") {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":51,"text":"    return \"Overview\";"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":52,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":53,"text":"  return `${padIndex(owner.index)} ${owner.title}`;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":54,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":55,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":56,"text":"export function selectionForLookFor(owner: LookForOwner): Selection {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":57,"text":"  return owner.kind === \"document\" ? { kind: \"overview\" } : { kind: \"group\", id: owner.id };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":58,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":59,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":60,"text":"export function claimsFromLookFor(owner: LookForOwner, items: readonly string[] | undefined): LookForClaim[] {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":61,"text":"  return (items ?? []).map((text, index) => {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":62,"text":"    const parsed = parseLookForBullet(text);"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":63,"text":"    const claim: LookForClaim = {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":64,"text":"      key: lookForKey(owner, index),"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":65,"text":"      owner,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":66,"text":"      index,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":67,"text":"      text,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":68,"text":"      body: parsed.body,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":69,"text":"      sourceIds: citationIds(text),"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":70,"text":"    };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":71,"text":"    if (parsed.tag !== undefined) {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":72,"text":"      claim.tag = parsed.tag;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":73,"text":"    }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":74,"text":"    return claim;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":75,"text":"  });"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":76,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":77,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":78,"text":"export function lookForClaims(document: { lookFor?: readonly string[] }, groups: readonly LookForGroup[]): LookForClaim[] {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":79,"text":"  const claims = claimsFromLookFor({ kind: \"document\" }, document.lookFor);"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":80,"text":"  const parts = groupParts(groups);"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":81,"text":"  const byId = new Map(groups.map((group) => [group.id, group]));"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":82,"text":"  for (const part of parts) {"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":83,"text":"    for (const id of part.groupIds) {"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":84,"text":"      const group = byId.get(id);"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":85,"text":"      if (group === undefined) {"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":86,"text":"        continue;"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":87,"text":"      }"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":88,"text":"      const owner: LookForOwner = {"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":89,"text":"        kind: \"group\","},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":90,"text":"        id: group.id,"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":91,"text":"        title: group.title,"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":92,"text":"        index: groupOrderIndex(parts, group.id),"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":93,"text":"      };"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":94,"text":"      if (group.part !== undefined) {"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":95,"text":"        owner.part = group.part;"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":96,"text":"      }"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":97,"text":"      claims.push(...claimsFromLookFor(owner, group.lookFor));"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":98,"text":"    }"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":99,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":100,"text":"  return claims;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":101,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":102,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":103,"text":"export type SourceOpenTarget = {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":104,"text":"  selection: Selection;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":105,"text":"  lookForKey?: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":106,"text":"  commentId?: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":107,"text":"};"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":108,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":109,"text":"export function openTargetForSource("},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":110,"text":"  source: Source,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":111,"text":"  claims: readonly LookForClaim[],"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":112,"text":"  document: ReviewDocument,"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":113,"text":"  currentGroupId?: string,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":114,"text":"): SourceOpenTarget {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":115,"text":"  if (isLinePinned(source)) {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":116,"text":"    const groupId = groupIdForPinnedSource(document, source);"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":117,"text":"    if (groupId !== undefined) {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":118,"text":"      return { selection: { kind: \"group\", id: groupId }, commentId: source.id };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":119,"text":"    }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":120,"text":"  }"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":121,"text":"  const citing = claims.filter((claim) => claim.sourceIds.includes(source.id));"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":122,"text":"  const currentClaim = citing.find("},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":123,"text":"    (claim) => claim.owner.kind === \"group\" && claim.owner.id === currentGroupId,"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":124,"text":"  );"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":125,"text":"  if (currentClaim !== undefined) {"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":126,"text":"    return { selection: selectionForLookFor(currentClaim.owner), lookForKey: currentClaim.key };"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":127,"text":"  }"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":128,"text":"  if (currentGroupId !== undefined) {"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":129,"text":"    const current = document.groups.find((group) => group.id === currentGroupId);"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":130,"text":"    if (current !== undefined && groupSourceIds(current).includes(source.id)) {"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":131,"text":"      return { selection: { kind: \"group\", id: currentGroupId } };"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":132,"text":"    }"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":133,"text":"  }"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":134,"text":"  const groupClaim = citing.find((claim) => claim.owner.kind === \"group\");"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":135,"text":"  if (groupClaim !== undefined) {"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":136,"text":"    return { selection: selectionForLookFor(groupClaim.owner), lookForKey: groupClaim.key };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":137,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":138,"text":"  const named = document.groups.find((group) => (group.sources ?? []).includes(source.id));"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":139,"text":"  if (named !== undefined) {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":140,"text":"    return { selection: { kind: \"group\", id: named.id } };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":141,"text":"  }"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":142,"text":"  const documentClaim = citing.find((claim) => claim.owner.kind === \"document\");"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":143,"text":"  if (documentClaim !== undefined) {"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":144,"text":"    return { selection: selectionForLookFor(documentClaim.owner), lookForKey: documentClaim.key };"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":145,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":146,"text":"  return { selection: { kind: \"overview\" } };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":147,"text":"}"}]}
