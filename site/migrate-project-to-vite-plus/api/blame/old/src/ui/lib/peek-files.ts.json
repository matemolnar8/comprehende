{"path":"src/ui/lib/peek-files.ts","ref":"faffb06a46ff492182596dbb26b16485f45b27a0","side":"old","lines":[{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":1,"text":"export const PEEK_LIMIT = 3;"},{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":2,"text":""},{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":3,"text":"/** Show every path when the remainder would be 1. Otherwise cap at `limit`. */"},{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":4,"text":"export function peekFiles(paths: readonly string[], limit = PEEK_LIMIT): { shown: string[]; rest: number } {"},{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":5,"text":"  if (paths.length <= limit + 1) {"},{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":6,"text":"    return { shown: [...paths], rest: 0 };"},{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":7,"text":"  }"},{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":8,"text":"  return { shown: paths.slice(0, limit), rest: paths.length - limit };"},{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":9,"text":"}"}]}
