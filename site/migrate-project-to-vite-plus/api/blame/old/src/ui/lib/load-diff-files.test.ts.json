{"path":"src/ui/lib/load-diff-files.test.ts","ref":"faffb06a46ff492182596dbb26b16485f45b27a0","side":"old","lines":[{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":1,"text":"import assert from \"node:assert/strict\";"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":2,"text":"import { describe, it } from \"node:test\";"},{"sha":"b78b90b404949197e2604456588c1d57033c3678","author":"Máté Molnár","timestamp":1787892092,"line":3,"text":"import type { ApiFile } from \"../../api/types.ts\";"},{"sha":"b78b90b404949197e2604456588c1d57033c3678","author":"Máté Molnár","timestamp":1787892092,"line":4,"text":"import { canHydrateDiff, loadDiffFilesWith, splitHasTwoSides, toPierreFile } from \"./load-diff-files.ts\";"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":5,"text":""},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":6,"text":"function apiFile(side: \"old\" | \"new\", path: string, content: string): ApiFile {"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":7,"text":"  return { path, ref: `${side}-sha`, side, content, language: \"typescript\" };"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":8,"text":"}"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":9,"text":""},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":10,"text":"describe(\"load diff files\", () => {"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":11,"text":"  it(\"keys Pierre file cache by side, ref, and path\", () => {"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":12,"text":"    const file = toPierreFile(apiFile(\"new\", \"src/app.ts\", \"export const n = 1;\\n\"));"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":13,"text":"    assert.equal(file.name, \"src/app.ts\");"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":14,"text":"    assert.equal(file.contents, \"export const n = 1;\\n\");"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":15,"text":"    assert.equal(file.cacheKey, toPierreFile(apiFile(\"new\", \"src/app.ts\", \"export const n = 1;\\n\")).cacheKey);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":16,"text":"    assert.notEqual(file.cacheKey, toPierreFile(apiFile(\"old\", \"src/app.ts\", \"export const n = 1;\\n\")).cacheKey);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":17,"text":"    assert.notEqual(file.cacheKey, toPierreFile(apiFile(\"new\", \"src/other.ts\", \"export const n = 1;\\n\")).cacheKey);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":18,"text":"    assert.notEqual("},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":19,"text":"      file.cacheKey,"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":20,"text":"      toPierreFile({ path: \"src/app.ts\", ref: \"other-sha\", side: \"new\", content: \"export const n = 1;\\n\", language: \"typescript\" }).cacheKey,"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":21,"text":"    );"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":22,"text":"  });"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":23,"text":""},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":24,"text":"  it(\"loads both sides for a changed file\", async () => {"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":25,"text":"    const calls: string[] = [];"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":26,"text":"    const loaded = await loadDiffFilesWith({ name: \"src/app.ts\", type: \"change\" }, async (path, side) => {"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":27,"text":"      calls.push(`${side}:${path}`);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":28,"text":"      return apiFile(side, path, `${side} body`);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":29,"text":"    });"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":30,"text":"    assert.deepEqual(calls.sort(), [\"new:src/app.ts\", \"old:src/app.ts\"]);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":31,"text":"    assert.equal(loaded.oldFile?.contents, \"old body\");"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":32,"text":"    assert.equal(loaded.newFile.contents, \"new body\");"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":33,"text":"  });"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":34,"text":""},{"sha":"bb4c0dfa388a8e17ac3d986bec01e6728bf8251d","author":"Cursor Agent","timestamp":1787468448,"line":35,"text":"  it(\"hydrates partial change and rename diffs, not added files\", () => {"},{"sha":"bb4c0dfa388a8e17ac3d986bec01e6728bf8251d","author":"Cursor Agent","timestamp":1787468448,"line":36,"text":"    assert.equal(canHydrateDiff({ isPartial: true, type: \"change\" }), true);"},{"sha":"bb4c0dfa388a8e17ac3d986bec01e6728bf8251d","author":"Cursor Agent","timestamp":1787468448,"line":37,"text":"    assert.equal(canHydrateDiff({ isPartial: true, type: \"rename-changed\" }), true);"},{"sha":"bb4c0dfa388a8e17ac3d986bec01e6728bf8251d","author":"Cursor Agent","timestamp":1787468448,"line":38,"text":"    assert.equal(canHydrateDiff({ isPartial: true, type: \"rename-pure\" }), true);"},{"sha":"bb4c0dfa388a8e17ac3d986bec01e6728bf8251d","author":"Cursor Agent","timestamp":1787468448,"line":39,"text":"    assert.equal(canHydrateDiff({ isPartial: false, type: \"change\" }), false);"},{"sha":"bb4c0dfa388a8e17ac3d986bec01e6728bf8251d","author":"Cursor Agent","timestamp":1787468448,"line":40,"text":"    assert.equal(canHydrateDiff({ isPartial: true, type: \"new\" }), false);"},{"sha":"bb4c0dfa388a8e17ac3d986bec01e6728bf8251d","author":"Cursor Agent","timestamp":1787468448,"line":41,"text":"  });"},{"sha":"bb4c0dfa388a8e17ac3d986bec01e6728bf8251d","author":"Cursor Agent","timestamp":1787468448,"line":42,"text":""},{"sha":"e19fdc8b56d4e6ebe757bf2e5b00f44b93cfe3ab","author":"matemolnar8","timestamp":1787517031,"line":43,"text":"  it(\"treats added and deleted files as one split pane\", () => {"},{"sha":"e19fdc8b56d4e6ebe757bf2e5b00f44b93cfe3ab","author":"matemolnar8","timestamp":1787517031,"line":44,"text":"    assert.equal(splitHasTwoSides(\"change\"), true);"},{"sha":"e19fdc8b56d4e6ebe757bf2e5b00f44b93cfe3ab","author":"matemolnar8","timestamp":1787517031,"line":45,"text":"    assert.equal(splitHasTwoSides(\"rename-changed\"), true);"},{"sha":"e19fdc8b56d4e6ebe757bf2e5b00f44b93cfe3ab","author":"matemolnar8","timestamp":1787517031,"line":46,"text":"    assert.equal(splitHasTwoSides(\"rename-pure\"), true);"},{"sha":"e19fdc8b56d4e6ebe757bf2e5b00f44b93cfe3ab","author":"matemolnar8","timestamp":1787517031,"line":47,"text":"    assert.equal(splitHasTwoSides(\"new\"), false);"},{"sha":"e19fdc8b56d4e6ebe757bf2e5b00f44b93cfe3ab","author":"matemolnar8","timestamp":1787517031,"line":48,"text":"    assert.equal(splitHasTwoSides(\"deleted\"), false);"},{"sha":"e19fdc8b56d4e6ebe757bf2e5b00f44b93cfe3ab","author":"matemolnar8","timestamp":1787517031,"line":49,"text":"  });"},{"sha":"e19fdc8b56d4e6ebe757bf2e5b00f44b93cfe3ab","author":"matemolnar8","timestamp":1787517031,"line":50,"text":""},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":51,"text":"  it(\"loads only the new side for a pure rename\", async () => {"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":52,"text":"    const calls: string[] = [];"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":53,"text":"    const loaded = await loadDiffFilesWith({ name: \"src/helpers.ts\", type: \"rename-pure\" }, async (path, side) => {"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":54,"text":"      calls.push(`${side}:${path}`);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":55,"text":"      return apiFile(side, path, \"renamed\");"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":56,"text":"    });"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":57,"text":"    assert.deepEqual(calls, [\"new:src/helpers.ts\"]);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":58,"text":"    assert.equal(loaded.oldFile, null);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":59,"text":"    assert.equal(loaded.newFile.contents, \"renamed\");"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":60,"text":"  });"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":61,"text":"});"}]}
