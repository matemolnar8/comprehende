":1787083603,"line":12,"text":"    assert.deepEqual(fitImageStage(100, 100, 400, 400), { width: 100, height: 100, scale: 1 });"},{"sha":"1b3e33b0d69556e008a7e6174a0bd5c8d624b4e9","author":"Cursor Agent","timestamp":1787083603,"line":13,"text":"  });"},{"sha":"1b3e33b0d69556e008a7e6174a0bd5c8d624b4e9","author":"Cursor Agent","timestamp":1787083603,"line":14,"text":""},{"sha":"1b3e33b0d69556e008a7e6174a0bd5c8d624b4e9","author":"Cursor Agent","timestamp":1787083603,"line":15,"text":"  it(\"returns an empty stage until the host is measured\", () => {"},{"sha":"1b3e33b0d69556e008a7e6174a0bd5c8d624b4e9","author":"Cursor Agent","timestamp":1787083603,"line":16,"text":"    assert.deepEqual(fitImageStage(320, 180, 0, 800), { width: 0, height: 0, scale: 1 });"},{"sha":"1b3e33b0d69556e008a7e6174a0bd5c8d624b4e9","author":"Cursor Agent","timestamp":1787083603,"line":17,"text":"  });"},{"sha":"1b3e33b0d69556e008a7e6174a0bd5c8d624b4e9","author":"Cursor Agent","timestamp":1787083603,"line":18,"text":"});"},{"sha":"1b3e33b0d69556e008a7e6174a0bd5c8d624b4e9","author":"Cursor Agent","timestamp":1787083603,"line":19,"text":""},{"sha":"a8b198f1801ee74faab6608a0a26871e94d42625","author":"Cursor Agent","timestamp":1787115088,"line":20,"text":"describe(\"fitTwoColumnStage\", () => {"},{"sha":"a8b198f1801ee74faab6608a0a26871e94d42625","author":"Cursor Agent","timestamp":1787115088,"line":21,"text":"  it(\"keeps two native panes when they already fit\", () => {"},{"sha":"a8b198f1801ee74faab6608a0a26871e94d42625","author":"Cursor Agent","timestamp":1787115088,"line":22,"text":"    const pane = fitTwoColumnStage(320, 180, 900, 800);"},{"sha":"a8b198f1801ee74faab6608a0a26871e94d42625","author":"Cursor Agent","timestamp":1787115088,"line":23,"text":"    assert.deepEqual(pane, { width: 320, height: 180, scale: 1 });"},{"sha":"a8b198f1801ee74faab6608a0a26871e94d42625","author":"Cursor Agent","timestamp":1787115088,"line":24,"text":"    assert.ok(pane.width * 2 + 1 <= 900);"},{"sha":"a8b198f1801ee74