e":14,"text":""},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":15,"text":"export function gapSeparator(path: readonly EventTarget[]): HTMLElement | undefined {"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":16,"text":"  for (const node of path) {"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":17,"text":"    if (!hasClosest(node)) continue"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":18,"text":"    const sep = node.closest(\"[data-expand-index]\")"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":19,"text":"    if (isBox(sep)) return sep"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":20,"text":"  }"},{"sha":"533c72789b32f8acc8c6ea1e5a311efa71e3e375","author":"Cursor Agent","timestamp":1787484361,"line":21,"text":"}"},{"sha":"533c72789b32f8acc8c6ea1e5a311efa71e3e375","author":"Cursor Agent","timestamp":1787484361,"line":22,"text":""},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":23,"text":"/** Pierre Shift+click and the count / expand-all control insert above. A plain ↓ does not. */"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":24,"text":"export function isPlainDownClick(path: readonly EventTarget[], shiftKey: boolean): boolean {"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":25,"text":"  if (shiftKey) return false"},{"sha":"57426b58398fa4fc449c21a27320efd64c5fb954","author":"Cursor Agent","timestamp":1787484836,"line":26,"text":"  for (const node of path) {"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":27,"text":"    if (!hasClosest(node)) continue"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":28,"text":"    if (node.closest(\"[data-expand-all-button]\")) return false"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":29,"text":"    if (node.closest(\"[data-expand-down]\")) return true"},{"sha":"57426b58398fa4fc449c21a27320efd64c5fb954","author":"Cursor Agent","timestamp":1787484836,"line":30,"text":"  }"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":31,"text":"  return false"},{"sha":"533c72789b32f8acc8c6ea1e5a311efa71e3e375","author":"Cursor Agent","timestamp":1787484361,"line":32,"text":"}"},{"sha":"533c72789b32f8acc8c6ea1e5a311efa71e3e375","author":"Cursor Agent","timestamp":1787484361,"line":33,"text":""},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":34,"text":"export function reviewScroller(from: Element): HTMLElement | undefined {"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":35,"text":"  const main = from.closest(\"main\")"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":36,"text":"  return main instanceof HTMLElement ? main : undefined"},{"sha":"533c72789b32f8acc8c6ea1e5a311efa71e3e375","author":"Cursor Agent","timestamp":1787484361,"line":37,"text":"}"},{"sha":"533c72789b32f8acc8c6ea1e5a311efa71e3e375","author":"Cursor Agent","timestamp":1787484361,"line":38,"text":""},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":39,"text":"export function adjustScroll(scroller: HTMLElement, delta: number): void {"},{"sha":"533c72789b32f8acc8c6ea1e5a311efa71e3e375","author":"Cursor Agent","timestamp":1787484361,"line":40,"text":"  if (delta === 0) return"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":41,"text":"  const { style } = scroller"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":42,"text":"  const prev = style.scrollBehavior"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":43,"text":"  style.scrollBehavior = \"auto\""},{"sha":"533c72789b32f8acc8c6ea1e5a311efa71e3e375","author":"Cursor Agent","timestamp":1787484361,"line":44,"text":"  scroller.scrollTop += delta"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":45,"text":"  style.scrollBehavior = prev"},{"sha":"533c72789b32f8acc8c6ea1e5a311efa71e3e375","author":"Cursor Agent","timestamp":1787484361,"line":46,"text":"}"},{"sha":"533c72789b32f8acc8c6ea1e5a311efa71e3e375","author":"Cursor Agent","timestamp":1787484361,"line":47,"text":""},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":48,"text":"export function settleGapPin(pin: GapPin, host: HTMLElement): \"wait\" | \"ok\" | \"done\" {"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":49,"text":"  if (Date.now() - pin.createdAt > STALE_MS) return \"done\""},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":50,"text":"  const root = host.shadowRoot"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":51,"text":"  if (root == null) return \"wait\""},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":52,"text":"  const sep = findSeparator(root, pin.index)"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":53,"text":"  if (sep === undefined) {"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":54,"text":"    adjustScroll(pin.scroller, pin.scroller.scrollHeight - pin.scrollHeight)"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":55,"text":"    return \"done\""},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":56,"text":"  }"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":57,"text":"  const delta = sep.getBoundingClientRect().top - pin.top"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":58,"text":"  if (Math.abs(delta) < ALIGN_PX) return \"ok\""},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":59,"text":"  adjustScroll(pin.scroller, delta)"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":60,"text":"  return \"wait\""},{"sha":"57426b58398fa4fc449c21a27320efd64c5fb954","author":"Cursor Agent","timestamp":1787484836,"line":61,"text":"}"},{"sha":"57426b58398fa4fc449c21a27320efd64c5fb954","author":"Cursor Agent","timestamp":1787484836,"line":62,"text":""},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":63,"text":"export function watchGapPin("},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":64,"text":"  pin: GapPin,"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":65,"text":"  host: HTMLElement,"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":66,"text":"  live: () => boolean,"},{"sha":"57426b58398fa4fc449c21a27320efd64c5fb954","author":"Cursor Agent","timestamp":1787484836,"line":67,"text":"  onDone: () => void,"},{"sha":"57426b58398fa4fc449c21a27320efd64c5fb954","author":"Cursor Agent","timestamp":1787484836,"line":68,"text":"  schedule: (tick: () => void) => void = requestAnimationFrame,"},{"sha":"57426b58398fa4fc449c21a27320efd64c5fb954","author":"Cursor Agent","timestamp":1787484836,"line":69,"text":"): void {"},{"sha":"57426b58398fa4fc449c21a27320efd64c5fb954","author":"Cursor Agent","timestamp":1787484836,"line":70,"text":"  let aligned = 0"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":71,"text":"  let moved = false"},{"sha":"57426b58398fa4fc449c21a27320efd64c5fb954","author":"Cursor Agent","timestamp":1787484836,"line":72,"text":"  const tick = () => {"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":73,"text":"    if (!live() || Date.now() - pin.createdAt > STALE_MS) {"},{"sha":"57426b58398fa4fc449c21a27320efd64c5fb954","author":"Cursor Agent","timestamp":1787484836,"line":74,"text":"      onDone()"},{"sha":"57426b58398fa4fc449c21a27320efd64c5fb954","author":"Cursor Agent","timestamp":1787484836,"line":75,"text":"      return"},{"sha":"57426b58398fa4fc449c21a27320efd64c5fb954","author":"Cursor Agent","timestamp":1787484836,"line":76,"text":"    }"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":77,"text":"    const result = settleGapPin(pin, host)"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc8185187019b","author":"Cursor Agent","timestamp":1787487434,"line":78,"text":"    if (result === \"done\") {"},{"sha":"57426b58398fa4fc449c21a27320efd64c5fb954","author":"Cursor Agent","timestamp":1787484836,"line":79,"text":"      onDone()"},{"sha":"57426b58398fa4fc449c21a27320efd64c5fb954","author":"Cursor Agent","timestamp":1787484836,"line":80,"text":"      return"},{"sha":"57426b58398fa4fc449c21a27320efd64c5fb954","author":"Cursor Agent","timestamp":1787484836,"line":81,"text":"    }"},{"sha":"1204f7cd9ad2ec588a3d2c58c1fcc