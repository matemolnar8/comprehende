{"path":"src/ui/lib/theme.test.ts","ref":"faffb06a46ff492182596dbb26b16485f45b27a0","side":"old","lines":[{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":1,"text":"import assert from \"node:assert/strict\";"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":2,"text":"import { describe, it } from \"node:test\";"},{"sha":"b78b90b404949197e2604456588c1d57033c3678","author":"Máté Molnár","timestamp":1787892092,"line":3,"text":"import { parseThemePreference, resolveTheme } from \"./theme.ts\";"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":4,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":5,"text":"describe(\"theme preference\", () => {"},{"sha":"3f2e98a27dafeeef111e98c7fec141a7f1e7c963","author":"Máté Molnár","timestamp":1787686401,"line":6,"text":"  it(\"treats missing or unknown values as auto\", () => {"},{"sha":"3f2e98a27dafeeef111e98c7fec141a7f1e7c963","author":"Máté Molnár","timestamp":1787686401,"line":7,"text":"    assert.equal(parseThemePreference(null), \"auto\");"},{"sha":"3f2e98a27dafeeef111e98c7fec141a7f1e7c963","author":"Máté Molnár","timestamp":1787686401,"line":8,"text":"    assert.equal(parseThemePreference(\"\"), \"auto\");"},{"sha":"3f2e98a27dafeeef111e98c7fec141a7f1e7c963","author":"Máté Molnár","timestamp":1787686401,"line":9,"text":"    assert.equal(parseThemePreference(\"dim\"), \"auto\");"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":10,"text":"  });"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":11,"text":""},{"sha":"3f2e98a27dafeeef111e98c7fec141a7f1e7c963","author":"Máté Molnár","timestamp":1787686401,"line":12,"text":"  it(\"accepts stored light, dark, and auto\", () => {"},{"sha":"0199c71ef25425800