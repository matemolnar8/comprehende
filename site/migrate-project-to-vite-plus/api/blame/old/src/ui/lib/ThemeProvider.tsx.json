{"path":"src/ui/lib/ThemeProvider.tsx","ref":"faffb06a46ff492182596dbb26b16485f45b27a0","side":"old","lines":[{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":1,"text":"import { createContext, useCallback, useContext, useEffect, useMemo, useState, type ReactNode } from \"react\";"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":2,"text":"import {"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":3,"text":"  applyResolvedTheme,"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":4,"text":"  readStoredPreference,"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":5,"text":"  resolveTheme,"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":6,"text":"  systemPrefersDark,"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":7,"text":"  writeStoredPreference,"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":8,"text":"  type ResolvedTheme,"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":9,"text":"  type ThemePreference,"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":10,"text":"} from \"./theme.ts\";"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":11,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":12,"text":"type ThemeContextValue = {"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":13,"text":"  preference: ThemePreference;"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":14,"text":"  resolved: ResolvedTheme;"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":15,"text":"  setPreference: (preference: ThemePreference) => void;"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":16,"text":"  toggleTheme: () => void;"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":17,"text":"};"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":18,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":19,"text":"const ThemeContext = createContext<ThemeContextValue | null>(null);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":20,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":21,"text":"export function ThemeProvider(props: { children: ReactNode }) {"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":22,"text":"  const [preference, setPreferenceState] = useState<ThemePreference>(readStoredPreference);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":23,"text":"  const [prefersDark, setPrefersDark] = useState(systemPrefersDark);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":24,"text":"  const resolved = resolveTheme(preference, prefersDark);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":25,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":26,"text":"  const setPreference = useCallback((next: ThemePreference) => {"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":27,"text":"    writeStoredPreference(next);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":28,"text":"    setPreferenceState(next);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":29,"text":"  }, []);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":30,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":31,"text":"  const toggleTheme = useCallback(() => {"},{"sha":"3f2e98a27dafeeef111e98c7fec141a7f1e7c963","author":"Máté Molnár","timestamp":1787686401,"line":32,"text":"    const next: ThemePreference = preference === \"auto\" ? \"light\" : preference === \"light\" ? \"dark\" : \"auto\";"},{"sha":"3f2e98a27dafeeef111e98c7fec141a7f1e7c963","author":"Máté Molnár","timestamp":1787686401,"line":33,"text":"    setPreference(next);"},{"sha":"3f2e98a27dafeeef111e98c7fec141a7f1e7c963","author":"Máté Molnár","timestamp":1787686401,"line":34,"text":"  }, [preference, setPreference]);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":35,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":36,"text":"  useEffect(() => {"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":37,"text":"    applyResolvedTheme(resolved);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":38,"text":"  }, [resolved]);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":39,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":40,"text":"  useEffect(() => {"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":41,"text":"    const media = window.matchMedia(\"(prefers-color-scheme: dark)\");"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":42,"text":"    const onChange = () => setPrefersDark(media.matches);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":43,"text":"    media.addEventListener(\"change\", onChange);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":44,"text":"    return () => media.removeEventListener(\"change\", onChange);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":45,"text":"  }, []);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":46,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":47,"text":"  const value = useMemo("},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":48,"text":"    () => ({ preference, resolved, setPreference, toggleTheme }),"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":49,"text":"    [preference, resolved, setPreference, toggleTheme],"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":50,"text":"  );"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":51,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":52,"text":"  return <ThemeContext.Provider value={value}>{props.children}</ThemeContext.Provider>;"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":53,"text":"}"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":54,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":55,"text":"export function useTheme(): ThemeContextValue {"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":56,"text":"  const value = useContext(ThemeContext);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":57,"text":"  if (value === null) {"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":58,"text":"    throw new Error(\"useTheme must be used within ThemeProvider\");"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":59,"text":"  }"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":60,"text":"  return value;"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":61,"text":"}"}]}
