{"path":"src/ui/diff-hydrate.test.ts","ref":"faffb06a46ff492182596dbb26b16485f45b27a0","side":"old","lines":[{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":1,"text":"import { hydratePartialDiff, parsePatchFiles } from \"@pierre/diffs\";"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":2,"text":"import assert from \"node:assert/strict\";"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":3,"text":"import { describe, it } from \"node:test\";"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":4,"text":"import { EXPANSION_LINE_COUNT } from \"./lib/gap-style.ts\";"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":5,"text":""},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":6,"text":"const PAD = Array.from({ length: 40 }, (_, i) => `const pad${i} = ${i};`);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":7,"text":""},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":8,"text":"const OLD = [\"const head = 1;\", 'const a = \"old\";', ...PAD, 'const b = \"old\";', \"const tail = 1;\"].join(\"\\n\");"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":9,"text":"const NEXT = [\"const head = 1;\", 'const a = \"new\";', ...PAD, 'const b = \"new\";', \"const tail = 1;\"].join(\"\\n\");"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":10,"text":""},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":11,"text":"const PATCH = `diff --git a/gap.ts b/gap.ts"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":12,"text":"--- a/gap.ts"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":13,"text":"+++ b/gap.ts"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":14,"text":"@@ -1,5 +1,5 @@"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":15,"text":" const head = 1;"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":16,"text":"-const a = \"old\";"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":17,"text":"+const a = \"new\";"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":18,"text":" const pad0 = 0;"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":19,"text":" const pad1 = 1;"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":20,"text":" const pad2 = 2;"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":21,"text":"@@ -40,5 +40,5 @@"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":22,"text":" const pad37 = 37;"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":23,"text":" const pad38 = 38;"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":24,"text":" const pad39 = 39;"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":25,"text":"-const b = \"old\";"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":26,"text":"+const b = \"new\";"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":27,"text":" const tail = 1;"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":28,"text":"`;"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":29,"text":""},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":30,"text":"describe(\"partial patch hydration\", () => {"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":31,"text":"  it(\"keeps the grouped hunks and fills the gap from full file contents\", () => {"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":32,"text":"    const parsed = parsePatchFiles(PATCH, \"gap-test\")[0]?.files[0];"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":33,"text":"    assert.ok(parsed);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":34,"text":"    assert.equal(parsed.isPartial, true);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":35,"text":"    assert.equal(parsed.hunks.length, 2);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":36,"text":"    const collapsed = parsed.hunks[1]?.collapsedBefore ?? 0;"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":37,"text":"    assert.ok(collapsed > EXPANSION_LINE_COUNT);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":38,"text":""},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":39,"text":"    const hydrated = hydratePartialDiff(\"clone\", parsed, {"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":40,"text":"      oldFile: { name: \"gap.ts\", contents: OLD, cacheKey: \"old\" },"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":41,"text":"      newFile: { name: \"gap.ts\", contents: NEXT, cacheKey: \"new\" },"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":42,"text":"    });"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":43,"text":"    assert.equal(hydrated.isPartial, false);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":44,"text":"    assert.equal(hydrated.hunks.length, 2);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":45,"text":"    assert.equal(hydrated.hunks[1]?.collapsedBefore, collapsed);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":46,"text":"    assert.equal(hydrated.additionLines.some((line) => line.includes('const a = \"new\"')), true);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":47,"text":"    assert.equal(hydrated.additionLines.some((line) => line.includes(\"const pad20 = 20\")), true);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":48,"text":"    assert.equal(hydrated.deletionLines.some((line) => line.includes('const b = \"old\"')), true);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":49,"text":"    assert.ok(hydrated.additionLines.length > 40);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":50,"text":"  });"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":51,"text":"});"}]}
