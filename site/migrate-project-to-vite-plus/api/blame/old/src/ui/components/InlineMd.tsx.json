r Agent","timestamp":1788035496,"line":37,"text":"      if (source === undefined) {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":38,"text":"        return createElement(StaleCite, { children });"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":39,"text":"      }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":40,"text":"      return createElement(SourceCite, { source, onCite: sources?.onCite, children });"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":41,"text":"    },"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":42,"text":"  } satisfies Components;"},{"sha":"915cc9ab35c05ee5e2fe1fff9aaaeb8ecca20657","author":"Cursor Agent","timestamp":1787460487,"line":43,"text":"  return createElement(Markdown, {"},{"sha":"915cc9ab35c05ee5e2fe1fff9aaaeb8ecca20657","author":"Cursor Agent","timestamp":1787460487,"line":44,"text":"    skipHtml: true,"},{"sha":"915cc9ab35c05ee5e2fe1fff9aaaeb8ecca20657","author":"Cursor Agent","timestamp":1787460487,"line":45,"text":"    unwrapDisallowed: true,"},{"sha":"07036ae64fc89577916ebc9fef5acdfec9f005eb","author":"Cursor Agent","timestamp":1787463924,"line":46,"text":"    allowedElements: [...INLINE_MD_ELEMENTS],"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":47,"text":"    urlTransform,"},{"sha":"07036ae64fc89577916ebc9fef5acdfec9f005eb","author":"Cursor Agent","timestamp":1787463924,"line":48,"text":"    components,"},{"sha":"915cc9ab35c05ee5e2fe1fff9aaaeb8ecca20657","author":"Cursor Agent","timestamp":1787460487,"line":49,"text":"    children: text,"},{"sha":"915cc9ab35c05ee5e2fe1fff9aaaeb8ecca20657","author":"Cursor Agent","timestamp":1787460487,"line":50,"text":"  });"},{"sha":"f58d51eae190c