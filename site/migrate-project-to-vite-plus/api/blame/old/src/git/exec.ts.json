xt":"      ...(opts?.input !== undefined ? { input: Buffer.from(opts.input) } : {}),"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":69,"text":"    });"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":70,"text":"    return stdout;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":71,"text":"  } catch (error) {"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":72,"text":"    throw gitFailure(args, asExecFailure(error));"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":73,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":74,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":75,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":76,"text":"export async function gitOk(cwd: string, args: string[]): Promise<boolean> {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":77,"text":"  try {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":78,"text":"    await git(cwd, args);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":79,"text":"    return true;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":80,"text":"  } catch {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":81,"text":"    return false;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":82,"text":"  }"},{"sha":"8