{"path":"src/review/digest.ts","ref":"faffb06a46ff492182596dbb26b16485f45b27a0","side":"old","lines":[{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":1,"text":"import { addedSymbols, lineDelta } from \"../schema/hunk-meta.ts\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":2,"text":"import { formatStoredHunkRef } from \"../schema/identity.ts\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":3,"text":"import type { DiffFile, FileStatus } from \"../schema/types.ts\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":4,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":5,"text":"export type DigestKind = \"logic\" | \"test\" | \"docs\" | \"generated\" | \"rename\" | \"copy\" | \"move\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":6,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":7,"text":"export type DigestHunk = {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":8,"text":"  /** Same syntax as hunkRefs: a path, or path@oldStart+newStart. */"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":9,"text":"  ref: string;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":10,"text":"  oldStart: number;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":11,"text":"  newStart: number;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":12,"text":"  added: number;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":13,"text":"  removed: number;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":14,"text":"  symbols: string[];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":15,"text":"  /** Every added and removed line is a moved block (see markMovedLines). */"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":16,"text":"  moved: boolean;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":17,"text":"};"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":18,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":19,"text":"export type DigestFile = {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":20,"text":"  path: string;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":21,"text":"  oldPath?: string;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":22,"text":"  status: FileStatus;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":23,"text":"  kind: DigestKind;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":24,"text":"  added: number;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":25,"text":"  removed: number;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":26,"text":"  hunks: DigestHunk[];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":27,"text":"  /** Test file whose source candidate lives next to it. Verify with show. */"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":28,"text":"  pairsWith?: string;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":29,"text":"  /** First path of an identical-copy cluster. Trust it; do not read both. */"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":30,"text":"  mirrorOf?: string;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":31,"text":"};"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":32,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":33,"text":"export type ChangeDigest = {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":34,"text":"  files: DigestFile[];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":35,"text":"  totalHunks: number;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":36,"text":"};"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":37,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":38,"text":"/** One line per file. No patch text, so this stays small on large diffs. */"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":39,"text":"export function buildDigest(files: DiffFile[]): ChangeDigest {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":40,"text":"  const digests = files"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":41,"text":"    .filter((file) => !file.binary || file.image)"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":42,"text":"    .map((file) => digestFile(file));"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":43,"text":"  markMirrors(digests, files);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":44,"text":"  return { files: digests, totalHunks: digests.reduce((total, file) => total + file.hunks.length, 0) };"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":45,"text":"}"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":46,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":47,"text":"function digestFile(file: DiffFile): DigestFile {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":48,"text":"  const hunks: DigestHunk[] = file.hunks.map((hunk) => {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":49,"text":"    const delta = lineDelta(hunk.lines);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":50,"text":"    const addedLines = hunk.lines.filter((line) => line.kind === \"add\").map((line) => line.text);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":51,"text":"    const content = hunk.lines.filter((line) => line.kind !== \"ctx\");"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":52,"text":"    return {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":53,"text":"      ref: formatStoredHunkRef("},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":54,"text":"        hunk.oldStart === 0 && hunk.newStart === 0"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":55,"text":"          ? { path: file.path }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":56,"text":"          : { path: file.path, oldStart: hunk.oldStart, newStart: hunk.newStart },"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":57,"text":"      ),"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":58,"text":"      oldStart: hunk.oldStart,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":59,"text":"      newStart: hunk.newStart,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":60,"text":"      added: delta.added,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":61,"text":"      removed: delta.removed,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":62,"text":"      symbols: addedSymbols(addedLines),"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":63,"text":"      moved: content.length > 0 && content.every((line) => line.moved !== undefined),"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":64,"text":"    };"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":65,"text":"  });"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":66,"text":"  const added = hunks.reduce((total, hunk) => total + hunk.added, 0);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":67,"text":"  const removed = hunks.reduce((total, hunk) => total + hunk.removed, 0);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":68,"text":"  const digest: DigestFile = {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":69,"text":"    path: file.path,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":70,"text":"    status: file.status,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":71,"text":"    kind: classifyKind(file, hunks),"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":72,"text":"    added,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":73,"text":"    removed,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":74,"text":"    hunks,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":75,"text":"  };"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":76,"text":"  if (file.oldPath !== undefined) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":77,"text":"    digest.oldPath = file.oldPath;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":78,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":79,"text":"  const pair = pairTarget(file.path, digest.kind);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":80,"text":"  if (pair !== undefined) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":81,"text":"    digest.pairsWith = pair;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":82,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":83,"text":"  return digest;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":84,"text":"}"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":85,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":86,"text":"function classifyKind(file: DiffFile, hunks: DigestHunk[]): DigestKind {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":87,"text":"  if (file.relocation?.kind === \"rename\" || file.status === \"renamed\") {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":88,"text":"    return \"rename\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":89,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":90,"text":"  if (file.relocation?.kind === \"copy\") {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":91,"text":"    return \"copy\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":92,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":93,"text":"  if (isTestPath(file.path)) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":94,"text":"    return \"test\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":95,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":96,"text":"  if (isDocsPath(file.path)) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":97,"text":"    return \"docs\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":98,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":99,"text":"  if (isGeneratedPath(file.path)) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":100,"text":"    return \"generated\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":101,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":102,"text":"  if (hunks.length > 0 && hunks.every((hunk) => hunk.moved)) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":103,"text":"    return \"move\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":104,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":105,"text":"  return \"logic\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":106,"text":"}"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":107,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":108,"text":"function isTestPath(path: string): boolean {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":109,"text":"  if (/(^|\\/)(__tests__|tests?)(\\/|$)/.test(path)) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":110,"text":"    return true;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":111,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":112,"text":"  if (/\\.(test|spec)\\.[a-z]+$/i.test(path)) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":113,"text":"    return true;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":114,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":115,"text":"  const base = path.split(\"/\").pop() ?? path;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":116,"text":"  return /(^test_.*|.*_test\\.[a-z]+$)/i.test(base);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":117,"text":"}"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":118,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":119,"text":"function isDocsPath(path: string): boolean {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":120,"text":"  return /\\.(md|mdx|txt|rst)$/i.test(path);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":121,"text":"}"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":122,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":123,"text":"function isGeneratedPath(path: string): boolean {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":124,"text":"  return /(^|\\/)(dist|build|coverage)\\//.test(path) || /\\.(min\\.js|bundle\\.js|snap)$/i.test(path) || /(^|\\/)(__snapshots__|snapshots?)\\//.test(path) || /\\.gen\\./.test(path);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":125,"text":"}"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":126,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":127,"text":"/** Same directory, same stem without the test affix. A prefix: the extension may differ. */"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":128,"text":"function pairTarget(path: string, kind: DigestKind): string | undefined {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":129,"text":"  if (kind !== \"test\") {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":130,"text":"    return undefined;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":131,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":132,"text":"  const slash = path.lastIndexOf(\"/\");"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":133,"text":"  const dir = slash === -1 ? \"\" : path.slice(0, slash + 1);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":134,"text":"  const base = slash === -1 ? path : path.slice(slash + 1);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":135,"text":"  const stem = base"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":136,"text":"    .replace(/\\.(test|spec)(\\.[a-z]+)?$/i, \"\")"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":137,"text":"    .replace(/^test_/, \"\")"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":138,"text":"    .replace(/_test(\\.[a-z]+)?$/i, \"\");"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":139,"text":"  if (stem === base) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":140,"text":"    return undefined;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":141,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":142,"text":"  return `${dir}${stem}`;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":143,"text":"}"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":144,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":145,"text":"/**"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":146,"text":" * Files with identical added+removed line multisets are sync copies."},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":147,"text":" * The first path wins; the rest point at it so the reader skips them."},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":148,"text":" */"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":149,"text":"function markMirrors(digests: DigestFile[], files: DiffFile[]): void {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":150,"text":"  const byKey = new Map<string, DigestFile[]>();"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":151,"text":"  for (let i = 0; i < digests.length; i += 1) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":152,"text":"    const digest = digests[i];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":153,"text":"    const file = files[i];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":154,"text":"    if (digest === undefined || file === undefined || digest.kind === \"move\") {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":155,"text":"      continue;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":156,"text":"    }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":157,"text":"    const lines: string[] = [];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":158,"text":"    for (const hunk of file.hunks) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":159,"text":"      for (const line of hunk.lines) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":160,"text":"        if (line.kind !== \"ctx\") {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":161,"text":"          lines.push(`${line.kind}:${line.text}`);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":162,"text":"        }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":163,"text":"      }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":164,"text":"    }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":165,"text":"    if (lines.length === 0) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":166,"text":"      continue;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":167,"text":"    }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":168,"text":"    const key = lines.sort().join(\"\\n\");"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":169,"text":"    const cluster = byKey.get(key);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":170,"text":"    if (cluster === undefined) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":171,"text":"      byKey.set(key, [digest]);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":172,"text":"    } else {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":173,"text":"      cluster.push(digest);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":174,"text":"    }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":175,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":176,"text":"  for (const cluster of byKey.values()) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":177,"text":"    if (cluster.length < 2) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":178,"text":"      continue;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":179,"text":"    }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":180,"text":"    const first = cluster[0]?.path;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":181,"text":"    if (first === undefined) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":182,"text":"      continue;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":183,"text":"    }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":184,"text":"    for (const digest of cluster.slice(1)) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":185,"text":"      digest.mirrorOf = first;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":186,"text":"    }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":187,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":188,"text":"}"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":189,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":190,"text":"/** Covering refs for one digest file: a path when that covers every hunk, else located refs. */"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":191,"text":"export function digestHunkRefs(file: DigestFile): string[] {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":192,"text":"  if (file.oldPath === undefined && file.hunks.length <= 1) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":193,"text":"    return [file.path];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":194,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":195,"text":"  return file.hunks.map((hunk) => {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":196,"text":"    const at = `${hunk.oldStart}+${hunk.newStart}`;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":197,"text":"    return file.oldPath === undefined ? `${file.path}@${at}` : `${file.oldPath} -> ${file.path}@${at}`;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":198,"text":"  });"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":199,"text":"}"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":200,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":201,"text":"export function formatDigest(digest: ChangeDigest, range: string): string {  const files = digest.files.length;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":202,"text":"  const header = `# Digest ${range} — ${files} file${files === 1 ? \"\" : \"s\"}, ${digest.totalHunks} hunk${digest.totalHunks === 1 ? \"\" : \"s\"}`;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":203,"text":"  return [header, ...digest.files.map(formatFile)].join(\"\\n\");"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":204,"text":"}"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":205,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":206,"text":"function formatFile(file: DigestFile): string {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":207,"text":"  const bits = [`- ${file.path}`, `${file.status} +${file.added}/-${file.removed}`, file.kind];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":208,"text":"  if (file.oldPath !== undefined) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":209,"text":"    bits.push(`was ${file.oldPath}`);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":210,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":211,"text":"  if (file.hunks.length > 1) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":212,"text":"    bits.push(`hunks: ${file.hunks.map((hunk) => hunk.ref).join(\" \")}`);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":213,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":214,"text":"  const symbols = [...new Set(file.hunks.flatMap((hunk) => hunk.symbols))];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":215,"text":"  if (symbols.length > 0) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":216,"text":"    bits.push(`symbols: ${symbols.join(\", \")}`);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":217,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":218,"text":"  if (file.pairsWith !== undefined) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":219,"text":"    bits.push(`pairs with ${file.pairsWith}.*`);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":220,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":221,"text":"  if (file.mirrorOf !== undefined) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":222,"text":"    bits.push(`identical copy of ${file.mirrorOf}`);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":223,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":224,"text":"  return bits.join(\" · \");"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":225,"text":"}"}]}
