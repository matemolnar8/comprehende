{"path":"src/review/digest.test.ts","ref":"faffb06a46ff492182596dbb26b16485f45b27a0","side":"old","lines":[{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":1,"text":"import assert from \"node:assert/strict\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":2,"text":"import { describe, it } from \"node:test\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":3,"text":"import { buildDigest, formatDigest } from \"./digest.ts\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":4,"text":"import type { DiffFile, LiveHunk } from \"../schema/types.ts\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":5,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":6,"text":"function hunk(path: string, oldStart: number, newStart: number, lines: LiveHunk[\"lines\"]): LiveHunk {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":7,"text":"  return { path, oldStart, oldLines: lines.length, newStart, newLines: lines.length, header: \"x\", lines, patch: \"\" };"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":8,"text":"}"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":9,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":10,"text":"function add(text: string, n = 1): LiveHunk[\"lines\"][number] {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":11,"text":"  return { kind: \"add\", oldNumber: null, newNumber: n, text };"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":12,"text":"}"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":13,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":14,"text":"function del(text: string, n = 1): LiveHunk[\"lines\"][number] {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":15,"text":"  return { kind: \"del\", oldNumber: n, newNumber: null, text };"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":16,"text":"}"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":17,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":18,"text":"function file(path: string, hunks: LiveHunk[], extra: Partial<DiffFile> = {}): DiffFile {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":19,"text":"  return { path, status: \"modified\", binary: false, image: false, headerPatch: \"\", patch: \"\", hunks, ...extra };"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":20,"text":"}"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":21,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":22,"text":"describe(\"buildDigest\", () => {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":23,"text":"  it(\"classifies test, docs, and logic files and pairs tests\", () => {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":24,"text":"    const digest = buildDigest(["},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":25,"text":"      file(\"src/auth/session.ts\", [hunk(\"src/auth/session.ts\", 1, 1, [add(\"export function setSessionCookie() {}\")])]),"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":26,"text":"      file(\"src/auth/session.test.ts\", [hunk(\"src/auth/session.test.ts\", 0, 1, [add(\"test()\")])]),"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":27,"text":"      file(\"README.md\", [hunk(\"README.md\", 1, 1, [add(\"docs\")])]),"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":28,"text":"    ]);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":29,"text":"    assert.equal(digest.totalHunks, 3);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":30,"text":"    assert.equal(digest.files[0]?.kind, \"logic\");"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":31,"text":"    assert.deepEqual(digest.files[0]?.hunks[0]?.symbols, [\"setSessionCookie\"]);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":32,"text":"    assert.equal(digest.files[1]?.kind, \"test\");"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":33,"text":"    assert.equal(digest.files[1]?.pairsWith, \"src/auth/session\");"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":34,"text":"    assert.equal(digest.files[2]?.kind, \"docs\");"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":35,"text":"  });"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":36,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":37,"text":"  it(\"marks pure moves and identical copies\", () => {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":38,"text":"    const moved = hunk(\"b.ts\", 1, 5, ["},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":39,"text":"      { ...del(\"const value = 42;\", 1), moved: { path: \"a.ts\", line: 9 } },"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":40,"text":"      { ...add(\"const value = 42;\", 5), moved: { path: \"a.ts\", line: 9 } },"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":41,"text":"    ]);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":42,"text":"    const digest = buildDigest(["},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":43,"text":"      file(\"a.ts\", [hunk(\"a.ts\", 9, 9, [del(\"const value = 42;\", 9)])]),"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":44,"text":"      file(\"b.ts\", [moved]),"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":45,"text":"      file(\"x/SKILL.md\", [hunk(\"x/SKILL.md\", 1, 1, [add(\"same\")])]),"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":46,"text":"      file(\"y/SKILL.md\", [hunk(\"y/SKILL.md\", 1, 1, [add(\"same\")])]),"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":47,"text":"    ]);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":48,"text":"    assert.equal(digest.files[1]?.kind, \"move\");"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":49,"text":"    assert.equal(digest.files[3]?.mirrorOf, \"x/SKILL.md\");"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":50,"text":"    assert.equal(digest.files[2]?.mirrorOf, undefined);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":51,"text":"  });"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":52,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":53,"text":"  it(\"prefers rename over test and skips binaries\", () => {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":54,"text":"    const digest = buildDigest(["},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":55,"text":"      file(\"a.test.ts\", [], { oldPath: \"b.test.ts\", status: \"renamed\", relocation: { kind: \"rename\" } }),"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":56,"text":"      file(\"dot.bin\", [], { binary: true }),"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":57,"text":"    ]);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":58,"text":"    assert.equal(digest.files.length, 1);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":59,"text":"    assert.equal(digest.files[0]?.kind, \"rename\");"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":60,"text":"  });"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":61,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":62,"text":"  it(\"prints one line per file with no patch text\", () => {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":63,"text":"    const secret = \"SECRET_LINE_BODY\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":64,"text":"    const text = formatDigest("},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":65,"text":"      buildDigest([file(\"a.ts\", [hunk(\"a.ts\", 3, 4, [add(secret), del(\"old\")])])]),"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":66,"text":"      \"base...head\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":67,"text":"    );"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":68,"text":"    assert.match(text, /# Digest base\\.\\.\\.head — 1 file, 1 hunk/);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":69,"text":"    assert.match(text, /- a\\.ts · modified \\+1\\/-1 · logic/);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":70,"text":"    assert.equal(text.includes(secret), false);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":71,"text":"  });"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":72,"text":"});"}]}
