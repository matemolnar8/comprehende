ead);"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":26,"text":"    const document = skeletonDocument(index);"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":27,"text":""},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":28,"text":"    assert.ok(index.hunks.length > 0);"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":29,"text":"    assert.deepEqual(document.source, index.source);"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":30,"text":"    assert.equal(document.groups.length, 1);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":31,"text":"    const paths = skeletonPaths(index);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":32,"text":"    assert.deepEqual(document.groups[0]?.hunkRefs, paths);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":33,"text":"    assert.ok(paths.length < index.hunks.length);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":34,"text":"    for (const hunk of index.hunks) {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":35,"text":"      assert.ok(paths.includes(hunk.path));"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":36,"text":"    }"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":37,"text":"    assert.equal(document.title, \"Untitled\");"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":38,"text":"    