{"path":"src/git/log.test.ts","ref":"5f921bb44fa732555b152da19147990c4e99b664","side":"new","lines":[{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":1,"text":"import assert from \"node:assert/strict\";"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":2,"text":"import { mkdtemp, mkdir, writeFile } from \"node:fs/promises\";"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":3,"text":"import { tmpdir } from \"node:os\";"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":4,"text":"import { join } from \"node:path\";"},{"sha":"f774aa2a03fbf7e2e034e49d5210fa15b1d1f5c2","author":"Máté Molnár","timestamp":1791577046,"line":5,"text":"import { afterAll, describe, it } from \"vite-plus/test\";"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":6,"text":"import { rmSync } from \"node:fs\";"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":7,"text":"import { git } from \"./exec.ts\";"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":8,"text":"import { listCommits } from \"./log.ts\";"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":9,"text":""},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":10,"text":"const roots: string[] = [];"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":11,"text":""},{"sha":"f774aa2a03fbf7e2e034e49d5210fa15b1d1f5c2","author":"Máté Molnár","timestamp":1791577046,"line":12,"text":"afterAll(() => {"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":13,"text":"  for (const root of roots) {"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":14,"text":"    rmSync(root, { recursive: true, force: true });"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":15,"text":"  }"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":16,"text":"});"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":17,"text":""},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":18,"text":"describe(\"listCommits\", () => {"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":19,"text":"  it(\"keeps a multiline body and does not treat it as a second commit\", async () => {"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":20,"text":"    const root = await mkdtemp(join(tmpdir(), \"comprehende-log-\"));"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":21,"text":"    roots.push(root);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":22,"text":"    await mkdir(root, { recursive: true });"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":23,"text":"    await git(root, [\"init\", \"-b\", \"main\"]);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":24,"text":"    await git(root, [\"config\", \"user.email\", \"comprehende@example.com\"]);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":25,"text":"    await git(root, [\"config\", \"user.name\", \"Comprehende Fixture\"]);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":26,"text":"    await git(root, [\"config\", \"commit.gpgsign\", \"false\"]);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":27,"text":""},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":28,"text":"    await writeFile(join(root, \"a.txt\"), \"one\\n\", \"utf8\");"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":29,"text":"    await git(root, [\"add\", \".\"]);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":30,"text":"    await git(root, [\"commit\", \"-m\", \"base\"]);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":31,"text":"    const base = (await git(root, [\"rev-parse\", \"HEAD\"])).trim();"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":32,"text":""},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":33,"text":"    await writeFile(join(root, \"a.txt\"), \"two\\n\", \"utf8\");"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":34,"text":"    await git(root, [\"add\", \".\"]);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":35,"text":"    await git(root, ["},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":36,"text":"      \"commit\","},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":37,"text":"      \"-m\","},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":38,"text":"      \"Fix the queue\\n\\nImport flooded MusicBrainz.\\nRoute through the serial path instead.\\n\\nCo-authored-by: Máté Molnár <mate@example.com>\","},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":39,"text":"    ]);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":40,"text":"    const head = (await git(root, [\"rev-parse\", \"HEAD\"])).trim();"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":41,"text":""},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":42,"text":"    const commits = await listCommits(root, base, head);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":43,"text":"    assert.equal(commits.length, 1);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":44,"text":"    assert.equal(commits[0]?.subject, \"Fix the queue\");"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":45,"text":"    assert.equal("},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":46,"text":"      commits[0]?.body,"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":47,"text":"      \"Import flooded MusicBrainz.\\nRoute through the serial path instead.\\n\\nCo-authored-by: Máté Molnár <mate@example.com>\","},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":48,"text":"    );"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":49,"text":"    assert.equal(commits[0]?.sha, head);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":50,"text":"    assert.ok((commits[0]?.shortSha.length ?? 0) >= 7);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":51,"text":"  });"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":52,"text":""},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":53,"text":"  it(\"returns an empty list when the range has no commits\", async () => {"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":54,"text":"    const root = await mkdtemp(join(tmpdir(), \"comprehende-log-empty-\"));"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":55,"text":"    roots.push(root);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":56,"text":"    await mkdir(root, { recursive: true });"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":57,"text":"    await git(root, [\"init\", \"-b\", \"main\"]);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":58,"text":"    await git(root, [\"config\", \"user.email\", \"comprehende@example.com\"]);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":59,"text":"    await git(root, [\"config\", \"user.name\", \"Comprehende Fixture\"]);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":60,"text":"    await git(root, [\"config\", \"commit.gpgsign\", \"false\"]);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":61,"text":"    await writeFile(join(root, \"a.txt\"), \"one\\n\", \"utf8\");"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":62,"text":"    await git(root, [\"add\", \".\"]);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":63,"text":"    await git(root, [\"commit\", \"-m\", \"only\"]);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":64,"text":"    const sha = (await git(root, [\"rev-parse\", \"HEAD\"])).trim();"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":65,"text":"    assert.deepEqual(await listCommits(root, sha, sha), []);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":66,"text":"  });"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":67,"text":"});"}]}
