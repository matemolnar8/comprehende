rsor Agent","timestamp":1786673228,"line":29,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":30,"text":"  return stdout"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":31,"text":"    .split(RECORD_SEP)"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":32,"text":"    .map((record) => record.replace(/^\\n/, \"\"))"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":33,"text":"    .filter((record) => record.length > 0)"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":34,"text":"    .map(parseCommitRecord);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":35,"text":"}"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":36,"text":""},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":37,"text":"function parseCommitRecord(record: string): CommitInfo {"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":38,"text":"  const [sha, shortSha, subject, author, date, ...bodyParts] = record.split(FIELD_SEP);"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":39,"text":"  return {"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":40,"text":"    sha: sha ?? \"\","},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":41,"text":"    shortSha: shortSha ?? \"\","},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":42,"text":"    subject: subject ?? \"\","},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":43,"text":"    author: author ?? \"\","},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":44,"text":"    date: date ?? \"\","},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":45,"text":"    body: (bodyParts.join(FIELD_SEP) ?? \"\").replace(/\\n+$/u, \"\"),"},{"sha":"725ab691f3849d9f95e75914afcf75da53c08cf7","author":"Cursor Agent","timestamp":1787244404,"line":46,"text":"  };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":47,"text":"}"}]}
