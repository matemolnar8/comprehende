{"path":"src/git/isolation.test.ts","ref":"5f921bb44fa732555b152da19147990c4e99b664","side":"new","lines":[{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":1,"text":"import assert from \"node:assert/strict\";"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":2,"text":"import { mkdtemp, writeFile } from \"node:fs/promises\";"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":3,"text":"import { tmpdir } from \"node:os\";"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":4,"text":"import { join } from \"node:path\";"},{"sha":"f774aa2a03fbf7e2e034e49d5210fa15b1d1f5c2","author":"Máté Molnár","timestamp":1791577046,"line":5,"text":"import { afterAll, describe, it } from \"vite-plus/test\";"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":6,"text":"import { rmSync } from \"node:fs\";"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":7,"text":"import { createExampleRepo, SECRET_ADD } from \"../test/example-repo.ts\";"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":8,"text":"import { git } from \"./exec.ts\";"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":9,"text":"import { pinRange } from \"./repo.ts\";"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":10,"text":"import { showFile } from \"./show.ts\";"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":11,"text":""},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":12,"text":"const roots: string[] = [];"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":13,"text":""},{"sha":"f774aa2a03fbf7e2e034e49d5210fa15b1d1f5c2","author":"Máté Molnár","timestamp":1791577046,"line":14,"text":"afterAll(() => {"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":15,"text":"  for (const root of roots) {"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":16,"text":"    rmSync(root, { recursive: true, force: true });"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":17,"text":"  }"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":18,"text":"});"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":19,"text":""},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":20,"text":"describe(\"git isolation\", () => {"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":21,"text":"  it(\"reads the blob at a pinned SHA after the work tree and HEAD move\", async () => {"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":22,"text":"    const root = await mkdtemp(join(tmpdir(), \"comprehende-iso-\"));"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":23,"text":"    roots.push(root);"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":24,"text":"    const repo = await createExampleRepo(root);"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":25,"text":"    const pin = await pinRange(repo.root, repo.base, \"HEAD\");"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":26,"text":"    const original = await showFile(repo.root, pin.headSha, \"src/app.ts\");"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":27,"text":"    assert.equal(original.includes(SECRET_ADD), true);"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":28,"text":""},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":29,"text":"    await writeFile(join(repo.root, \"src/app.ts\"), \"export const dirty = true;\\n\");"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":30,"text":"    await git(repo.root, [\"add\", \"src/app.ts\"]);"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":31,"text":"    await git(repo.root, [\"commit\", \"-m\", \"overwrite app\"]);"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":32,"text":"    await writeFile(join(repo.root, \"src/app.ts\"), \"export const unstaged = true;\\n\");"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":33,"text":""},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":34,"text":"    const pinned = await showFile(repo.root, pin.headSha, \"src/app.ts\");"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":35,"text":"    assert.equal(pinned, original);"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":36,"text":"    assert.equal(pinned.includes(\"dirty\"), false);"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":37,"text":"    assert.equal(pinned.includes(\"unstaged\"), false);"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":38,"text":""},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":39,"text":"    const headNow = (await git(repo.root, [\"rev-parse\", \"HEAD\"])).trim();"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":40,"text":"    assert.notEqual(headNow, pin.headSha);"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":41,"text":"  });"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":42,"text":"});"}]}
