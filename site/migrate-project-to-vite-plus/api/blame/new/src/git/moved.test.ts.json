s) {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":131,"text":"      for (const line of hunk.lines) {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":132,"text":"        if (line.moved !== undefined && (line.kind === \"add\" || line.kind === \"del\")) {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":133,"text":"          keys.push(`${file.path}\\0${line.kind}\\0${line.text}`);"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":134,"text":"        }"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":135,"text":"      }"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":136,"text":"    }"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":137,"text":"  }"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":138,"text":"  return keys.sort();"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":139,"text":"}"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":140,"text":""},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":141,"text":"function movedKeysFromColor(stdout: string): string[] {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":142,"text":"  const keys: string[] = [];"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":143,"text":"  let path = \"\";"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":144,"text":"  for (const line of stdout.split(\"\\n\")) {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":145,"text":"    const header = /^diff --git a\\/(.+) b\\/(.+)$/.exec(stripAnsi(line));"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":146,"text":"    if (header?.[2] !== undefined) {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":147,"text":"      path = header[2];"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":148,"text":"      continue;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":149,"text":"    }"},{"sha":"5f921bb44fa732555b152da19147990c4e99b664","author":"Máté Molnár","timestamp":1791577158,"line":150,"text":"    // eslint-disable-next-line no-control-regex -- git color-words output embeds ANSI escapes"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":151,"text":"    const added = /^(?:\\x1b\\[36m\\+\\x1b\\[m\\x1b\\[36m|\\x1b\\[36m\\+)(.*)\\x1b\\[m$/.exec(line);"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":152,"text":"    if (added?.[1] !== undefined && !added[1].startsWith(\"@\")) {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":153,"text":"      keys.push(`${path}\\0add\\0${added[1]}`);"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":154,"text":"      continue;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":155,"text":"    }"},{"sha":"5f921bb44fa732555b152da19147990c4e99b664","author":"Máté Molnár","timestamp":1791577158,"line":156,"text":"    // eslint-disable-next-line no-control-regex -- git color-words output embeds ANSI escapes"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":157,"text":"    const deleted = /^(?:\\x1b\\[35m-\\x1b\\[m\\x1b\\[35m|\\x1b\\[35m-)(.*)\\x1b\\[m$/.exec(line);"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":158,"text":"    if (deleted?.[1] !== undefined) {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":159,"text":"      keys.push(`${path}\\0del\\0${deleted[1]}`);"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":160,"text":"    }"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":161,"text":"  }"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":162,"text":"  return keys.sort();"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":163,"text":"}"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":164,"text":""},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":165,"text":"function stripAnsi(line: string): string {"},{"sha":"5f921bb44fa732555b152da19147990c4e99b664","author":"Máté Molnár","timestamp":1791577158,"line":166,"text":"  // eslint-disable-next-line no-control-regex -- stripping ANSI escapes is the whole job"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":167,"text":"  return line.replaceAll(/\\x1b\\[[0-9;]*m/g, \"\");"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":168,"text":"}"}]}
