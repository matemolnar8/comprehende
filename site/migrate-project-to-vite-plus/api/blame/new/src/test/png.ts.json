{"path":"src/test/png.ts","ref":"5f921bb44fa732555b152da19147990c4e99b664","side":"new","lines":[{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":1,"text":"import { deflateSync } from \"node:zlib\";"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":2,"text":""},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":3,"text":"export function encodePng("},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":4,"text":"  width: number,"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":5,"text":"  height: number,"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":6,"text":"  rgba: (x: number, y: number) => readonly [number, number, number, number],"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":7,"text":"): Buffer {"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":8,"text":"  const stride = width * 4 + 1;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":9,"text":"  const raw = Buffer.alloc(stride * height);"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":10,"text":"  for (let y = 0; y < height; y += 1) {"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":11,"text":"    const row = y * stride;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":12,"text":"    raw[row] = 0;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":13,"text":"    for (let x = 0; x < width; x += 1) {"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":14,"text":"      const pixel = rgba(x, y);"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":15,"text":"      const i = row + 1 + x * 4;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":16,"text":"      raw[i] = pixel[0];"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":17,"text":"      raw[i + 1] = pixel[1];"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":18,"text":"      raw[i + 2] = pixel[2];"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":19,"text":"      raw[i + 3] = pixel[3];"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":20,"text":"    }"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":21,"text":"  }"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":22,"text":"  const ihdr = Buffer.alloc(13);"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":23,"text":"  ihdr.writeUInt32BE(width, 0);"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":24,"text":"  ihdr.writeUInt32BE(height, 4);"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":25,"text":"  ihdr[8] = 8;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":26,"text":"  ihdr[9] = 6;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":27,"text":"  const signature = Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]);"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":28,"text":"  return Buffer.concat(["},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":29,"text":"    signature,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":30,"text":"    pngChunk(\"IHDR\", ihdr),"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":31,"text":"    pngChunk(\"IDAT\", deflateSync(raw)),"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":32,"text":"    pngChunk(\"IEND\", Buffer.alloc(0)),"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":33,"text":"  ]);"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":34,"text":"}"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":35,"text":""},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":36,"text":"function pngChunk(type: string, data: Buffer): Buffer {"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":37,"text":"  const header = Buffer.alloc(8);"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":38,"text":"  header.writeUInt32BE(data.length, 0);"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":39,"text":"  header.write(type, 4, 4, \"ascii\");"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":40,"text":"  const crc = Buffer.alloc(4);"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":41,"text":"  crc.writeUInt32BE(crc32(Buffer.concat([header.subarray(4), data])), 0);"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":42,"text":"  return Buffer.concat([header, data, crc]);"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":43,"text":"}"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":44,"text":""},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":45,"text":"function crc32(data: Buffer): number {"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":46,"text":"  let crc = 0xffffffff;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":47,"text":"  for (const byte of data) {"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":48,"text":"    crc ^= byte;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":49,"text":"    for (let i = 0; i < 8; i += 1) {"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":50,"text":"      crc = (crc >>> 1) ^ (0xedb88320 & -(crc & 1));"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":51,"text":"    }"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":52,"text":"  }"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":53,"text":"  return (crc ^ 0xffffffff) >>> 0;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":54,"text":"}"}]}
