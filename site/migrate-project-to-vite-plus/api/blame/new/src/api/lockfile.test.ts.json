ck.patch, \"\");"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":89,"text":"    assert.ok((lock.added ?? 0) > 0);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":90,"text":""},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":91,"text":"    const yarn = lockfiles.files.find((file) => file.path === \"apps/web/yarn.lock\");"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":92,"text":"    assert.ok(yarn);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":93,"text":"    assert.equal(yarn.kind, \"lockfile\");"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":94,"text":"    assert.equal(yarn.patch, \"\");"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":95,"text":""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":96,"text":"    const patchRes = await fetch("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":97,"text":"      new URL(apiHref({ kind: \"patch\", path: \"package-lock.json\" }), `${live.url}/`),"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":98,"text":"    );"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":99,"text":"    assert.equal(patchRes.status, 200);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":100,"text":"    const patch = (await patchRes.json()) as { path: string; kind: string; patch: string };"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":101,"text":"    assert.equal(patch.kind, \"lockfile\");"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":102,"text":"    assert.equal(patch.patch.includes(LOCKFILE_SECRET), true);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":103,"text":"    assert.equal(patch.patch.startsWith(\"diff --git \"), true);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":104,"text":""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":105,"text":"    const missing = await fetch("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":106,"text":"      new URL(apiHref({ kind: \"patch\", path: \"src/app.ts\" }), `${live.url}/`),"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":107,"text":"    );"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":108,"text":"    assert.equal(missing.status, 404);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":109,"text":""},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":110,"text":"    const outDir = join(root, \"site\");"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":111,"text":"    const ctx = await openReview(repo.root, dataPath);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":112,"text":"    await exportStaticSite({ cwd: repo.root, dataPath, outDir, uiRoot, ctx });"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":113,"text":"    const frozen = await startStaticSite(outDir, 