"author":"Máté Molnár","timestamp":1791576459,"line":106,"text":"    parts.length >= 4 &&"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":107,"text":"    parts[2] !== undefined"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":108,"text":"  ) {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":109,"text":"    const side = parts[2];"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":110,"text":"    if (!isSourceSide(side)) {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":111,"text":"      return undefined;"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":112,"text":"    }"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":113,"text":"    const rest = parts.slice(3);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":114,"text":"    const last = rest.at(-1);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":115,"text":"    const stem = last === undefined ? undefined : jsonStem(last);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":116,"text":"    if (stem === undefined) {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":117,"text":"      return undefined;"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":118,"text":"    }"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":119,"text":"    rest[rest.length - 1] = stem;"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":120,"text":"    const path = rest.join(\"/\");"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":121,"text":"    if (!isSafePath(path)) {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":122,"text":"      return undefined;"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":123,"text":"    }"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":124,"text":"    return { kind: parts[1] === \"files\" ? \"file\" : \"blame\", path, side };"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":125,"text":"  }"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":126,"text":"  return undefined;"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":127,"text":"}"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":128,"text":""},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":129,"text":"function encodeFilePath(path: string): string {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":130,"text":"  return path.split(\"/\").map(encodeURIComponent).join(\"/\");"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":131,"text":"}"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":132,"text":""},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":133,"text":"function decodeSegment(segment: string): string {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":134,"text":"  try {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":135,"text":"    return decodeURIComponent(segment);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":136,"text":"  } catch {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":137,"text":"    return segment;"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":138,"text":"  }"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":139,"text":"}"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":140,"text":""},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":141,"text":"function agentMdRel(resource: Extract<ApiResource, { kind: \"agent-md\" }>): string {"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":142,"text":"  if (resource.target === \"overview\") {"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":143,"text":"    return \"api/agent/overview.md\";"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":144,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":145,"text":"  return `api/agent/${agentMdGroupHref(resource.group)}`;"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":146,"text":"}"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":147,"text":""},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":148,"text":"function jsonStem(file: string): string | undefined {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":149,"text":"  return stem(file, \".json\");"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":150,"text":"}"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":151,"text":""},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":152,"text":"function mdStem(file: string): string | undefined {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":153,"text":"  return stem(file, \".md\");"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":154,"text":"}"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":155,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":156,"text":"function stem(file: string, ext: string): string | undefined {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":157,"text":"  if (!file.endsWith(ext)) {"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":158,"text":"    return undefined;"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":159,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":160,"text":"  const bare = file.slice(0, -ext.length);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":161,"text":"  return bare === \"\" ? undefined : bare;"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":162,"text":"}"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":163,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":164,"text":"export function isSafePath(path: string): boolean {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":165,"text":"  return ("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":166,"text":"    path.trim() !== \"\" &&"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":167,"text":"    !path.startsWith(\"/\") &&"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":168,"text":"    !path.includes(\"\\0\") &&"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":169,"text":"    !path.split(\"/\").includes(\"..\")"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":170,"text":"  );"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":171,"text":"}"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":172,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":173,"text":"export function assertSafePath(path: string): void {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":174,"text":"  if (!isSafePath(path)) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":175,"text":"    throw new Error(`invalid path: ${path}`);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":176,"text":"  }"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":177,"text":"}"}]}
