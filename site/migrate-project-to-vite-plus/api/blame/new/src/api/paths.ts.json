13282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":52,"text":"    .map(decodeSegment);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":53,"text":"  if (parts[0] !== \"api\" || parts[1] === undefined) {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":54,"text":"    return undefined;"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":55,"text":"  }"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":56,"text":"  if (parts[1] === \"review.json\" && parts.length === 2) {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":57,"text":"    return { kind: \"review\" };"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":58,"text":"  }"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":59,"text":"  if (parts[1] === \"agent\") {"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":60,"text":"    if (parts.length === 3 && parts[2] === \"overview.md\") {"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":61,"text":"      return { kind: \"agent-md\", target: \"overview\" };"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":62,"text":"    }"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":63,"text":"    if (parts.length === 4 && parts[2] === \"groups\" && parts[3] !== undefined) {"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":64,"text":"      const group = mdStem(parts[3]);"},{"sha":"41be4a38ae6bcd0b4ba37a1