nent(group)}.md`;"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":26,"text":"}"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":27,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":28,"text":"function apiRel(resource: ApiResource, encodeFiles: boolean): string {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":29,"text":"  const filePath = (path: string): string => (encodeFiles ? encodeFilePath(path) : path);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":30,"text":"  switch (resource.kind) {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":31,"text":"    case \"review\":"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":32,"text":"      return \"api/review.json\";"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":33,"text":"    case \"agent-md\":"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":34,"text":"      return agentMdRel(resource);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":35,"text":"    case \"hunks\":"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":36,"text":"      return `api/hunks/${encodeURIComponent(resource.group)}.json`;"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":37,"text":"    case \"file\":"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":38,"text":"      return `api/files/${resource.side}/${filePath(re