0,"text":"      const full = join(current, entry.name);"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":131,"text":"      if (entry.isDirectory()) {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":132,"text":"        await walk(full);"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":133,"text":"        continue;"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":134,"text":"      }"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":135,"text":"      out.set(relative(dir, full), await readFile(full, \"utf8\"));"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":136,"text":"    }"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":137,"text":"  };"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":138,"text":"  await walk(dir);"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":139,"text":"  return out;"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":140,"text":"}"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":141,"text":""},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":142,"text":"function gitStagedTree(root: string, prefix: string): Map<string, string> {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":143,"text":"  const listing = execFileSync(\"git\", [\"ls-files\", \"-z\", \"--\", prefix], {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":144,"text":"    cwd: root,"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":145,"text":"    encoding: \"utf8\","},{"sha":"83c2b3f857fbf459921d1a3f57971090b0b9e4a2","author":"Máté Molnár","timestamp":1787858752,"line":146,"text":"    env: gitEnv(),"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":147,"text":"  });"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":148,"text":"  const out = new Map<string, string>();"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":149,"text":"  for (const full of listing.split(\"\\0\").filter(Boolean)) {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":150,"text":"    out.set(relative(prefix, full), gitShowStaged(root, full));"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":151,"text":"  }"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":152,"text":"  return out;"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":153,"text":"}"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":154,"text":""},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":155,"text":"function gitShowStaged(root: string, path: string): string {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":156,"text":"  try {"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":157,"text":"    return execFileSync(\"git\", [\"show\", `:${path}`], {"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":158,"text":"      cwd: root,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":159,"text":"      encoding: \"utf8\","},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":160,"text":"      env: gitEnv(),"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":161,"text":"    });"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":162,"text":"  } catch {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":163,"text":"    throw new Error(`staged file missing: ${path}`);"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":164,"text":"  }"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":165,"text":"}"}]}
