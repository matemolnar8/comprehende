{"path":"src/schema/types.ts","ref":"5f921bb44fa732555b152da19147990c4e99b664","side":"new","lines":[{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":1,"text":"import type { HunkRef, ReviewSource, Source } from \"./review.ts\";"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":2,"text":""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":3,"text":"export type {"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":4,"text":"  HunkRef,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":5,"text":"  ReviewDocument,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":6,"text":"  ReviewGroup,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":7,"text":"  ReviewHunkRef,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":8,"text":"  ReviewPart,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":9,"text":"  ReviewSource,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":10,"text":"  Source,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":11,"text":"} from \"./review.ts\";"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":12,"text":""},{"sha":"5c713233ac7998a896201cef62027b5b4e3a2bd7","author":"matemolnar8","timestamp":1786706250,"line":13,"text":"export const REVIEW_SIZES = [\"trivial\", \"small\", \"medium\", \"large\", \"very-large\"] as const;"},{"sha":"5c713233ac7998a896201cef62027b5b4e3a2bd7","author":"matemolnar8","timestamp":1786706250,"line":14,"text":""},{"sha":"5c713233ac7998a896201cef62027b5b4e3a2bd7","author":"matemolnar8","timestamp":1786706250,"line":15,"text":"export type ReviewSize = (typeof REVIEW_SIZES)[number];"},{"sha":"5c713233ac7998a896201cef62027b5b4e3a2bd7","author":"matemolnar8","timestamp":1786706250,"line":16,"text":""},{"sha":"5c713233ac7998a896201cef62027b5b4e3a2bd7","author":"matemolnar8","timestamp":1786706250,"line":17,"text":"export function isReviewSize(value: unknown): value is ReviewSize {"},{"sha":"5c713233ac7998a896201cef62027b5b4e3a2bd7","author":"matemolnar8","timestamp":1786706250,"line":18,"text":"  return typeof value === \"string\" && (REVIEW_SIZES as readonly string[]).includes(value);"},{"sha":"5c713233ac7998a896201cef62027b5b4e3a2bd7","author":"matemolnar8","timestamp":1786706250,"line":19,"text":"}"},{"sha":"5c713233ac7998a896201cef62027b5b4e3a2bd7","author":"matemolnar8","timestamp":1786706250,"line":20,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":21,"text":"export function padIndex(index: number): string {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":22,"text":"  return String(index).padStart(2, \"0\");"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":23,"text":"}"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":24,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":25,"text":"export function sizeLabel(size: ReviewSize): string {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":26,"text":"  return size.replace(\"-\", \" \");"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":27,"text":"}"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":28,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":29,"text":"export function shortSha(sha: string): string {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":30,"text":"  return sha.slice(0, 7);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":31,"text":"}"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":32,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":33,"text":"/** Last slash segment of a git path. Git paths use forward slashes. */"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":34,"text":"export function basename(path: string): string {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":35,"text":"  const slash = path.lastIndexOf(\"/\");"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":36,"text":"  return slash === -1 ? path : path.slice(slash + 1);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":37,"text":"}"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":38,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":39,"text":"export const SOURCE_KINDS = [\"ticket\", \"pr\", \"pr-comment\", \"commit\", \"transcript\"] as const;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":40,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":41,"text":"export type SourceKind = (typeof SOURCE_KINDS)[number];"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":42,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":43,"text":"export function isSourceKind(value: unknown): value is SourceKind {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":44,"text":"  return typeof value === \"string\" && (SOURCE_KINDS as readonly string[]).includes(value);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":45,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":46,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":47,"text":"export type SourceSide = \"old\" | \"new\";"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":48,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":49,"text":"export function isSourceSide(value: unknown): value is SourceSide {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":50,"text":"  return value === \"old\" || value === \"new\";"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":51,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":52,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":53,"text":"export type LinePinnedSource = Source & {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":54,"text":"  kind: \"pr-comment\";"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","aut