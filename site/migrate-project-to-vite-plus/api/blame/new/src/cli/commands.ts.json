efined) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":105,"text":"    throw new Error(`no diff for path: ${parsed.path}`);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":106,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":107,"text":"  if (parsed.kind === \"file\") {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":108,"text":"    return file.patch;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":109,"text":"  }"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":110,"text":"  const hunk = file.hunks.find("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":111,"text":"    (item) => item.oldStart === parsed.oldStart && item.newStart === parsed.newStart,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":112,"text":"  );"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":113,"text":"  if (hunk === undefined) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":114,"text":"    throw new Error(`no hunk matches: ${target}`);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":115,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":116,"text":"  return filePatchFromGit(file, [hunk]);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":117,"text":"}"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":118,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":119,"text":"/**"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":120,"text":" * Draft review.json from deterministic rules: identical-copy clusters,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":121,"text":" * mechanical files (rename, copy, move, generated), and one change group"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":122,"text":" * for the rest. The skill accepts, splits, and writes the prose."},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":123,"text":" */"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":124,"text":"export async function cmdPregroup("},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":125,"text":"  cwd: string,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":126,"text":"  dataPath: string,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":127,"text":"  base: string | undefined,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":128,"text":"  head: string | undefined,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":129,"text":"): Promise<{ document: ReviewDocument; index: HunkIndex }> {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":130,"text":"  const baseRef = base ?? (await defaultBaseRef(cwd));"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":131,"text":"  const headRef = head ?? \"HEAD\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":132,"text":"  const { source, baseSha, headSha } = await resolveSource(cwd, baseRef, headRef);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":133,"text":"  const files = await readDiff(cwd, baseSha, headSha);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":134,"text":"  const { files: digests } = buildDigest(files);"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":135,"text":"  const mirrorRoots = new Set("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":136,"text":"    digests"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":137,"text":"      .filter((digest) => digest.mirrorOf !== undefined)"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":138,"text":"      .map((digest) => digest.mirrorOf as string),"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":139,"text":"  );"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":140,"text":"  const mirrors = new Map<string, string[]>();"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":141,"text":"  const mechanical: string[] = [];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":142,"text":"  const change: string[] = [];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":143,"text":"  for (const digest of digests) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":144,"text":"    const refs = digestHunkRefs(digest);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":145,"text":"    if (digest.mirrorOf !== undefined || mirrorRoots.has(digest.path)) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":146,"text":"      const root = digest.mirrorOf ?? digest.path;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":147,"text":"      const cluster = mirrors.get(root) ?? [];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":148,"text":"      cluster.push(...refs);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":149,"text":"      mirrors.set(root, cluster);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":150,"text":"      continue;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":151,"text":"    }"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":152,"text":"    if ("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":153,"text":"      digest.kind === \"rename\" ||"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":154,"text":"      digest.kind === \"copy\" ||"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":155,"text":"      digest.kind === \"move\" ||"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":156,"text":"      digest.kind === \"generated\""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":157,"text":"    ) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":158,"text":"      mechanical.push(...refs);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":159,"text":"      continue;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":160,"text":"    }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":161,"text":"    change.push(...refs);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":162,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":163,"text":"  const index = await readHunkIndex(cwd, baseRef, headRef);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":164,"text":"  const skeleton = skeletonDocument(index);"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":165,"text":"  const groups: {"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":166,"text":"    id: string;"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":167,"text":"    title: string;"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":168,"text":"    why: string;"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":169,"text":"    summary: string;"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":170,"text":"    suggestedOrder: number;"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":171,"text":"    hunkRefs: string[];"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":172,"text":"  }[] = [];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":173,"text":"  if (change.length > 0 || (mirrors.size === 0 && mechanical.length === 0)) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":174,"text":"    groups.push({"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":175,"text":"      id: \"change\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":176,"text":"      title: \"Change\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":177,"text":"      why: \"Draft: the change minus copies and mechanical files. Split by concern.\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":178,"text":"      summary: \"Fill this group.\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":179,"text":"      suggestedOrder: 0,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":180,"text":"      hunkRefs: change,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":181,"text":"    });"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":182,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":183,"text":"  let order = 1;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":184,"text":"  for (const [root, paths] of mirrors) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":185,"text":"    groups.push({"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":186,"text":"      id: `mirrors-${order}`,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":187,"text":"      title: \"Synced copies\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":188,"text":"      why: `Draft: identical copies of ${root}. Read one, skip the rest.`,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":189,"text":"      summary: \"Fill this group.\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":190,"text":"      suggestedOrder: order,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":191,"text":"      hunkRefs: [...new Set(paths)],"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":192,"text":"    });"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":193,"text":"    order += 1;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":194,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":195,"text":"  if (mechanical.length > 0) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":196,"text":"    groups.push({"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":197,"text":"      id: \"mechanical\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":198,"text":"      title: \"Mechanical\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":199,"text":"      why: \"Draft: renames, copies, moves, or generated output. Say what the reader can skip.\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":200,"text":"      summary: \"Fill this group.\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":201,"text":"      suggestedOrder: order,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":202,"text":"      hunkRefs: mechanical,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":203,"text":"    });"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":204,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":205,"text":"  const document = { ...skeleton, source, groups };"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":206,"text":"  await mkdir(dirname(dataPath), { recursive: true });"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":207,"text":"  await writeFile(dataPath, `${JSON.stringify(document, null, 2)}\\n`);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":208,"text":"  const loaded = await loadDocument(dataPath);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":209,"text":"  return { document: loaded, index };"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":210,"text":"}"}]}
