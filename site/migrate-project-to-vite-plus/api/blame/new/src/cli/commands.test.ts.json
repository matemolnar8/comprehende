36711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":140,"text":"    const patch = await cmdShow(repo.root, repo.base, repo.head, { file: \"src/types.ts\" });"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":141,"text":"    assert.match(patch, /string \\| number/);"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":142,"text":"    await assert.rejects("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":143,"text":"      () => cmdShow(repo.root, repo.base, repo.head, { file: \"nope.ts\" }),"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":144,"text":"      /no diff for path/,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":145,"text":"    );"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":146,"text":"    await assert.rejects(() => cmdShow(repo.root, repo.base, repo.head, {}), /--hunk/);"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":147,"text":"    await assert.rejects("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":148,"text":"      () => cmdShow(repo.root, repo.base, repo.head, { hunk: \"bogus\" }),"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":149,"text":"      /invalid hunk ref|no diff for path/,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":150,"text":"    );"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":151,"text":"  });"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":152,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":153,"text":"  it(\"pregroups a draft that validate accepts\", async () => {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":154,"text":"    const root = await mkdtemp(join(tmpdir(), \"comprehende-pregroup-\"));"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":155,"text":"    roots.push(root);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":156,"text":"    const repo = await createExampleRepo(join(root, \"repo\"));"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":157,"text":"    const dataPath = join(root, \"review.json\");"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":158,"text":"    const { document } = await cmdPregroup(repo.root, dataPath, repo.base, repo.head);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":159,"text":"    assert.ok(document.groups.some((group) => group.id === \"change\"));"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":160,"text":"    assert.ok(document.groups.some((group) => group.id === \"mechanical\"));"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":161,"text":"    await cmdValidate(repo.root, dataPath);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":162,"text":"  });"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":163,"text":"});"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":164,"text":""},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":165,"text":"type GitLog = {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":166,"text":"  read: () => Promise<string[][]>;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":167,"text":"  clear: () => Promise<void>;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":168,"text":"};"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":169,"text":""},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":170,"text":"async function withGitLog(root: string, fn: (log: GitLog) => Promise<void>): Promise<void> {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":171,"text":"  const bin = join(root, \"bin\");"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":172,"text":"  const logPath = join(root, \"git.log\");"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":173,"text":"  await mkdir(bin, { recursive: true });"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":174,"text":"  await writeFile(logPath, \"\");"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":175,"text":"  await writeFile("},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":176,"text":"    join(bin, \"git\"),"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":177,"text":"    `#!/bin/bash\\nprintf '%s\\\\0' \"$@\" >> ${shellQuote(logPath)}\\nprintf '\\\\n' >> ${shellQuote(logPath)}\\nexec ${shellQuote(REAL_GIT)} \"$@\"\\n`,"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":178,"text":"  );"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":179,"text":"  await chmod(join(bin, \"git\"), 0o755);"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":180,"text":"  const previousPath = process.env.PATH;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":181,"text":"  process.env.PATH = `${bin}${delimiter}${previousPath ?? \"\"}`;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":182,"text":"  try {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":183,"text":"    await fn({"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":184,"text":"      read: async () => parseGitLog(await readFile(logPath, \"utf8\")),"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":185,"text":"      clear: () => writeFile(logPath, \"\"),"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":186,"text":"    });"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":187,"text":"  } finally {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":188,"text":"    if (previousPath === undefined) {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":189,"text":"      delete process.env.PATH;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":190,"text":"    } else {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":191,"text":"      process.env.PATH = previousPath;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":192,"text":"    }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":193,"text":"  }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":194,"text":"}"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":195,"text":""},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":196,"text":"function parseGitLog(text: string): string[][] {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":197,"text":"  return text"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":198,"text":"    .split(\"\\n\")"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":199,"text":"    .filter((line) => line.length > 0)"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":200,"text":"    .map((line) => line.split(\"\\0\").filter((arg) => arg.length > 0));"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":201,"text":"}"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":202,"text":""},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":203,"text":"function gitCommand(argv: string[]): string | undefined {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":204,"text":"  for (let i = 0; i < argv.length; i += 1) {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":205,"text":"    const arg = argv[i];"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":206,"text":"    if (arg === \"-c\") {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":207,"text":"      i += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":208,"text":"      continue;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":209,"text":"    }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":210,"text":"    return arg;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":211,"text":"  }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":212,"text":"  return undefined;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":213,"text":"}"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":214,"text":""},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":215,"text":"function tally(calls: string[][]): {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":216,"text":"  revParse: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":217,"text":"  nameStatus: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":218,"text":"  unified: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":219,"text":"  numstat: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":220,"text":"  mergeBase: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":221,"text":"  other: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":222,"text":"} {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":223,"text":"  const counts = { revParse: 0, nameStatus: 0, unified: 0, numstat: 0, mergeBase: 0, other: 0 };"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":224,"text":"  for (const argv of calls) {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":225,"text":"    const command = gitCommand(argv);"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":226,"text":"    if (command === \"rev-parse\") {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":227,"text":"      counts.revParse += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":228,"text":"    } else if (command === \"merge-base\") {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":229,"text":"      counts.mergeBase += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":230,"text":"    } else if (command === \"diff\" && argv.includes(\"--name-status\")) {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":231,"text":"      counts.nameStatus += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":232,"text":"    } else if (command === \"diff\" && argv.includes(\"--numstat\")) {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":233,"text":"      counts.numstat += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":234,"text":"    } else if (command === \"diff\") {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":235,"text":"      counts.unified += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":236,"text":"    } else {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":237,"text":"      counts.other += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":238,"text":"    }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":239,"text":"  }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":240,"text":"  return counts;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":241,"text":"}"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":242,"text":""},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":243,"text":"function shellQuote(value: string): string {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":244,"text":"  return `'${value.replaceAll(\"'\", `'\\\\''`)}'`;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":245,"text":"}"}]}
