r":"matemolnar8","timestamp":1786994449,"line":15,"text":"  writeStoredPreference,"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":16,"text":"  type ResolvedTheme,"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":17,"text":"  type ThemePreference,"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":18,"text":"} from \"./theme.ts\";"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":19,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":20,"text":"type ThemeContextValue = {"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":21,"text":"  preference: ThemePreference;"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":22,"text":"  resolved: ResolvedTheme;"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":23,"text":"  setPreference: (preference: ThemePreference) => void;"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":24,"text":"  toggleTheme: () => void;"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":25,"text":"};"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":26,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":27,"text":"const ThemeContext = createContext<ThemeContextValue | null>(null);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":28,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":29,"text":"export function ThemeProvider(props: { children: ReactNode }) {"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":30,"text":"  const [preference, setPreferenceState] = useState<ThemePreference>(readStoredPreference);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":31,"text":"  const [prefersDark, setPrefersDark] = useState(systemPrefersDark);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":32,"text":"  const resolved = resolveTheme(preference, prefersDark);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":33,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":34,"text":"  const setPreference = useCallback((next: ThemePreference) => {"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":35,"text":"    writeStoredPreference(next);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":36,"text":"    setPreferenceState(next);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":37,"text":"  }, []);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":38,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":39,"text":"  const toggleTheme = useCallback(() => {"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":40,"text":"    const next: ThemePreference ="},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":41,"text":"      preference === \"auto\" ? \"light\" : preference === \"light\" ? \"dark\" : \"auto\";"},{"sha":"3f2e98a27dafeeef111e98c7fec141a7f1e7c963","author":"Máté Molnár","timestamp":1787686401,"line":42,"text":"    setPreference(next);"},{"sha":"3f2e98a27dafeeef111e98c7fec141a7f1e7c963","author":"Máté Molnár","timestamp":1787686401,"line":43,"text":"  }, [preference, setPreference]);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":44,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":45,"text":"  useEffect(() => {"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":46,"text":"    applyResolvedTheme(resolved);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":47,"text":"  }, [resolved]);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":48,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":49,"text":"  useEffect(() => {"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":50,"text":"    const media = window.matchMedia(\"(prefers-color-scheme: dark)\");"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":51,"text":"    const onChange = () => setPrefersDark(media.matches);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":52,"text":"    media.addEventListener(\"change\", onChange);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":53,"text":"    return () => media.removeEventListener(\"change\", onChange);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":54,"text":"  }, []);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":55,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":56,"text":"  const value = useMemo("},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":57,"text":"    () => ({ preference, resolved, setPreference, toggleTheme }),"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":58,"text":"    [preference, resolved, setPreference, toggleTheme],"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":59,"text":"  );"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":60,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":61,"text":"  return <ThemeContext.Provider value={value}>{props.children}</ThemeContext.Provider>;"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":62,"text":"}"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":63,"text":""},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":64,"text":"export function useTheme(): ThemeContextValue {"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":65,"text":"  const value = useContext(ThemeContext);"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":66,"text":"  if (value === null) {"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":67,"text":"    throw new Error(\"useTheme must be used within ThemeProvider\");"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":68,"text":"  }"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":69,"text":"  return value;"},{"sha":"0199c71ef254258006a44521bf048825b7db38b7","author":"matemolnar8","timestamp":1786994449,"line":70,"text":"}"}]}
