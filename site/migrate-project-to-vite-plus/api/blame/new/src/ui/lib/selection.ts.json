Agent","timestamp":1787255475,"line":13,"text":"  lockfiles?: { fileCount: number };"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":14,"text":"};"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":15,"text":""},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":16,"text":"export type PartShiftSource = {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":17,"text":"  groups: PartGroup[];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":18,"text":"};"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":19,"text":""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":20,"text":"// Only the group id and title feed the selection caption, so tests can pass a"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":21,"text":"// minimal meta instead of a full review."},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":22,"text":"export type SelectionCaptionMeta = {"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":23,"text":"  document: { title: string };"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":24,"text":"  groups: readonly { id: string; title: string }[];"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":25,"text":"};"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":26,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":27,"text":"export function defaultSelection(source: SelectionStackSource): Selection {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":28,"text":"  if (source.groups.length > 0) {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":29,"text":"    return { kind: \"overview\" };"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":30,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":31,"text":"  return { kind: REVIEW_BUCKETS.unassigned };"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":32,"text":"}"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":33,"text":""},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":34,"text":"const GROUP_HASH_PREFIX = \"group/\";"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":35,"text":""},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":36,"text":"export function parseHash(hash: string): Selection | null {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":37,"text":"  const trimmed = hash.startsWith(\"#\") ? hash.slice(1) : hash;"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":38,"text":"  const path = trimmed.replace(/^\\/+/, \"\");"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":39,"text":"  if (path === \"\") {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":40,"text":"    return null;"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":41,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":42,"text":"  if (path === \"overview\") {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":43,"text":"    return { kind: \"overview\" };"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":44,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":45,"text":"  if (path === REVIEW_BUCKETS.unassigned) {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":46,"text":"    return { kind: REVIEW_BUCKETS.unassigned };"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":47,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":48,"text":"  if (path === REVIEW_BUCKETS.lockfiles) {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":49,"text":"    return { kind: REVIEW_BUCKETS.lockfiles };"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":50,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":51,"text":"  if (!path.startsWith(GROUP_HASH_PREFIX)) {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":52,"text":"    return null;"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":53,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":54,"text":"  const rawId = path.slice(GROUP_HASH_PREFIX.length);"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":55,"text":"  if (rawId === \"\") {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":56,"text":"    return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":57,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":58,"text":"  try {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":59,"text":"    const id = decodeURIComponent(rawId);"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":60,"text":"    if (id === \"\") {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":61,"text":"      return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":62,"text":"    }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":63,"text":"    return { kind: \"group\", id };"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":64,"text":"  } catch {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":65,"text":"    return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":66,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":67,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":68,"text":""},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":69,"text":"export function serializeHash(selection: Selection): string {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":70,"text":"  if (selection.kind === \"group\") {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":71,"text":"    return `#${GROUP_HASH_PREFIX}${encodeURIComponent(selection.id)}`;"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":72,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":73,"text":"  if (selection.kind === \"overview\") {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":74,"text":"    return \"#overview\";"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":75,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":76,"text":"  return `#${selection.kind}`;"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":77,"text":"}"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":78,"text":""},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":79,"text":"export function selectionFromHash(source: SelectionStackSource, hash: string): Selection {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":80,"text":"  return restoreSelection(source, parseHash(hash));"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":81,"text":"}"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":82,"text":""},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":83,"text":"export function urlWithSelection(href: string, selection: Selection): string {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":84,"text":"  const url = new URL(href);"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":85,"text":"  url.hash = serializeHash(selection);"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":86,"text":"  return url.href;"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":87,"text":"}"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":88,"text":""},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":89,"text":"export function hashWriteMode("},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":90,"text":"  source: SelectionStackSource,"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":91,"text":"  currentHash: string,"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":92,"text":"  selection: Selection,"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":93,"text":"  initialized: boolean,"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":94,"text":"): \"skip\" | \"replace\" | \"push\" {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":95,"text":"  const parsed = parseHash(currentHash);"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":96,"text":"  if (parsed !== null && sameSelection(parsed, selection)) {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":97,"text":"    return \"skip\";"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":98,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":99,"text":"  const parsedIsLive = parsed !== null && sameSelection(restoreSelection(source, parsed), parsed);"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":100,"text":"  if (!initialized || !parsedIsLive) {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":101,"text":"    return \"replace\";"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":102,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":103,"text":"  return \"push\";"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":104,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":105,"text":""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":106,"text":"export function restoreSelection("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":107,"text":"  source: SelectionStackSource,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":108,"text":"  stored: Selection | null,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":109,"text":"): Selection {"},{"sha":"b5e2c3e0733d804aee4f4adf06766621138e3c78","author":"Máté Molnár","timestamp":1788535976,"line":110,"text":"  // Invariant: unknown or missing buckets fall back to the default selection."},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":111,"text":"  if (stored === null) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":112,"text":"    return defaultSelection(source);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":113,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":114,"text":"  if (stored.kind === \"group\" && !source.groups.some((group) => group.id === stored.id)) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":115,"text":"    return defaultSelection(source);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":116,"text":"  }"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":117,"text":"  if ("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":118,"text":"    stored.kind === REVIEW_BUCKETS.unassigned &&"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":119,"text":"    source.unassigned.hunkCount === 0 &&"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":120,"text":"    source.groups.length > 0"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":121,"text":"  ) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":122,"text":"    return defaultSelection(source);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":123,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":124,"text":"  if (stored.kind === REVIEW_BUCKETS.lockfiles && (source.lockfiles?.fileCount ?? 0) === 0) {"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":125,"text":"    return defaultSelection(source);"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":126,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":127,"text":"  return stored;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":128,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":129,"text":""},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":130,"text":"/** Overview, then groups in part / dependsOn order. Unassigned and lockfiles stay off this walk. */"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":131,"text":"export function groupWalk(source: SelectionStackSource): Selection[] {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":132,"text":"  const parts = groupParts(source.groups);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":133,"text":"  return ["},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":134,"text":"    { kind: \"overview\" },"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":135,"text":"    ...parts.flatMap((part) => part.groupIds.map((id) => ({ kind: \"group\" as const, id }))),"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":136,"text":"  ];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":137,"text":"}"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":138,"text":""},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":139,"text":"export function selectionStack(source: SelectionStackSource): Selection[] {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":140,"text":"  const ids = groupWalk(source);"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":141,"text":"  if (source.unassigned.hunkCount > 0) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":142,"text":"    ids.push({ kind: REVIEW_BUCKETS.unassigned });"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":143,"text":"  }"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":144,"text":"  if ((source.lockfiles?.fileCount ?? 0) > 0) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":145,"text":"    ids.push({ kind: REVIEW_BUCKETS.lockfiles });"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":146,"text":"  }"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":147,"text":"  return ids;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":148,"text":"}"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":149,"text":""},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":150,"text":"export function neighborSelection("},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":151,"text":"  source: SelectionStackSource | null,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":152,"text":"  selection: Selection | null,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":153,"text":"  delta: number,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":154,"text":"): Selection | undefined {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":155,"text":"  if (source === null || delta === 0) {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":156,"text":"    return undefined;"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":157,"text":"  }"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":158,"text":"  const walk = partWalk(source, selection);"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":159,"text":"  const current = walk.findIndex((item) => sameSelection(item, selection));"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":160,"text":"  if (current >= 0) {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":161,"text":"    return walk[current + delta];"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":162,"text":"  }"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":163,"text":"  if (delta < 0) {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":164,"text":"    return walk[walk.length - 1];"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":165,"text":"  }"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":166,"text":"  return undefined;"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":167,"text":"}"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":168,"text":""},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":169,"text":"/** Overview, then the current part in dependsOn order. From overview, that is the first part. */"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":170,"text":"function partWalk(source: SelectionStackSource, selection: Selection | null): Selection[] {"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":171,"text":"  const parts = groupParts(source.groups);"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":172,"text":"  const part = partForWalk(parts, selection);"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":173,"text":"  return ["},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":174,"text":"    { kind: \"overview\" },"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":175,"text":"    ...(part?.groupIds ?? []).map((id) => ({ kind: \"group\" as const, id })),"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":176,"text":"  ];"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":177,"text":"}"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":178,"text":""},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":179,"text":"function partForWalk(parts: readonly Part[], selection: Selection | null): Part | undefined {"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":180,"text":"  if (selection?.kind === \"group\") {"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":181,"text":"    return parts.find((item) => item.groupIds.includes(selection.id)) ?? parts[0];"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":182,"text":"  }"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":183,"text":"  if ("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":184,"text":"    selection?.kind === REVIEW_BUCKETS.unassigned ||"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":185,"text":"    selection?.kind === REVIEW_BUCKETS.lockfiles"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":186,"text":"  ) {"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":187,"text":"    return parts[parts.length - 1];"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":188,"text":"  }"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":189,"text":"  return parts[0];"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":190,"text":"}"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":191,"text":""},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":192,"text":"export function shiftSelection("},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":193,"text":"  source: SelectionStackSource | null,"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":194,"text":"  selection: Selection | null,"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":195,"text":"  setSelection: (selection: Selection) => void,"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":196,"text":"  delta: number,"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":197,"text":"): void {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":198,"text":"  const next = neighborSelection(source, selection, delta);"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":199,"text":"  if (next !== undefined) {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":200,"text":"    setSelection(next);"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":201,"text":"  }"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":202,"text":"}"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":203,"text":""},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":204,"text":"export function shiftPartSelection("},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":205,"text":"  meta: PartShiftSource | null,"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":206,"text":"  selection: Selection | null,"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":207,"text":"  setSelection: (selection: Selection) => void,"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":208,"text":"  delta: number,"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":209,"text":"): void {"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":210,"text":"  if ("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":211,"text":"    meta === null ||"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":212,"text":"    selection === null ||"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":213,"text":"    selection.kind === REVIEW_BUCKETS.unassigned ||"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":214,"text":"    selection.kind === REVIEW_BUCKETS.lockfiles"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":215,"text":"  ) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":216,"text":"    return;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":217,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":218,"text":"  const parts = groupParts(meta.groups);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":219,"text":"  if (!isMixedReview(parts)) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":220,"text":"    return;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":221,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":222,"text":"  const current ="},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":223,"text":"    selection.kind === \"group\""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":224,"text":"      ? parts.findIndex((part) => part.groupIds.includes(selection.id))"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":225,"text":"      : delta > 0"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":226,"text":"        ? -1"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":227,"text":"        : parts.length;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":228,"text":"  if (selection.kind === \"group\" && current < 0) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":229,"text":"    return;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":230,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":231,"text":"  const next = parts[(current + delta + parts.length) % parts.length];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":232,"text":"  const id = next?.groupIds[0];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":233,"text":"  if (id !== undefined && (selection.kind !== \"group\" || id !== selection.id)) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":234,"text":"    setSelection({ kind: \"group\", id });"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":235,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":236,"text":"}"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":237,"text":""},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":238,"text":"export function sameSelection(a: Selection, b: Selection | null): boolean {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":239,"text":"  if (b === null) {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":240,"text":"    return false;"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":241,"text":"  }"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":242,"text":"  if (a.kind === \"overview\") {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":243,"text":"    return b.kind === \"overview\";"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":244,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":245,"text":"  if (a.kind === REVIEW_BUCKETS.unassigned) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":246,"text":"    return b.kind === REVIEW_BUCKETS.unassigned;"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":247,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":248,"text":"  if (a.kind === REVIEW_BUCKETS.lockfiles) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":249,"text":"    return b.kind === REVIEW_BUCKETS.lockfiles;"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":250,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":251,"text":"  return a.kind === \"group\" && b.kind === \"group\" && b.id === a.id;"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":252,"text":"}"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":253,"text":""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":254,"text":"export function selectionNavLabel(meta: SelectionCaptionMeta, selection: Selection): string {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":255,"text":"  const caption = selectionCaption(meta, selection);"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":256,"text":"  return caption.index !== undefined ? `${caption.index} ${caption.title}` : caption.title;"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":257,"text":"}"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":258,"text":""},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":259,"text":"export function selectionCaption("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":260,"text":"  meta: SelectionCaptionMeta,"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":261,"text":"  selection: Selection | null,"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":262,"text":"): { index?: string; title: string } {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":263,"text":"  if (selection === null || selection.kind === \"overview\") {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":264,"text":"    return { title: \"Overview\" };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":265,"text":"  }"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":266,"text":"  if (selection.kind === \"group\") {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":267,"text":"    const parts = groupParts(meta.groups);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":268,"text":"    const index = groupOrderIndex(parts, selection.id);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":269,"text":"    const group = meta.groups.find((item) => item.id === selection.id);"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":270,"text":"    return {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":271,"text":"      index: index > 0 ? padIndex(index) : undefined,"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":272,"text":"      title: group?.title ?? \"Group\","},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":273,"text":"    };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":274,"text":"  }"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":275,"text":"  if (selection.kind === REVIEW_BUCKETS.unassigned) {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":276,"text":"    return { title: \"Unassigned\" };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":277,"text":"  }"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":278,"text":"  return { title: \"Lockfiles\" };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":279,"text":"}"}]}
