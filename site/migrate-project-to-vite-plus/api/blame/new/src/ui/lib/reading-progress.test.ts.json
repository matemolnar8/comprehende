 Agent","timestamp":1790138044,"line":13,"text":"      total: 2,"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":14,"text":"      viewed: 1,"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":15,"text":"      left: 1,"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":16,"text":"    });"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":17,"text":"  });"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":18,"text":""},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":19,"text":"  it(\"names files still to read, and a list the reader finished\", () => {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":20,"text":"    const none = readingStatus([\"a.ts\", \"b.ts\"], new Set());"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":21,"text":"    assert.equal(none?.label, \"2 left\");"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":22,"text":"    assert.equal(none?.filesLabel, \"2 files left\");"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":23,"text":""},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":24,"text":"    const one = readingStatus([\"a.ts\"], new Set());"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":25,"text":"    assert.equal(one?.label, \"1 left\");"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":26,"text":"    assert.equal(one?.filesLabel, \"1 file left\");"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":27,"text":""},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":28,"text":"    const done = readingStatus([\"a.ts\"], new Set([\"a.ts\"]));"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":29,"text":"    assert.equal(done?.left, 0);"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":30,"text":"    assert.equal(done?.label, \"Viewed\");"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":31,"text":"    assert.equal(done?.filesLabel, \"All files viewed\");"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":32,"text":"  });"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":33,"text":""},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":34,"text":"  it(\"has no mark when there are no files\", () => {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":35,"text":"    assert.equal(readingStatus([], new Set([\"a.ts\"])), null);"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":36,"text":"    assert.deepEqual(readingCounts([], new Set()), { total: 0, viewed: 0, left: 0 });"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":37,"text":"  });"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":38,"text":""},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":39,"text":"  it(\"unions group, unassigned, and lock