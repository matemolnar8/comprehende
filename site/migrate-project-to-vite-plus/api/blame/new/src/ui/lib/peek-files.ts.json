{"path":"src/ui/lib/peek-files.ts","ref":"5f921bb44fa732555b152da19147990c4e99b664","side":"new","lines":[{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":1,"text":"export const PEEK_LIMIT = 3;"},{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":2,"text":""},{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":3,"text":"/** Show every path when the remainder would be 1. Otherwise cap at `limit`. */"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":4,"text":"export function peekFiles("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":5,"text":"  paths: readonly string[],"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":6,"text":"  limit = PEEK_LIMIT,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":7,"text":"): { shown: string[]; rest: number } {"},{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":8,"text":"  if (paths.length <= limit + 1) {"},{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":9,"text":"    return { shown: [...paths], rest: 0 };"},{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":10,"text":"  }"},{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":11,"text":"  return { shown: paths.slice(0, limit), rest: paths.length - limit };"},{"sha":"b263db277863ea7c94910b39e4ca6ea3e39f49d2","author":"Cursor Agent","timestamp":1787949142,"line":12,"text":"}"}]}
