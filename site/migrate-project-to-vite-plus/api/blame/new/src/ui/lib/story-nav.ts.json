4f61","author":"Cursor Agent","timestamp":1789285558,"line":28,"text":"  };"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":29,"text":"}"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":30,"text":""},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":31,"text":"function hop(byId: Map<string, StoryGroup>, id: string): StoryHop[] {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":32,"text":"  const group = byId.get(id);"},{"sha":"86712bcaccbdf3b49275460c05a5e29e31fab599","author":"Cursor Agent","timestamp":1789295650,"line":33,"text":"  return group === undefined ? [] : [{ id, title: group.title }];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":34,"text":"}"}]}
