author":"Cursor Agent","timestamp":1789285713,"line":13,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":14,"text":"export type LookForTag = (typeof LOOK_FOR_TAGS)[number];"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":15,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":16,"text":"const LOOK_FOR_TAG_RE = /^(Subtle|Breaking|Race|Perf)\\.\\s+(.*)$/;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":17,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":18,"text":"export type LookForOwner ="},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":19,"text":"  | { kind: \"document\" }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":20,"text":"  | { kind: \"group\"; id: string; title: string; index: number; part?: string };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":21,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":22,"text":"export type LookForClaim = {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":23,"text":"  key: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":24,"text":"  owner: LookForOwner;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":25,"text":"  index: number;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":26,"text":"  tag?: LookForTag;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":27,"text":"  text: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":28,"text":"  body: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":29,"text":"  sourceIds: string[];"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":30,"text":"};"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":31,"text":""},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":32,"text":"export type LookForGroup = PartGroup & {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":33,"text":"  title: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":34,"text":"  lookFor?: readonly string[];"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":35,"text":"};"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":36,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":37,"text":"export function parseLookForBullet(text: string): { tag?: LookForTag; body: string } {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":38,"text":"  const match = LOOK_FOR_TAG_RE.exec(text);"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":39,"text":"  if (match === null) {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":40,"text":"    return { body: text };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":41,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":42,"text":"  const tag = match[1];"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":43,"text":"  const body = match[2];"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":44,"text":"  if (tag === undefined || body === undefined || body === \"\") {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":45,"text":"    return { body: text };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":46,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":47,"text":"  return { tag: tag as LookForTag, body };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":48,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":49,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":50,"text":"export function lookForKey(owner: LookForOwner, index: number): string {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":51,"text":"  return owner.kind === \"document\" ? `document:${index}` : `group:${owner.id}:${index}`;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":52,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":53,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":54,"text":"export function lookForOwnerLabel(owner: LookForOwner): string {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":55,"text":"  if (owner.kind === \"document\") {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":56,"text":"    return \"Overview\";"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":57,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":58,"text":"  return `${padIndex(owner.index)} ${owner.title}`;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":59,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":60,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":61,"text":"export function selectionForLookFor(owner: LookForOwner): Selection {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":62,"text":"  return owner.kind === \"document\" ? { kind: \"overview\" } : { kind: \"group\", id: owner.id };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":63,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":64,"text":""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":65,"text":"export function claimsFromLookFor("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":66,"text":"  owner: LookForOwner,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":67,"text":"  items: readonly string[] | undefined,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":68,"text":"): LookForClaim[] {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":69,"text":"  return (items ?? []).map((text, index) => {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":70,"text":"    const parsed = parseLookForBullet(text);"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":71,"text":"    const claim: LookForClaim = {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":72,"text":"      key: lookForKey(owner, index),"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":73,"text":"      owner,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":74,"text":"      index,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":75,"text":"      text,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":76,"text":"      body: parsed.body,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":77,"text":"      sourceIds: citationIds(text),"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":78,"text":"    };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":79,"text":"    if (parsed.tag !== undefined) {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":80,"text":"      claim.tag = parsed.tag;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":81,"text":"    }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":82,"text":"    return claim;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":83,"text":"  });"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":84,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":85,"text":""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":86,"text":"export function lookForClaims("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":87,"text":"  document: { lookFor?: readonly string[] },"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":88,"text":"  groups: readonly LookForGroup[],"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":89,"text":"): LookForClaim[] {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":90,"text":"  const claims = claimsFromLookFor({ kind: \"document\" }, document.lookFor);"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":91,"text":"  const parts = groupParts(groups);"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":92,"text":"  const byId = new Map(groups.map((group) => [group.id, group]));"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":93,"text":"  for (const part of parts) {"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":94,"text":"    for (const id of part.groupIds) {"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":95,"text":"      const group = byId.get(id);"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":96,"text":"      if (group === undefined) {"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":97,"text":"        continue;"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":98,"text":"      }"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":99,"text":"      const owner: LookForOwner = {"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":100,"text":"        kind: \"group\","},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":101,"text":"        id: group.id,"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":102,"text":"        title: group.title,"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":103,"text":"        index: groupOrderIndex(parts, group.id),"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":104,"text":"      };"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":105,"text":"      if (group.part !== undefined) {"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":106,"text":"        owner.part = group.part;"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":107,"text":"      }"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":108,"text":"      claims.push(...claimsFromLookFor(owner, group.lookFor));"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":109,"text":"    }"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":110,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":111,"text":"  return claims;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":112,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":113,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":114,"text":"export type SourceOpenTarget = {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":115,"text":"  selection: Selection;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":116,"text":"  lookForKey?: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":117,"text":"  commentId?: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":118,"text":"};"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":119,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":120,"text":"export function openTargetForSource("},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":121,"text":"  source: Source,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":122,"text":"  claims: readonly LookForClaim[],"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":123,"text":"  document: ReviewDocument,"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":124,"text":"  currentGroupId?: string,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":125,"text":"): SourceOpenTarget {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":126,"text":"  if (isLinePinned(source)) {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":127,"text":"    const groupId = groupIdForPinnedSource(document, source);"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":128,"text":"    if (groupId !== undefined) {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":129,"text":"      return { selection: { kind: \"group\", id: groupId }, commentId: source.id };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":130,"text":"    }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":131,"text":"  }"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":132,"text":"  const citing = claims.filter((claim) => claim.sourceIds.includes(source.id));"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":133,"text":"  const currentClaim = citing.find("},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":134,"text":"    (claim) => claim.owner.kind === \"group\" && claim.owner.id === currentGroupId,"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":135,"text":"  );"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":136,"text":"  if (currentClaim !== undefined) {"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":137,"text":"    return { selection: selectionForLookFor(currentClaim.owner), lookForKey: currentClaim.key };"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":138,"text":"  }"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":139,"text":"  if (currentGroupId !== undefined) {"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":140,"text":"    const current = document.groups.find((group) => group.id === currentGroupId);"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":141,"text":"    if (current !== undefined && groupSourceIds(current).includes(source.id)) {"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":142,"text":"      return { selection: { kind: \"group\", id: currentGroupId } };"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":143,"text":"    }"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":144,"text":"  }"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":145,"text":"  const groupClaim = citing.find((claim) => claim.owner.kind === \"group\");"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":146,"text":"  if (groupClaim !== undefined) {"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":147,"text":"    return { selection: selectionForLookFor(groupClaim.owner), lookForKey: groupClaim.key };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":148,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":149,"text":"  const named = document.groups.find((group) => (group.sources ?? []).includes(source.id));"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":150,"text":"  if (named !== undefined) {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":151,"text":"    return { selection: { kind: \"group\", id: named.id } };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":152,"text":"  }"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":153,"text":"  const documentClaim = citing.find((claim) => claim.owner.kind === \"document\");"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":154,"text":"  if (documentClaim !== undefined) {"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":155,"text":"    return { selection: selectionForLookFor(documentClaim.owner), lookForKey: documentClaim.key };"},{"sha":"83f549cc93ad95bc2ecf0771e8faa4fe30167239","author":"Cursor Agent","timestamp":1789312800,"line":156,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":157,"text":"  return { selection: { kind: \"overview\" } };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":158,"text":"}"}]}
