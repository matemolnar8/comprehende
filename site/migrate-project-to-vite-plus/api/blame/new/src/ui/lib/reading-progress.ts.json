{"path":"src/ui/lib/reading-progress.ts","ref":"5f921bb44fa732555b152da19147990c4e99b664","side":"new","lines":[{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":1,"text":"export type ReadingCounts = {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":2,"text":"  total: number;"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":3,"text":"  viewed: number;"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":4,"text":"  left: number;"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":5,"text":"};"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":6,"text":""},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":7,"text":"export type ReadingStatus = ReadingCounts & {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":8,"text":"  /** Short mark for a row: \"3 left\" or \"Viewed\". */"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":9,"text":"  label: string;"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":10,"text":"  /** Standalone mark: \"3 files left\", \"1 file left\", or \"All files viewed\". */"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":11,"text":"  filesLabel: string;"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":12,"text":"};"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":13,"text":""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":14,"text":"export function readingCounts("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":15,"text":"  paths: readonly string[],"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":16,"text":"  viewed: ReadonlySet<string>,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":17,"text":"): ReadingCounts {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":18,"text":"  const unique = new Set(paths);"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":19,"text":"  let viewedCount = 0;"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":20,"text":"  for (const path of unique) {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":21,"text":"    if (viewed.has(path)) {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":22,"text":"      viewedCount += 1;"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":23,"text":"    }"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":24,"text":"  }"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":25,"text":"  return { total: unique.size, viewed: viewedCount, left: unique.size - viewedCount };"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":26,"text":"}"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":27,"text":""},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":28,"text":"/** Null when the list has no files. Progress is the reader's attention, not a verdict. */"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":29,"text":"export function readingStatus("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":30,"text":"  paths: readonly string[],"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":31,"text":"  viewed: ReadonlySet<string>,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":32,"text":"): ReadingStatus | null {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":33,"text":"  const counts = readingCounts(paths, viewed);"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":34,"text":"  if (counts.total === 0) {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":35,"text":"    return null;"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":36,"text":"  }"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":37,"text":"  const done = counts.left === 0;"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":38,"text":"  return {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":39,"text":"    ...counts,"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":40,"text":"    label: done ? \"Viewed\" : `${counts.left} left`,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":41,"text":"    filesLabel: done"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":42,"text":"      ? \"All files viewed\""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":43,"text":"      : counts.left === 1"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":44,"text":"        ? \"1 file left\""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":45,"text":"        : `${counts.left} files left`,"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":46,"text":"  };"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":47,"text":"}"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":48,"text":""},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":49,"text":"export function reviewReadingPaths(review: {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":50,"text":"  groups: readonly { files: readonly string[] }[];"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":51,"text":"  unassigned: { files: readonly string[] };"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":52,"text":"  lockfiles: { files: readonly string[] };"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":53,"text":"}): string[] {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":54,"text":"  const seen = new Set<string>();"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":55,"text":"  const paths: string[] = [];"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":56,"text":"  const add = (path: string) => {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":57,"text":"    if (seen.has(path)) {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":58,"text":"      return;"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":59,"text":"    }"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":60,"text":"    seen.add(path);"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":61,"text":"    paths.push(path);"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":62,"text":"  };"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":63,"text":"  for (const group of review.groups) {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":64,"text":"    for (const path of group.files) {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":65,"text":"      add(path);"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":66,"text":"    }"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":67,"text":"  }"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":68,"text":"  for (const path of review.unassigned.files) {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":69,"text":"    add(path);"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":70,"text":"  }"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":71,"text":"  for (const path of review.lockfiles.files) {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":72,"text":"    add(path);"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":73,"text":"  }"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":74,"text":"  return paths;"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":75,"text":"}"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":76,"text":""},{"sha":"d8658c1681fc92d4fa0a6d11218095be343f5219","author":"Cursor Agent","timestamp":1790402413,"line":77,"text":"/** Binary paths git skipped. Null when nothing was skipped. */"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":78,"text":"export function skippedBinaryNote("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":79,"text":"  skipped: readonly { path: string; reason: string }[],"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":80,"text":"): string | null {"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":81,"text":"  const paths = skipped.flatMap((file) => (file.reason === \"binary\" ? [file.path] : []));"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":82,"text":"  if (paths.length === 0) {"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":83,"text":"    return null;"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":84,"text":"  }"},{"sha":"d8658c1681fc92d4fa0a6d11218095be343f5219","author":"Cursor Agent","timestamp":1790402413,"line":85,"text":"  return paths.join(\", \");"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":86,"text":"}"}]}
