{"path":"src/ui/lib/load-diff-files.ts","ref":"5f921bb44fa732555b152da19147990c4e99b664","side":"new","lines":[{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":1,"text":"import type { FileContents, FileDiffLoadedFiles, FileDiffMetadata } from \"@pierre/diffs\";"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":2,"text":"import type { ApiFile, FileSide } from \"../../api/types.ts\";"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":3,"text":""},{"sha":"bb4c0dfa388a8e17ac3d986bec01e6728bf8251d","author":"Cursor Agent","timestamp":1787468448,"line":4,"text":"export function canHydrateDiff(fileDiff: Pick<FileDiffMetadata, \"isPartial\" | \"type\">): boolean {"},{"sha":"bb4c0dfa388a8e17ac3d986bec01e6728bf8251d","author":"Cursor Agent","timestamp":1787468448,"line":5,"text":"  return ("},{"sha":"bb4c0dfa388a8e17ac3d986bec01e6728bf8251d","author":"Cursor Agent","timestamp":1787468448,"line":6,"text":"    fileDiff.isPartial &&"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":7,"text":"    (fileDiff.type === \"change\" ||"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":8,"text":"      fileDiff.type === \"rename-changed\" ||"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":9,"text":"      fileDiff.type === \"rename-pure\")"},{"sha":"bb4c0dfa388a8e17ac3d986bec01e6728bf8251d","author":"Cursor Agent","timestamp":1787468448,"line":10,"text":"  );"},{"sha":"bb4c0dfa388a8e17ac3d986bec01e6728bf8251d","author":"Cursor Agent","timestamp":1787468448,"line":11,"text":"}"},{"sha":"bb4c0dfa388a8e17ac3d986bec01e6728bf8251d","author":"Cursor Agent","timestamp":1787468448,"line":12,"text":""},{"sha":"e19fdc8b56d4e6ebe757bf2e5b00f44b93cfe3ab","author":"matemolnar8","timestamp":1787517031,"line":13,"text":"export function splitHasTwoSides(type: FileDiffMetadata[\"type\"]): boolean {"},{"sha":"e19fdc8b56d4e6ebe757bf2e5b00f44b93cfe3ab","author":"matemolnar8","timestamp":1787517031,"line":14,"text":"  return type !== \"new\" && type !== \"deleted\";"},{"sha":"e19fdc8b56d4e6ebe757bf2e5b00f44b93cfe3ab","author":"matemolnar8","timestamp":1787517031,"line":15,"text":"}"},{"sha":"e19fdc8b56d4e6ebe757bf2e5b00f44b93cfe3ab","author":"matemolnar8","timestamp":1787517031,"line":16,"text":""},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":17,"text":"export function toPierreFile(file: ApiFile): FileContents {"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":18,"text":"  return {"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":19,"text":"    name: file.path,"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":20,"text":"    contents: file.content,"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":21,"text":"    cacheKey: `${file.side}:${file.ref}:${file.path}`,"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":22,"text":"  };"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":23,"text":"}"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":24,"text":""},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":25,"text":"export async function loadDiffFilesWith("},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":26,"text":"  fileDiff: Pick<FileDiffMetadata, \"name\" | \"type\">,"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":27,"text":"  loadSide: (path: string, side: FileSide) => Promise<ApiFile>,"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":28,"text":"): Promise<FileDiffLoadedFiles> {"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":29,"text":"  if (fileDiff.type === \"rename-pure\") {"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":30,"text":"    const next = await loadSide(fileDiff.name, \"new\");"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":31,"text":"    return { oldFile: null, newFile: toPierreFile(next) };"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":32,"text":"  }"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":33,"text":"  const [oldFile, newFile] = await Promise.all(["},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":34,"text":"    loadSide(fileDiff.name, \"old\"),"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":35,"text":"    loadSide(fileDiff.name, \"new\"),"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":36,"text":"  ]);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":37,"text":"  return { oldFile: toPierreFile(oldFile), newFile: toPierreFile(newFile) };"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":38,"text":"}"}]}
