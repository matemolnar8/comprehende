or Agent","timestamp":1787466357,"line":55,"text":"    assert.equal(hydrated.isPartial, false);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":56,"text":"    assert.equal(hydrated.hunks.length, 2);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":57,"text":"    assert.equal(hydrated.hunks[1]?.collapsedBefore, collapsed);"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":58,"text":"    assert.equal("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":59,"text":"      hydrated.additionLines.some((line) => line.includes('const a = \"new\"')),"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":60,"text":"      true,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":61,"text":"    );"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":62,"text":"    assert.equal("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":63,"text":"      hydrated.additionLines.some((line) => line.includes(\"const pad20 = 20\")),"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":64,"text":"      true,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":65,"text":"    );"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":66,"text":"    assert.equal("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":67,"text":"      hydrated.deletionLines.some((line) => line.includes('const b = \"old\"')),"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Mát