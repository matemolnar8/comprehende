{"path":"scripts/eval/env.test.ts","ref":"5f921bb44fa732555b152da19147990c4e99b664","side":"new","lines":[{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":1,"text":"import assert from \"node:assert/strict\";"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":2,"text":"import { mkdtemp, writeFile } from \"node:fs/promises\";"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":3,"text":"import { tmpdir } from \"node:os\";"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":4,"text":"import { join } from \"node:path\";"},{"sha":"f774aa2a03fbf7e2e034e49d5210fa15b1d1f5c2","author":"Máté Molnár","timestamp":1791577046,"line":5,"text":"import { describe, it } from \"vite-plus/test\";"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":6,"text":"import { loadDotEnv } from \"./env.ts\";"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":7,"text":""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":8,"text":"const KEYS = ["},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":9,"text":"  \"COMPREHENDE_EVAL_DOTENV_A\","},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":10,"text":"  \"COMPREHENDE_EVAL_DOTENV_B\","},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":11,"text":"  \"COMPREHENDE_EVAL_DOTENV_C\","},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":12,"text":"] as const;"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":13,"text":""},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":14,"text":"function save(): Map<string, string | undefined> {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":15,"text":"  return new Map(KEYS.map((key) => [key, process.env[key]]));"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":16,"text":"}"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":17,"text":""},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":18,"text":"function restore(saved: Map<string, string | undefined>): void {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":19,"text":"  for (const [key, value] of saved) {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":20,"text":"    if (value === undefined) {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":21,"text":"      delete process.env[key];"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":22,"text":"    } else {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":23,"text":"      process.env[key] = value;"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":24,"text":"    }"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":25,"text":"  }"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":26,"text":"}"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":27,"text":""},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":28,"text":"describe(\"loadDotEnv\", () => {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":29,"text":"  it(\"loads keys, strips quotes, skips comments, and leaves real env alone\", async () => {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":30,"text":"    const saved = save();"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":31,"text":"    try {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":32,"text":"      const dir = await mkdtemp(join(tmpdir(), \"comprehende-dotenv-\"));"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":33,"text":"      await writeFile("},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":34,"text":"        join(dir, \".env\"),"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":35,"text":"        ["},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":36,"text":"          \"# comment\","},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":37,"text":"          \"\","},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":38,"text":"          \"COMPREHENDE_EVAL_DOTENV_A=abc\","},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":39,"text":"          'COMPREHENDE_EVAL_DOTENV_B=\"x y\"',"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":40,"text":"          \"COMPREHENDE_EVAL_DOTENV_C=from-file\","},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":41,"text":"          \"NOEQUALS\","},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":42,"text":"        ].join(\"\\n\"),"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":43,"text":"      );"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":44,"text":"      process.env.COMPREHENDE_EVAL_DOTENV_C = \"real-env\";"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":45,"text":"      await loadDotEnv(dir);"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":46,"text":"      assert.equal(process.env.COMPREHENDE_EVAL_DOTENV_A, \"abc\");"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":47,"text":"      assert.equal(process.env.COMPREHENDE_EVAL_DOTENV_B, \"x y\");"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":48,"text":"      assert.equal(process.env.COMPREHENDE_EVAL_DOTENV_C, \"real-env\");"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":49,"text":"    } finally {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":50,"text":"      restore(saved);"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":51,"text":"    }"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":52,"text":"  });"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":53,"text":""},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":54,"text":"  it(\"ignores a missing file\", async () => {"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":55,"text":"    const dir = await mkdtemp(join(tmpdir(), \"comprehende-dotenv-empty-\"));"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":56,"text":"    await loadDotEnv(dir);"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":57,"text":"  });"},{"sha":"faffb06a46ff492182596dbb26b16485f45b27a0","author":"Máté Molnár","timestamp":1791486625,"line":58,"text":"});"}]}
