342,"line":12,"text":"  if (parsed === undefined) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":13,"text":"    throw new Error(`not a GitHub repo URL: ${repoUrl}`);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":14,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":15,"text":"  return join(cacheDir, githubCacheName(parsed.owner, parsed.repo));"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":16,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":17,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":18,"text":"export async function ensureBareClone(opts: {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":19,"text":"  cacheDir: string;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":20,"text":"  repoUrl: string;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":21,"text":"  localMirror?: string;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":22,"text":"}): Promise<string> {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":23,"text":"  const dest = cachePath(opts.cacheDir, opts.repoUrl);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":24,"text":"  const token = process.env.GH_TOKEN ?? process.env.GITHUB_TOKEN;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":25,"text":"  const remoteUrl = authedGitUrl(opts.repoUrl, token);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":26,"text":"  if (!existsSync(join(dest, \"HEAD\"))) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":27,"text":"    await mkdir(opts.cacheDir, { recursive: true });"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":28,"text":"    if (opts.localMirror !== undefined && existsSync(join(opts.localMirror, \".git\"))) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":29,"text":"      await git(opts.cacheDir, [\"clone\", \"--bare\", opts.localMirror, dest]);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":30,"text":"      const remotes = (await git(dest, [\"remote\"])).trim().split(\"\\n\");"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":31,"text":"      if (!remotes.includes(\"github\")) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":32,"text":"        await git(dest, [\"remote\", \"add\", \"github\", remoteUrl]);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":33,"text":"      }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":34,"text":"    } else {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":35,"text":"      await git(dirname(dest), [\"clone\", \"--bare\", remoteUrl, dest]);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":36,"text":"    }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":37,"text":"  }"},{"sha":"11108ceae