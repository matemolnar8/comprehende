108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":66,"text":"  const missing = [];"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":67,"text":"  if (!(await gitOk(bare, [\"cat-file\", \"-e\", `${head}^{commit}`]))) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":68,"text":"    missing.push(`head ${head}`);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":69,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":70,"text":"  if (!(await gitOk(bare, [\"cat-file\", \"-e\", `${base}^{commit}`]))) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":71,"text":"    missing.push(`base ${base}`);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":72,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":73,"text":"  if (missing.length > 0) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":74,"text":"    throw new Error(`clone is missing ${missing.join(\" and \")}`);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":75,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":76,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":77,"text":""},{"sha":"a6c2a1cddfe8c0639336e5a0c5b58ee0fbb6c157","author":"Máté Molnár","timestamp":1790195924,"line":78,"text":"export const CASE_BUNDLE = \"repo.bundle\";"},{"sha":"a6c2a1cddfe8c0639336e5a0c5b58ee0fbb6c157","author":"Máté Molnár","timestamp":1790195924,"