1791576459,"line":92,"text":"    );"},{"sha":"a6c2a1cddfe8c0639336e5a0c5b58ee0fbb6c157","author":"Máté Molnár","timestamp":1790195924,"line":93,"text":"  }"},{"sha":"a6c2a1cddfe8c0639336e5a0c5b58ee0fbb6c157","author":"Máté Molnár","timestamp":1790195924,"line":94,"text":"  await git(bare, [\"update-ref\", BUNDLE_BASE_REF, base]);"},{"sha":"a6c2a1cddfe8c0639336e5a0c5b58ee0fbb6c157","author":"Máté Molnár","timestamp":1790195924,"line":95,"text":"  await git(bare, [\"update-ref\", BUNDLE_HEAD_REF, head]);"},{"sha":"a6c2a1cddfe8c0639336e5a0c5b58ee0fbb6c157","author":"Máté Molnár","timestamp":1790195924,"line":96,"text":"  const tmp = await mkdtemp(join(tmpdir(), \"comprehende-bundle-\"));"},{"sha":"a6c2a1cddfe8c0639336e5a0c5b58ee0fbb6c157","author":"Máté Molnár","timestamp":1790195924,"line":97,"text":"  try {"},{"sha":"a6c2a1cddfe8c0639336e5a0c5b58ee0fbb6c157","author":"Máté Molnár","timestamp":1790195924,"line":98,"text":"    const source = pathToFileURL(bare).href;"},{"sha":"a6c2a1cddfe8c0639336e5a0c5b58ee0fbb6c157","author":"Máté Molnár","timestamp":1790195924,"line":99,"text":"    await git(tmp, [\"init\", \"--bare\", \"--quiet\"]);"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":100,"text":"    await git(tmp, ["},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":101,"text":"      \"fetch\","},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":102,"text":"      \"--quiet\","},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":103,"text":"      \"--depth=1\","},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":104,"text":"      source,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":105,"text":"      `${BUNDLE_BASE_REF}:${BUNDLE_BASE_REF}`,"},{"sha