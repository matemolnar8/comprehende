{"path":"scripts/eval/args.ts","ref":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","side":"new","lines":[{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":1,"text":"import {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":2,"text":"  AGENT_KINDS,"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":3,"text":"  DEFAULT_GRADER_MODEL,"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":4,"text":"  DEFAULT_MUSECODE_MODEL,"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":5,"text":"  DEFAULT_PRODUCER_MODEL,"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":6,"text":"  type AgentKind,"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":7,"text":"} from \"./constants.ts\";"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":8,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":9,"text":"export const EVAL_USAGE = `Usage: pnpm eval -- [options]"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":10,"text":""},{"sha":"d05d71698063919c5928f161ed03e5c749f26594","author":"Cursor Agent","timestamp":1789938688,"line":11,"text":"Grade Comprehende reviews. An isolated producer follows the next skill. Deterministic checks score the result. Two read-only graders also score unless --no-graders. LLM findings do not change the exit code."},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":12,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":13,"text":"Options:"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":14,"text":"  --case <id>             Run this case (repeatable)"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":15,"text":"  --tag <tag>             Run cases with this tag"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":16,"text":"  --baseline <dir>        Print deltas against a previous eval/runs/<stamp>"},{"sha":"ef1e688be084667a7f76ce365dfbe44bba1f7f55","author":"Cursor Agent","timestamp":1790371794,"line":17,"text":"  --rescore <dir>         Re-check eval/runs/<stamp> reviews. No producer, no graders, no API key"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":18,"text":"  --json                  Also print summary.json to stdout"},{"sha":"cd8c738cce16c865125042bac4a6a5e85a13e364","author":"Cursor Agent","timestamp":1790362168,"line":19,"text":"  --producer-model <id>   Default ${DEFAULT_PRODUCER_MODEL}. Params: <id>:<param>=<value>,... (grok-4.6:effort=high)"},{"sha":"cd8c738cce16c865125042bac4a6a5e85a13e364","author":"Cursor Agent","timestamp":1790362168,"line":20,"text":"  --grader-model <id>     Default ${DEFAULT_GRADER_MODEL}. Same param form"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":21,"text":"  --producer-agent <kind> Default cursor. musecode runs the producer in Muse Code"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":22,"text":"  --grader-agent <kind>    Default cursor. musecode runs the graders in Muse Code"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":23,"text":"  --musecode-model <id>   Default ${DEFAULT_MUSECODE_MODEL}. Used when an agent is musecode"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":24,"text":"  --cursor-fallback       Probe Cursor first; on any Cursor error run cursor roles in Muse Code"},{"sha":"d05d71698063919c5928f161ed03e5c749f26594","author":"Cursor Agent","timestamp":1789938688,"line":25,"text":"  --no-graders            Skip grouping and prose graders"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":26,"text":"  --sandbox               Enable local sandboxOptions (cursor agents only)"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":27,"text":"  -h, --help"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":28,"text":""},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":29,"text":"Needs CURSOR_API_KEY unless --rescore, plus MUSE_CODE_API_KEY when an agent is musecode or --cursor-fallback is set. Writes eval/runs/<stamp>/index.html. Exit 1 when validate fails or a deterministic expect misses. Prose lint is advisory."},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":30,"text":"`;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":31,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":32,"text":"export const ADD_CASE_USAGE = `Usage: pnpm eval:add -- --pr <github pr url>"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":33,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":34,"text":"Fetch a pull request and write eval/cases/<repo>-<n>/ with frozen sources and empty expect."},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timest