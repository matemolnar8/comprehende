5,"line":13,"text":"  steps: number;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":14,"text":"};"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":15,"text":""},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":16,"text":"type MuseEvent = {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":17,"text":"  payload_type?: string;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":18,"text":"  payload?: {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":19,"text":"    kind?: string;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":20,"text":"    terminal?: string;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":21,"text":"    text?: string;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":22,"text":"    reason?: string | null;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":23,"text":"    event?: { kind?: string; operation?: string };"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":24,"text":"  };"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":25,"text":"};"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":26,"text":""},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":27,"text":"export function parseMuseExecJsonl(stdout: string): MuseExecResult {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":28,"text":"  const toolCalls: ToolCallRecord[] = [];"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":29,"text":"  let steps = 0;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":30,"text":"  let terminal = \"\";"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":31,"text":"  let text = \"\";"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":32,"text":"  let reason: string | undefined;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":33,"text":"  for (const line of stdout.split(\"\\n\")) {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":34,"text":"    const trimmed = line.trim();"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":35,"text":"    if (trimmed === \"\") {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":36,"text":"      continue;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":37,"text":"    }"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":38,"text":"    let event: MuseEvent;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":39,"text":"    try {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":40,"text":"      event = JSON.parse(trimmed) as MuseEvent;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":41,"text":"    } catch {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":42,"text":"      continue;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":43,"text":"    }"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":44,"text":"    const payload = event.payload;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":45,"text":"    if (payload?.kind === \"run_terminal\") {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":46,"text":"      terminal = payload.terminal ?? \"\";"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":47,"text":"      text = payload.text ?? \"\";"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":48,"text":"      reason = payload.reason ?? undefined;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":49,"text":"      continue;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":50,"text":"    }"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":51,"text":"    if (payload?.event?.kind === \"side_effect_intent\") {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":52,"text":"      const operation = payload.event.operation ?? \"\";"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":53,"text":"      if (operation.startsWith(\"tool:\")) {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":54,"text":"        toolCalls.push({ name: operation.slice(\"tool:\".length) });"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":55,"text":"      } else if (operation.startsWith(\"model.\")) {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":56,"text":"        steps += 1;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":57,"text":"      }"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":58,"text":"    }"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":59,"text":"  }"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":60,"text":"  return { text, terminal, reason, toolCalls, steps };"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":61,"text":"}"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":62,"text":""},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":63,"text":"/** Headless `muse exec`. Prompt travels in a file, the API key in stdin. */"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":64,"text":"export async function runMuseCodeAgent(opts: {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":65,"text":"  cwd: string;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":66,"text":"  model: string;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":67,"text":"  prompt: string;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":68,"text":"  apiKey: string;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":69,"text":"  readO