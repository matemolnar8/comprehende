":""},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":121,"text":"  it(\"pregroups a draft that validate accepts\", async () => {"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":122,"text":"    const root = await mkdtemp(join(tmpdir(), \"comprehende-pregroup-\"));"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":123,"text":"    roots.push(root);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":124,"text":"    const repo = await createExampleRepo(join(root, \"repo\"));"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":125,"text":"    const dataPath = join(root, \"review.json\");"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":126,"text":"    const { document } = await cmdPregroup(repo.root, dataPath, repo.base, repo.head);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":127,"text":"    assert.ok(document.groups.some((group) => group.id === \"change\"));"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":128,"text":"    assert.ok(document.groups.some((group) => group.id === \"mechanical\"));"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":129,"text":"    await cmdValidate(repo.root, dataPath);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":130,"text":"  });"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":131,"text":"});"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":132,"text":""},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":133,"text":"type GitLog = {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":134,"text":"  read: () => Promise<string[][]>;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":135,"text":"  clear: () => Promise<void>;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":136,"text":"};"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":137,"text":""},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":138,"text":"async function withGitLog(root: string, fn: (log: GitLog) => Promise<void>): Promise<void> {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":139,"text":"  const bin = join(root, \"bin\");"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":140,"text":"  const logPath = join(root, \"git.log\");"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":141,"text":"  await mkdir(bin, { recursive: true });"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":142,"text":"  await writeFile(logPath, \"\");"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":143,"text":"  await writeFile("},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":144,"text":"    join(bin, \"git\"),"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":145,"text":"    `#!/bin/bash\\nprintf '%s\\\\0' \"$@\" >> ${shellQuote(logPath)}\\nprintf '\\\\n' >> ${shellQuote(logPath)}\\nexec ${shellQuote(REAL_GIT)} \"$@\"\\n`,"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":146,"text":"  );"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":147,"text":"  await chmod(join(bin, \"git\"), 0o755);"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":148,"text":"  const previousPath = process.env.PATH;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":149,"text":"  process.env.PATH = `${bin}${delimiter}${previousPath ?? \"\"}`;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":150,"text":"  try {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":151,"text":"    await fn({"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":152,"text":"      read: async () => parseGitLog(await readFile(logPath, \"utf8\")),"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":153,"text":"      clear: () => writeFile(logPath, \"\"),"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":154,"text":"    });"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":155,"text":"  } finally {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":156,"text":"    if (previousPath === undefined) {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":157,"text":"      delete process.env.PATH;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":158,"text":"    } else {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":159,"text":"      process.env.PATH = previousPath;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":160,"text":"    }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":161,"text":"  }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":162,"text":"}"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":163,"text":""},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":164,"text":"function parseGitLog(text: string): string[][] {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":165,"text":"  return text"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":166,"text":"    .split(\"\\n\")"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":167,"text":"    .filter((line) => line.length > 0)"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":168,"text":"    .map((line) => line.split(\"\\0\").filter((arg) => arg.length > 0));"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":169,"text":"}"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":170,"text":""},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":171,"text":"function gitCommand(argv: string[]): string | undefined {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":172,"text":"  for (let i = 0; i < argv.length; i += 1) {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":173,"text":"    const arg = argv[i];"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":174,"text":"    if (arg === \"-c\") {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":175,"text":"      i += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":176,"text":"      continue;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":177,"text":"    }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":178,"text":"    return arg;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":179,"text":"  }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":180,"text":"  return undefined;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":181,"text":"}"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":182,"text":""},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":183,"text":"function tally(calls: string[][]): {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":184,"text":"  revParse: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":185,"text":"  nameStatus: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":186,"text":"  unified: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":187,"text":"  numstat: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":188,"text":"  mergeBase: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":189,"text":"  other: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":190,"text":"} {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":191,"text":"  const counts = { revParse: 0, nameStatus: 0, unified: 0, numstat: 0, mergeBase: 0, other: 0 };"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":192,"text":"  for (const argv of calls) {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":193,"text":"    const command = gitCommand(argv);"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":194,"text":"    if (command === \"rev-parse\") {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":195,"text":"      counts.revParse += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":196,"text":"    } else if (command === \"merge-base\") {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":197,"text":"      counts.mergeBase += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":198,"text":"    } else if (command === \"diff\" && argv.includes(\"--name-status\")) {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":199,"text":"      counts.nameStatus += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":200,"text":"    } else if (command === \"diff\" && argv.includes(\"--numstat\")) {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":201,"text":"      counts.numstat += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":202,"text":"    } else if (command === \"diff\") {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":203,"text":"      counts.unified += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":204,"text":"    } else {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":205,"text":"      counts.other += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":206,"text":"    }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":207,"text":"  }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":208,"text":"  return counts;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":209,"text":"}"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":210,"text":""},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":211,"text":"function shellQuote(value: string): string {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":212,"text":"  return `'${value.replaceAll(\"'\", `'\\\\''`)}'`;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":213,"text":"}"}]}
