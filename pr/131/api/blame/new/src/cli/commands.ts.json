","timestamp":1788035496,"line":11,"text":"import { sourceCitationErrors } from \"../schema/source.ts\";"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":12,"text":"import type { HunkIndex, ReviewDocument } from \"../schema/types.ts\";"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":13,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":14,"text":"export async function cmdIndex(cwd: string, base: string | undefined, head: string | undefined): Promise<HunkIndex> {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":15,"text":"  const baseRef = base ?? (await defaultBaseRef(cwd));"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":16,"text":"  const headRef = head ?? \"HEAD\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":17,"text":"  return readHunkIndex(cwd, baseRef, headRef);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":18,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":19,"text":""},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":20,"text":"export function resolveOutPath(out: string | undefined, cwd: string): string {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":21,"text":"  return resolveCliPath(out, cwd, \"--out <dir>\");"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":22,"text":"}"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":23,"text":""},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":24,"text":"export async function cmdReview("},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":25,"text":"  cwd: string,"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":26,"text":"  dataPath: string,"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":27,"text":"  base: string | undefined,"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":28,"text":"  head: string | undefined,"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":29,"text":"): Promise<{ document: ReviewDocument; index: HunkIndex }> {"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":30,"text":"  const index = await cmdIndex(cwd, base, head);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":31,"text":"  const skeleton = skeletonDocument(index);"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":32,"text":"  await mkdir(dirname(dataPath), { recursive: true });"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":33,"text":"  await writeFile(dataPath, `${JSON.stringify(skeleton, null, 2)}\\n`);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":34,"text":"  const document = await loadDocument(dataPath);"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":35,"text":"  return { document, index };"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":36,"text":"}"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":37,"text":""},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":38,"text":"export async function cmdValidate("},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":39,"text":"  cwd: string,"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":40,"text":"  dataPath: string,"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":41,"text":"): Promise<{ document: ReviewDocument; warnings: string[]; assignedHunks: number }> {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":42,"text":"  const document = await loadDocument(dataPath);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":43,"text":"  const resolved = await resolveSource(cwd, document.source.baseRef, document.source.headRef);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":44,"text":"  const { coverage } = await coverReview(cwd, document);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":45,"text":"  const pins = await staleCommentPins(cwd, document, resolved);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":46,"text":"  const errors = [...coverageErrors(coverage), ...sourceCitationErrors(document), ...commentPinErrors(pins)];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":47,"text":"  if (errors.length > 0) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":48,"text":"    throw new Error(errors.join(\"\\n\\n\"));"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":49,"text":"  }"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":50,"text":"  return { document, warnings: [], assignedHunks: coverage.assignedHunks };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":51,"text":"}"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":52,"text":""},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":53,"text":"/** One line per file. No patch text. Group from this; fetch patch with show. */"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":54,"text":"export async function cmdDigest(cwd: string, base: string | undefined, head: string | undefined): Promise<string> {"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":55,"text":"  const baseRef = base ?? (await defaultBaseRef(cwd));"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":56,"text":"  const headRef = head ?? \"HEAD\";"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":57,"text":"  const { source, baseSha, headSha } = await resolveSource(cwd, baseRef, headRef);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":58,"text":"  const files = await readDiff(cwd, baseSha, headSha);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":59,"text":"  const range = source.range ?? `${baseRef}...${headRef}`;"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":60,"text":"  return `${formatDigest(buildDigest(files), range)}\\n`;"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":61,"text":"}"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":62,"text":""},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":63,"text":"export type ShowRequest = { hunk?: string; file?: string };"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":64,"text":""},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":65,"text":"/** Full patch for one file or one hunk. The detail behind a digest line. */"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":66,"text":"export async function cmdShow("},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":67,"text":"  cwd: string,"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":68,"text":"  base: string | undefined,"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":69,"text":"  head: string | undefined,"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":70,"text":"  request: ShowRequest,"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":71,"text":"): Promise<string> {"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":72,"text":"  const baseRef = base ?? (await defaultBaseRef(cwd));"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":73,"text":"  const headRef = head ?? \"HEAD\";"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":74,"text":"  const target = request.hunk ?? request.file;"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":75,"text":"  if (target === undefined) {"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":76,"text":"    throw new Error(\"show needs --hunk <ref> or --file <path>\");"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":77,"text":"  }"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":78,"text":"  const parsed = request.hunk === undefined ? { kind: \"file\", path: target } as const : parseHunkRefString(target);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":79,"text":"  if (parsed === undefined) {"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":80,"text":"    throw new Error(`invalid hunk ref: ${target}`);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":81,"text":"  }"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":82,"text":"  const file = await readPathDiff(cwd, baseRef, headRef, parsed.path);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":83,"text":"  if (file === undefined) {"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":84,"text":"    throw new Error(`no diff for path: ${parsed.path}`);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":85,"text":"  }"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":86,"text":"  if (parsed.kind === \"file\") {"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":87,"text":"    return file.patch;"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":88,"text":"  }"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":89,"text":"  const hunk = file.hunks.find((item) => item.oldStart === parsed.oldStart && item.newStart === parsed.newStart);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":90,"text":"  if (hunk === undefined) {"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":91,"text":"    throw new Error(`no hunk matches: ${target}`);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":92,"text":"  }"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":93,"text":"  return filePatchFromGit(file, [hunk]);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":94,"text":"}"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":95,"text":""},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":96,"text":"/**"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":97,"text":" * Draft review.json from deterministic rules: identical-copy clusters,"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":98,"text":" * mechanical files (rename, copy, move, generated), and one change group"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":99,"text":" * for the rest. The skill accepts, splits, and writes the prose."},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":100,"text":" */"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":101,"text":"export async function cmdPregroup("},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":102,"text":"  cwd: string,"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":103,"text":"  dataPath: string,"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":104,"text":"  base: string | undefined,"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":105,"text":"  head: string | undefined,"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":106,"text":"): Promise<{ document: ReviewDocument; index: HunkIndex }> {"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":107,"text":"  const baseRef = base ?? (await defaultBaseRef(cwd));"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":108,"text":"  const headRef = head ?? \"HEAD\";"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":109,"text":"  const { source, baseSha, headSha } = await resolveSource(cwd, baseRef, headRef);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":110,"text":"  const files = await readDiff(cwd, baseSha, headSha);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":111,"text":"  const { files: digests } = buildDigest(files);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":112,"text":"  const mirrorRoots = new Set(digests.filter((digest) => digest.mirrorOf !== undefined).map((digest) => digest.mirrorOf as string));"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":113,"text":"  const mirrors = new Map<string, string[]>();"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":114,"text":"  const mechanical: string[] = [];"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":115,"text":"  const change: string[] = [];"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":116,"text":"  for (const digest of digests) {"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":117,"text":"    const refs = digestHunkRefs(digest);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":118,"text":"    if (digest.mirrorOf !== undefined || mirrorRoots.has(digest.path)) {"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":119,"text":"      const root = digest.mirrorOf ?? digest.path;"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":120,"text":"      const cluster = mirrors.get(root) ?? [];"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":121,"text":"      cluster.push(...refs);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":122,"text":"      mirrors.set(root, cluster);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":123,"text":"      continue;"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":124,"text":"    }"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":125,"text":"    if (digest.kind === \"rename\" || digest.kind === \"copy\" || digest.kind === \"move\" || digest.kind === \"generated\") {"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":126,"text":"      mechanical.push(...refs);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":127,"text":"      continue;"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":128,"text":"    }"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":129,"text":"    change.push(...refs);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":130,"text":"  }"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":131,"text":"  const index = await readHunkIndex(cwd, baseRef, headRef);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":132,"text":"  const skeleton = skeletonDocument(index);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":133,"text":"  const groups: { id: string; title: string; why: string; summary: string; suggestedOrder: number; hunkRefs: string[] }[] = [];"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":134,"text":"  if (change.length > 0 || (mirrors.size === 0 && mechanical.length === 0)) {"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":135,"text":"    groups.push({"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":136,"text":"      id: \"change\","},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":137,"text":"      title: \"Change\","},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":138,"text":"      why: \"Draft: the change minus copies and mechanical files. Split by concern.\","},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":139,"text":"      summary: \"Fill this group.\","},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":140,"text":"      suggestedOrder: 0,"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":141,"text":"      hunkRefs: change,"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":142,"text":"    });"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":143,"text":"  }"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":144,"text":"  let order = 1;"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":145,"text":"  for (const [root, paths] of mirrors) {"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":146,"text":"    groups.push({"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":147,"text":"      id: `mirrors-${order}`,"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":148,"text":"      title: \"Synced copies\","},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":149,"text":"      why: `Draft: identical copies of ${root}. Read one, skip the rest.`,"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":150,"text":"      summary: \"Fill this group.\","},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":151,"text":"      suggestedOrder: order,"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":152,"text":"      hunkRefs: [...new Set(paths)],"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":153,"text":"    });"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":154,"text":"    order += 1;"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":155,"text":"  }"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":156,"text":"  if (mechanical.length > 0) {"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":157,"text":"    groups.push({"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":158,"text":"      id: \"mechanical\","},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":159,"text":"      title: \"Mechanical\","},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":160,"text":"      why: \"Draft: renames, copies, moves, or generated output. Say what the reader can skip.\","},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":161,"text":"      summary: \"Fill this group.\","},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":162,"text":"      suggestedOrder: order,"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":163,"text":"      hunkRefs: mechanical,"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":164,"text":"    });"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":165,"text":"  }"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":166,"text":"  const document = { ...skeleton, source, groups };"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":167,"text":"  await mkdir(dirname(dataPath), { recursive: true });"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":168,"text":"  await writeFile(dataPath, `${JSON.stringify(document, null, 2)}\\n`);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":169,"text":"  const loaded = await loadDocument(dataPath);"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":170,"text":"  return { document: loaded, index };"},{"sha":"8c5594bbc15b7382c254dbd821ad68b5dadafbc0","author":"Máté Molnár","timestamp":1791134736,"line":171,"text":"}"}]}
