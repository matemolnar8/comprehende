  await git(tmp, [\"fetch\", \"--quiet\", `--shallow-exclude=${BUNDLE_BASE_REF}`, source, `${BUNDLE_HEAD_REF}:${BUNDLE_HEAD_REF}`]);"},{"kind":"add","oldNumber":null,"newNumber":86,"text":"    await git(tmp, [\"bundle\", \"create\", \"--quiet\", resolve(dest), BUNDLE_BASE_REF, BUNDLE_HEAD_REF]);"},{"kind":"add","oldNumber":null,"newNumber":87,"text":"  } finally {"},{"kind":"add","oldNumber":null,"newNumber":88,"text":"    await rm(tmp, { recursive: true, force: true });"},{"kind":"add","oldNumber":null,"newNumber":89,"text":"  }"},{"kind":"add","oldNumber":null,"newNumber":90,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":91,"text":""},{"kind":"add","oldNumber":null,"newNumber":92,"text":"/** A bundle carries no shallow list, so mark base as the boundary before fetching from it. */"},{"kind":"add","oldNumber":null,"newNumber":93,"text":"export async function cloneCaseBundle(opts: { bundle: string; dest: string; base: string; repoUrl: string }): Promise<void> {"},{"kind":"add","oldNumber":null,"newNumber":94,"text":"  await mkdir(opts.dest, { recursive: true });"},{"kind":"add","oldNumber":null,"newNumber":95,"text":"  await git(opts.dest, [\"init\", \"--bare\", \"--quiet\"]);"},{"kind":"add","oldNumber":null,"newNumber":96,"text":"  await writeFile(join(opts.dest, \"shallow\"), `${opts.base}\\n`);"},{"kind":"add","oldNumber":null,"newNumber":97,"text":"  await git(opts.dest, [\"fetch\", \"--quiet\", resolve(opts.bundle), \"refs/eval/*:refs/eval/*\"]);"},{"kind":"add","oldNumber":null,"newNumber":98,"text":"  await git(opts.dest, [\"remote\", \"add\", \"origin\", opts.repoUrl]);"},{"kind":"add","oldNumber":null,"newNumber":99,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":100,"text":""},{"kind":"ctx","oldNumber":67,"newNumber":101,"text":"export async function addDetachedWorktree(bare: string, dest: string, head: string): Promise<void> {"},{"kind":"ctx","oldNumber":68,"newNumber":102,"text":"  await git(bare, [\"worktree\", \"prune\"], { allowFail: true });"},{"kind":"ctx","oldNumber":69,"newNumber":103,"text":"  await git(bare, [\"worktree\", \"add\", \"--detach\", dest, head]);"}]}]},{"path":"scripts/eval/clone.test.ts","kind":"text","status":"added","patch":"diff --git a/scripts/eval/clone.test.ts b/scripts/eval/clone.test.ts\nnew file mode 100644\nindex 0000000..1f464e4\n--- /dev/null\n+++ b/scripts/eval/clone.test.ts\n@@ -0,0 +1,56 @@\n+import assert from \"node:assert/strict\";\n+import { mkdtemp, writeFile } from \"node:fs/promises\";\n+import { rmSync } from \"node:fs\";\n+import { tmpdir } from \"node:os\";\n+import { join } from \"node:path\";\n+import { after, describe, it } from \"node:test\";\n+import { git } from \"../../src/git/exec.ts\";\n+import { initEmptyRepo } from \"../../src/test/init-repo.ts\";\n+import { cloneCaseBundle, writeCaseBundle } from \"./clone.ts\";\n+\n+const roots: string[] = [];\n+after(() => {\n+  for (const root of roots) {\n+    rmSync(root, { recursive: true, force: true });\n+  }\n+});\n+\n+async function commit(cwd: string, file: string, message: string): Promise<string> {\n+  await writeFile(join(cwd, file), `${message}\\n`);\n+  await git(cwd, [\"add\", \".\"]);\n+  await git(cwd, [\"commit\", \"-m\", message]);\n+  return (await git(cwd, [\"rev-parse\", \"HEAD\"])).trim();\n+}\n+\n+describe(\"case bundle\", () => {\n+  it(\"cuts history at base and still diffs base...head offline\", async () => {\n+    const root = await mkdtemp(join(tmpdir(), \"eval-bundle-\"));\n+    roots.push(root);\n+    const src = join(root, \"src\");\n+    await initEmptyRepo(src);\n+    await commit(src, \"old.txt\", \"before base\");\n+    const base = await commit(src, \"a.txt\", \"base\");\n+    await commit(src, \"b.txt\", \"one\");\n+    const head = await commit(src, \"c.txt\", \"two\");\n+\n+    const bundle = join(root, \"repo.bundle\");\n+    await writeCaseBundle(src, base, head, bundle);\n+    const bare = join(root, \"clone.git\");\n+    await cloneCaseBundle({ bundle, dest: bare, base, repoUrl: \"https://github.com/o/r.git\" });\n+\n+    assert.equal((await git(bare, [\"rev-list\", \"--count\", `${base}..${head}`])).trim(), \"2\");\n+    assert.equal((await git(bare, [\"merge-base\", base, head])).trim(), base);\n+    assert.equal((await git(bare, [\"rev-list\", \"--count\", head])).trim(), \"3\");\n+    assert.deepEqual((await git(bare, [\"diff\", \"--name-only\", `${base}...${head}`])).trim().split(\"\\n\"), [\"b.txt\", \"c.txt\"]);\n+    assert.equal((await git(bare, [\"config\", \"--get\", \"remote.origin.url\"])).trim(), \"https://github.com/o/r.git\");\n+  });\n+\n+  it(\"refuses a base that is not an ancestor of head\", async () => {\n+    const root = await mkdtemp(join(tmpdir(), \"eval-bundle-\"));\n+    roots.push(root);\n+    await initEmptyRepo(root);\n+    const first = await commit(root, \"a.txt\", \"first\");\n+    const second = await commit(root, \"b.txt\", \"second\");\n+    await assert.rejects(writeCaseBundle(root, second, first, join(root, \"x.bundle\")), /not an ancestor/);\n+  });\n+});\n","complete":true,"hunks":[{"path":"scripts/eval/clone.test.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":56,"header":"@@ -0,0 +1,56 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import assert from \"node:assert/strict\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import { mkdtemp, writeFile } from \"node:fs/promises\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import { rmSync } from \"node:fs\";"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"import { tmpdir } from \"node:os\";"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"import { join } from \"node:path\";"},{"kind":"add","oldNumber":null,"newNumber":6,"text":"import { after, describe, it } from \"node:test\";"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"import { git } from \"../../src/git/exec.ts\";"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"import { initEmptyRepo }