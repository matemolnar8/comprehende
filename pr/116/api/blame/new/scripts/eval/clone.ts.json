9268342,"line":12,"text":"  if (parsed === undefined) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":13,"text":"    throw new Error(`not a GitHub repo URL: ${repoUrl}`);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":14,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":15,"text":"  return join(cacheDir, githubCacheName(parsed.owner, parsed.repo));"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":16,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":17,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":18,"text":"export async function ensureBareClone(opts: {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":19,"text":"  cacheDir: string;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":20,"text":"  repoUrl: string;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":21,"text":"  localMirror?: string;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":22,"text":"}): Promise<string> {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":23,"text":"  const dest = cachePath(opts.cacheDir, opts.repoUrl);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":24,"text":"  const token = process.env.GH_TOKEN ?? process.env.GITHUB_TOKEN;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":25,"text":"  const remoteUrl = authedGitUrl(opts.repoUrl, token);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":26,"text":"  if (!existsSync(join(dest, \"HEAD\"))) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":27,"text":"    await mkdir(opts.cacheDir, { recursive: true });"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":28,"text":"    if (opts.localMirror !== undefined && existsSync(join(opts.localMirror, \".git\"))) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":29,"text":"      await git(opts.cacheDir, [\"clone\", \"--bare\", opts.localMirror, dest]);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":30,"text":"      const remotes = (await git(dest, [\"remote\"])).trim().split(\"\\n\");"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":31,"text":"      if (!remotes.includes(\"github\")) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":32,"text":"        await git(dest, [\"remote\", \"add\", \"github\", remoteUrl]);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":33,"text":"      }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":34,"text":"    } else {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":35,"text":"      await git(dirname(dest), [\"clone\", \"--bare\", remoteUrl, dest]);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":36,"text":"    }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":37,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":38,"text":"  return dest;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":39,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":40,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":41,"text":"export async function fetchCaseRefs(bare: string, pr: number, base: string, head: string): Promise<void> {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":42,"text":"  const remote = (await gitOk(bare, [\"remote\", \"get-url\", \"github\"])) ? \"github\" : \"origin\";"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":43,"text":"  await git(bare, ["},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":44,"text":"    \"fetch\","},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":45,"text":"    \"--prune\","},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":46,"text":"    remote,"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":47,"text":"    `+refs/pull/${pr}/head:refs/eval/pr-${pr}`,"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":48,"text":"    \"+refs/heads/main:refs/heads/main\","},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":49,"text":"    \"+refs/heads/master:refs/heads/master\","},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":50,"text":"  ], { allowFail: true });"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":51,"text":"  if (!(await gitOk(bare, [\"cat-file\", \"-e\", `${head}^{commit}`]))) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":52,"text":"    await git(bare, [\"fetch\", remote, head]);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":53,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":54,"text":"  if (!(await gitOk(bare, [\"cat-file\", \"-e\", `${base}^{commit}`]))) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":55,"text":"    await git(bare, [\"fetch\", remote, base]);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":56,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":57,"text":"  const missing = [];"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":58,"text":"  if (!(await gitOk(bare, [\"cat-file\", \"-e\", `${head}^{commit}`]))) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":59,"text":"    missing.push(`head ${head}`);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":60,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":61,"text":"  if (!(await gitOk(bare, [\"cat-file\", \"-e\", `${base}^{commit}`]))) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":62,"text":"    missing.push(`base ${base}`);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":63,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":64,"text":"  if (missing.length > 0) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":65,"text":"    throw new Error(`clone is missing ${missing.join(\" and \")}`);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":66,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":67,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":68,"text":""},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":69,"text":"export const CASE_BUNDLE = \"repo.bundle\";"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":70,"text":"const BUNDLE_BASE_REF = \"refs/eval/base\";"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":71,"text":"const BUNDLE_HEAD_REF = \"refs/eval/head\";"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":72,"text":""},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":73,"text":"/** Bundle the base tree plus base..head so a run needs no remote. The history is cut at base. */"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":74,"text":"export async function writeCaseBundle(bare: string, base: string, head: string, dest: string): Promise<void> {"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":75,"text":"  if (!(await gitOk(bare, [\"merge-base\", \"--is-ancestor\", base, head]))) {"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":76,"text":"    throw new Error(`base ${base} is not an ancestor of head ${head}, so the history cannot be cut at base`);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":77,"text":"  }"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":78,"text":"  await git(bare, [\"update-ref\", BUNDLE_BASE_REF, base]);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":79,"text":"  await git(bare, [\"update-ref\", BUNDLE_HEAD_REF, head]);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":80,"text":"  const tmp = await mkdtemp(join(tmpdir(), \"comprehende-bundle-\"));"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":81,"text":"  try {"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":82,"text":"    const source = pathToFileURL(bare).href;"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":83,"text":"    await git(tmp, [\"init\", \"--bare\", \"--quiet\"]);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":84,"text":"    await git(tmp, [\"fetch\", \"--quiet\", \"--depth=1\", source, `${BUNDLE_BASE_REF}:${BUNDLE_BASE_REF}`]);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":85,"text":"    await git(tmp, [\"fetch\", \"--quiet\", `--shallow-exclude=${BUNDLE_BASE_REF}`, source, `${BUNDLE_HEAD_REF}:${BUNDLE_HEAD_REF}`]);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":86,"text":"    await git(tmp, [\"bundle\", \"create\", \"--quiet\", resolve(dest), BUNDLE_BASE_REF, BUNDLE_HEAD_REF]);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":87,"text":"  } finally {"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":88,"text":"    await rm(tmp, { recursive: true, force: true });"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":89,"text":"  }"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":90,"text":"}"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":91,"text":""},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":92,"text":"/** A bundle carries no shallow list, so mark base as the boundary before fetching from it. */"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":93,"text":"export async function cloneCaseBundle(opts: { bundle: string; dest: string; base: string; repoUrl: string }): Promise<void> {"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":94,"text":"  await mkdir(opts.dest, { recursive: true });"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":95,"text":"  await git(opts.dest, [\"init\", \"--bare\", \"--quiet\"]);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":96,"text":"  await writeFile(join(opts.dest, \"shallow\"), `${opts.base}\\n`);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":97,"text":"  await git(opts.dest, [\"fetch\", \"--quiet\", resolve(opts.bundle), \"refs/eval/*:refs/eval/*\"]);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":98,"text":"  await git(opts.dest, [\"remote\", \"add\", \"origin\", opts.repoUrl]);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":99,"text":"}"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":100,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":101,"text":"export async function addDetachedWorktree(bare: string, dest: string, head: string): Promise<void> {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":102,"text":"  await git(bare, [\"worktree\", \"prune\"], { allowFail: true });"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":103,"text":"  await git(bare, [\"worktree\", \"add\", \"--detach\", dest, head]);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":104,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":105,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":106,"text":"export async function removeWorktree(bare: string, dest: string): Promise<void> {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":107,"text":"  await git(bare, [\"worktree\", \"remove\", \"--force\", dest], { allowFail: true });"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":108,"text":"  await git(bare, [\"worktree\", \"prune\"], { allowFail: true });"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":109,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":110,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":111,"text":"export async function thisRepoMirror(packageRoot: string, repoUrl: string): Promise<string | undefined> {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":112,"text":"  const wanted = parseGithubRepo(repoUrl);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":113,"text":"  if (wanted === undefined) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":114,"text":"    return undefined;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":115,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":116,"text":"  const origin = (await git(packageRoot, [\"config\", \"--get\", \"remote.origin.url\"], { allowFail: true })).trim();"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":117,"text":"  const parsed = parseGithubRepo(origin);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":118,"text":"  if (parsed === undefined || parsed.owner !== wanted.owner || parsed.repo !== wanted.repo) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":119,"text":"    return undefined;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":120,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":121,"text":"  return packageRoot;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":122,"text":"}"}]}
