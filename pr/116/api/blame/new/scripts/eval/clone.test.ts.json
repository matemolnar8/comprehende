{"path":"scripts/eval/clone.test.ts","ref":"a610a8c226a46a202300b570b1519382fa6a92cd","side":"new","lines":[{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":1,"text":"import assert from \"node:assert/strict\";"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":2,"text":"import { mkdtemp, writeFile } from \"node:fs/promises\";"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":3,"text":"import { rmSync } from \"node:fs\";"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":4,"text":"import { tmpdir } from \"node:os\";"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":5,"text":"import { join } from \"node:path\";"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":6,"text":"import { after, describe, it } from \"node:test\";"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":7,"text":"import { git } from \"../../src/git/exec.ts\";"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":8,"text":"import { initEmptyRepo } from \"../../src/test/init-repo.ts\";"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":9,"text":"import { cloneCaseBundle, writeCaseBundle } from \"./clone.ts\";"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":10,"text":""},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":11,"text":"const roots: string[] = [];"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":12,"text":"after(() => {"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":13,"text":"  for (const root of roots) {"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":14,"text":"    rmSync(root, { recursive: true, force: true });"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":15,"text":"  }"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":16,"text":"});"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":17,"text":""},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":18,"text":"async function commit(cwd: string, file: string, message: string): Promise<string> {"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":19,"text":"  await writeFile(join(cwd, file), `${message}\\n`);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":20,"text":"  await git(cwd, [\"add\", \".\"]);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":21,"text":"  await git(cwd, [\"commit\", \"-m\", message]);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":22,"text":"  return (await git(cwd, [\"rev-parse\", \"HEAD\"])).trim();"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":23,"text":"}"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":24,"text":""},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":25,"text":"describe(\"case bundle\", () => {"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":26,"text":"  it(\"cuts history at base and still diffs base...head offline\", async () => {"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":27,"text":"    const root = await mkdtemp(join(tmpdir(), \"eval-bundle-\"));"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":28,"text":"    roots.push(root);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":29,"text":"    const src = join(root, \"src\");"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":30,"text":"    await initEmptyRepo(src);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":31,"text":"    await commit(src, \"old.txt\", \"before base\");"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":32,"text":"    const base = await commit(src, \"a.txt\", \"base\");"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":33,"text":"    await commit(src, \"b.txt\", \"one\");"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":34,"text":"    const head = await commit(src, \"c.txt\", \"two\");"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":35,"text":""},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":36,"text":"    const bundle = join(root, \"repo.bundle\");"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":37,"text":"    await writeCaseBundle(src, base, head, bundle);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":38,"text":"    const bare = join(root, \"clone.git\");"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":39,"text":"    await cloneCaseBundle({ bundle, dest: bare, base, repoUrl: \"https://github.com/o/r.git\" });"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":40,"text":""},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":41,"text":"    assert.equal((await git(bare, [\"rev-list\", \"--count\", `${base}..${head}`])).trim(), \"2\");"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":42,"text":"    assert.equal((await git(bare, [\"merge-base\", base, head])).trim(), base);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":43,"text":"    assert.equal((await git(bare, [\"rev-list\", \"--count\", head])).trim(), \"3\");"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":44,"text":"    assert.deepEqual((await git(bare, [\"diff\", \"--name-only\", `${base}...${head}`])).trim().split(\"\\n\"), [\"b.txt\", \"c.txt\"]);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":45,"text":"    assert.equal((await git(bare, [\"config\", \"--get\", \"remote.origin.url\"])).trim(), \"https://github.com/o/r.git\");"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":46,"text":"  });"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":47,"text":""},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":48,"text":"  it(\"refuses a base that is not an ancestor of head\", async () => {"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":49,"text":"    const root = await mkdtemp(join(tmpdir(), \"eval-bundle-\"));"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":50,"text":"    roots.push(root);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":51,"text":"    await initEmptyRepo(root);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":52,"text":"    const first = await commit(root, \"a.txt\", \"first\");"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":53,"text":"    const second = await commit(root, \"b.txt\", \"second\");"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":54,"text":"    await assert.rejects(writeCaseBundle(root, second, first, join(root, \"x.bundle\")), /not an ancestor/);"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":55,"text":"  });"},{"sha":"dbc97e90ef1e690bcd1ac64f0728fafafcd8c299","author":"Cursor Agent","timestamp":1790144467,"line":56,"text":"});"}]}
