{"path":"src/ui/components/ReadingMark.tsx","ref":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","side":"new","lines":[{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":1,"text":"import { readingStatus } from \"../lib/reading-progress.ts\";"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":2,"text":"import { cn } from \"@/lib/utils.ts\";"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":3,"text":""},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":4,"text":"export function ReadingMark(props: {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":5,"text":"  paths: readonly string[];"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":6,"text":"  viewed: ReadonlySet<string>;"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":7,"text":"  /** Use the noun when the mark stands alone. Rows stay short. */"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":8,"text":"  noun?: boolean;"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":9,"text":"  className?: string;"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":10,"text":"}) {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":11,"text":"  const status = readingStatus(props.paths, props.viewed);"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":12,"text":"  if (status === null) {"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":13,"text":"    return null;"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":14,"text":"  }"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":15,"text":"  return ("},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":16,"text":"    <span className={cn(\"mt-px shrink-0 font-mono text-[11px] tabular-nums text-muted-foreground\", props.className)}>"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":17,"text":"      {props.noun === true ? status.filesLabel : status.label}"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":18,"text":"    </span>"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":19,"text":"  );"},{"sha":"fe3f8acbfa301232ca8380ef4377aee004f1d3f5","author":"Cursor Agent","timestamp":1790138044,"line":20,"text":"}"}]}
