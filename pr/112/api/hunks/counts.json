 a/src/ui/lib/reading-progress.ts b/src/ui/lib/reading-progress.ts\nnew file mode 100644\nindex 0000000..91d5404\n--- /dev/null\n+++ b/src/ui/lib/reading-progress.ts\n@@ -0,0 +1,65 @@\n+export type ReadingCounts = {\n+  total: number;\n+  viewed: number;\n+  left: number;\n+};\n+\n+export type ReadingStatus = ReadingCounts & {\n+  /** Short mark for a row: \"3 left\" or \"Viewed\". */\n+  label: string;\n+  /** Standalone mark: \"3 files left\", \"1 file left\", or \"All files viewed\". */\n+  filesLabel: string;\n+};\n+\n+export function readingCounts(paths: readonly string[], viewed: ReadonlySet<string>): ReadingCounts {\n+  const unique = new Set(paths);\n+  let viewedCount = 0;\n+  for (const path of unique) {\n+    if (viewed.has(path)) {\n+      viewedCount += 1;\n+    }\n+  }\n+  return { total: unique.size, viewed: viewedCount, left: unique.size - viewedCount };\n+}\n+\n+/** Null when the list has no files. Progress is the reader's attention, not a verdict. */\n+export function readingStatus(paths: readonly string[], viewed: ReadonlySet<string>): ReadingStatus | null {\n+  const counts = readingCounts(paths, viewed);\n+  if (counts.total === 0) {\n+    return null;\n+  }\n+  const done = counts.left === 0;\n+  return {\n+    ...counts,\n+    label: done ? \"Viewed\" : `${counts.left} left`,\n+    filesLabel: done ? \"All files viewed\" : counts.left === 1 ? \"1 file left\" : `${counts.left} files left`,\n+  };\n+}\n+\n+export function reviewReadingPaths(review: {\n+  groups: readonly { files: readonly string[] }[];\n+  unassigned: { files: readonly string[] };\n+  lockfiles: { files: readonly string[] };\n+}): string[] {\n+  const seen = new Set<string>();\n+  const paths: string[] = [];\n+  const add = (path: string) => {\n+    if (seen.has(path)) {\n+      return;\n+    }\n+    seen.add(path);\n+    paths.push(path);\n+  };\n+  for (const group of review.groups) {\n+    for (const path of group.files) {\n+      add(path);\n+    }\n+  }\n+  for (const path of review.unassigned.files) {\n+    add(path);\n+  }\n+  for (const path of review.lockfiles.files) {\n+    add(path);\n+  }\n+  return paths;\n+}\n","complete":true,"hunks":[{"path":"src/ui/lib/reading-progress.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":65,"header":"@@ -0,0 +1,65 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"export type ReadingCounts = {"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"  total: number;"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"  viewed: number;"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"  left: number;"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"};"},{"kind":"add","oldNumber":null,"newNumber":6,"text":""},{"kind":"add","oldNumber":null,"newNumber":7,"text":"export type ReadingStatus = ReadingCounts & {"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"  /** Short mark for a row: \"3 left\" or \"Viewed\". */"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"  label: string;"},{"kind":"add","oldNumber":null,"newNumber":10,"text":"  /** Standalone mark: \"3 files left\", \"1 file left\", or \"All files viewed\". */"},{"kind":"add","oldNumber":null,"newNumber":11,"text":"  filesLabel: string;"},{"kind":"add","oldNumber":null,"newNumber":12,"text":"};"},{"kind":"add","oldNumber":null,"newNumber":13,"text":""},{"kind":"add","oldNumber":null,"newNumber":14,"text":"export function readingCounts(paths: readonly string[], viewed: ReadonlySet<string>): ReadingCounts {"},{"kind":"add","oldNumber":null,"newNumber":15,"text":"  const unique = new Set(paths);"},{"kind":"add","oldNumber":null,"newNumber":16,"text":"  let viewedCount = 0;"},{"kind":"add","oldNumber":null,"newNumber":17,"text":"  for (const path of unique) {"},{"kind":"add","oldNumber":null,"newNumber":18,"text":"    if (viewed.has(path)) {"},{"kind":"add","oldNumber":null,"newNumber":19,"text":"      viewedCount += 1;"},{"kind":"add","oldNumber":null,"newNumber":20,"text":"   