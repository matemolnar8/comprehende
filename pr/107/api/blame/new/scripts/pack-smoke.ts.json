{"path":"scripts/pack-smoke.ts","ref":"8ec784735acf2ab1b549753b27af9048c32d423a","side":"new","lines":[{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":1,"text":"#!/usr/bin/env node"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":2,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":3,"text":"import assert from \"node:assert/strict\";"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":4,"text":"import { execFileSync, spawn, spawnSync } from \"node:child_process\";"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":5,"text":"import { mkdtemp, readFile, writeFile } from \"node:fs/promises\";"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":6,"text":"import { existsSync, rmSync } from \"node:fs\";"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":7,"text":"import { tmpdir } from \"node:os\";"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":8,"text":"import { dirname, join } from \"node:path\";"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":9,"text":"import { fileURLToPath } from \"node:url\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":10,"text":"import { readPackageVersionFromDir } from \"../src/package-root.ts\";"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":11,"text":"import { createExampleRepo } from \"../src/test/example-repo.ts\";"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":12,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":13,"text":"const repoRoot = join(dirname(fileURLToPath(import.meta.url)), \"..\");"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":14,"text":"const roots: string[] = [];"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":15,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":16,"text":"try {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":17,"text":"  await run();"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":18,"text":"} finally {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":19,"text":"  for (const root of roots) {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":20,"text":"    rmSync(root, { recursive: true, force: true });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":21,"text":"  }"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":22,"text":"}"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":23,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":24,"text":"async function run(): Promise<void> {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":25,"text":"  const packDir = await mkdtemp(join(tmpdir(), \"comprehende-pack-\"));"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":26,"text":"  roots.push(packDir);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":27,"text":"  execFileSync(\"pnpm\", [\"pack\", \"--pack-destination\", packDir], { cwd: repoRoot, stdio: \"inherit\" });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":28,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":29,"text":"  const version = await readPackageVersionFromDir(repoRoot);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":30,"text":"  const tarball = join(packDir, `comprehende-${version}.tgz`);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":31,"text":"  assert.equal(existsSync(tarball), true, `expected ${tarball}`);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":32,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":33,"text":"  const listing = execFileSync(\"tar\", [\"-tzf\", tarball], { encoding: \"utf8\" }).split(\"\\n\");"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":34,"text":"  for (const required of [\"package/dist/cli/main.js\", \"package/dist/ui/index.html\", \"package/skills/comprehende/SKILL.md\"]) {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":35,"text":"    assert.equal(listing.includes(required), true, `tarball missing ${required}`);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":36,"text":"  }"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":37,"text":"  assert.equal("},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":38,"text":"    listing.some((path) => path.includes(\"skills-next\")),"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":39,"text":"    false,"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":40,"text":"    \"tarball must not include skills-next\","},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":41,"text":"  );"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":42,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":43,"text":"  const packedPkg: unknown = JSON.parse("},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":44,"text":"    execFileSync(\"tar\", [\"-xOf\", tarball, \"package/package.json\"], { encoding: \"utf8\" }),"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":45,"text":"  );"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":46,"text":"  const packedDependencies: unknown = isRecord(packedPkg) ? packedPkg.dependencies : undefined;"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":47,"text":"  assert.deepEqual(Object.keys(packedDependencies ?? {}).sort(), [\"zod\"], \"packed tarball may depend on zod only\");"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":48,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":49,"text":"  const installDir = await mkdtemp(join(tmpdir(), \"comprehende-install-\"));"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":50,"text":"  roots.push(installDir);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":51,"text":"  await writeFile(join(installDir, \"package.json\"), `${JSON.stringify({ name: \"pack-smoke-consumer\", private: true }, null, 2)}\\n`);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":52,"text":"  execFileSync(\"npm\", [\"install\", tarball, \"--omit=dev\"], { cwd: installDir, stdio: \"inherit\" });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":53,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":54,"text":"  const bin = join(installDir, \"node_modules/.bin/comprehende\");"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":55,"text":"  assert.equal(existsSync(bin), true, \"installed package must expose the comprehende bin\");"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":56,"text":"  assert.equal("},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":57,"text":"    existsSync(join(installDir, \"node_modules/comprehende/node_modules/@pierre\")),"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":58,"text":"    false,"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":59,"text":"    \"npx install must not pull @pierre/diffs\","},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":60,"text":"  );"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":61,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":62,"text":"  const versionOut = execFileSync(bin, [\"--version\"], { encoding: \"utf8\" });"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":63,"text":"  assert.equal(versionOut.trim(), version, `packed bin --version: ${JSON.stringify(versionOut)}`);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":64,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":65,"text":"  const work = await mkdtemp(join(tmpdir(), \"comprehende-cwd-\"));"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":66,"text":"  roots.push(work);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":67,"text":"  const repo = await createExampleRepo(work);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":68,"text":"  const dataPath = join(work, \"review.json\");"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":69,"text":""},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":70,"text":"  const helpOut = execFileSync(bin, [\"--help\"], { encoding: \"utf8\" });"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":71,"text":"  assert.match(helpOut, /review\\s+\\[--base/);"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":72,"text":"  assert.doesNotMatch(helpOut, /^\\s+index\\s/m);"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":73,"text":"  const indexOut = spawnSync(bin, [\"index\", \"--base\", repo.base, \"--head\", repo.head], {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":74,"text":"    cwd: repo.root,"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":75,"text":"    encoding: \"utf8\","},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":76,"text":"  });"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":77,"text":"  assert.equal(indexOut.status, 1, \"packed bin must reject index\");"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":78,"text":"  assert.match(indexOut.stderr, /Unknown command: index/);"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":79,"text":""},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":80,"text":"  const reviewOut = execFileSync(bin, [\"review\", \"--base\", repo.base, \"--head\", repo.head, \"--data\", dataPath], {"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":81,"text":"    cwd: repo.root,"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":82,"text":"    encoding: \"utf8\","},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":83,"text":"  });"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":84,"text":"  assert.equal(reviewOut.trim(), dataPath);"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":85,"text":"  const skeletonRaw: unknown = JSON.parse(await readFile(dataPath, \"utf8\"));"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":86,"text":"  assert.ok(isRecord(skeletonRaw), \"review skeleton must be a JSON object\");"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":87,"text":"  assert.equal(skeletonRaw.title, \"Untitled\");"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":88,"text":"  assert.equal(skeletonRaw.why, undefined);"},{"sha":"3d120347ff1a85ae0e78ab94c4ed1c25b3168da2","author":"Cursor Agent","timestamp":1790106806,"line":89,"text":"  assert.deepEqual(skeletonRaw.lookFor, []);"},{"sha":"3d120347ff1a85ae0e78ab94c4ed1c25b3168da2","author":"Cursor Agent","timestamp":1790106806,"line":90,"text":"  assert.deepEqual(skeletonRaw.parts, []);"},{"sha":"3d120347ff1a85ae0e78ab94c4ed1c25b3168da2","author":"Cursor Agent","timestamp":1790106806,"line":91,"text":"  assert.deepEqual(skeletonRaw.sources, []);"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":92,"text":"  const skeletonGroups = skeletonRaw.groups;"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":93,"text":"  assert.ok(Array.isArray(skeletonGroups) && isRecord(skeletonGroups[0]));"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":94,"text":"  const skeletonHunks = skeletonGroups[0]?.hunkRefs;"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":95,"text":"  assert.ok(Array.isArray(skeletonHunks) && skeletonHunks.length > 0, \"review skeleton must list hunk refs\");"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":96,"text":"  const groupId = skeletonGroups[0]?.id;"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":97,"text":"  if (typeof groupId !== \"string\") {"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":98,"text":"    throw new Error(\"review skeleton group is missing id\");"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":99,"text":"  }"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":100,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":101,"text":"  const validateOut = execFileSync(bin, [\"validate\", \"--data\", dataPath], {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":102,"text":"    cwd: repo.root,"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":103,"text":"    encoding: \"utf8\","},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":104,"text":"  });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":105,"text":"  assert.match(validateOut, /^ok\\s/);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":106,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":107,"text":"  const child = spawn(bin, [\"serve\", \"--data\", dataPath, \"--port\", \"0\"], {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":108,"text":"    cwd: repo.root,"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":109,"text":"    stdio: [\"ignore\", \"pipe\", \"pipe\"],"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":110,"text":"  });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":111,"text":"  try {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":112,"text":"    const url = await waitForLocalhost(child);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":113,"text":"    const health = await fetch(`${url}/api/health`);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":114,"text":"    assert.equal(health.status, 200);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":115,"text":"    const page = await fetch(url);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":116,"text":"    assert.equal(page.status, 200);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":117,"text":"    const html = await page.text();"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":118,"text":"    assert.match(html, /<div id=\"root\">/);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":119,"text":"  } finally {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":120,"text":"  child.kill(\"SIGTERM\");"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":121,"text":"    await waitForExit(child);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":122,"text":"  }"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":123,"text":""},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":124,"text":"  const outDir = join(work, \"site\");"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":125,"text":"  const exportOut = execFileSync(bin, [\"export\", \"--data\", dataPath, \"--out\", outDir], {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":126,"text":"    cwd: repo.root,"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":127,"text":"    encoding: \"utf8\","},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":128,"text":"  });"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":129,"text":"  assert.equal(existsSync(join(outDir, \"index.html\")), true, \"export must copy the UI\");"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":130,"text":"  assert.equal(existsSync(join(outDir, \"api/review.json\")), true, \"export must write frozen review JSON\");"},{"sha":"4989e245a1e63c5d1629e59ebc5ff201a17874e2","author":"Cursor Agent","timestamp":1787642148,"line":131,"text":"  assert.equal(existsSync(join(outDir, \"api/agent/overview.md\")), true, \"export must write overview agent markdown\");"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":132,"text":"  assert.equal(existsSync(join(outDir, `api/agent/groups/${groupId}.md`)), true, \"export must write group agent markdown\");"},{"sha":"4989e245a1e63c5d1629e59ebc5ff201a17874e2","author":"Cursor Agent","timestamp":1787642148,"line":133,"text":"  const overviewMd = await readFile(join(outDir, \"api/agent/overview.md\"), \"utf8\");"},{"sha":"4989e245a1e63c5d1629e59ebc5ff201a17874e2","author":"Cursor Agent","timestamp":1787642148,"line":134,"text":"  assert.match(overviewMd, /git diff --find-renames/);"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":135,"text":"  assert.match(overviewMd, new RegExp(`\\\\[groups/${groupId}\\\\.md\\\\]\\\\(groups/${groupId}\\\\.md\\\\)`));"},{"sha":"fc3b218dc68b54db2ec50c36f40f47902531f6b3","author":"Cursor Agent","timestamp":1787642506,"line":136,"text":"  assert.doesNotMatch(overviewMd, /@@ -/);"},{"sha":"4989e245a1e63c5d1629e59ebc5ff201a17874e2","author":"Cursor Agent","timestamp":1787642148,"line":137,"text":"  assert.equal(overviewMd.includes(\"+++\"), false, \"agent markdown must not include patch text\");"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":138,"text":"  assert.equal(existsSync(join(outDir, \".git\")), false, \"export must not copy git\");"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":139,"text":"  assert.match(exportOut, /\\/site/);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":140,"text":""},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":141,"text":"  const packedUi = join(installDir, \"node_modules/comprehende/dist/ui\");"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":142,"text":"  const packedManifest = JSON.parse(await readFile(join(packedUi, \"shiki-langs.json\"), \"utf8\")) as {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":143,"text":"    chunks: string[];"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":144,"text":"  };"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":145,"text":"  assert.ok(packedManifest.chunks.length > 20, \"prebuilt UI must keep every highlighter chunk\");"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":146,"text":"  assert.ok("},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":147,"text":"    packedManifest.chunks.every((file) => existsSync(join(packedUi, file))),"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":148,"text":"    \"serve UI must keep unused highlighter files on disk\","},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":149,"text":"  );"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":150,"text":"  assert.ok("},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":151,"text":"    packedManifest.chunks.some((file) => file.includes(\"shiki-lang-python\")),"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":152,"text":"    \"serve UI must still include unused languages such as python\","},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":153,"text":"  );"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":154,"text":""},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":155,"text":"  const exportedManifest = JSON.parse(await readFile(join(outDir, \"shiki-langs.json\"), \"utf8\")) as {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":156,"text":"    chunks: string[];"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":157,"text":"  };"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":158,"text":"  const kept = exportedManifest.chunks.filter((file) => existsSync(join(outDir, file)));"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":159,"text":"  const dropped = exportedManifest.chunks.filter((file) => !existsSync(join(outDir, file)));"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":160,"text":"  assert.ok(kept.some((file) => file.includes(\"shiki-lang-typescript\")), \"export must keep typescript\");"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":161,"text":"  assert.ok(kept.some((file) => file.includes(\"shiki-lang-markdown\")), \"export must keep markdown\");"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":162,"text":"  assert.ok(dropped.some((file) => file.includes(\"shiki-lang-python\")), \"export must drop unused python\");"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":163,"text":"  assert.ok(dropped.length > kept.length, \"export must drop most highlighter files\");"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":164,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":165,"text":"  console.log(\"pack-smoke ok\");"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":166,"text":"}"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":167,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":168,"text":"function waitForLocalhost(child: ReturnType<typeof spawn>): Promise<string> {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":169,"text":"  return new Promise((resolve, reject) => {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":170,"text":"    let stdout = \"\";"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":171,"text":"    let stderr = \"\";"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":172,"text":"    const timer = setTimeout(() => {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":173,"text":"      reject(new Error(`serve timed out\\nstdout:\\n${stdout}\\nstderr:\\n${stderr}`));"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":174,"text":"    }, 15_000);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":175,"text":"    child.stdout?.on(\"data\", (chunk: Buffer) => {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":176,"text":"      stdout += chunk.toString();"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":177,"text":"      const match = stdout.match(/http:\\/\\/127\\.0\\.0\\.1:\\d+/);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":178,"text":"      if (match?.[0] !== undefined) {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":179,"text":"        clearTimeout(timer);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":180,"text":"        resolve(match[0]);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":181,"text":"      }"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":182,"text":"    });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":183,"text":"    child.stderr?.on(\"data\", (chunk: Buffer) => {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":184,"text":"      stderr += chunk.toString();"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":185,"text":"    });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":186,"text":"    child.on(\"error\", (error) => {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":187,"text":"      clearTimeout(timer);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":188,"text":"      reject(error);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":189,"text":"    });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":190,"text":"    child.on(\"exit\", (code) => {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":191,"text":"      if (code !== 0 && code !== null) {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":192,"text":"        clearTimeout(timer);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":193,"text":"        reject(new Error(`serve exited ${code}\\nstdout:\\n${stdout}\\nstderr:\\n${stderr}`));"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":194,"text":"      }"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":195,"text":"    });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":196,"text":"  });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":197,"text":"}"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":198,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":199,"text":"function waitForExit(child: ReturnType<typeof spawn>): Promise<void> {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":200,"text":"  if (child.exitCode !== null) {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":201,"text":"    return Promise.resolve();"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":202,"text":"  }"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":203,"text":"  return new Promise((resolve) => {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":204,"text":"    child.once(\"exit\", () => resolve());"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":205,"text":"  });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":206,"text":"}"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":207,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":208,"text":"function isRecord(value: unknown): value is Record<string, unknown> {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":209,"text":"  return typeof value === \"object\" && value !== null && !Array.isArray(value);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":210,"text":"}"}]}
