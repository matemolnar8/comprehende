okFor, []);"},{"sha":"3d120347ff1a85ae0e78ab94c4ed1c25b3168da2","author":"Cursor Agent","timestamp":1790106806,"line":63,"text":"    assert.deepEqual(raw.sources, []);"},{"sha":"3d120347ff1a85ae0e78ab94c4ed1c25b3168da2","author":"Cursor Agent","timestamp":1790106806,"line":64,"text":"    assert.deepEqual(raw.parts, []);"},{"sha":"3d120347ff1a85ae0e78ab94c4ed1c25b3168da2","author":"Cursor Agent","timestamp":1790106806,"line":65,"text":"    const group = document.groups[0];"},{"sha":"3d120347ff1a85ae0e78ab94c4ed1c25b3168da2","author":"Cursor Agent","timestamp":1790106806,"line":66,"text":"    assert.deepEqual(group?.lookFor, []);"},{"sha":"3d120347ff1a85ae0e78ab94c4ed1c25b3168da2","author":"Cursor Agent","timestamp":1790106806,"line":67,"text":"    assert.deepEqual(group?.dependsOn, []);"},{"sha":"3d120347ff1a85ae0e78ab94c4ed1c25b3168da2","author":"Cursor Agent","timestamp":1790106806,"line":68,"text":"    assert.deepEqual(group?.sources, []);"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":69,"text":"    assert.deepEqual(document.groups[0]?.hunkRefs, index.hunks.map(toHunkRef));"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":70,"text":"    assert.equal(document.groups[0]?.hunkRefs.length, index.hunks.length);"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":71,"text":"    assert.deepEqual(validated.document, document);"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":72,"text":"  });"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":73,"text":"});"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":74,"text":""},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":75,"text":"functio