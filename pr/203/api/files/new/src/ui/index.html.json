{"path":"src/ui/index.html","ref":"7013656b0c46cb764980c91fea0358e3414ab683","side":"new","content":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Comprehende</title>\n    <base href=\"./\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"./favicon.svg\" />\n    <script>\n      // Mirrors THEME_STORAGE_KEY in src/ui/lib/theme.ts. Runs before the bundle loads, so it cannot import it.\n      (() => {\n        let stored = null;\n        try {\n          stored = localStorage.getItem(\"comprehende.theme\");\n        } catch {\n          // Storage is blocked: follow the system.\n        }\n        const prefersDark = window.matchMedia(\"(prefers-color-scheme: dark)\").matches;\n        const dark = stored === \"dark\" || (stored !== \"light\" && prefersDark);\n        document.documentElement.classList.toggle(\"dark\", dark);\n        document.documentElement.style.colorScheme = dark ? \"dark\" : \"light\";\n      })();\n    </script>\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"./main.tsx\"></script>\n  </body>\n</html>\n","language":"html"}
