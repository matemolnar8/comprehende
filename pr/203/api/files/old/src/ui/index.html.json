{"path":"src/ui/index.html","ref":"7397a98caabcef2ae34ea2721b6cdf59ebc4bed1","side":"old","content":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Comprehende</title>\n    <base href=\"./\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"./favicon.svg\" />\n    <script>\n      // Mirrors THEME_STORAGE_KEY in src/ui/lib/theme.ts. Runs before the bundle loads, so it cannot import it.\n      (() => {\n        try {\n          const stored = localStorage.getItem(\"comprehende.theme\");\n          const prefersDark = window.matchMedia(\"(prefers-color-scheme: dark)\").matches;\n          const dark = stored === \"dark\" || (stored !== \"light\" && prefersDark);\n          document.documentElement.classList.toggle(\"dark\", dark);\n          document.documentElement.style.colorScheme = dark ? \"dark\" : \"light\";\n        } catch {\n          // private mode\n        }\n      })();\n    </script>\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"./main.tsx\"></script>\n  </body>\n</html>\n","language":"html"}
