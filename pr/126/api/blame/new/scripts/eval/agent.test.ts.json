SOR_RIPGREP_PATH;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":26,"text":"    try {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":27,"text":"      const path = configureSdkRipgrep();"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":28,"text":"      assert.ok(path);"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":29,"text":"      assert.equal(process.env.CURSOR_RIPGREP_PATH, path);"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":30,"text":"      assert.equal(isAbsolute(path), true);"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":31,"text":"      accessSync(path, constants.X_OK);"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":32,"text":"      const version = spawnSync(path, [\"--version\"], { encoding: \"utf8\" });"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":33,"text":"      assert.equal(version.status, 0);"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":34,"text":"      assert.match(version.stdout, /ripgrep/);"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":35,"text":"      configureSdkRipgrep();"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":36,"text":"      assert.equal(process.env.CURSOR_RIPGREP_PATH, path);"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":37,"text":"    } finally {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":38,"text":"      if (previous === undefined) {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":39,"text":"        delete process.env.CURSOR_RIPGREP_PATH;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":40,"text":"      } else {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":41,"text":"        process.env.CURSOR_RIPGREP_PATH = previous;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":42,"text":"      }"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":43,"text":"    }"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":44,"text":"  });"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":45,"text":"});"}]}
