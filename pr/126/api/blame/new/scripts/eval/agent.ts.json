{"path":"scripts/eval/agent.ts","ref":"fc810024da4c98cba58061aafa6fa182a580aef2","side":"new","lines":[{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":1,"text":"import { accessSync, constants, readFileSync, realpathSync } from \"node:fs\";"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":2,"text":"import { createRequire } from \"node:module\";"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":3,"text":"import { dirname, isAbsolute, join } from \"node:path\";"},{"sha":"cd8c738cce16c865125042bac4a6a5e85a13e364","author":"Cursor Agent","timestamp":1790362168,"line":4,"text":"import { Agent, type ConversationStep, type ModelSelection, type ToolName } from \"@cursor/sdk\";"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":5,"text":"import { TASK_TIMEOUT_MS } from \"./constants.ts\";"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":6,"text":""},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":7,"text":"const require = createRequire(import.meta.url);"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":8,"text":""},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":9,"text":"/**"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":10,"text":" * Absolute path to a real rg. `@cursor/sdk` does not export `configureRipgrepPath`."},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":11,"text":" * On local startup it reads `CURSOR_RIPGREP_PATH` and passes that path to the function."},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":12,"text":" * Without it, ignore scans log \"Ripgrep path not configured\" when rg is not on PATH."},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":13,"text":" */"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":14,"text":"export function configureSdkRipgrep(): string | undefined {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":15,"text":"  const current = process.env.CURSOR_RIPGREP_PATH;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":16,"text":"  if (current !== undefined && isAbsolute(current) && executableFile(current) !== undefined) {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":17,"text":"    return current;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":18,"text":"  }"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":19,"text":"  const sdkDir = cursorSdkDir();"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":20,"text":"  const bundled = sdkDir === undefined ? undefined : bundledRipgrep(sdkDir);"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":21,"text":"  if (bundled === undefined) {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":22,"text":"    return undefined;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":23,"text":"  }"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":24,"text":"  process.env.CURSOR_RIPGREP_PATH = bundled;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":25,"text":"  return bundled;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":26,"text":"}"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":27,"text":""},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":28,"text":"function cursorSdkDir(): string | undefined {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":29,"text":"  let dir: string;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":30,"text":"  try {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":31,"text":"    dir = dirname(realpathSync(require.resolve(\"@cursor/sdk\")));"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":32,"text":"  } catch {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":33,"text":"    return undefined;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":34,"text":"  }"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":35,"text":"  for (;;) {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":36,"text":"    if (readPackageName(dir) === \"@cursor/sdk\") {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":37,"text":"      return dir;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":38,"text":"    }"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":39,"text":"    const parent = dirname(dir);"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":40,"text":"    if (parent === dir) {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":41,"text":"      return undefined;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":42,"text":"    }"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":43,"text":"    dir = parent;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":44,"text":"  }"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":45,"text":"}"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":46,"text":""},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":47,"text":"function bundledRipgrep(sdkDir: string): string | undefined {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":48,"text":"  const binary = process.platform === \"win32\" ? \"rg.exe\" : \"rg\";"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":49,"text":"  const pkg = `@cursor/sdk-${process.platform}-${process.arch}`;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":50,"text":"  try {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":51,"text":"    const fromSdk = createRequire(join(sdkDir, \"package.json\"));"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":52,"text":"    const pkgJson = fromSdk.resolve(`${pkg}/package.json`);"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":53,"text":"    const resolved = executableFile(join(dirname(pkgJson), \"bin\", binary));"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":54,"text":"    if (resolved !== undefined) {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":55,"text":"      return resolved;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":56,"text":"    }"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":57,"text":"  } catch {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":58,"text":"    // pnpm links the optional platform package beside @cursor/sdk, outside Node lookup."},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":59,"text":"  }"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":60,"text":"  const folder = `sdk-${process.platform}-${process.arch}`;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":61,"text":"  return executableFile(join(dirname(sdkDir), folder, \"bin\", binary));"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":62,"text":"}"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":63,"text":""},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":64,"text":"function executableFile(path: string): string | undefined {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":65,"text":"  try {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":66,"text":"    accessSync(path, constants.X_OK);"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":67,"text":"    return realpathSync(path);"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":68,"text":"  } catch {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":69,"text":"    return undefined;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":70,"text":"  }"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":71,"text":"}"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":72,"text":""},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":73,"text":"function readPackageName(dir: string): string | undefined {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":74,"text":"  let parsed: unknown;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":75,"text":"  try {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":76,"text":"    parsed = JSON.parse(readFileSync(join(dir, \"package.json\"), \"utf8\"));"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":77,"text":"  } catch {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":78,"text":"    return undefined;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":79,"text":"  }"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":80,"text":"  if (typeof parsed !== \"object\" || parsed === null || !(\"name\" in parsed)) {"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":81,"text":"    return undefined;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":82,"text":"  }"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":83,"text":"  return typeof parsed.name === \"string\" ? parsed.name : undefined;"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":84,"text":"}"},{"sha":"fc810024da4c98cba58061aafa6fa182a580aef2","author":"Cursor Agent","timestamp":1790498289,"line":85,"text":""},{"sha":"94cb4481550de0078f0e6593b69fa3d52c5730a9","author":"Máté Molnár","timestamp":1790081755,"line":86,"text":"export type ToolCallRecord = {"},{"sha":"94cb4481550de0078f0e6593b69fa3d52c5730a9","author":"Máté Molnár","timestamp":1790081755,"line":87,"text":"  name: string;"},{"sha":"94cb4481550de0078f0e6593b69fa3d52c5730a9","author":"Máté Molnár","timestamp":1790081755,"line":88,"text":"  detail?: string;"},{"sha":"94cb4481550de0078f0e6593b69fa3d52c5730a9","author":"Máté Molnár","timestamp":1790081755,"line":89,"text":"};"},{"sha":"94cb4481550de0078f0e6593b69fa3d52c5730a9","author":"Máté Molnár","timestamp":1790081755,"line":90,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":91,"text":"export type AgentRunResult = {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":92,"text":"  text: string;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":93,"text":"  status: \"finished\" | \"error\" | \"cancelled\";"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestam