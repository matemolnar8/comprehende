5125042bac4a6a5e85a13e364","author":"Cursor Agent","timestamp":1790362168,"line":108,"text":"    return { id };"},{"sha":"cd8c738cce16c865125042bac4a6a5e85a13e364","author":"Cursor Agent","timestamp":1790362168,"line":109,"text":"  }"},{"sha":"cd8c738cce16c865125042bac4a6a5e85a13e364","author":"Cursor Agent","timestamp":1790362168,"line":110,"text":"  const params = rest.split(\",\").map((pair) => {"},{"sha":"cd8c738cce16c865125042bac4a6a5e85a13e364","author":"Cursor Agent","timestamp":1790362168,"line":111,"text":"    const [key, value] = pair.split(\"=\", 2);"},{"sha":"cd8c738cce16c865125042bac4a6a5e85a13e364","author":"Cursor Agent","timestamp":1790362168,"line":112,"text":"    if (key === undefined || key === \"\" || value === undefined || value === \"\") {"},{"sha":"cd8c738cce16c865125042bac4a6a5e85a13e364","author":"Cursor Agent","timestamp":1790362168,"line":113,"text":"      throw new Error(`model param must be key=value, got \"${pair}\" in \"${spec}\"`);"},{"sha":"cd8c738cce16c865125042bac4a6a5e85a13e364","author":"Cursor Agent","timestamp":1790362168,"line":114,"text":"    }"},{"sha":"cd8c738cce16c865125042bac4a6a5e85a13e364","author":"Cursor Agent","timestamp":1790362168,"line":115,"text":"    return { id: key, value };"},{"sha":"cd8c738cce16c865125042bac4a6a5e85a13e364","author":"Cursor Agent","timestamp":1790362168,"line":116,"text":"  });"},{"sha":"cd8c738cce16c865125042bac4a6a5e85a13e364","author":"Cursor Agent","timestamp":1790362168,"line":117,"text":"  return { id, params };"},{"sha":"cd8c738cce16c865125042bac4a6a5e85a13e364","author":"Cursor Agent","timestamp":1790362168,"line":118,"text":"}"},{"sha":"cd8c738cce16c865125042bac4a6a5e85a13e364","author":"Cursor Agent","timestamp":1790362168,"line":119,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":120,"text":"export async function runLocalAgent(opts: {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","time