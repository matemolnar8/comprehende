 {"},{"kind":"add","oldNumber":null,"newNumber":39,"text":"        delete process.env.CURSOR_RIPGREP_PATH;"},{"kind":"add","oldNumber":null,"newNumber":40,"text":"      } else {"},{"kind":"add","oldNumber":null,"newNumber":41,"text":"        process.env.CURSOR_RIPGREP_PATH = previous;"},{"kind":"add","oldNumber":null,"newNumber":42,"text":"      }"},{"kind":"add","oldNumber":null,"newNumber":43,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":44,"text":"  });"},{"kind":"add","oldNumber":null,"newNumber":45,"text":"});"}]}],"files":[{"path":"scripts/eval/agent.ts","kind":"text","status":"modified","patch":"diff --git a/scripts/eval/agent.ts b/scripts/eval/agent.ts\nindex bbf5cfd..6e59b95 100644\n--- a/scripts/eval/agent.ts\n+++ b/scripts/eval/agent.ts\n@@ -1,6 +1,88 @@\n+import { accessSync, constants, readFileSync, realpathSync } from \"node:fs\";\n+import { createRequire } from \"node:module\";\n+import { dirname, isAbsolute, join } from \"node:path\";\n import { Agent, type ConversationStep, type ModelSelection, type ToolName } from \"@cursor/sdk\";\n import { TASK_TIMEOUT_MS } from \"./constants.ts\";\n \n+const require = createRequire(import.meta.url);\n+\n+/**\n+ * Absolute path to a real rg. `@cursor/sdk` does not export `configureRipgrepPath`.\n+ * On local startup it reads `CURSOR_RIPGREP_PATH` and passes that path to the function.\n+ * Without it, ignore scans log \"Ripgrep path not configured\" when rg is not on PATH.\n+ */\n+export function configureSdkRipgrep(): string | undefined {\n+  const current = process.env.CURSOR_RIPGREP_PATH;\n+  if (current !== undefined && isAbsolute(current) && executableFile(current) !== undefined) {\n+    return current;\n+  }\n+  const sdkDir = cursorSdkDir();\n+  const bundled = sdkDir === undefined ? undefined : bundledRipgrep(sdkDir);\n+  if (bundled === undefined) {\n+    return undefined;\n+  }\n+  process.env.CURSOR_RIPGREP_PATH = bundled;\n+  return bundled;\n+}\n+\n+function cursorSdkDir(): string | undefined {\n+  let dir: string;\n+  try {\n+    dir = dirname(realpathSync(require.resolve(\"@cursor/sdk\")));\n+  } catch {\n+    return undefined;\n+  }\n+  for (;;) {\n+    if (readPackageName(dir) === \"@cursor/sdk\") {\n+      return dir;\n+    }\n+    const parent = dirname(dir);\n+    if (parent === dir) {\n+      return undefined;\n+    }\n+    dir = parent;\n+  }\n+}\n+\n+function bundledRipgrep(sdkDir: string): string | undefined {\n+  const binary = process.platform === \"win32\" ? \"rg.exe\" : \"rg\";\n+  const pkg = `@cursor/sdk-${process.platform}-${process.arch}`;\n+  try {\n+    const fromSdk = createRequire(join(sdkDir, \"package.json\"));\n+    const pkgJson = fromSdk.resolve(`${pkg}/package.json`);\n+    const resolved = executableFile(join(dirname(pkgJson), \"bin\", binary));\n+    if (resolved !== undefined) {\n+      return resolved;\n+    }\n+  } catch {\n+    // pnpm links the optional platform package beside @cursor/sdk, outside Node lookup.\n+  }\n+  const folder = `sdk-${process.platform}-${process.arch}`;\n+  return executableFile(join(dirname(sdkDir), folder, \"bin\", binary));\n+}\n+\n+function executableFile(path: string): string | undefined {\n+  try {\n+    accessSync(path, constants.X_OK);\n+    return realpathSync(path);\n+  } catch {\n+    return undefined;\n+  }\n+}\n+\n+function readPackageName(dir: string): string | undefined {\n+  let parsed: unknown;\n+  try {\n+    parsed = JSON.parse(readFileSync(join(dir, \"package.json\"), \"utf8\"));\n+  } catch {\n+    return undefined;\n+  }\n+  if (typeof parsed !== \"object\" || parsed === null || !(\"name\" in parsed)) {\n+    return undefined;\n+  }\n+  return typeof parsed.name === \"string\" ? parsed.name : undefined;\n+}\n+\n export type ToolCallRecord = {\n   name: string;\n   detail?: string;\n@@ -46,6 +128,7 @@ export async function runLocalAgent(opts: {\n   timeoutMs?: number;\n }): Promise<AgentRunResult> {\n   const timeoutMs = opts.timeoutMs ?? TASK_TIMEOUT_MS;\n+  configureSdkRipgrep();\n   await using agent = await Agent.create({\n     apiKey: opts.apiKey,\n     name: \"comprehende-eval\",\n","complete":true,"hunks":[{"path":"scripts/eval/agent.ts","oldStart":1,"oldLines":6,"newStart":1,"newLines":88,"header":"@@ -1,6 +1,88 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import { accessSync, constants, readFileSync, realpathSync } from \"node:fs\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import { createRequire } from \"node:module\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import { dirname, isAbsolute, join } from \"node:path\";"},{"kind":"ctx","oldNumber":1,"newNumber":4,"text":"import { Agent, type ConversationStep, type ModelSelection, type ToolName } from \"@cursor/sdk\";"},{"kind":"ctx","oldNumber":2,"newNumber":5,"text":"import { TASK_TIMEOUT_MS } from \"./constants.ts\";"},{"kind":"ctx","oldNumber":3,"newNumber":6,"text":""},{"kind":"add","oldNumber":null,"newNumber":7,"text":"const require = createRequire(import.meta.url);"},{"kind":"add","oldNumber":null,"newNumber":8,"text":""},{"kind":"add","oldNumber":null,"newNumber":9,"text":"/**"},{"kind":"add","oldNumber":null,"newNumber":10,"text":" * Absolute path to a real rg. `@cursor/sdk` does not export `configureRipgrepPath`."},{"kind":"add","oldNumber":null,"newNumber":11,"text":" * On local startup it reads `CURSOR_RIPGREP_PATH` and passes that path to the function."},{"kind":"add","oldNumber":null,"newNumber":12,"text":" * Without it, ignore scans log \"Ripgrep path not configured\" when rg is not on PATH."},{"kind":"add","oldNumber":null,"newNumber":13,"text":" */"},{"kind":"add","oldNumber":null,"newNumber":14,"text":"export function configureSdkRipgrep(): string | undefined {"},{"kind":"add","oldNumber":null,"newNumber":15,"text":"  const current = process.env.CURSOR_RIPGREP_PATH;"},{"kind":"add","oldNumber":null,"newNumber":16,"text":"  if (current !== undefined && isAbsolute(current) && executableFil