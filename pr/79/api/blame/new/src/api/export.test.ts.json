ual(liveShell.status, 200);"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":64,"text":"    assert.equal(frozenShell.status, 200);"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":65,"text":"    assert.equal(await liveShell.text(), await frozenShell.text());"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":66,"text":""},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":67,"text":"    const resources = listResources(ctx);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":68,"text":"    assert.ok(resources.length > 4);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":69,"text":""},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":70,"text":"    for (const resource of resources) {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":71,"text":"      const href = new URL(apiHref(resource), `${live.url}/`).href;"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":72,"text":"      const liveRes = await fetch(href);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":73,"text":"      const frozenRes = await fetch(new URL(apiHref(resource), `${frozen.url}/`).href);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":74,"text":"      assert.equal(frozenRes.status, liveRes.status, `${apiHref(resource)} status`);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":75,"text":"      if (liveRes.status !== 200) {"},{"sha":"af78242f