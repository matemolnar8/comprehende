{"path":"src/ui/lib/selection.ts","ref":"4779db00491f81c01848be0c1a452efe167232e8","side":"new","lines":[{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":1,"text":"import { REVIEW_BUCKETS, type ReviewBucket } from \"../../api/types.ts\";"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":2,"text":"import { padIndex } from \"../../schema/types.ts\";"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":3,"text":"import type { ReviewMeta } from \"../api.ts\";"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":4,"text":"import { groupOrderIndex, groupParts, isMixedReview, type PartGroup } from \"./parts.ts\";"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":5,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":6,"text":"export type Selection = { kind: \"overview\" } | { kind: \"group\"; id: string } | { kind: ReviewBucket };"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":7,"text":""},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":8,"text":"export type SelectionStackSource = {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":9,"text":"  groups: PartGroup[];"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":10,"text":"  unassigned: { hunkCount: number };"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":11,"text":"  lockfiles?: { fileCount: number };"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":12,"text":"};"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":13,"text":""},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":14,"text":"export type PartShiftSource = {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":15,"text":"  groups: PartGroup[];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":16,"text":"};"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":17,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":18,"text":"export function defaultSelection(source: SelectionStackSource): Selection {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":19,"text":"  if (source.groups.length > 0) {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":20,"text":"    return { kind: \"overview\" };"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":21,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":22,"text":"  return { kind: REVIEW_BUCKETS.unassigned };"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":23,"text":"}"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":24,"text":""},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":25,"text":"const GROUP_HASH_PREFIX = \"group/\";"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":26,"text":""},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":27,"text":"export function parseHash(hash: string): Selection | null {"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":28,"text":"  const trimmed = hash.startsWith(\"#\") ? hash.slice(1) : hash;"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":29,"text":"  const path = trimmed.replace(/^\\/+/, \"\");"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":30,"text":"  if (path === \"\") {"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":31,"text":"    return null;"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":32,"text":"  }"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":33,"text":"  if (path === \"overview\") {"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":34,"text":"    return { kind: \"overview\" };"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":35,"text":"  }"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":36,"text":"  if (path === REVIEW_BUCKETS.unassigned) {"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":37,"text":"    return { kind: REVIEW_BUCKETS.unassigned };"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":38,"text":"  }"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":39,"text":"  if (path === REVIEW_BUCKETS.lockfiles) {"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":40,"text":"    return { kind: REVIEW_BUCKETS.lockfiles };"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":41,"text":"  }"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":42,"text":"  if (!path.startsWith(GROUP_HASH_PREFIX)) {"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":43,"text":"    return null;"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":44,"text":"  }"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":45,"text":"  const rawId = path.slice(GROUP_HASH_PREFIX.length);"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":46,"text":"  if (rawId === \"\") {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":47,"text":"    return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":48,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":49,"text":"  try {"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":50,"text":"    const id = decodeURIComponent(rawId);"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":51,"text":"    if (id === \"\") {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":52,"text":"      return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":53,"text":"    }"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":54,"text":"    return { kind: \"group\", id };"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":55,"text":"  } catch {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":56,"text":"    return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":57,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":58,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":59,"text":""},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":60,"text":"export function serializeHash(selection: Selection): string {"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":61,"text":"  if (selection.kind === \"group\") {"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":62,"text":"    return `#${GROUP_HASH_PREFIX}${encodeURIComponent(selection.id)}`;"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":63,"text":"  }"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":64,"text":"  if (selection.kind === \"overview\") {"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":65,"text":"    return \"#overview\";"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":66,"text":"  }"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":67,"text":"  return `#${selection.kind}`;"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":68,"text":"}"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":69,"text":""},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":70,"text":"export function selectionFromHash(source: SelectionStackSource, hash: string): Selection {"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":71,"text":"  return restoreSelection(source, parseHash(hash));"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":72,"text":"}"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":73,"text":""},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":74,"text":"export function urlWithSelection(href: string, selection: Selection): string {"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":75,"text":"  const url = new URL(href);"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":76,"text":"  url.hash = serializeHash(selection);"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":77,"text":"  return url.href;"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":78,"text":"}"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":79,"text":""},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":80,"text":"export function hashWriteMode("},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":81,"text":"  source: SelectionStackSource,"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":82,"text":"  currentHash: string,"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":83,"text":"  selection: Selection,"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":84,"text":"  initialized: boolean,"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":85,"text":"): \"skip\" | \"replace\" | \"push\" {"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":86,"text":"  const parsed = parseHash(currentHash);"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":87,"text":"  if (parsed !== null && sameSelection(parsed, selection)) {"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":88,"text":"    return \"skip\";"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":89,"text":"  }"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":90,"text":"  const parsedIsLive = parsed !== null && sameSelection(restoreSelection(source, parsed), parsed);"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":91,"text":"  if (!initialized || !parsedIsLive) {"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":92,"text":"    return \"replace\";"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":93,"text":"  }"},{"sha":"4779db00491f81c01848be0c1a452efe167232e8","author":"Cursor Agent","timestamp":1789295672,"line":94,"text":"  return \"push\";"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":95,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":96,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":97,"text":"export function restoreSelection(source: SelectionStackSource, stored: Selection | null): Selection {"},{"sha":"b5e2c3e0733d804aee4f4adf06766621138e3c78","author":"Máté Molnár","timestamp":1788535976,"line":98,"text":"  // Invariant: unknown or missing buckets fall back to the default selection."},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":99,"text":"  if (stored === null) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":100,"text":"    return defaultSelection(source);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":101,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":102,"text":"  if (stored.kind === \"group\" && !source.groups.some((group) => group.id === stored.id)) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":103,"text":"    return defaultSelection(source);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":104,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":105,"text":"  if (stored.kind === REVIEW_BUCKETS.unassigned && source.unassigned.hunkCount === 0 && source.groups.length > 0) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":106,"text":"    return defaultSelection(source);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":107,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":108,"text":"  if (stored.kind === REVIEW_BUCKETS.lockfiles && (source.lockfiles?.fileCount ?? 0) === 0) {"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":109,"text":"    return defaultSelection(source);"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":110,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":111,"text":"  return stored;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":112,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":113,"text":""},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":114,"text":"/** Overview, then groups in part / dependsOn order. Unassigned and lockfiles stay off this walk. */"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":115,"text":"export function groupWalk(source: SelectionStackSource): Selection[] {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":116,"text":"  const parts = groupParts(source.groups);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":117,"text":"  return ["},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":118,"text":"    { kind: \"overview\" },"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":119,"text":"    ...parts.flatMap((part) => part.groupIds.map((id) => ({ kind: \"group\" as const, id }))),"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":120,"text":"  ];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":121,"text":"}"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":122,"text":""},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":123,"text":"export function selectionStack(source: SelectionStackSource): Selection[] {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":124,"text":"  const ids = groupWalk(source);"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":125,"text":"  if (source.unassigned.hunkCount > 0) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":126,"text":"    ids.push({ kind: REVIEW_BUCKETS.unassigned });"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":127,"text":"  }"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":128,"text":"  if ((source.lockfiles?.fileCount ?? 0) > 0) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":129,"text":"    ids.push({ kind: REVIEW_BUCKETS.lockfiles });"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":130,"text":"  }"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":131,"text":"  return ids;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":132,"text":"}"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":133,"text":""},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":134,"text":"export function neighborSelection("},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":135,"text":"  source: SelectionStackSource | null,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":136,"text":"  selection: Selection | null,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":137,"text":"  delta: number,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":138,"text":"): Selection | undefined {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":139,"text":"  if (source === null || delta === 0) {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":140,"text":"    return undefined;"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":141,"text":"  }"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":142,"text":"  const walk = groupWalk(source);"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":143,"text":"  const current = walk.findIndex((item) => sameSelection(item, selection));"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":144,"text":"  if (current >= 0) {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":145,"text":"    return walk[current + delta];"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":146,"text":"  }"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":147,"text":"  if (delta < 0) {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":148,"text":"    return walk[walk.length - 1];"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":149,"text":"  }"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":150,"text":"  return undefined;"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":151,"text":"}"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":152,"text":""},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":153,"text":"export function shiftSelection("},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":154,"text":"  source: SelectionStackSource | null,"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":155,"text":"  selection: Selection | null,"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":156,"text":"  setSelection: (selection: Selection) => void,"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":157,"text":"  delta: number,"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":158,"text":"): void {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":159,"text":"  const next = neighborSelection(source, selection, delta);"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":160,"text":"  if (next !== undefined) {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":161,"text":"    setSelection(next);"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":162,"text":"  }"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":163,"text":"}"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":164,"text":""},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":165,"text":"export function shiftPartSelection("},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":166,"text":"  meta: PartShiftSource | null,"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":167,"text":"  selection: Selection | null,"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":168,"text":"  setSelection: (selection: Selection) => void,"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":169,"text":"  delta: number,"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":170,"text":"): void {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":171,"text":"  if (meta === null || selection === null || selection.kind === REVIEW_BUCKETS.unassigned || selection.kind === REVIEW_BUCKETS.lockfiles) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":172,"text":"    return;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":173,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":174,"text":"  const parts = groupParts(meta.groups);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":175,"text":"  if (!isMixedReview(parts)) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":176,"text":"    return;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":177,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":178,"text":"  const current ="},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":179,"text":"    selection.kind === \"group\" ? parts.findIndex((part) => part.groupIds.includes(selection.id)) : delta > 0 ? -1 : parts.length;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":180,"text":"  if (selection.kind === \"group\" && current < 0) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":181,"text":"    return;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":182,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":183,"text":"  const next = parts[(current + delta + parts.length) % parts.length];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":184,"text":"  const id = next?.groupIds[0];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":185,"text":"  if (id !== undefined && (selection.kind !== \"group\" || id !== selection.id)) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":186,"text":"    setSelection({ kind: \"group\", id });"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":187,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":188,"text":"}"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":189,"text":""},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":190,"text":"export function sameSelection(a: Selection, b: Selection | null): boolean {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":191,"text":"  if (b === null) {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":192,"text":"    return false;"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":193,"text":"  }"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":194,"text":"  if (a.kind === \"overview\") {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":195,"text":"    return b.kind === \"overview\";"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":196,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":197,"text":"  if (a.kind === REVIEW_BUCKETS.unassigned) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":198,"text":"    return b.kind === REVIEW_BUCKETS.unassigned;"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":199,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":200,"text":"  if (a.kind === REVIEW_BUCKETS.lockfiles) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":201,"text":"    return b.kind === REVIEW_BUCKETS.lockfiles;"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":202,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":203,"text":"  return a.kind === \"group\" && b.kind === \"group\" && b.id === a.id;"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":204,"text":"}"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":205,"text":""},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":206,"text":"export function selectionNavLabel("},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":207,"text":"  meta: Pick<ReviewMeta, \"document\" | \"groups\">,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":208,"text":"  selection: Selection,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":209,"text":"): string {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":210,"text":"  const caption = selectionCaption(meta, selection);"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":211,"text":"  return caption.index !== undefined ? `${caption.index} ${caption.title}` : caption.title;"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":212,"text":"}"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":213,"text":""},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":214,"text":"export function selectionCaption("},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":215,"text":"  meta: Pick<ReviewMeta, \"document\" | \"groups\">,"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":216,"text":"  selection: Selection | null,"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":217,"text":"): { index?: string; title: string } {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":218,"text":"  if (selection === null || selection.kind === \"overview\") {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":219,"text":"    return { title: \"Overview\" };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":220,"text":"  }"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":221,"text":"  if (selection.kind === \"group\") {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":222,"text":"    const parts = groupParts(meta.groups);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":223,"text":"    const index = groupOrderIndex(parts, selection.id);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":224,"text":"    const group = meta.groups.find((item) => item.id === selection.id);"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":225,"text":"    return {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":226,"text":"      index: index > 0 ? padIndex(index) : undefined,"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":227,"text":"      title: group?.title ?? \"Group\","},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":228,"text":"    };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":229,"text":"  }"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":230,"text":"  if (selection.kind === REVIEW_BUCKETS.unassigned) {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":231,"text":"    return { title: \"Unassigned\" };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":232,"text":"  }"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":233,"text":"  return { title: \"Lockfiles\" };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":234,"text":"}"}]}
