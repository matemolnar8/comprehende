{"sha":"8febfe58216a23b69f9e3f57c08518a67bafe9d4","author":"Cursor Agent","timestamp":1789938724,"line":25,"text":"  dataPath: string,"},{"sha":"8febfe58216a23b69f9e3f57c08518a67bafe9d4","author":"Cursor Agent","timestamp":1789938724,"line":26,"text":"  base: string | undefined,"},{"sha":"8febfe58216a23b69f9e3f57c08518a67bafe9d4","author":"Cursor Agent","timestamp":1789938724,"line":27,"text":"  head: string | undefined,"},{"sha":"8febfe58216a23b69f9e3f57c08518a67bafe9d4","author":"Cursor Agent","timestamp":1789938724,"line":28,"text":"): Promise<{ document: ReviewDocument; index: HunkIndex }> {"},{"sha":"8febfe58216a23b69f9e3f57c08518a67bafe9d4","author":"Cursor Agent","timestamp":1789938724,"line":29,"text":"  const index = await cmdIndex(cwd, base, head);"},{"sha":"8febfe58216a23b69f9e3f57c08518a67bafe9d4","author":"Cursor Agent","timestamp":1789938724,"line":30,"text":"  const document = skeletonDocument(index);"},{"sha":"8febfe58216a23b69f9e3f57c08518a67bafe9d4","author":"Cursor Agent","timestamp":1789938724,"line":31,"text":"  await mkdir(dirname(dataPath), { recursive: true });"},{"sha":"8febfe58216a23b69f9e3f57c08518a67bafe9d4","author":"Cursor Agent","timestamp":1789938724,"line":32,"text":"  await writeFile(dataPath, `${JSON.stringify(document, null, 2)}\\n`);"},{"sha":"8febfe58216a23b69f9e3f57c08518a67bafe9d4","author":"Cursor Agent","timestamp":1789938724,"line":33,"text":"  await cmdValidate(cwd, dataPath);"},{"sha":"8febfe58216a23b69f9e3f57c08518a67bafe9d4","author":"Cursor Agent","timestamp":1789938724,"line":34,"text":"  return { document, index };"},{"sha":"8febfe58216a23b69f9e3f57c08518a67bafe9d4","author":"Cursor Agent","timestamp":1789938724,"line":35,"text":"}"},{"sha":"8febfe58216a23b69f9e3f57c08518a67bafe9d4","author":"Cursor Agent","timestamp":1789938724,"line":36,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":37,"text":"export async function cmdValidate(cwd: string, dataPath: string): Promise<{ document: ReviewDocument; warnings: string[] }> {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":38,"text":"  const document = await loadDocument(dataPath);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":39,"text":"  const resolved = await resolveSource(cwd, document.source.baseRef, document.source.headRef);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":40,"text":"  const { coverage } = await coverReview(cwd, document);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":41,"text":"  const pins = await staleCommentPins(cwd, document, resolved);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":42,"text":"  const errors = [...coverageErrors(coverage), ...sourceCitationErrors(document), ...commentPinErrors(pins)];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":43,"text":"  if (errors.length > 0) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":44,"text":"    throw new Error(errors.join(\"\\n\\n\"));"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":45,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":46,"text":"  return { document, warnings: [] };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":47,"text":"}"}]}
