12024","author":"Cursor Agent","timestamp":1787035272,"line":14,"text":"      out?: string;"},{"sha":"0e0d85039c547ae5207b51e5ada8ed67e877e607","author":"Cursor Agent","timestamp":1789286146,"line":15,"text":"      from?: string;"},{"sha":"0e0d85039c547ae5207b51e5ada8ed67e877e607","author":"Cursor Agent","timestamp":1789286146,"line":16,"text":"      to?: string;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":17,"text":"      port: number;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":18,"text":"      open: boolean;"},{"sha":"0e0d85039c547ae5207b51e5ada8ed67e877e607","author":"Cursor Agent","timestamp":1789286146,"line":19,"text":"      json: boolean;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":20,"text":"    };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":21,"text":""},{"sha":"0e0d85039c547ae5207b51e5ada8ed67e877e607","author":"Cursor Agent","timestamp":1789286146,"line":22,"text":"const COMMANDS: ReadonlySet<string> = new Set<CommandName>([\"index\", \"validate\", \"serve\", \"export\", \"compare\"]);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":23,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":24,"text":"export const DEFAULT_PORT = 4567;"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":25,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":26,"text":"export class ArgError extends Error {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":27,"text":"  constructor(message: string) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":28,"text":"    super(message);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":29,"text":"    this.name = \"ArgError\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":30,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":31,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":32,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":33,"text":"export const USAGE = `Usage: comprehende <command> [options]"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":34,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":35,"text":"Run inside the git repository under review. Cwd is the repo."},{"sha":"0e0d85039c547ae5207b51e5ada8ed67e877e607","author":"Cursor Agent","timestamp":1789286146,"line":36,"text":"compare reads two review documents from any directory."},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":37,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":38,"text":"Commands:"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":39,"text":"  index     [--base <ref>] [--head <ref>]"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":40,"text":"            List hunk refs from live git (no patch text)"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":41,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":42,"text":"  validate  --data <review.json>"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":43,"text":"            Check schema, ref resolution, hunk coverage, and source citations"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":44,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":45,"text":"  serve     --data <review.json> [--port <n>] [--open]"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":46,"text":"            Serve the local UI on 127.0.0.1 (pins commit SHAs at start)"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":47,"text":""},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":48,"text":"  export    --data <review.json> --out <dir>"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":49,"text":"            Write a static site (same UI + frozen git payloads). Highlighters only"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":50,"text":"            for languages in the review. No server after that."},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":51,"text":""},{"sha":"0e0d85039c547ae5207b51e5ada8ed67e877e607","author":"Cursor Agent","timestamp":1789286146,"line":52,"text":"  compare   --from <review.json> --to <review.json> [--json]"},{"sha":"0e0d85039c547ae5207b51e5ada8ed67e877e607","author":"Cursor Agent","timestamp":1789286146,"line":53,"text":"            [--open] [--port <n>]"},{"sha":"0e0d85039c547ae5207b51e5ada8ed67e877e607","author":"Cursor Agent","timestamp":1789286146,"line":54,"text":"            Show what changed in the interpretation. Not a code diff."},{"sha":"0e0d85039c547ae5207b51e5ada8ed67e877e607","author":"Cursor Agent","timestamp":1789286146,"line":55,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":56,"text":"Options:"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":57,"text":"  --base <ref>     Base ref (default: origin/HEAD or main/master)"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":58,"text":"  --head <ref>     Head ref (default: HEAD)"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":59,"text":"  --data <path>    Review document path"},{"sha":"0e0d85039c547ae5207b51e5ada8ed67e877e607","author":"Cursor Agent","timestamp":1789286146,"line":60,"text":"  --from <path>    First review.json (compare)"},{"sha":"0e0d85039c547ae5207b51e5ada8ed67e877e607","author":"Cursor Agent","timestamp":1789286146,"line":61,"text":"  --to <path>      Second review.json (compare)"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":62,"text":"  --out <dir>      Output directory for export"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":63,"text":"  --port <n>       Listen port (default: ${DEFAULT_PORT}, 0 for ephemeral)"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":64,"text":"  --open           Open the UI in a browser"},{"sha":"0e0d85039c547ae5207b51e5ada8ed67e877e607","author":"Cursor Agent","timestamp":1789286146,"line":65,"text":"  --json           Print compare as JSON"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":66,"text":"  -h, --help       Show this help"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":67,"text":"  -v, --version    Show version"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":68,"text":""},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":69,"text":"Diffs come from git objects at the pinned SHAs. The review document is interpretation only."},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":70,"text":"Serve resolves refs when it starts. A later checkout does not change that review."},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":71,"text":"`;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":72,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":73,"text":"export function parseArgv(argv: string[], cwd = process.cwd()): CliRequest {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":74,"text":"  const args = argv[0] === \"--\" ? argv.slice(1) : [...argv];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":75,"text":"  if (args.length === 0 || args.includes(\"-h\") || args.includes(\"--help\")) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":76,"text":"    return { kind: \"help\" };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":77,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":78,"text":"  if (args.includes(\"-v\") || args.includes(\"--version\")) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":79,"text":"    return { kind: \"version\" };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":80,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":81,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":82,"text":"  const command = args[0];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":83,"text":"  if (command === undefined) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":84,"text":"    return { kind: \"help\" };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":85,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":86,"text":"  if (!isCommand(command)) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":87,"text":"    return { kind: \"error\", message: `Unknown command: ${command}\\n\\n${USAGE}` };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":88,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":89,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":90,"text":"  const rest = args.slice(1);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":91,"text":"  try {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":92,"text":"    const port = Number(flag(rest, \"--port\") ?? String(DEFAULT_PORT));"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":93,"text":"    if (!Number.isInteger(port) || port < 0) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":94,"text":"      throw new ArgError(\"--port must be a non-negative integer\");"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":95,"text":"    }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":96,"text":"    return {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":97,"text":"      kind: \"command\","},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":98,"text":"      command,"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":99,"text":"      cwd,"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":100,"text":"      base: flag(rest, \"--base\"),"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":101,"text":"      head: flag(rest, \"--head\"),"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":102,"text":"      data: flag(rest, \"--data\"),"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":103,"text":"      out: flag(rest, \"--out\"),"},{"sha":"0e0d85039c547ae5207b51e5ada8ed67e877e607","author":"Cursor Agent","timestamp":1789286146,"line":104,"text":"      from: flag(rest, \"--from\"),"},{"sha":"0e0d85039c547ae5207b51e5ada8ed67e877e607","author":"Cursor Agent","timestamp":1789286146,"line":105,"text":"      to: flag(rest, \"--to\"),"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":106,"text":"      port,"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":107,"text":"      open: rest.includes(\"--open\"),"},{"sha":"0e0d85039c547ae5207b51e5ada8ed67e877e607","author":"Cursor Agent","timestamp":1789286146,"line":108,"text":"      json: rest.includes(\"--json\"),"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":109,"text":"    };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":110,"text":"  } catch (error) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":111,"text":"    return { kind: \"error\", message: error instanceof Error ? error.message : String(error) };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":112,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":113,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":114,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":115,"text":"function isCommand(value: string): value is CommandName {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":116,"text":"  return COMMANDS.has(value);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":117,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":118,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":119,"text":"function flag(args: string[], name: string): string | undefined {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":120,"text":"  const prefix = `${name}=`;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":121,"text":"  for (let i = 0; i < args.length; i += 1) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":122,"text":"    const arg = args[i];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":123,"text":"    if (arg === undefined) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":124,"text":"      continue;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":125,"text":"    }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":126,"text":"    if (arg === name) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":127,"text":"      const value = args[i + 1];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":128,"text":"      if (value === undefined || value.startsWith(\"-\")) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":129,"text":"        throw new ArgError(`${name} requires a value`);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":130,"text":"      }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":131,"text":"      return value;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":132,"text":"    }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":133,"text":"    if (arg.startsWith(prefix)) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":134,"text":"      const value = arg.slice(prefix.length);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":135,"text":"      if (value === \"\") {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":136,"text":"        throw new ArgError(`${name} requires a value`);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":137,"text":"      }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":138,"text":"      return value;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":139,"text":"    }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":140,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":141,"text":"  return undefined;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":142,"text":"}"}]}
