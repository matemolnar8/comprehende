{"path":"src/ui/api.ts","ref":"95879630ef53ba6bd6da25c6958a19fe06786fe0","side":"old","lines":[{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":1,"text":"import { apiHref, type ApiResource } from \"../api/paths.ts\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":2,"text":"import type { ApiBlame, ApiFile, ApiHunk, ApiHunks, ApiGroupFile, ApiReview, FileKind, FileSide } from \"../api/types.ts\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":3,"text":"import type { FileStatus } from \"../schema/types.ts\";"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":4,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":5,"text":"// UI LiveHunk is ApiHunk (adds language, omits patch), not schema LiveHunk (adds patch, omits language)."},{"sha":"e9b20d5d583fc4d220337a9ff22e1e6bcf6373e7","author":"Cursor Agent","timestamp":1787413230,"line":6,"text":"export type { ApiHunk as LiveHunk, ApiGroupFile, ApiReview as ReviewMeta, FileKind, FileStatus };"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":7,"text":"export { shortSha } from \"../schema/types.ts\";"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":8,"text":""},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":9,"text":"export function resourceHref(resource: ApiResource): string {"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":10,"text":"  return new URL(apiHref(resource), new URL(\"./\", document.baseURI)).href;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":11,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":12,"text":""},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":13,"text":"async function getJson<T>(resource: ApiResource): Promise<T> {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":14,"text":"  const path = resourceHref(resource);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":15,"text":"  const response = await fetch(path);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":16,"text":"  const text = await response.text();"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":17,"text":"  if (!response.ok) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":18,"text":"    let message = text;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":19,"text":"    try {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":20,"text":"      const parsed: unknown = JSON.parse(text);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":21,"text":"      if (isRecord(parsed) && typeof parsed.error === \"string\") {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":22,"text":"        message = parsed.error;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":23,"text":"      }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":24,"text":"    } catch {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":25,"text":"      // keep raw text"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":26,"text":"    }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":27,"text":"    throw new Error(message);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":28,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":29,"text":"  const data: unknown = JSON.parse(text);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":30,"text":"  return data as T;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":31,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":32,"text":""},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":33,"text":"export function fetchReview(): Promise<ApiReview> {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":34,"text":"  return getJson<ApiReview>({ kind: \"review\" });"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":35,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":36,"text":""},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":37,"text":"export function fetchHunks(group: string): Promise<ApiHunks> {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":38,"text":"  return getJson<ApiHunks>({ kind: \"hunks\", group });"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":39,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":40,"text":""},{"sha":"e9b20d5d583fc4d220337a9ff22e1e6bcf6373e7","author":"Cursor Agent","timestamp":1787413230,"line":41,"text":"export function fetchPatch(path: string): Promise<ApiGroupFile> {"},{"sha":"e9b20d5d583fc4d220337a9ff22e1e6bcf6373e7","author":"Cursor Agent","timestamp":1787413230,"line":42,"text":"  return getJson<ApiGroupFile>({ kind: \"patch\", path });"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":43,"text":"}"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":44,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":45,"text":"export function fetchFile(path: string, side: FileSide): Promise<ApiFile> {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":46,"text":"  return getJson<ApiFile>({ kind: \"file\", path, side });"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":47,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":48,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":49,"text":"export function fetchBlame(path: string, side: FileSide): Promise<ApiBlame> {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":50,"text":"  return getJson<ApiBlame>({ kind: \"blame\", path, side });"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":51,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":52,"text":""},{"sha":"e9b20d5d583fc4d220337a9ff22e1e6bcf6373e7","author":"Cursor Agent","timestamp":1787413230,"line":53,"text":"export function groupIndex(groups: { id: string }[], id: string): number {"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":54,"text":"  return groups.findIndex((group) => group.id === id) + 1;"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":55,"text":"}"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":56,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":57,"text":"function isRecord(value: unknown): value is Record<string, unknown> {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":58,"text":"  return typeof value === \"object\" && value !== null && !Array.isArray(value);"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":59,"text":"}"}]}
