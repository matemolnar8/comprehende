{"path":"src/schema/cli-pin.ts","ref":"603bbf138873e1fab673ef73d0a8238cc225190a","side":"new","lines":[{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":1,"text":"export function cliPin(version: string): string {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":2,"text":"  return `npx comprehende@${version}`;"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":3,"text":"}"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":4,"text":""},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":5,"text":"const PIN = /npx comprehende@([^\\s`]+)/g;"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":6,"text":""},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":7,"text":"export function listedCliPins(markdown: string): string[] {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":8,"text":"  return [...markdown.matchAll(PIN)].map((match) => match[1] ?? \"\");"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":9,"text":"}"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":10,"text":""},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":11,"text":"export function applyCliPin(markdown: string, version: string): string {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":12,"text":"  return markdown.replace(PIN, cliPin(version));"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":13,"text":"}"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":14,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":15,"text":"/** Rewrite every `npx comprehende@…` invocation to `command`. */"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":16,"text":"export function replaceCliPin(markdown: string, command: string): string {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":17,"text":"  return markdown.replace(PIN, command);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":18,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":19,"text":""},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":20,"text":"export function cliPinErrors(markdown: string, version: string): string[] {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":21,"text":"  const expected = cliPin(version);"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":22,"text":"  const pins = listedCliPins(markdown);"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":23,"text":"  if (pins.length === 0) {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":24,"text":"    return [`SKILL.md must pin ${expected}`];"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":25,"text":"  }"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":26,"text":"  return [...new Set(pins.filter((pin) => pin !== version))].map("},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":27,"text":"    (pin) => `SKILL.md pins npx comprehende@${pin}, package.json version is ${version}`,"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":28,"text":"  );"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":29,"text":"}"}]}
