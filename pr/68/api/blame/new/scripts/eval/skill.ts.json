{"path":"scripts/eval/skill.ts","ref":"603bbf138873e1fab673ef73d0a8238cc225190a","side":"new","lines":[{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":1,"text":"import { cp, readFile, writeFile } from \"node:fs/promises\";"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":2,"text":"import { join } from \"node:path\";"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":3,"text":"import { replaceCliPin } from \"../../src/schema/cli-pin.ts\";"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":4,"text":"import { skillPaths } from \"../../src/schema/skill-paths.ts\";"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":5,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":6,"text":"export async function copySkillForEval(packageRoot: string, dest: string, cliPath: string): Promise<void> {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":7,"text":"  const { nextSkill } = skillPaths(packageRoot);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":8,"text":"  await cp(nextSkill, dest, { recursive: true });"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":9,"text":"  const skillMd = join(dest, \"SKILL.md\");"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":10,"text":"  const original = await readFile(skillMd, \"utf8\");"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":11,"text":"  const rewritten = replaceCliPin(original, `node ${cliPath}`);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":12,"text":"  if (rewritten === original) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":13,"text":"    throw new Error(\"SKILL.md has no npx comprehende@ pin to rewrite\");"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":14,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":15,"text":"  await writeFile(skillMd, rewritten);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":16,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":17,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":18,"text":"export function skillSection(markdown: string, heading: string): string {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":19,"text":"  const lines = markdown.split(\"\\n\");"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":20,"text":"  const start = lines.findIndex((line) => line === `## ${heading}`);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":21,"text":"  if (start === -1) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":22,"text":"    throw new Error(`SKILL.md missing ## ${heading}`);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":23,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":24,"text":"  let end = lines.length;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":25,"text":"  for (let i = start + 1; i < lines.length; i += 1) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":26,"text":"    const line = lines[i];"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":27,"text":"    if (line !== undefined && line.startsWith(\"## \")) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":28,"text":"      end = i;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":29,"text":"      break;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":30,"text":"    }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":31,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":32,"text":"  return lines.slice(start + 1, end).join(\"\\n\").trim();"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":33,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":34,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":35,"text":"export async function readNextSkillMd(packageRoot: string): Promise<string> {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":36,"text":"  return readFile(join(skillPaths(packageRoot).nextSkill, \"SKILL.md\"), \"utf8\");"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":37,"text":"}"}]}
