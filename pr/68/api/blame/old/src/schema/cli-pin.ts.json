{"path":"src/schema/cli-pin.ts","ref":"61f79cce8191e348bcd1d72ade335b4c47c18ad9","side":"old","lines":[{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":1,"text":"export function cliPin(version: string): string {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":2,"text":"  return `npx comprehende@${version}`;"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":3,"text":"}"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":4,"text":""},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":5,"text":"const PIN = /npx comprehende@([^\\s`]+)/g;"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":6,"text":""},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":7,"text":"export function listedCliPins(markdown: string): string[] {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":8,"text":"  return [...markdown.matchAll(PIN)].map((match) => match[1] ?? \"\");"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":9,"text":"}"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":10,"text":""},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":11,"text":"export function applyCliPin(markdown: string, version: string): string {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":12,"text":"  return markdown.replace(PIN, cliPin(version));"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":13,"text":"}"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":14,"text":""},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":15,"text":"export function cliPinErrors(markdown: string, version: string): string[] {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":16,"text":"  const expected = cliPin(version);"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":17,"text":"  const pins = listedCliPins(markdown);"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":18,"text":"  if (pins.length === 0) {"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":19,"text":"    return [`SKILL.md must pin ${expected}`];"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":20,"text":"  }"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":21,"text":"  return [...new Set(pins.filter((pin) => pin !== version))].map("},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":22,"text":"    (pin) => `SKILL.md pins npx comprehende@${pin}, package.json version is ${version}`,"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":23,"text":"  );"},{"sha":"1680a59f2dcd0e42e351b876ad116f86ae4d0d36","author":"matemolnar8","timestamp":1786901093,"line":24,"text":"}"}]}
