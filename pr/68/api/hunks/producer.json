owedTools] } : {}),\n+    local: {\n+      cwd: opts.cwd,\n+      settingSources: [],\n+      ...(opts.sandbox ? { sandboxOptions: { enabled: true } } : {}),\n+    },\n+  });\n+  const run = await agent.send(opts.prompt);\n+  let timer: ReturnType<typeof setTimeout> | undefined;\n+  try {\n+    const result = await Promise.race([\n+      run.wait(),\n+      new Promise<never>((_, reject) => {\n+        timer = setTimeout(() => {\n+          void run.cancel();\n+          reject(new Error(`agent timed out after ${timeoutMs}ms`));\n+        }, timeoutMs);\n+      }),\n+    ]);\n+    return {\n+      text: result.result ?? \"\",\n+      status: result.status,\n+      durationMs: result.durationMs ?? 0,\n+      tokens: result.usage?.totalTokens ?? 0,\n+      error: result.error?.message,\n+    };\n+  } finally {\n+    if (timer !== undefined) {\n+      clearTimeout(timer);\n+    }\n+  }\n+}\n","complete":true,"hunks":[{"path":"scripts/eval/agent.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":59,"header":"@@ -0,0 +1,59 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import { Agent, type ToolName } from \"@cursor/sdk\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import { TASK_TIMEOUT_MS } from \"./constants.ts\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":""},{"kind":"add","oldNumber":null,"newNumber":4,"text":"export type AgentRunResult = {"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"  text: string;"},{"kind":"add","oldNumber":null,"newNumber":6,"text":"  status: \"finished\" | \"error\" | \"cancelled\";"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"  durationMs: number;"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"  tokens: number;"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"  error?: string;"},{"kind":"add","oldNumber":null,"newNumber":10,"text":"};"},{"kind":"add","oldNumber":null,"newNumber":11,"text":""},{"kind":"add","oldNumber":null,"newNumber":12,"text