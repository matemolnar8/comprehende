xt":"  });"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":107,"text":"});"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":108,"text":""},{"sha":"ed48e1ff7dd740ed2c2adf7a13544e9c2caa292a","author":"matemolnar8","timestamp":1786704985,"line":109,"text":"describe(\"example repo index/validate\", () => {"},{"sha":"ed48e1ff7dd740ed2c2adf7a13544e9c2caa292a","author":"matemolnar8","timestamp":1786704985,"line":110,"text":"  it(\"indexes refs without patch text, coverage fails on extra or missing refs\", async () => {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":111,"text":"    const root = await mkdtemp(join(tmpdir(), \"comprehende-\"));"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":112,"text":"    roots.push(root);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":113,"text":"    const repo = await createExampleRepo(root);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":114,"text":"    const index = await readHunkIndex(repo.root, repo.base, repo.head);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":115,"text":"    const encoded = JSON.stringify(index);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":116,"text":"    assert.equal(encoded.includes(SECRET_ADD), false);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":117,"text":"    assert.equal(encoded.includes(SECRET_DEL), false);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":118,"text":"    assert.ok(index.hunks.length >= 4);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":119,"text":"    assert.ok(index.skipped.some((item) => item.path === \"assets/dot.bin\"));"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":120,"text":"    assert.equal(index.hunks.filter((hunk) => hunk.path === \"src/app.ts\").length, 2);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":121,"text":"    const appHunks = index.hunks.filter((hunk) => hunk.path === \"src/app.ts\");"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":122,"text":"    const appFirst = appHunks[0];"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":123,"text":"    const appSecond = appHunks[1];"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":124,"text":"    assert.ok(appFirst);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":125,"text":"    assert.ok(appSecond);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":126,"text":"    const gap = appSecond.newStart - (appFirst.newStart + appFirst.newLines);"},{"sha":"06a5ca9442ad1aab16b554c5e56b31bb28732749","author":"Cursor Agent","timestamp":1787466357,"line":127,"text":"    assert.ok(gap > 10, `expected a collapsed gap over 10 lines, got ${gap}`);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":128,"text":"    assert.ok(index.hunks.some((hunk) => hunk.path === \"src/helpers.ts\" && hunk.oldPath === \"src/util.ts\"));"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":129,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":130,"text":"    const dataPath = join(root, \"review.json\");"},{"sha":"ed48e1ff7dd740ed2c2adf7a13544e9c2caa292a","author":"matemolnar8","timestamp":1786704985,"line":131,"text":"    const document = await writeCoveringDocument(dataPath, index);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":132,"text":"    await cmdValidate(repo.root, dataPath);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":133,"text":"    const { coverage } = await coverReview(repo.root, document);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":134,"text":"    assert.equal(coverage.unassigned.length, 0);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":135,"text":"    assert.equal(coverage.stale.length, 0);"},{"sha":"ed48e1ff7dd740ed2c2adf7a13544e9c2caa292a","author":"matemolnar8","timestamp":1786704985,"line":136,"text":"    assert.equal(document.groups[0]?.hunkRefs.length, index.hunks.length);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":137,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":138,"text":"    const broken = structuredClone(document);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":139,"text":"    const first = broken.groups[0];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":140,"text":"    assert.ok(first);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":141,"text":"    first.hunkRefs.push({ path: \"nope.ts\", oldStart: 1, oldLines: 1, newStart: 1, newLines: 1 });"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":142,"text":"    const brokenPath = join(root, \"broken.json\");"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":143,"text":"    await writeFile(brokenPath, `${JSON.stringify(broken, null, 2)}\\n`);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":144,"text":"    await assert.rejects(() => cmdValidate(repo.root, brokenPath), /stale/);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":145,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":146,"text":"    const missing = structuredClone(document);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":147,"text":"    missing.groups = missing.groups.map((group) => ({ ...group, hunkRefs: [] }));"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":148,"text":"    const missingPath = join(root, \"missing.json\");"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":149,"text":"    await writeFile(missingPath, `${JSON.stringify(missing, null, 2)}\\n`);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":150,"text":"    await assert.rejects(() => cmdValidate(repo.root, missingPath), /coverage/);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":151,"text":"  });"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":152,"text":"});"}]}
