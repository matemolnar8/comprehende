review concern.\","},{"sha":"b0eea5819a4b5fc6c67efbf066d311aff4312ae8","author":"matemolnar8","timestamp":1787644209,"line":210,"text":"    \"\","},{"sha":"fc3b218dc68b54db2ec50c36f40f47902531f6b3","author":"Cursor Agent","timestamp":1787642506,"line":211,"text":"    ...resolveShaSteps(review),"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":212,"text":"    \"\","},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":213,"text":"    \"2. Load the hunks.\","},{"sha":"b0eea5819a4b5fc6c67efbf066d311aff4312ae8","author":"matemolnar8","timestamp":1787644209,"line":214,"text":"    \"   A hunk ref is a pointer into the live git diff at the pinned SHAs.\","},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":215,"text":"    `   For each hunk ref, run \\`git diff --find-renames ${baseSha} ${headSha} -- <path>\\` and keep the hunk whose header matches the @@ range.`,"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":216,"text":"    \"   Done when every hunk ref has a matching live hunk.\","},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":217,"text":"    \"\","},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":218,"text":"    \"3. Answer from live git.\","},{"sha":"b0eea5819a4b5fc6c67efbf066d311aff4312ae8","author":"matemolnar8","timestamp":1787644209,"line":219,"text":"    \"   Read those hunks. Use the why and the what as interpretation. Live git wins when they disagree.\","},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":220,"text":"    `   ${SHOW_CODE_RULE}`,"},{"sha":"fc3b218dc68b54db2ec50c36f40f47902531f6b3","author":"Cursor Agent","timestamp":1787642506,"line":221,"text":"    \"   Done when the answer quotes the live code.\","},{"sha":"fc3b218dc68b54db2ec50c36f40f47902531f6b3","author":"Cursor Agent","timestamp":1787642506,"line":222,"text":"  ].join(\"\\n\");"},{"sha":"fc3b218dc68b54db2ec50c36f40f47902531f6b3","author":"Cursor Agent","timestamp":1787642506,"line":223,"text":"}"},{"sha":"fc3b218dc68b54db2ec50c36f40f47902531f6b3","author":"Cursor Agent","timestamp":1787642506,"line":224,"text":""},{"sha":"fc3b218dc68b54db2ec50c36f40f47902531f6b3","author":"Cursor Agent","timestamp":1787642506,"line":225,"text":"function resolveShaSteps(review: ApiReview): string[] {"},{"sha":"fc3b218dc68b54db2ec50c36f40f47902531f6b3","author":"Cursor Agent","timestamp":1787642506,"line":226,"text":"  const { baseSha, headSha } = review.resolved;"},{"sha":"fc3b218dc68b54db2ec50c36f40f47902531f6b3","author":"Cursor Agent","timestamp":1787642506,"line":227,"text":"  return ["},{"sha":"fc3b218dc68b54db2ec50c36f40f47902531f6b3","author":"Cursor Agent","timestamp":1787642506,"line":228,"text":"    \"1. Resolve the pinned SHAs.\","},{"sha":"fc3b218dc68b54db2ec50c36f40f47902531f6b3","author":"Cursor Agent","timestamp":1787642506,"line":229,"text":"    `   Run \\`git rev-parse --verify ${baseSha}\\` and \\`git rev-parse --verify ${headSha}\\` in this repository.`,"},{"sha":"fc3b218dc68b54db2ec50c36f40f47902531f6b3","author":"Cursor Agent","timestamp":1787642506,"line":230,"text":"    \"   Done when both objects exist.\","},{"sha":"b0eea5819a4b5fc6c67efbf066d311aff4312ae8","author":"matemolnar8","timestamp":1787644209,"line":231,"text":"  ];"},{"sha":"b0eea5819a4b5fc6c67efbf066d311aff4312ae8","author":"matemolnar8","timestamp":1787644209,"line":232,"text":"}"},{"sha":"b0eea5819a4b5fc6c67efbf066d311aff4312ae8","author":"matemolnar8","timestamp":1787644209,"line":233,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":234,"text":"const SHOW_CODE_RULE = \"When you show code, quote the live git lines.\";"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":235,"text":""},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":236,"text":"function joinBlocks(parts: Array<string | null | undefined>): string {"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":237,"text":"  return parts.filter((part): part is string => part !== null && part !== undefined && part.length > 0).join(\"\\n\\n\");"},{"sha":"41be4a38ae6bcd0b4ba37a1f55fb4764cb1b2a13","author":"Cursor Agent","timestamp":1787602539,"line":238,"text":"}"}]}
