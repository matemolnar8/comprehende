summary, \"Fill this review.\");"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":39,"text":"    assert.equal(\"why\" in document, false);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":40,"text":"    assert.equal(\"lookFor\" in document, false);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":41,"text":"    assert.equal(\"sources\" in document, false);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":42,"text":"    assert.equal(\"parts\" in document, false);"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":43,"text":"    assert.equal(document.groups[0]?.id, \"ungrouped\");"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":44,"text":"    assert.equal(document.groups[0]?.summary, \"\");"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":45,"text":"    assert.doesNotMatch(JSON.stringify(document), /All changes/);"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":46,"text":"  });"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":47,"text":"});"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":48,"text":""},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":49,"text":"describe(\"cmdReview\", () => {"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":50,"text":"  it(\"writes a covering skeleton, then validate passes\", async () => {"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","