1789938724,"line":63,"text":"    assert.equal(raw.sources, undefined);"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":64,"text":"    assert.equal(raw.parts, undefined);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":65,"text":"    const paths = skeletonPaths(index);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":66,"text":"    assert.ok(Array.isArray(raw.groups));"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":67,"text":"    const writtenGroup = raw.groups[0];"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":68,"text":"    assert.ok(isRecord(writtenGroup));"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":69,"text":"    assert.deepEqual(writtenGroup.hunkRefs, paths);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":70,"text":"    assert.ok(paths.every((path) => typeof path === \"string\"));"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":71,"text":"    assert.deepEqual("},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":72,"text":"      document.groups[0]?.hunkRefs,"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":73,"text":"      paths.map((path) => ({ path })),"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":74,"text":"    );"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":75,"text":"    const { coverage } = await coverReview(repo.root, document);"},{"sha":"b84519867812a62c793e2a4b9b2