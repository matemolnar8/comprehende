{"path":"src/schema/identity.ts","ref":"b84519867812a62c793e2a4b9b21a4978b1a5911","side":"new","lines":[{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":1,"text":"import type { HunkRef } from \"./types.ts\";"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":2,"text":""},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":3,"text":"const COMPACT_SUFFIX = /@(\\d+)\\+(\\d+)$/;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":4,"text":"const RENAME_MARK = \" -> \";"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":5,"text":""},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":6,"text":"/** Every live hunk of `path`. */"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":7,"text":"export type FileHunkRef = {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":8,"text":"  path: string;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":9,"text":"};"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":10,"text":""},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":11,"text":"/** One hunk. Line counts are present only when the object form supplied them. */"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":12,"text":"export type LocatedHunkRef = {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":13,"text":"  path: string;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":14,"text":"  oldPath?: string;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":15,"text":"  oldStart: number;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":16,"text":"  newStart: number;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":17,"text":"  oldLines?: number;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":18,"text":"  newLines?: number;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":19,"text":"};"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":20,"text":""},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":21,"text":"export type ReviewHunkRef = FileHunkRef | LocatedHunkRef;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":22,"text":""},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":23,"text":"export type ParsedHunkString ="},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":24,"text":"  | { kind: \"file\"; path: string }"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":25,"text":"  | { kind: \"hunk\"; path: string; oldPath?: string; oldStart: number; newStart: number };"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":26,"text":""},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":27,"text":"export function isLocatedHunkRef(ref: ReviewHunkRef): ref is LocatedHunkRef {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":28,"text":"  return \"oldStart\" in ref;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":29,"text":"}"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":30,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":31,"text":"export function hunkKey(ref: Pick<HunkRef, \"path\" | \"oldPath\" | \"oldStart\" | \"newStart\">): string {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":32,"text":"  const oldPath = ref.oldPath ?? \"\";"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":33,"text":"  return `${oldPath}\\0${ref.path}\\0${ref.oldStart}\\0${ref.newStart}`;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":34,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":35,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":36,"text":"export function formatHunkRef(ref: HunkRef): string {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":37,"text":"  const rename = ref.oldPath !== undefined ? `${ref.oldPath} -> ` : \"\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":38,"text":"  return `${rename}${ref.path} @@ -${ref.oldStart},${ref.oldLines} +${ref.newStart},${ref.newLines} @@`;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":39,"text":"}"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":40,"text":""},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":41,"text":"/** Path string, or `path@oldStart+newStart`, or `old -> new@oldStart+newStart`. */"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":42,"text":"export function parseHunkRefString(value: string): ParsedHunkString | undefined {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":43,"text":"  const text = value.trim();"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":44,"text":"  if (text === \"\") {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":45,"text":"    return undefined;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":46,"text":"  }"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":47,"text":"  const suffix = COMPACT_SUFFIX.exec(text);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":48,"text":"  if (suffix === null) {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":49,"text":"    return { kind: \"file\", path: text };"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":50,"text":"  }"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":51,"text":"  const oldStart = Number(suffix[1]);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":52,"text":"  const newStart = Number(suffix[2]);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":53,"text":"  if (!Number.isSafeInteger(oldStart) || !Number.isSafeInteger(newStart)) {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":54,"text":"    return undefined;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":55,"text":"  }"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":56,"text":"  const head = text.slice(0, suffix.index);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":57,"text":"  const arrow = head.lastIndexOf(RENAME_MARK);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":58,"text":"  if (arrow === -1) {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":59,"text":"    if (head === \"\") {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":60,"text":"      return undefined;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":61,"text":"    }"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":62,"text":"    return { kind: \"hunk\", path: head, oldStart, newStart };"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":63,"text":"  }"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":64,"text":"  const oldPath = head.slice(0, arrow);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":65,"text":"  const path = head.slice(arrow + RENAME_MARK.length);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":66,"text":"  if (oldPath === \"\" || path === \"\") {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":67,"text":"    return undefined;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":68,"text":"  }"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":69,"text":"  return { kind: \"hunk\", path, oldPath, oldStart, newStart };"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":70,"text":"}"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":71,"text":""},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":72,"text":"export function formatStoredHunkRef(ref: ReviewHunkRef): string {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":73,"text":"  if (!isLocatedHunkRef(ref)) {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":74,"text":"    return ref.path;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":75,"text":"  }"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":76,"text":"  if (ref.oldLines !== undefined && ref.newLines !== undefined) {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":77,"text":"    return formatHunkRef({"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":78,"text":"      path: ref.path,"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":79,"text":"      ...(ref.oldPath !== undefined ? { oldPath: ref.oldPath } : {}),"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":80,"text":"      oldStart: ref.oldStart,"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":81,"text":"      oldLines: ref.oldLines,"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":82,"text":"      newStart: ref.newStart,"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":83,"text":"      newLines: ref.newLines,"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":84,"text":"    });"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":85,"text":"  }"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":86,"text":"  const rename = ref.oldPath !== undefined ? `${ref.oldPath} -> ` : \"\";"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":87,"text":"  return `${rename}${ref.path}@${ref.oldStart}+${ref.newStart}`;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":88,"text":"}"}]}
