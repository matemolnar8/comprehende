{"path":"src/schema/parse.ts","ref":"b84519867812a62c793e2a4b9b21a4978b1a5911","side":"new","lines":[{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":1,"text":"import * as z from \"zod\";"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":2,"text":"import { reviewDocumentSchema, type ReviewDocument } from \"./review.ts\";"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":3,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":4,"text":"export type ParseFailure = {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":5,"text":"  ok: false;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":6,"text":"  errors: string[];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":7,"text":"};"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":8,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":9,"text":"export type ParseSuccess = {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":10,"text":"  ok: true;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":11,"text":"  document: ReviewDocument;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":12,"text":"};"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":13,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":14,"text":"export type ParseResult = ParseSuccess | ParseFailure;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":15,"text":""},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":16,"text":"const UNKNOWN_FIELD_NOTE = \"review documents may not store patch text or file contents\";"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":17,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":18,"text":"export function parseReviewDocument(input: unknown): ParseResult {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":19,"text":"  if (!isRecord(input)) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":20,"text":"    return { ok: false, errors: [\"review document must be a JSON object\"] };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":21,"text":"  }"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":22,"text":"  const result = reviewDocumentSchema.safeParse(input);"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":23,"text":"  if (result.success) {"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":24,"text":"    return { ok: true, document: result.data };"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":25,"text":"  }"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":26,"text":"  return { ok: false, errors: formatZodIssues(result.error) };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":27,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":28,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":29,"text":"export function parseReviewJson(text: string): ParseResult {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":30,"text":"  let value: unknown;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":31,"text":"  try {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":32,"text":"    value = JSON.parse(text);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":33,"text":"  } catch {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":34,"text":"    return { ok: false, errors: [\"review document is not valid JSON\"] };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":35,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":36,"text":"  return parseReviewDocument(value);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":37,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":38,"text":""},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":39,"text":"function formatZodIssues(error: z.ZodError): string[] {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":40,"text":"  return collectIssues(error.issues, []);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":41,"text":"}"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":42,"text":""},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":43,"text":"function collectIssues(issues: readonly z.core.$ZodIssue[], prefix: PropertyKey[]): string[] {"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":44,"text":"  const errors: string[] = [];"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":45,"text":"  for (const issue of issues) {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":46,"text":"    const path = [...prefix, ...issue.path];"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":47,"text":"    if (issue.code === \"unrecognized_keys\") {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":48,"text":"      const where = formatPath(path) || \"document\";"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":49,"text":"      for (const key of issue.keys) {"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":50,"text":"        errors.push(`${where} has unknown field \"${key}\" (${UNKNOWN_FIELD_NOTE})`);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":51,"text":"      }"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":52,"text":"      continue;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":53,"text":"    }"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":54,"text":"    if (issue.code === \"invalid_union\" && Array.isArray(issue.errors)) {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":55,"text":"      const nested = issue.errors.flat().filter((item) => !isBranchTypeMismatch(item));"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":56,"text":"      if (nested.length > 0) {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":57,"text":"        errors.push(...collectIssues(nested, path));"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":58,"text":"        continue;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":59,"text":"      }"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":60,"text":"      const where = formatPath(path);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":61,"text":"      const message = \"must be a hunk object or a path string\";"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":62,"text":"      errors.push(where === \"\" ? message : `${where} ${message}`);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":63,"text":"      continue;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":64,"text":"    }"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":65,"text":"    const where = formatPath(path);"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":66,"text":"    errors.push(where === \"\" ? issue.message : `${where} ${issue.message}`);"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":67,"text":"  }"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":68,"text":"  return errors;"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":69,"text":"}"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":70,"text":""},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":71,"text":"function isBranchTypeMismatch(issue: z.core.$ZodIssue): boolean {"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":72,"text":"  return issue.code === \"invalid_type\" && issue.path.length === 0;"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":73,"text":"}"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":74,"text":""},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":75,"text":"function formatPath(path: PropertyKey[]): string {"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":76,"text":"  let out = \"\";"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":77,"text":"  for (const part of path) {"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":78,"text":"    if (typeof part === \"number\") {"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":79,"text":"      out += `[${part}]`;"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":80,"text":"    } else if (out === \"\") {"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":81,"text":"      out = String(part);"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":82,"text":"    } else {"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":83,"text":"      out += `.${String(part)}`;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":84,"text":"    }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":85,"text":"  }"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":86,"text":"  return out;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":87,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":88,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":89,"text":"function isRecord(value: unknown): value is Record<string, unknown> {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":90,"text":"  return typeof value === \"object\" && value !== null && !Array.isArray(value);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":91,"text":"}"}]}
