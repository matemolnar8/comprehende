{"path":"src/schema/source.ts","ref":"b84519867812a62c793e2a4b9b21a4978b1a5911","side":"new","lines":[{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":1,"text":"import { isLocatedHunkRef } from \"./identity.ts\";"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":2,"text":"import type { LinePinnedSource, ReviewDocument, Source } from \"./types.ts\";"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":3,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":4,"text":"export const SOURCE_HREF_PREFIX = \"source:\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":5,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":6,"text":"function escapeRegExp(value: string): string {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":7,"text":"  return value.replaceAll(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":8,"text":"}"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":9,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":10,"text":"function sourceLinkPattern(): RegExp {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":11,"text":"  return new RegExp(`\\\\]\\\\(\\\\s*${escapeRegExp(SOURCE_HREF_PREFIX)}([^)\\\\s]+)(?:\\\\s+\"[^\"]*\")?\\\\s*\\\\)`, \"g\");"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":12,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":13,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":14,"text":"export function isLinePinned(source: Source): source is LinePinnedSource {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":15,"text":"  return ("},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":16,"text":"    source.kind === \"pr-comment\" &&"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":17,"text":"    source.path !== undefined &&"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":18,"text":"    source.side !== undefined &&"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":19,"text":"    source.line !== undefined"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":20,"text":"  );"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":21,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":22,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":23,"text":"export function citationIds(text: string): string[] {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":24,"text":"  const ids: string[] = [];"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":25,"text":"  for (const match of text.matchAll(sourceLinkPattern())) {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":26,"text":"    const id = match[1];"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":27,"text":"    if (id !== undefined && id !== \"\") {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":28,"text":"      ids.push(id);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":29,"text":"    }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":30,"text":"  }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":31,"text":"  return ids;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":32,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":33,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":34,"text":"export type CitationRef = {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":35,"text":"  where: string;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":36,"text":"  id: string;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":37,"text":"};"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":38,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":39,"text":"export function documentCitationRefs(document: ReviewDocument): CitationRef[] {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":40,"text":"  const out: CitationRef[] = [];"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":41,"text":"  const add = (where: string, text: string | undefined): void => {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":42,"text":"    if (text === undefined) {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":43,"text":"      return;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":44,"text":"    }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":45,"text":"    for (const id of citationIds(text)) {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":46,"text":"      out.push({ where, id });"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":47,"text":"    }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":48,"text":"  };"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":49,"text":"  add(\"why\", document.why);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":50,"text":"  add(\"summary\", document.summary);"},{"sha":"1c29b4199ba85c3bdb2120b43b9d3e593c5900d2","author":"Cursor Agent","timestamp":1789216370,"line":51,"text":"  (document.lookFor ?? []).forEach((item, j) => {"},{"sha":"1c29b4199ba85c3bdb2120b43b9d3e593c5900d2","author":"Cursor Agent","timestamp":1789216370,"line":52,"text":"    add(`lookFor[${j}]`, item);"},{"sha":"1c29b4199ba85c3bdb2120b43b9d3e593c5900d2","author":"Cursor Agent","timestamp":1789216370,"line":53,"text":"  });"},{"sha":"c77e82775e65bb5e490a77688e8ffd272829c18f","author":"Cursor Agent","timestamp":1789847074,"line":54,"text":"  (document.parts ?? []).forEach((part, i) => {"},{"sha":"c77e82775e65bb5e490a77688e8ffd272829c18f","author":"Cursor Agent","timestamp":1789847074,"line":55,"text":"    add(`parts[${i}].summary`, part.summary);"},{"sha":"c77e82775e65bb5e490a77688e8ffd272829c18f","author":"Cursor Agent","timestamp":1789847074,"line":56,"text":"  });"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":57,"text":"  document.groups.forEach((group, i) => {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":58,"text":"    add(`groups[${i}].why`, group.why);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":59,"text":"    add(`groups[${i}].summary`, group.summary);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":60,"text":"    (group.lookFor ?? []).forEach((item, j) => {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":61,"text":"      add(`groups[${i}].lookFor[${j}]`, item);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":62,"text":"    });"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":63,"text":"  });"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":64,"text":"  return out;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":65,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":66,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":67,"text":"export function sourceCitationErrors(document: ReviewDocument): string[] {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":68,"text":"  const known = new Set((document.sources ?? []).map((source) => source.id));"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":69,"text":"  const seen = new Set<string>();"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":70,"text":"  const errors: string[] = [];"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":71,"text":"  for (const { where, id } of documentCitationRefs(document)) {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":72,"text":"    const key = `${where}\\0${id}`;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":73,"text":"    if (seen.has(key)) {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":74,"text":"      continue;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":75,"text":"    }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":76,"text":"    seen.add(key);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":77,"text":"    if (!known.has(id)) {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":78,"text":"      errors.push(`source: unknown id \"${id}\" in ${where}`);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":79,"text":"    }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":80,"text":"  }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":81,"text":"  return errors;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":82,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":83,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":84,"text":"export function parseSourceHref(href: string | undefined): string | undefined {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":85,"text":"  if (href === undefined || !href.startsWith(SOURCE_HREF_PREFIX)) {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":86,"text":"    return undefined;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":87,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":88,"text":"  const id = href.slice(SOURCE_HREF_PREFIX.length);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":89,"text":"  return id === \"\" ? undefined : id;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":90,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":91,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":92,"text":"export function linePinnedSources(sources: readonly Source[] | undefined): LinePinnedSource[] {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":93,"text":"  return (sources ?? []).filter(isLinePinned);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":94,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":95,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":96,"text":"export function groupIdForPinnedSource(document: ReviewDocument, source: Source): string | undefined {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":97,"text":"  if (!isLinePinned(source)) {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":98,"text":"    return undefined;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":99,"text":"  }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":100,"text":"  const named = document.groups.filter((group) => (group.sources ?? []).includes(source.id));"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":101,"text":"  const covering = document.groups.filter((group) =>"},{"sha":"b84519867812a62c793e2a4b9b21a4978b1a5911","author":"Cursor Agent","timestamp":1790107747,"line":102,"text":"    group.hunkRefs.some((ref) => ref.path === source.path || (isLocatedHunkRef(ref) && ref.oldPath === source.path)),"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":103,"text":"  );"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":104,"text":"  const both = covering.filter((group) => named.some((item) => item.id === group.id));"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":105,"text":"  return (both[0] ?? covering[0] ?? named[0])?.id;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":106,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":107,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":108,"text":"export function groupSourceIds(group: ReviewDocument[\"groups\"][number]): string[] {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":109,"text":"  const named = group.sources ?? [];"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":110,"text":"  const cited = [group.why, group.summary, ...(group.lookFor ?? [])].flatMap(citationIds);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":111,"text":"  return [...new Set([...named, ...cited])];"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":112,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":113,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":114,"text":"export function textLineCount(content: string): number {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":115,"text":"  if (content === \"\") {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":116,"text":"    return 0;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":117,"text":"  }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":118,"text":"  const stripped = content.endsWith(\"\\n\") ? content.slice(0, -1) : content;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":119,"text":"  return stripped.split(\"\\n\").length;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":120,"text":"}"}]}
