{"path":"src/ui/lib/use-claim-focus.ts","ref":"843230cb6e4245c73cf07b7fb1db23e79a77c5ba","side":"new","lines":[{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":1,"text":"import { useEffect } from \"react\";"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":2,"text":""},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":3,"text":"/** Scrolls the `[data-claim]` element with this key into view when the key changes. */"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":4,"text":"export function useClaimFocus(focusKey: string | undefined): void {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":5,"text":"  useEffect(() => {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":6,"text":"    if (focusKey === undefined) {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":7,"text":"      return;"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":8,"text":"    }"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":9,"text":"    const el = document.querySelector(`[data-claim=\"${CSS.escape(focusKey)}\"]`);"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":10,"text":"    if (!(el instanceof HTMLElement)) {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":11,"text":"      return;"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":12,"text":"    }"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":13,"text":"    const reduce = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":14,"text":"    el.scrollIntoView({ block: \"center\", behavior: reduce ? \"instant\" : \"smooth\" });"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":15,"text":"  }, [focusKey]);"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":16,"text":"}"}]}
