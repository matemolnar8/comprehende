{"path":"src/ui/lib/use-claim-focus.ts","ref":"5f50618caf4f4029e5dbba2aa5e83419842b8460","side":"new","lines":[{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":1,"text":"import { useEffect } from \"react\";"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":2,"text":""},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":3,"text":"/** Scrolls the `[data-claim]` element with this key into view when the key changes. */"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":4,"text":"export function useClaimFocus(focusKey: string | undefined): void {"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":5,"text":"  useEffect(() => {"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":6,"text":"    if (focusKey === undefined) {"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":7,"text":"      return;"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":8,"text":"    }"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":9,"text":"    const el = document.querySelector(`[data-claim=\"${CSS.escape(focusKey)}\"]`);"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":10,"text":"    if (!(el instanceof HTMLElement)) {"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":11,"text":"      return;"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":12,"text":"    }"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":13,"text":"    const reduce = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":14,"text":"    el.scrollIntoView({ block: \"center\", behavior: reduce ? \"instant\" : \"smooth\" });"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":15,"text":"  }, [focusKey]);"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":16,"text":"}"}]}
