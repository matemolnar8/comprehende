{"path":"src/ui/lib/claims.ts","ref":"843230cb6e4245c73cf07b7fb1db23e79a77c5ba","side":"new","lines":[{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":1,"text":"import {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":2,"text":"  citationIds,"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":3,"text":"  groupIdForPinnedSource,"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":4,"text":"  groupSourceIds,"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":5,"text":"  isLinePinned,"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":6,"text":"} from \"../../schema/source.ts\";"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":7,"text":"import type { Attention, ReviewDocument, Source } from \"../../schema/types.ts\";"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":8,"text":"import { groupParts, type PartGroup } from \"./parts.ts\";"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":9,"text":"import type { Selection } from \"./selection.ts\";"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":10,"text":""},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":11,"text":"/** Prose a source click can scroll to: a document lookFor bullet, or a group attention. */"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":12,"text":"export type Claim = {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":13,"text":"  key: string;"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":14,"text":"  /** Unset for document lookFor. */"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":15,"text":"  groupId?: string;"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":16,"text":"  sourceIds: string[];"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":17,"text":"};"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":18,"text":""},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":19,"text":"export type ClaimGroup = PartGroup & { attention?: Attention };"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":20,"text":""},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":21,"text":"export function lookForKey(index: number): string {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":22,"text":"  return `look-for:${index}`;"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":23,"text":"}"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":24,"text":""},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":25,"text":"export function attentionKey(groupId: string): string {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":26,"text":"  return `attention:${groupId}`;"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":27,"text":"}"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":28,"text":""},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":29,"text":"/** Document lookFor first, then group attentions in reading order. */"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":30,"text":"export function reviewClaims("},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":31,"text":"  document: { lookFor?: readonly string[] },"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":32,"text":"  groups: readonly ClaimGroup[],"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":33,"text":"): Claim[] {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":34,"text":"  const claims: Claim[] = (document.lookFor ?? []).map((text, index) => ({"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":35,"text":"    key: lookForKey(index),"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":36,"text":"    sourceIds: citationIds(text),"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":37,"text":"  }));"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":38,"text":"  const byId = new Map(groups.map((group) => [group.id, group]));"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":39,"text":"  for (const id of groupParts(groups).flatMap((part) => part.groupIds)) {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":40,"text":"    const attention = byId.get(id)?.attention;"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":41,"text":"    if (attention !== undefined) {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":42,"text":"      claims.push({ key: attentionKey(id), groupId: id, sourceIds: citationIds(attention.note) });"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":43,"text":"    }"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":44,"text":"  }"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":45,"text":"  return claims;"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":46,"text":"}"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":47,"text":""},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":48,"text":"export type SourceOpenTarget = {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":49,"text":"  selection: Selection;"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":50,"text":"  claimKey?: string;"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":51,"text":"  commentId?: string;"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":52,"text":"};"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":53,"text":""},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":54,"text":"function claimTarget(claim: Claim): SourceOpenTarget {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":55,"text":"  return {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":56,"text":"    selection:"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":57,"text":"      claim.groupId === undefined ? { kind: \"overview\" } : { kind: \"group\", id: claim.groupId },"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":58,"text":"    claimKey: claim.key,"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":59,"text":"  };"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":60,"text":"}"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":61,"text":""},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":62,"text":"export function openTargetForSource("},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":63,"text":"  source: Source,"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":64,"text":"  claims: readonly Claim[],"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":65,"text":"  document: ReviewDocument,"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":66,"text":"  currentGroupId?: string,"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":67,"text":"  renames?: ReadonlyMap<string, string>,"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":68,"text":"): SourceOpenTarget {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":69,"text":"  if (isLinePinned(source)) {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":70,"text":"    const groupId = groupIdForPinnedSource(document, source, renames);"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":71,"text":"    if (groupId !== undefined) {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":72,"text":"      return { selection: { kind: \"group\", id: groupId }, commentId: source.id };"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":73,"text":"    }"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":74,"text":"  }"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":75,"text":"  const citing = claims.filter((claim) => claim.sourceIds.includes(source.id));"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":76,"text":"  const currentClaim = citing.find("},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":77,"text":"    (claim) => claim.groupId !== undefined && claim.groupId === currentGroupId,"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":78,"text":"  );"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":79,"text":"  if (currentClaim !== undefined) {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":80,"text":"    return claimTarget(currentClaim);"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":81,"text":"  }"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":82,"text":"  if (currentGroupId !== undefined) {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":83,"text":"    const current = document.groups.find((group) => group.id === currentGroupId);"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":84,"text":"    if (current !== undefined && groupSourceIds(current).includes(source.id)) {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":85,"text":"      return { selection: { kind: \"group\", id: currentGroupId } };"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":86,"text":"    }"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":87,"text":"  }"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":88,"text":"  const groupClaim = citing.find((claim) => claim.groupId !== undefined);"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":89,"text":"  if (groupClaim !== undefined) {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":90,"text":"    return claimTarget(groupClaim);"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":91,"text":"  }"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":92,"text":"  const named = document.groups.find((group) => (group.sources ?? []).includes(source.id));"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":93,"text":"  if (named !== undefined) {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":94,"text":"    return { selection: { kind: \"group\", id: named.id } };"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":95,"text":"  }"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":96,"text":"  const documentClaim = citing.find((claim) => claim.groupId === undefined);"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":97,"text":"  if (documentClaim !== undefined) {"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":98,"text":"    return claimTarget(documentClaim);"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":99,"text":"  }"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":100,"text":"  return { selection: { kind: \"overview\" } };"},{"sha":"335d5d032a7fed08739010c0cfc0c4978608b4c5","author":"Máté Molnár","timestamp":1793514832,"line":101,"text":"}"}]}
