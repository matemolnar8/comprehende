"line":171,"text":"      group.hunkRefs.flatMap((ref) => {"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":172,"text":"        if (!isDirHunkRef(ref)) {"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":173,"text":"          return [ref.path];"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":174,"text":"        }"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":175,"text":"        return live === undefined"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":176,"text":"          ? [ref.dir]"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":177,"text":"          : paths.filter("},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":178,"text":"              (path) =>"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":179,"text":"                path.startsWith(ref.dir) &&"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":180,"text":"                groupsHoldingPath(document.groups, path).includes(group),"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":181,"text":"            );"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":182,"text":"      }),"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":183,"text":"    ),"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":184,"text":"  ];"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":185,"text":"}"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":186,"text":""},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":187,"text":"function hasChange(change: ApiGroupChange): boolean {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":188,"text":"  const hunks = change.hunks;"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":189,"text":"  return ("},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":190,"text":"    Object.keys(change.text).length > 0 ||"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":191,"text":"    change.attention !== undefined ||"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":192,"text":"    change.files.added.length + change.files.removed.length > 0 ||"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":193,"text":"    (hunks !== undefined && hunks.new + hunks.changed + hunks.reformat > 0)"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":194,"text":"  );"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":195,"text":"}"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":196,"text":""},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":197,"text":"function readingOrder(groups: readonly ReviewGroup[]): ReviewGroup[] {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":198,"text":"  return groups"},{"sha":"d86dd9523f70c22459487