":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":14,"text":"export type CodeChanges = {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":15,"text":"  delta: HunkDelta;"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":16,"text":"  /** Live hunks of each current group. */"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":17,"text":"  groups: ReadonlyMap<string, readonly LiveHunk[]>;"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":18,"text":"};"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":19,"text":""},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":20,"text":"/** Compare a review with the one it was refreshed from. Groups match by id. */"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":21,"text":"export function changesPayload("},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":22,"text":"  previous: ReviewDocument,"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":23,"text":"  current: ReviewDocument,"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":24,"text":"  code: CodeChanges | undefined,"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":25,"text":"): ApiChanges {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":26,"text":"  const count = code === undefined ? undefined : hunkCounter(code.delta);"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":27,"text":"  const delta = code?.delta;"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":28,"text":"  const matched = delta === undefined ? [] : [...delta.same, ...delta.changed, ...delta.reformat];"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":29,"text":"  const pathsBefore = (group: ReviewGroup) =>"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":30,"text":"    groupPaths(group, previous, delta && [...matched.map((m) => m.previous), ...delta.removed]);"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":31,"text":"  const pathsAfter = (group: ReviewGroup) =>"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":32,"text":"    groupPaths(group, current, delta && [...matched.map((m) => m.next), ...delta.added]);"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":33,"text":"  const before = new Map(previous.groups.map((group) => [group.id, group]));"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":34,"text":"  const after = new Set(current.groups.map((group) => group.id));"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":35,"text":"  const groups: ApiGroupChange[] = [];"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":36,"text":"  for (const group of readingOrder(current.groups)) {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":37,"text":"    const old = before.get(group.id);"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":3