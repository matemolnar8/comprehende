3f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":131,"text":"  after: string | undefined,"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":132,"text":"): ApiTextChange | undefined {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":133,"text":"  const from = before ?? \"\";"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":134,"text":"  const to = after ?? \"\";"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":135,"text":"  return from === to ? undefined : { before: from, after: to };"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":136,"text":"}"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":137,"text":""},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":138,"text":"function listChange(before: readonly string[] = [], after: readonly string[] = []): ApiListChange {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":139,"text":"  const had = new Set(before);"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":140,"text":"  const has = new Set(after);"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":141,"text":"  return {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":142,"text":"    added: [...has].filter((item) => !had.has(item)),"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":143,"text":"    removed: [...had].filter((item) => !has.has(item)),"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":144,"text":"  };"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":145,"text":"}"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":146,"text":""},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":147,"text":"function attentionChange("},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":148,"text":"  before: Attention | undefined,"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":149,"text":"  after: Attention | undefined,"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":150,"text":"): ApiAttentionChange | undefined {"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":151,"text":"  if (after !== undefined) {"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":152,"text":"    const same = before?.kind === after.kind && before.note === after.note;"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":153,"text":"    return same ? undefined : { before: before ?? null, after };"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":154,"text":"  }"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":155,"text":"  return before === undefined ? undefined : { before, after: null };"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":156,"text":"}"},{"sha":"3f0459710e0d3fe1780e2e8174d3328ab40c1b19","author":"Máté Molnár","timestamp":1793514832,"line":157,"text":""},{"sha":"