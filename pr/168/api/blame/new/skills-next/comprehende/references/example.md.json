thor":"Cursor Agent","timestamp":1789847074,"line":32,"text":"    {"},{"sha":"c77e82775e65bb5e490a77688e8ffd272829c18f","author":"Cursor Agent","timestamp":1789847074,"line":33,"text":"      \"name\": \"README\","},{"sha":"c77e82775e65bb5e490a77688e8ffd272829c18f","author":"Cursor Agent","timestamp":1789847074,"line":34,"text":"      \"summary\": \"The README documents the new session cookie behavior.\""},{"sha":"c77e82775e65bb5e490a77688e8ffd272829c18f","author":"Cursor Agent","timestamp":1789847074,"line":35,"text":"    }"},{"sha":"c77e82775e65bb5e490a77688e8ffd272829c18f","author":"Cursor Agent","timestamp":1789847074,"line":36,"text":"  ],"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":37,"text":"  \"sources\": ["},{"sha":"59b597c2cd0617205d4936c85ab2a33232321c29","author":"Cursor Agent","timestamp":1787289659,"line":38,"text":"    {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":39,"text":"      \"id\": \"s1\","},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":40,"text":"      \"kind\": \"ticket\","},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":41,"text":"      \"label\": \"#12\","},{"sha":"ce37ae12a31e89d85e5dc95b4196576d03c8042c","author":"Cursor Agent","timestamp":1787406907,"line":42,"text":"      \"title\": \"HttpOnly session cookies\","},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":43,"text":"      \"gist\": \"Requires login sessions that client scripts cannot read.\","},{"sha":"ce37ae12a31e89d85e5dc95b4196576d03c8042c","author":"Cursor Agent","timestamp":1787406907,"line":44,"text":"      \"part\": \"Session cookie\""},{"sha":"59b597c2cd0617205d4936c85ab2a33232321c29","author":"Cursor Agent","timestamp":1787289659,"line":45,"text":"    }"},{"sha":"59b597c2cd0617205d4936c85ab2a33232321c29","author":"Cursor Agent","timestamp":1787289659,"line":46,"text":"  ],"},{"sha":"db481f3c643558b8140ada24dbd8c0978b611d30","author":"Cursor Agent","timestamp":1789216668,"line":47,"text":"  \"lookFor\": ["},{"sha":"db481f3c643558b8140ada24dbd8c0978b611d30","author":"Cursor Agent","timestamp":1789216668,"line":48,"text":"    \"[#12](source:s1) also asks logout to clear the session cookie. No hunk touches `src/api/logout.ts`.\","},{"sha":"6284efe1e3e79fd1ca0ddb2c1454594f4f5ef7f8","author":"Máté Molnár","timestamp":1793515095,"line":49,"text":"    \"[#12](source:s1) wants sessions that client scripts cannot read. Sessions issued before this change keep their old cookie until it expires; no hunk rotates them.\""},{"sha":"db481f3c643558b8140ada24dbd8c0978b611d30","author":"Cursor Agent","timestamp":1789216668,"line":50,"text":"  ],"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":51,"text":"  \"groups\": ["},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":52,"text":"    {"},{"sha":"ce37ae12a31e89d85e5dc95b4196576d03c8042c","author":"Cursor Agent","timestamp":1787406907,"line":53,"text":"      \"id\": \"cookie\","},{"sha":"ce37ae12a31e89d85e5dc95b4196576d03c8042c","author":"Cursor Agent","timestamp":1787406907,"line":54,"text":"      \"title\": \"Session cookie helper\","},{"sha":"3942655921e194989f89d2c8457b194172c9ed83","author":"Cursor Agent","timestamp":1787411833,"line":55,"text":"      \"why\": \"The login route needs one helper to apply the session cookie options.\","},{"sha":"ee9f79a7d6790f4e36ca9f027a1c799c3b386ced","author":"Cursor Agent","timestamp":1790349567,"line":56,"text":"      \"summary\": \"`setSessionCookie` applies the required options to session cookies, and its test checks them.\","},{"sha":"ce37ae12a31e89d85e5dc95b4196576d03c8042c","author":"Cursor Agent","timestamp":1787406907,"line":57,"text":"      \"part\": \"Session cookie\","},{"sha":"6284efe1e3e79fd1ca0ddb2c1454594f4f5ef7f8","author":"Máté Molnár","timestamp":1793515095,"line":58,"text":"      \"attention\": {"},{"sha":"6284efe1e3e79fd1ca0ddb2c1454594f4f5ef7f8","author":"Máté Molnár","timestamp":1793515095,"line":59,"text":"        \"kind\": \"contract\","},{"sha":"6284efe1e3e79fd1ca0ddb2c1454594f4f5ef7f8","author":"Máté Molnár","timestamp":1793515095,"line":60,"text":"        \"note\": \"`setSessionCookie` throws when a caller passes `httpOnly: false`. A caller that needs a cookie scripts can read now fails at runtime.\""},{"sha":"6284efe1e3e79fd1ca0ddb2c1454594f4f5ef7f8","author":"Máté Molnár","timestamp":1793515095,"line":61,"text":"      },"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":62,"text":"      \"suggestedOrder\": 0,"},{"sha":"ee9f79a7d6790f4e36ca9f027a1c799c3b386ced","author":"Cursor Agent","timestamp":1790349567,"line":63,"text":"      \"hunkRefs\": [\"src/auth/session.ts\", \"src/auth/session.test.ts\"]"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":64,"text":"    },"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":65,"text":"    {"},{"sha":"ce37ae12a31e89d85e5dc95b4196576d03c8042c","author":"Cursor Agent","timestamp":1787406907,"line":66,"text":"      \"id\": \"login\","},{"sha":"ce37ae12a31e89d85e5dc95b4196576d03c8042c","author":"Cursor Agent","timestamp":1787406907,"line":67,"text":"      \"title\": \"Login route\","},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":68,"text":"      \"why\": \"[#12](source:s1) requires HttpOnly session cookies. The route must set them through the helper.\","},{"sha":"123b37bed0b9c4dafff5b5a187a0f73192913854","author":"Cursor Agent","timestamp":1787409379,"line":69,"text":"      \"summary\": \"The login route in `login.ts` uses `setSessionCookie` from `session.ts`.\","},{"sha":"ce37ae12a31e89d85e5dc95b4196576d03c8042c","author":"Cursor Agent","timestamp":1787406907,"line":70,"text":"      \"part\": \"Session cookie\","},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":71,"text":"      \"sources\": [\"s1\"],"},{"sha":"6284efe1e3e79fd1ca0ddb2c1454594f4f5ef7f8","author":"Máté Molnár","timestamp":1793515095,"line":72,"text":"      \"attention\": {"},{"sha":"6284efe1e3e79fd1ca0ddb2c1454594f4f5ef7f8","author":"Máté Molnár","timestamp":1793515095,"line":73,"text":"        \"kind\": \"product\","},{"sha":"6284efe1e3e79fd1ca0ddb2c1454594f4f5ef7f8","author":"Máté Molnár","timestamp":1793515095,"line":74,"text":"        \"note\": \"With `rememberMe = false` the cookie has no `Max-Age`, so the session ends when the browser closes. Decide whether that is the intended behavior.\""},{"sha":"6284efe1e3e79fd1ca0ddb2c1454594f4f5ef7f8","author":"Máté Molnár","timestamp":1793515095,"line":75,"text":"      },"},{"sha":"ce37ae12a31e89d85e5dc95b4196576d03c8042c","author":"Cursor Agent","timestamp":1787406907,"line":76,"text":"      \"dependsOn\": [\"cookie\"],"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":77,"text":"      \"suggestedOrder\": 1,"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":78,"text":"      \"hunkRefs\": [\"src/api/login.ts\"]"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":79,"text":"    },"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":80,"text":"    {"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":81,"text":"      \"id\": \"docs\","},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":82,"text":"      \"title\": \"README wording\","},{"sha":"3942655921e194989f89d2c8457b194172c9ed83","author":"Cursor Agent","timestamp":1787411833,"line":83,"text":"      \"why\": \"The README still describes the previous cookie behavior.\","},{"sha":"123b37bed0b9c4dafff5b5a187a0f73192913854","author":"Cursor Agent","timestamp":1787409379,"line":84,"text":"      \"summary\": \"The README section on sessions matches the new cookie behavior.\","},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":85,"text":"      \"part\": \"README\","},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":86,"text":"      \"suggestedOrder\": 2,"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":87,"text":"      \"hunkRefs\": [\"README.md\"]"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":88,"text":"    }"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":89,"text":"  ]"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":90,"text":"}"},{"sha":"2cbb99191147fd1a87aad9563a4f103fd826b513","author":"Cursor Agent","timestamp":1787288235,"line":91,"text":"```"}]}
