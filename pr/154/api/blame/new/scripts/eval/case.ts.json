":13,"text":"});"},{"sha":"ecd0dd466758b53e56eefa0a780ab322a4cddc9a","author":"Cursor Agent","timestamp":1790350171,"line":14,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":15,"text":"const expectSchema = z"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":16,"text":"  .strictObject({"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":17,"text":"    why: z.enum([\"present\", \"absent\"]).optional(),"},{"sha":"ecd0dd466758b53e56eefa0a780ab322a4cddc9a","author":"Cursor Agent","timestamp":1790350171,"line":18,"text":"    parts: countRange.optional(),"},{"sha":"ecd0dd466758b53e56eefa0a780ab322a4cddc9a","author":"Cursor Agent","timestamp":1790350171,"line":19,"text":"    groups: countRange.optional(),"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":20,"text":"    size: z.array(z.enum(REVIEW_SIZES)).min(1).optional(),"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":21,"text":"    sourceKinds: z.array(z.enum(SOURCE_KINDS)).min(1).optional(),"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":22,"text":"    mechanicalPaths: pathSet.optional(),"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":23,"text":"    together: z.array(pathSet).optional(),"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":24,"text":"    apart: z.array(z.tuple([nonemptyString, nonemptyString])).optional(),"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":25,"text":"  })"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":26,"text":"  .optional();"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":27,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":28,"text":"const caseSchema = z.strictObject({"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":29,"text":"  id: nonemptyString,"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":30,"text":"  repo: nonemptyString,"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":31,"text":"  pr: z.number().int().positive(),"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":32,"text":"  base: nonemptyString,"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":33,"text":"  head: nonemptyString,"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":34,"text":"  tags: z.array(nonemptyString).default([]),"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":35,"text":"  expect: expectSchema,"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":36,"text":"});"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":37,"text":""},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":38,"text":"const rubricSchema = z.strictObject({"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":39,"text":"  must: z.array(nonemptyString),"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":40,"text":"  good: z.array(nonemptyString),"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":41,"text":"  mustNot: z.array(nonemptyString),"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":42,"text":"});"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":43,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":44,"text":"export type EvalCase = z.infer<typeof caseSchema>;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":45,"text":"export type EvalExpect = NonNullable<EvalCase[\"expect\"]>;"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":46,"text":"export type Rubric = z.infer<typeof rubricSchema>;"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":47,"text":""},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":48,"text":"export type ListedCase = { dir: string; spec: EvalCase; rubric: Rubric };"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":49,"text":""},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":50,"text":"const RUBRIC_SECTIONS: { key: keyof Rubric; heading: string }[] = ["},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":51,"text":"  { key: \"must\", heading: \"## Must\" },"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":52,"text":"  { key: \"good\", heading: \"## Good\" },"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":53,"text":"  { key: \"mustNot\", heading: \"## Must not\" },"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":54,"text":"];"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":55,"text":""},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":56,"text":"/** The grader lists come from `expected.md`: one `- ` bullet per line under each heading. */"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":57,"text":"export function parseExpectedMd(text: string): Rubric {"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":58,"text":"  const lines = text.split(\"\\n\");"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":59,"text":"  const bullets = (heading: string): string[] => {"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":60,"text":"    const start = lines.findIndex((line) => line.trim() === heading);"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":61,"text":"    if (start === -1) {"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":62,"text":"      throw new Error(`expected.md is missing ${heading}`);"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":63,"text":"    }"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":64,"text":"    const items: string[] = [];"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":65,"text":"    for (const line of lines.slice(start + 1)) {"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":66,"text":"      if (line.startsWith(\"## \")) {"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":67,"text":"        break;"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":68,"text":"      }"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":69,"text":"      if (line.startsWith(\"- \")) {"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":70,"text":"        items.push(line.slice(2).trim());"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":71,"text":"      }"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":72,"text":"    }"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":73,"text":"    return items;"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":74,"text":"  };"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":75,"text":"  return rubricSchema.parse("},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":76,"text":"    Object.fromEntries(RUBRIC_SECTIONS.map(({ key, heading }) => [key, bullets(heading)])),"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":77,"text":"  );"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":78,"text":"}"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":79,"text":""},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":80,"text":"export async function loadRubric(dir: string): Promise<Rubric> {"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":81,"text":"  let text: string;"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":82,"text":"  try {"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":83,"text":"    text = await readFile(join(dir, \"expected.md\"), \"utf8\");"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":84,"text":"  } catch {"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":85,"text":"    return { must: [], good: [], mustNot: [] };"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":86,"text":"  }"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":87,"text":"  try {"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":88,"text":"    return parseExpectedMd(text);"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":89,"text":"  } catch (error) {"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":90,"text":"    throw new Error("},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":91,"text":"      `${dir}/expected.md: ${error instanceof Error ? error.message : String(error)}`,"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":92,"text":"    );"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":93,"text":"  }"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":94,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":95,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":96,"text":"export function parseEvalCase(value: unknown): EvalCase {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":97,"text":"  return caseSchema.parse(value);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":98,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":99,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":100,"text":"export function parseEvalCaseJson(text: string): EvalCase {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":101,"text":"  let value: unknown;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":102,"text":"  try {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":103,"text":"    value = JSON.parse(text);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":104,"text":"  } catch {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":105,"text":"    throw new Error(\"case.json is not valid JSON\");"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":106,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":107,"text":"  return parseEvalCase(value);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":108,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":109,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":110,"text":"export async function loadEvalCase(dir: string): Promise<EvalCase> {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":111,"text":"  const loaded = parseEvalCaseJson(await readFile(join(dir, \"case.json\"), \"utf8\"));"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":112,"text":"  const folder = dir.replace(/\\\\/g, \"/\").split(\"/\").pop();"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":113,"text":"  if (folder !== loaded.id) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":114,"text":"    throw new Error(`case id \"${loaded.id}\" does not match folder \"${folder}\"`);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":115,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":116,"text":"  return loaded;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":117,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":118,"text":""},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":119,"text":"export async function listEvalCases(casesDir: string): Promise<ListedCase[]> {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":120,"text":"  const names = await readdir(casesDir, { withFileTypes: true });"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":121,"text":"  const loaded: ListedCase[] = [];"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":122,"text":"  for (const entry of names.sort((a, b) => a.name.localeCompare(b.name))) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":123,"text":"    if (!entry.isDirectory()) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":124,"text":"      continue;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":125,"text":"    }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":126,"text":"    const dir = join(casesDir, entry.name);"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":127,"text":"    loaded.push({ dir, spec: await loadEvalCase(dir), rubric: await loadRubric(dir) });"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":128,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":129,"text":"  return loaded;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":130,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":131,"text":""},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":132,"text":"export function selectEvalCases<T extends { spec: EvalCase }>("},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":133,"text":"  cases: T[],"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":134,"text":"  opts: { ids?: string[]; tag?: string },"},{"sha":"440230593329fe6616132e7e71a315ae63953624","author":"Máté Molnár","timestamp":1792773845,"line":135,"text":"): T[] {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":136,"text":"  return cases.filter(({ spec }) => {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":137,"text":"    if (opts.ids !== undefined && opts.ids.length > 0 && !opts.ids.includes(spec.id)) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":138,"text":"      return false;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":139,"text":"    }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":140,"text":"    if (opts.tag !== undefined && !spec.tags.includes(opts.tag)) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":141,"text":"      return false;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":142,"text":"    }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":143,"text":"    return true;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":144,"text":"  });"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":145,"text":"}"}]}
