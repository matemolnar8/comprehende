ates them.\""},{"sha":"db481f3c643558b8140ada24dbd8c0978b611d30","author":"Cursor Agent","timestamp":1789216668,"line":47,"text":"  ],"},{"sha":"49eaa02828541874edbb79ee96464387fceef7ad","author":"matemolnar8","timestamp":1786681607,"line":48,"text":"  \"groups\": ["},{"sha":"49eaa02828541874edbb79ee96464387fceef7ad","author":"matemolnar8","timestamp":1786681607,"line":49,"text":"    {"},{"sha":"ce37ae12a31e89d85e5dc95b4196576d03c8042c","author":"Cursor Agent","timestamp":1787406907,"line":50,"text":"      \"id\": \"cookie\","},{"sha":"ce37ae12a31e89d85e5dc95b4196576d03c8042c","author":"Cursor Agent","timestamp":1787406907,"line":51,"text":"      \"title\": \"Session cookie helper\","},{"sha":"3942655921e194989f89d2c8457b194172c9ed83","author":"Cursor Agent","timestamp":1787411833,"line":52,"text":"      \"why\": \"The login route needs one helper to apply the session cookie options.\","},{"sha":"ee9f79a7d6790f4e36ca9f027a1c799c3b386ced","author":"Cursor Agent","timestamp":1790349567,"line":53,"text":"      \"summary\": \"`setSessionCookie` applies the required options to session cookies, and its test checks them.\","},{"sha":"ce37ae12a31e89d85e5dc95b4196576d03c8042c","author":"Cursor Agent","timestamp":1787406907,"line":54,"text":"      \"part\": \"Session cookie\","},{"sha":"ed48e1ff7dd740ed2c2adf7a13544e9c2caa292a","author":"matemolnar8","timestamp":1786704985,"line":55,"text":"      \"lookFor\": ["},{"sha":"123b37bed0b9c4dafff5b5a187a0f73192913854","author":"Cursor Agent","timestamp":1787409379,"line":56,"text":"        \"Breaking. `setSessionCookie` throws when the caller passes `httpOnly: false`.\""},{"sha":"ed48e1ff7dd740ed2c2adf7a13544e9c2caa292a","author":"matemolnar8","timestamp":1786704985,"line":57,"text":"      ],"},{"sha":"49eaa02828541874edbb79ee96464387fceef7ad","author":"matemolnar8","timestamp":1786681607,"line":58,"text":"      \"suggestedOrder\": 0,"},{"sha":"ee9f79a7d6790f4e36ca9f027a1c799c3b386ced","author":"Cursor Agent","timestamp":1790349567