,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":13,"text":"    })),"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":14,"text":"  };"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":15,"text":"  return `${JSON.stringify(written, null, 2)}\\n`;"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":16,"text":"}"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":17,"text":""},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":18,"text":"export async function writeDocument(dataPath: string, document: ReviewDocument): Promise<void> {"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":19,"text":"  await mkdir(dirname(dataPath), { recursive: true });"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":20,"text":"  await writeFile(dataPath, reviewFileBody(document));"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":21,"text":"}"}]}
