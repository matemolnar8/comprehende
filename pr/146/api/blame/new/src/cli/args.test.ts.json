a3","author":"Cursor Agent","timestamp":1786673228,"line":136,"text":"      const text = lines.join(\"\\n\");"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":137,"text":"      assert.match(text, /Usage: comprehende/);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":138,"text":"      assert.match(text, /export/);"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":139,"text":"      assert.match(text, /review\\s+\\[--base/);"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":140,"text":"      assert.doesNotMatch(text, /^\\s+index\\s/m);"},{"sha":"53ce92c5822101e58c4083aa726af937877718a8","author":"matemolnar8","timestamp":1787001928,"line":141,"text":"      assert.ok(text.includes(readPackageVersion()));"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":142,"text":"      assert.match(text, /Unknown command: nope/);"},{"sha":"a05aef85c489e9ccd5c42f7b3397219b35b95719","author":"Máté Molnár","timestamp":1790020494,"line":143,"text":"      assert.match(text, /Unknown command: index/);"},{"sha":"bd6f3e1d9eb46b6563cd77474833eb78bcb7a45c","author":"Cursor Agent","timestamp":1789938724,"line":144,"text":"      assert.match(text, /missing --data <review.json>/);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":145,"text":"    } finally {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":146,"text":"      console.log = log;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":147,"text":"      console.error = err;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":148,"text":"    }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":149,"text":"  });"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":150,"text":"});"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":151,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":152,"text":"describe(\"isCliEntry\", () => {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":153,"text":"  it(\"accepts the npm bin shim and the built file\", () => {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":154,"text":"    assert.equal(isCliEntry(\"/tmp/dist/cli/main.js\", \"/tmp/node_modules/.bin/comprehende\"), true);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":155,"text":"    assert.equal(isCliEntry(\"/tmp/dist/cli/main.js\", \"/tmp/dist/cli/main.js\"), true);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":156,"text":"    assert.equal(isCliEntry(\"/tmp/src/cli/main.ts\", \"/tmp/src/cli/main.ts\"), true);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":157,"text":"    assert.equal(isCliEntry(\"/tmp/dist/cli/main.js\", \"/tmp/src/cli/args.test.ts\"), false);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":158,"text":"    assert.equal(isCliEntry(\"/tmp/dist/cli/main.js\", undefined), false);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":159,"text":"  });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":160,"text":"});"}]}
