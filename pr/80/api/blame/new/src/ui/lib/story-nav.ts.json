{"path":"src/ui/lib/story-nav.ts","ref":"f865bbb76de68ee5750ec0db3a02261094831d26","side":"new","lines":[{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":1,"text":"export type StoryGroup = {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":2,"text":"  id: string;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":3,"text":"  title: string;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":4,"text":"  dependsOn?: readonly string[];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":5,"text":"};"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":6,"text":""},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":7,"text":"export type StoryHop = {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":8,"text":"  id: string;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":9,"text":"  title: string;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":10,"text":"};"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":11,"text":""},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":12,"text":"export type StoryNav = {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":13,"text":"  dependsOn: StoryHop[];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":14,"text":"  dependents: StoryHop[];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":15,"text":"};"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":16,"text":""},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":17,"text":"export function storyNav(groups: readonly StoryGroup[], groupId: string): StoryNav {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":18,"text":"  const byId = new Map(groups.map((group) => [group.id, group]));"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":19,"text":"  const group = byId.get(groupId);"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":20,"text":"  if (group === undefined) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":21,"text":"    return { dependsOn: [], dependents: [] };"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":22,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":23,"text":"  return {"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":24,"text":"    dependsOn: (group.dependsOn ?? []).flatMap((id) => hop(byId, id)),"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":25,"text":"    dependents: groups.flatMap((item) => ((item.dependsOn ?? []).includes(groupId) ? hop(byId, item.id) : [])),"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":26,"text":"  };"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":27,"text":"}"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":28,"text":""},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":29,"text":"function hop(byId: Map<string, StoryGroup>, id: string): StoryHop[] {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":30,"text":"  const group = byId.get(id);"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":31,"text":"  return group === undefined ? [] : [{ id, title: group.title }];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":32,"text":"}"}]}
