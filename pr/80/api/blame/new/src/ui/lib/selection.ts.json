{"path":"src/ui/lib/selection.ts","ref":"f865bbb76de68ee5750ec0db3a02261094831d26","side":"new","lines":[{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":1,"text":"import { REVIEW_BUCKETS, type ReviewBucket } from \"../../api/types.ts\";"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":2,"text":"import { padIndex } from \"../../schema/types.ts\";"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":3,"text":"import type { ReviewMeta } from \"../api.ts\";"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":4,"text":"import { groupOrderIndex, groupParts, isMixedReview, type Part, type PartGroup } from \"./parts.ts\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":5,"text":"import { readKey, writeKey } from \"./storage.ts\";"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":6,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":7,"text":"export type Selection = { kind: \"overview\" } | { kind: \"group\"; id: string } | { kind: ReviewBucket };"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":8,"text":""},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":9,"text":"export type SelectionStackSource = {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":10,"text":"  groups: PartGroup[];"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":11,"text":"  unassigned: { hunkCount: number };"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":12,"text":"  lockfiles?: { fileCount: number };"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":13,"text":"};"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":14,"text":""},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":15,"text":"export type PartShiftSource = {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":16,"text":"  groups: PartGroup[];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":17,"text":"};"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":18,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":19,"text":"export function defaultSelection(source: SelectionStackSource): Selection {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":20,"text":"  if (source.groups.length > 0) {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":21,"text":"    return { kind: \"overview\" };"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":22,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":23,"text":"  return { kind: REVIEW_BUCKETS.unassigned };"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":24,"text":"}"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":25,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":26,"text":"export function selectionStorageKey(baseSha: string, headSha: string): string {"},{"sha":"e9b20d5d583fc4d220337a9ff22e1e6bcf6373e7","author":"Cursor Agent","timestamp":1787413230,"line":27,"text":"  return `comprehende.group.${baseSha}.${headSha}`;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":28,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":29,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":30,"text":"export function parseSelection(raw: string | null): Selection | null {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":31,"text":"  if (raw === null || raw === \"\") {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":32,"text":"    return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":33,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":34,"text":"  try {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":35,"text":"    const parsed: unknown = JSON.parse(raw);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":36,"text":"    if (typeof parsed !== \"object\" || parsed === null || !(\"kind\" in parsed)) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":37,"text":"      return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":38,"text":"    }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":39,"text":"    if (parsed.kind === \"overview\") {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":40,"text":"      return { kind: \"overview\" };"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":41,"text":"    }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":42,"text":"    if (parsed.kind === REVIEW_BUCKETS.unassigned) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":43,"text":"      return { kind: REVIEW_BUCKETS.unassigned };"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":44,"text":"    }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":45,"text":"    if (parsed.kind === REVIEW_BUCKETS.lockfiles) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":46,"text":"      return { kind: REVIEW_BUCKETS.lockfiles };"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":47,"text":"    }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":48,"text":"    if (parsed.kind === \"group\" && \"id\" in parsed && typeof parsed.id === \"string\" && parsed.id !== \"\") {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":49,"text":"      return { kind: \"group\", id: parsed.id };"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":50,"text":"    }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":51,"text":"    return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":52,"text":"  } catch {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":53,"text":"    return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":54,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":55,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":56,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":57,"text":"export function serializeSelection(selection: Selection): string {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":58,"text":"  return JSON.stringify(selection);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":59,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":60,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":61,"text":"export function restoreSelection(source: SelectionStackSource, stored: Selection | null): Selection {"},{"sha":"b5e2c3e0733d804aee4f4adf06766621138e3c78","author":"Máté Molnár","timestamp":1788535976,"line":62,"text":"  // Invariant: unknown or missing buckets fall back to the default selection."},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":63,"text":"  if (stored === null) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":64,"text":"    return defaultSelection(source);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":65,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":66,"text":"  if (stored.kind === \"group\" && !source.groups.some((group) => group.id === stored.id)) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":67,"text":"    return defaultSelection(source);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":68,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":69,"text":"  if (stored.kind === REVIEW_BUCKETS.unassigned && source.unassigned.hunkCount === 0 && source.groups.length > 0) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":70,"text":"    return defaultSelection(source);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":71,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":72,"text":"  if (stored.kind === REVIEW_BUCKETS.lockfiles && (source.lockfiles?.fileCount ?? 0) === 0) {"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":73,"text":"    return defaultSelection(source);"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":74,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":75,"text":"  return stored;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":76,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":77,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":78,"text":"export function readStoredSelection(baseSha: string, headSha: string): Selection | null {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":79,"text":"  return parseSelection(readKey(sessionStorage, selectionStorageKey(baseSha, headSha)));"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":80,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":81,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":82,"text":"export function writeStoredSelection(baseSha: string, headSha: string, selection: Selection): void {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":83,"text":"  writeKey(sessionStorage, selectionStorageKey(baseSha, headSha), serializeSelection(selection));"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":84,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":85,"text":""},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":86,"text":"/** Overview, then groups in part / dependsOn order. Unassigned and lockfiles stay off this walk. */"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":87,"text":"export function groupWalk(source: SelectionStackSource): Selection[] {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":88,"text":"  const parts = groupParts(source.groups);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":89,"text":"  return ["},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":90,"text":"    { kind: \"overview\" },"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":91,"text":"    ...parts.flatMap((part) => part.groupIds.map((id) => ({ kind: \"group\" as const, id }))),"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":92,"text":"  ];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":93,"text":"}"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":94,"text":""},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":95,"text":"export function selectionStack(source: SelectionStackSource): Selection[] {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":96,"text":"  const ids = groupWalk(source);"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":97,"text":"  if (source.unassigned.hunkCount > 0) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":98,"text":"    ids.push({ kind: REVIEW_BUCKETS.unassigned });"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":99,"text":"  }"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":100,"text":"  if ((source.lockfiles?.fileCount ?? 0) > 0) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":101,"text":"    ids.push({ kind: REVIEW_BUCKETS.lockfiles });"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":102,"text":"  }"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":103,"text":"  return ids;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":104,"text":"}"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":105,"text":""},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":106,"text":"export function neighborSelection("},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":107,"text":"  source: SelectionStackSource | null,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":108,"text":"  selection: Selection | null,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":109,"text":"  delta: number,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":110,"text":"): Selection | undefined {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":111,"text":"  if (source === null || delta === 0) {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":112,"text":"    return undefined;"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":113,"text":"  }"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":114,"text":"  const walk = partWalk(source, selection);"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":115,"text":"  const current = walk.findIndex((item) => sameSelection(item, selection));"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":116,"text":"  if (current >= 0) {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":117,"text":"    return walk[current + delta];"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":118,"text":"  }"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":119,"text":"  if (delta < 0) {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":120,"text":"    return walk[walk.length - 1];"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":121,"text":"  }"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":122,"text":"  return undefined;"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":123,"text":"}"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":124,"text":""},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":125,"text":"/** Overview, then the current part in dependsOn order. From overview, that is the first part. */"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":126,"text":"function partWalk(source: SelectionStackSource, selection: Selection | null): Selection[] {"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":127,"text":"  const parts = groupParts(source.groups);"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":128,"text":"  const part = partForWalk(parts, selection);"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":129,"text":"  return ["},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":130,"text":"    { kind: \"overview\" },"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":131,"text":"    ...(part?.groupIds ?? []).map((id) => ({ kind: \"group\" as const, id })),"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":132,"text":"  ];"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":133,"text":"}"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":134,"text":""},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":135,"text":"function partForWalk(parts: readonly Part[], selection: Selection | null): Part | undefined {"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":136,"text":"  if (selection?.kind === \"group\") {"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":137,"text":"    return parts.find((item) => item.groupIds.includes(selection.id)) ?? parts[0];"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":138,"text":"  }"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":139,"text":"  if (selection?.kind === REVIEW_BUCKETS.unassigned || selection?.kind === REVIEW_BUCKETS.lockfiles) {"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":140,"text":"    return parts[parts.length - 1];"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":141,"text":"  }"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":142,"text":"  return parts[0];"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":143,"text":"}"},{"sha":"f865bbb76de68ee5750ec0db3a02261094831d26","author":"Cursor Agent","timestamp":1789295650,"line":144,"text":""},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":145,"text":"export function shiftSelection("},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":146,"text":"  source: SelectionStackSource | null,"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":147,"text":"  selection: Selection | null,"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":148,"text":"  setSelection: (selection: Selection) => void,"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":149,"text":"  delta: number,"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":150,"text":"): void {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":151,"text":"  const next = neighborSelection(source, selection, delta);"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":152,"text":"  if (next !== undefined) {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":153,"text":"    setSelection(next);"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":154,"text":"  }"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":155,"text":"}"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":156,"text":""},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":157,"text":"export function shiftPartSelection("},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":158,"text":"  meta: PartShiftSource | null,"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":159,"text":"  selection: Selection | null,"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":160,"text":"  setSelection: (selection: Selection) => void,"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":161,"text":"  delta: number,"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":162,"text":"): void {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":163,"text":"  if (meta === null || selection === null || selection.kind === REVIEW_BUCKETS.unassigned || selection.kind === REVIEW_BUCKETS.lockfiles) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":164,"text":"    return;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":165,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":166,"text":"  const parts = groupParts(meta.groups);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":167,"text":"  if (!isMixedReview(parts)) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":168,"text":"    return;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":169,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":170,"text":"  const current ="},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":171,"text":"    selection.kind === \"group\" ? parts.findIndex((part) => part.groupIds.includes(selection.id)) : delta > 0 ? -1 : parts.length;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":172,"text":"  if (selection.kind === \"group\" && current < 0) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":173,"text":"    return;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":174,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":175,"text":"  const next = parts[(current + delta + parts.length) % parts.length];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":176,"text":"  const id = next?.groupIds[0];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":177,"text":"  if (id !== undefined && (selection.kind !== \"group\" || id !== selection.id)) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":178,"text":"    setSelection({ kind: \"group\", id });"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":179,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":180,"text":"}"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":181,"text":""},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":182,"text":"export function sameSelection(a: Selection, b: Selection | null): boolean {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":183,"text":"  if (b === null) {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":184,"text":"    return false;"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":185,"text":"  }"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":186,"text":"  if (a.kind === \"overview\") {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":187,"text":"    return b.kind === \"overview\";"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":188,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":189,"text":"  if (a.kind === REVIEW_BUCKETS.unassigned) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":190,"text":"    return b.kind === REVIEW_BUCKETS.unassigned;"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":191,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":192,"text":"  if (a.kind === REVIEW_BUCKETS.lockfiles) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":193,"text":"    return b.kind === REVIEW_BUCKETS.lockfiles;"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":194,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":195,"text":"  return a.kind === \"group\" && b.kind === \"group\" && b.id === a.id;"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":196,"text":"}"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":197,"text":""},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":198,"text":"export function selectionNavLabel("},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":199,"text":"  meta: Pick<ReviewMeta, \"document\" | \"groups\">,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":200,"text":"  selection: Selection,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":201,"text":"): string {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":202,"text":"  const caption = selectionCaption(meta, selection);"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":203,"text":"  return caption.index !== undefined ? `${caption.index} ${caption.title}` : caption.title;"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":204,"text":"}"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":205,"text":""},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":206,"text":"export function selectionCaption("},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":207,"text":"  meta: Pick<ReviewMeta, \"document\" | \"groups\">,"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":208,"text":"  selection: Selection | null,"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":209,"text":"): { index?: string; title: string } {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":210,"text":"  if (selection === null || selection.kind === \"overview\") {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":211,"text":"    return { title: \"Overview\" };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":212,"text":"  }"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":213,"text":"  if (selection.kind === \"group\") {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":214,"text":"    const parts = groupParts(meta.groups);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":215,"text":"    const index = groupOrderIndex(parts, selection.id);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":216,"text":"    const group = meta.groups.find((item) => item.id === selection.id);"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":217,"text":"    return {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":218,"text":"      index: index > 0 ? padIndex(index) : undefined,"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":219,"text":"      title: group?.title ?? \"Group\","},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":220,"text":"    };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":221,"text":"  }"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":222,"text":"  if (selection.kind === REVIEW_BUCKETS.unassigned) {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":223,"text":"    return { title: \"Unassigned\" };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":224,"text":"  }"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":225,"text":"  return { title: \"Lockfiles\" };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":226,"text":"}"}]}
