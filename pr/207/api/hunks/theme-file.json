`);\n+    }\n+    return { path, theme: parsed.theme };\n+  }\n+  return undefined;\n+}\n","complete":true,"hunks":[{"path":"src/api/theme.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":32,"header":"@@ -0,0 +1,32 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import { readFile } from \"node:fs/promises\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import { homedir } from \"node:os\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import { join } from \"node:path\";"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"import { parseThemeJson, type Theme } from \"../schema/theme.ts\";"},{"kind":"add","oldNumber":null,"newNumber":5,"text":""},{"kind":"add","oldNumber":null,"newNumber":6,"text":"export const THEME_FILE = join(\".comprehende\", \"theme.json\");"},{"kind":"add","oldNumber":null,"newNumber":7,"text":""},{"kind":"add","oldNumber":null,"newNumber":8,"text":"export type LoadedTheme = { path: string; theme: Theme };"},{"kind":"add","oldNumber":null,"newNumber":9,"text":""},{"kind":"add","oldNumber":null,"newNumber":10,"text":"/** The project's theme file wins over the user's, whole: the two never merge. */"},{"kind":"add","oldNumber":null,"newNumber":11,"text":"export async function loadTheme("},{"kind":"add","oldNumber":null,"newNumber":12,"text":"  repoRoot: string,"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"  home = homedir(),"},{"kind":"add","oldNumber":null,"newNumber":14,"text":"): Promise<LoadedTheme | undefined> {"},{"kind":"add","oldNumber":null,"newNumber":15,"text":"  for (const path of [join(repoRoot, THEME_FILE), join(home, THEME_FILE)]) {"},{"kind":"add","oldNumber":null,"newNumber":16,"text":"    let text: string;"},{"kind":"add","oldNumber":null,"newNumber":17,"text":"    try {"},{"kind":"add","oldNumber":null,"newNumber":18,"text":"      text = await readFile(path, \"utf8\");"},{"kind":"add","oldNumber":null,"newNumber":19,"text":"    } catch (error) {"},{"kind":"add","oldNumber":null,"newNumber":20,"text":"      if (error instanceof Error && \"code\" in error && error.code === \"ENOENT\") {"},{"kind":"add","oldNumber":null,"newNumber":21,"text":"        continue;"},{"kind":"add","oldNumber":null,"newNumber":22,"text":"      }"},{"kind":"add","oldNumber":null,"newNumber":23,"text":"      throw error;"},{"kind":"add","oldNumber":null,"newNumber":24,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":25,"text":"    const parsed = parseThemeJson(text);"},{"kind":"add","oldNumber":null,"newNumber":26,"text":"    if (!parsed.ok) {"},{"kind":"add","oldNumber":null,"newNumber":27,"text":"      throw new Error(`invalid theme ${path}:\\n${parsed.error}`);"},{"kind":"add","oldNumber":null,"newNumber":28,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":29,"text":"    return { path, theme: parsed.theme };"},{"kind":"add","oldNumber":null,"newNumber":30,"text":"  }"},{"kind":"add","oldNumber":null,"newNumber":31,"text":"  return undefined;"},{"kind":"add","oldNumber":null,"newNumber":32,"text":"}"}]}]},{"path":"src/api/theme.test.ts","kind":"text","status":"added","patch":"diff --git a/src/api/theme.test.ts b/src/api/theme.test.ts\nnew file mode 100644\nindex 00000000..3c951780\n--- /dev/null\n+++ b/src/api/theme.test.ts\n@@ -0,0 +1,98 @@\n+import assert from \"node:assert/strict\";\n+import { mkdir, mkdtemp, readFile, rm, writeFile } from \"node:fs/promises\";\n+import { tmpdir } from \"node:os\";\n+import { join } from \"node:path\";\n+import { afterEach, describe, it } from \"vite-plus/test\";\n+import { findPackageRoot } from \"../package-root.ts\";\n+import { parseThemeJson, THEME_TOKENS } from \"../schema/theme.ts\";\n+import { loadTheme } from \"./theme.ts\";\n+\n+const roots: string[] = [];\n+\n+afterEach(async () => {\n+  await Promise.all(roots.splice(0).map((root) => rm(root, { recursive: true, force: true })));\n+});\n+\n+async function folders() {\n+  const root = await mkdtemp(join(tmpdir(), \"comprehende-theme-\"));\n+  roots.push(root);\n+  const repo = join(root, \"repo\");\n+  const home = join(root, \"home\");\n+  await Promise.all([\n+    mkdir(join(repo, \".comprehende\"), { recursive: true }),\n+    mkdir(join(home, \".comprehende\"), { recursive: true }),\n+  ]);\n+  return { repo, home };\n+}\n+\n+describe(\"loadTheme\", () => {\n+  it(\"prefers the repository file over the home file, whole\", async () => {\n+    const { repo, home } = await folders();\n+    await writeFile(\n+      join(home, \".comprehende/theme.json\"),\n+      '{\"radius\":\"1rem\",\"dark\":{\"ring\":\"#fff\"}}',\n+    );\n+    await writeFile(join(repo, \".comprehende/theme.json\"), '{\"dark\":{\"primary\":\"#fbbf24\"}}');\n+\n+    const loaded = await loadTheme(repo, home);\n+\n+    assert.equal(loaded?.path, join(repo, \".comprehende/theme.json\"));\n+    assert.deepEqual(loaded?.theme, { dark: { primary: \"#fbbf24\" } });\n+  });\n+\n+  it(\"falls back to the home file, and to nothing\", async () => {\n+    const { repo, home } = await folders();\n+    assert.equal(await loadTheme(repo, home), undefined);\n+\n+    await writeFile(\n+      join(home, \".comprehende/theme.json\"),\n+      '{\"light\":{\"primary\":\"oklch(0.67 0.16 58)\"}}',\n+    );\n+    assert.equal((await loadTheme(repo, home))?.path, join(home, \".comprehende/theme.json\"));\n+  });\n+\n+  it(\"names the file and the field when the theme is invalid\", async () => {\n+    const { repo, home } = await folders();\n+    await writeFile(join(repo, \".comprehende/theme.json\"), '{\"dark\":{\"primry\":\"#fff\"}}');\n+\n+    await assert.rejects(() => loadTheme(repo, home), /invalid theme .*theme\\.json[\\s\\S]*primry/);\n+  });\n+});\n+\n+describe(\"parseThemeJson\", () => {\n+  it(\"accepts hex and colour functions\", () => {\n+    const parsed = parseThemeJson(\n+      JSON.stringify({\n+        light: { primary: \"#d97706\", border: \"rgb(226 232 240 / 80%)\", ring: \"oklch(0.7 0.15 70)\" },\n+      }),\n+    );\n+    assert.equal(parsed.ok, true);\n+  });\n+\n+  it(\"rejects values that are not a literal colour\", () => {\n+    for (const value of [\n+      \"red; } body { display: none\",\n+      \"var(--color-amber-400)\",\n+      \"url(x)\",\n+      \"amber\",\n+      \"#12345\",\n+      \"oklch(nope)\",\n+      \"rgb()\",\n+    ]) {\n+      const parsed = parseThemeJson(JSON.stringify({ dark: { primary: value } }));\n+      assert.equal(parsed.ok, false, value);\n+    }\n+  });\n+});\n+\n+describe(\"THEME_TOKENS\", () => {\n+  it(\"names a variable that styles.css sets\", async () => {\n+    const css = await readFile(join(findPackageRoot(), \"src/ui/styles.css\"), \"utf8\");\n+    const start = css.indexOf(\"\\n:root {\");\n+    const root = css.slice(start, css.indexOf(\"\\n}\", start));\n+    assert.deepEqual(\n+      THEME_TOKENS.filter((token) => !root.includes(`--${token}:`)),\n+      [],\n+    );\n+  });\n+});\n","complete":true,"hunks":[{"path":"src/api/theme.test.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":98,"header":"@@ -0,0 +1,98 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import assert from \"node:assert/strict\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import { mkdir, mkdtemp, readFile, rm, writeFile } from \"node:fs/promises\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import { tmpdir } from \"node:os\";"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"import { join } from \"node:path\";"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"import { afterEach, describe, it } from \"vite-plus/test\";"},{"kind":"add","oldNumber":null,"newNumber":6,"text":"import { findPackageRoot } from \"../package-root.ts\";"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"import { parseThemeJson, THEME_TOKENS } from \"../schema/theme.ts\";"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"import { loadTheme } from \"./theme.ts\";"},{"kind":"add","oldNumber":null,"newNumbe