ons\", () => {"},{"kind":"add","oldNumber":null,"newNumber":64,"text":"    const parsed = parseThemeJson("},{"kind":"add","oldNumber":null,"newNumber":65,"text":"      JSON.stringify({"},{"kind":"add","oldNumber":null,"newNumber":66,"text":"        light: { primary: \"#d97706\", border: \"rgb(226 232 240 / 80%)\", ring: \"oklch(0.7 0.15 70)\" },"},{"kind":"add","oldNumber":null,"newNumber":67,"text":"      }),"},{"kind":"add","oldNumber":null,"newNumber":68,"text":"    );"},{"kind":"add","oldNumber":null,"newNumber":69,"text":"    assert.equal(parsed.ok, true);"},{"kind":"add","oldNumber":null,"newNumber":70,"text":"  });"},{"kind":"add","oldNumber":null,"newNumber":71,"text":""},{"kind":"add","oldNumber":null,"newNumber":72,"text":"  it(\"rejects values that are not a literal colour\", () => {"},{"kind":"add","oldNumber":null,"newNumber":73,"text":"    for (const value of ["},{"kind":"add","oldNumber":null,"newNumber":74,"text":"      \"red; } body { display: none\","},{"kind":"add","oldNumber":null,"newNumber":75,"text":"      \"var(--color-amber-400)\","},{"kind":"add","oldNumber":null,"newNumber":76,"text":"      \"url(x)\","},{"kind":"add","oldNumber":null,"newNumber":77,"text":"      \"amber\","},{"kind":"add","oldNumber":null,"newNumber":78,"text":"      \"#12345\","},{"kind":"add","oldNumber":null,"newNumber":79,"text":"      \"oklch(nope)\","},{"kind":"add","oldNumber":null,"newNumber":80,"text":"      \"rgb()\","},{"kind":"add","oldNumber":null,"newNumber":81,"text":"    ]) {"},{"kind":"add","oldNumber":null,"newNumber":82,"text":"      const parsed = parseThemeJson(JSON.stringify({ dark: { primary: value } }));"},{"kind":"add","oldNumber":null,"newNumber":83,"text":"      assert.equal(parsed.ok, false, value);"},{"kind":"add","oldNumber":null,"newNumber":84,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":85,"text":"  });"},{"kind":"add","oldNumber":null,"newNumber":86,"text":"});"},{"kind":"add","oldNumber":null,"newNumber":87,"text":""},{"kind":"add","oldNumber":null,"newNumber":88,"text":"describe(\"THEME_TOKENS\", () => {"},{"kind":"add","oldNumber":null,"newNumber":89,"text":"  it(\"names a variable that styles.css sets\", async () => {"},{"kind":"add","oldNumber":null,"newNumber":90,"text":"    const css = await readFile(join(findPackageRoot(), \"src/ui/styles.css\"), \"utf8\");"},{"kind":"add","oldNumber":null,"newNumber":91,"text":"    const start = css.indexOf(\"\\n:root {\");"},{"kind":"add","oldNumber":null,"newNumber":92,"text":"    const root = css.slice(start, css.indexOf(\"\\n}\", start));"},{"kind":"add","oldNumber":null,"newNumber":93,"text":"    assert.deepEqual("},{"kind":"add","oldNumber":null,"newNumber":94,"text":"      THEME_TOKENS.filter((token) => !root.includes(`--${token}:`)),"},{"kind":"add","oldNumber":null,"newNumber":95,"text":"      [],"},{"kind":"add","oldNumber":null,"newNumber":96,"text":"    );"},{"kind":"add","oldNumber":null,"newNumber":97,"text":"  });"},{"kind":"add","oldNumber":null,"newNumber":98,"text":"});"}]}],"files":[{"path":"src/schema/theme.ts","kind":"text","status":"added","patch":"diff --git a/src/schema/theme.ts b/src/schema/theme.ts\nnew file mode 100644\nindex 00000000..dffc3387\n--- /dev/null\n+++ b/src/schema/theme.ts\n@@ -0,0 +1,82 @@\n+import * as z from \"zod\";\n+\n+/** The UI colour variables a theme may set. Each one is a `--<token>` in `src/ui/styles.css`, in light and dark. */\n+export const THEME_TOKENS = [\n+  \"background\",\n+  \"foreground\",\n+  \"card\",\n+  \"card-foreground\",\n+  \"popover\",\n+  \"popover-foreground\",\n+  \"primary\",\n+  \"primary-foreground\",\n+  \"secondary\",\n+  \"secondary-foreground\",\n+  \"muted\",\n+  \"muted-foreground\",\n+  \"accent\",\n+  \"accent-foreground\",\n+  \"destructive\",\n+  \"border\",\n+  \"input\",\n+  \"ring\",\n+  \"add\",\n+  \"del\",\n+  \"warn\",\n+  \"moved\",\n+  \"strand-0\",\n+  \"strand-1\",\n+  \"strand-2\",\n+  \"strand-3\",\n+  \"strand-4\",\n+  \"strand-5\",\n+  \"diff-canvas\",\n+  \"diff-fg\",\n+  \"diff-add-line\",\n+  \"diff-add-num\",\n+  \"diff-add-word\",\n+  \"diff-del-line\",\n+  \"diff-del-num\",\n+  \"diff-del-word\",\n+  \"diff-hunk\",\n+  \"diff-hover\",\n+] as const;\n+\n+export type ThemeToken = (typeof THEME_TOKENS)[number];\n+\n+const HEX = String.raw`#([0-9a-f]{3,4}|[0-9a-f]{6}|[0-9a-f]{8})`;\n+const ARG = String.raw`([-+]?(\\d+\\.?\\d*|\\.\\d+)(%|deg|rad|grad|turn)?|none)`;\n+const FUNCTION = String.raw`(rgba?|hsla?|hwb|lab|lch|oklab|oklch)\\(\\s*${ARG}([\\s,/]+${ARG})*\\s*\\)`;\n+\n+/** Literal colours only. An export is a public page, so a value never carries other CSS. */\n+const color = z.string().regex(new RegExp(`^(${HEX}|${FUNCTION})$`, \"i\"), {\n+  error: \"must be a hex colour or a CSS colour function such as oklch(0.7 0.15 70)\",\n+});\n+\n+const palette = z.partialRecord(z.enum(THEME_TOKENS), color);\n+\n+export const themeSchema = z.strictObject({\n+  radius: z\n+    .string()\n+    .regex(/^\\d*\\.?\\d+(rem|px)$/, { error: \"must be a length in rem or px, such as 0.5rem\" })\n+    .optional(),\n+  light: palette.optional(),\n+  dark: palette.optional(),\n+});\n+\n+export type Theme = z.infer<typeof themeSchema>;\n+\n+export type ThemeParseResult = { ok: true; theme: Theme } | { ok: false; error: string };\n+\n+export function parseThemeJson(text: string): ThemeParseResult {\n+  let input: unknown;\n+  try {\n+    input = JSON.parse(text);\n+  } catch (error) {\n+    return { ok: false, error: error instanceof Error ? error.message : String(error) };\n+  }\n+  const result = themeSchema.safeParse(input);\n+  return result.success\n+    ? { ok: true, theme: result.data }\n+    : { ok: false, error: z.prettifyError(result.error) };\n+}\n","complete":true,"hunks":[{"path":"src/schema/theme.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":82,"header":"@@ -0,0 +1,82 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import * as z from \"zod\";"},{"kind":"add","ol