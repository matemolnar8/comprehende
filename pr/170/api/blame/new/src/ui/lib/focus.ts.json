s edge widens to the whole"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":54,"text":" * block when the cut-off part holds the other side: a range that starts on an added line also"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":55,"text":" * shows the deletions that block replaces. A block of only additions stays cut."},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":56,"text":" */"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":57,"text":"export function rangeLines(lines: readonly DiffLine[], range: FocusRange): number[] {"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":58,"text":"  const number = (line: DiffLine) => (range.side === \"old\" ? line.oldNumber : line.newNumber);"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":59,"text":"  const inside = lines.map((line) => {"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":60,"text":"    const n = number(line);"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":61,"text":"    return n !== null && n >= range.start && n <= range.end;"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":62,"text":"  });"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":63,"text":"  let first = inside.indexOf(true);"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":64,"text":"  let last = inside.lastIndexOf(true);"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":65,"text":"  if (fir