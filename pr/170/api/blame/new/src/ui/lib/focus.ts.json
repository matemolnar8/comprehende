;"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":79,"text":"  }"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":80,"text":"  let blockEnd = last;"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":81,"text":"  while (changed(last) && changed(blockEnd + 1)) blockEnd += 1;"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":82,"text":"  if (pairs(last + 1, blockEnd)) {"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":83,"text":"    last = blockEnd;"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":84,"text":"  }"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":85,"text":"  return Array.from({ length: last - first + 1 }, (_, i) => first + i);"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":86,"text":"}"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":87,"text":""},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":88,"text":"/** Notes in a focused hunk that its shown lines leave out. */"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":89,"text":"export function hiddenNotes("},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":90,"text":"  hunk: LiveHunk,"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":91,"text":"  focus: HunkFocus,"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":92,"text":"  notes: readonly 