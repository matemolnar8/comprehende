length !== hunks.length || starts[0] === undefined) {"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":120,"text":"    return patch;"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":121,"text":"  }"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":122,"text":"  const out = lines.slice(0, starts[0]);"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":123,"text":"  starts.forEach((start, i) => {"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":124,"text":"    const hunk = hunks[i];"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":125,"text":"    const focus = collapsed.find((item) => item.hunk === i);"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":126,"text":"    if (hunk === undefined || focus === undefined) {"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":127,"text":"      out.push(...lines.slice(start, starts[i + 1] ?? lines.length));"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":128,"text":"      return;"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":129,"text":"    }"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":130,"text":"    for (const run of runs(focus.shown)) {"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":131,"text":"      out.push(...subHunk(hunk, run));"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":132,"text":"    }"},{"sha":"