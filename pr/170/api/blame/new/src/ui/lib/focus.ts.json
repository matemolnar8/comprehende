"line":146,"text":"    }"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":147,"text":"  }"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":148,"text":"  return out;"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":149,"text":"}"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":150,"text":""},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":151,"text":"const MARK = { ctx: \" \", add: \"+\", del: \"-\" } as const;"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":152,"text":""},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":153,"text":"function subHunk(hunk: LiveHunk, run: readonly number[]): string[] {"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":154,"text":"  const first = run[0] ?? 0;"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":155,"text":"  const before = hunk.lines.slice(0, first);"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":156,"text":"  const picked = run.flatMap((i) => hunk.lines[i] ?? []);"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":157,"text":"  const count = (list: readonly DiffLine[], side: \"oldNumber\" | \"newNumber\") =>"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":158,"text":"    list.filter((line) => line[side] !== null).length;"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":159,"text":"  // An empty side starts on the line before the excerpt, as git writes it. A hunk that is empty on"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":160,"text":"  // that side already names that line."},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":161,"text":"  const start = (hunkStart: number, hunkLines: number, side: \"oldNumber\" | \"newNumber\") => {"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":162,"text":"    const at = hunkStart + count(before, side);"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":163,"text":"    return count(picked, side) === 0 && hunkLines > 0 ? at - 1 : at;"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":164,"text":"  };"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":165,"text":"  const header = `@@ -${start(hunk.oldStart, hunk.oldLines, \"oldNumber\")},${count(picked, \"oldNumber\")} +${start(hunk.newStart, hunk.newLines, \"newNumber\")},${count(picked, \"newNumber\")} @@`;"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":166,"text":"  return [header, ...picked.map((line) => `${MARK[line.kind]}${line.text}`)];"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":167,"text":"}"}]}
