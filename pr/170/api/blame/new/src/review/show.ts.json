{"path":"src/review/show.ts","ref":"40fb350b116d4142086135bae7691f55d33ea6b1","side":"new","lines":[{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":1,"text":"import type { DiffFile, LiveHunk } from \"../schema/types.ts\";"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":2,"text":""},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":3,"text":"/**"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":4,"text":" * The file header, then each hunk with its old and new line numbers before the diff mark, so a"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":5,"text":" * focus range or note copies numbers instead of counting from the `@@` header. Reads the raw hunk"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":6,"text":" * text, so git's `\\ No newline at end of file` marker stays."},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":7,"text":" */"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":8,"text":"export function numberedPatch(file: DiffFile, hunks: readonly LiveHunk[]): string {"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":9,"text":"  if (hunks.every((hunk) => hunk.lines.length === 0)) {"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":10,"text":"    return file.patch;"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":11,"text":"  }"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":12,"text":"  const width = String("},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":13,"text":"    Math.max("},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":14,"text":"      ...hunks.map((hunk) =>"},{"sha":"bae4cb6f4b805dbf6b219bc9416d522ea39e4f5f","author":"Máté Molnár","timestamp":1793522879,"line":15,"text":"        Math.max(hunk.oldStart + hunk.oldLines - 1, hunk.newStart + hunk.newLines - 1),"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":16,"text":"      ),"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":17,"text":"    ),"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":18,"text":"  ).length;"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":19,"text":"  const cell = (n?: number): string => (n === undefined ? \"\" : String(n)).padStart(width);"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":20,"text":"  const body = hunks.flatMap((hunk) => {"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":21,"text":"    const [header = hunk.header, ...raw] = hunk.patch.replace(/\\n$/, \"\").split(\"\\n\");"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":22,"text":"    let oldNumber = hunk.oldStart;"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":23,"text":"    let newNumber = hunk.newStart;"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":24,"text":"    const numbered = raw.map((line) => {"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":25,"text":"      const mark = line[0];"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":26,"text":"      if (mark === \"+\") {"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":27,"text":"        return `${cell()} ${cell(newNumber++)} ${line}`;"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":28,"text":"      }"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":29,"text":"      if (mark === \"-\") {"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":30,"text":"        return `${cell(oldNumber++)} ${cell()} ${line}`;"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":31,"text":"      }"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":32,"text":"      if (mark === \"\\\\\") {"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":33,"text":"        return `${cell()} ${cell()} ${line}`;"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":34,"text":"      }"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":35,"text":"      return `${cell(oldNumber++)} ${cell(newNumber++)} ${line}`;"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":36,"text":"    });"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":37,"text":"    return [header, ...numbered];"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":38,"text":"  });"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":39,"text":"  return `${file.headerPatch}${body.join(\"\\n\")}\\n`;"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":40,"text":"}"}]}
