{"path":"src/review/show.ts","ref":"e9f4feaea4f6a3725324ae13159d13fcb53ef6c9","side":"new","lines":[{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":1,"text":"import type { DiffFile, LiveHunk } from \"../schema/types.ts\";"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":2,"text":""},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":3,"text":"/**"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":4,"text":" * The file header, then each hunk with its old and new line numbers before the diff mark, so a"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":5,"text":" * focus range or note copies numbers instead of counting from the `@@` header. Reads the raw hunk"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":6,"text":" * text, so git's `\\ No newline at end of file` marker stays."},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":7,"text":" */"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":8,"text":"export function numberedPatch(file: DiffFile, hunks: readonly LiveHunk[]): string {"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":9,"text":"  if (hunks.every((hunk) => hunk.lines.length === 0)) {"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":10,"text":"    return file.patch;"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":11,"text":"  }"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":12,"text":"  const width = String("},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":13,"text":"    Math.max("},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":14,"text":"      ...hunks.map((hunk) =>"},{"sha":"e9f4feaea4f6a3725324ae13159d13fcb53ef6c9","author":"Máté Molnár","timestamp":1793522879,"line":15,"text":"        Math.max(hunk.oldStart + hunk.oldLines - 1, hunk.newStart + hunk.newLines - 1),"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":16,"text":"      ),"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":17,"text":"    ),"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":18,"text":"  ).length;"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":19,"text":"  const cell = (n?: number): string => (n === undefined ? \"\" : String(n)).padStart(width);"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":20,"text":"  const body = hunks.flatMap((hunk) => {"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":21,"text":"    const [header = hunk.header, ...raw] = hunk.patch.replace(/\\n$/, \"\").split(\"\\n\");"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":22,"text":"    let oldNumber = hunk.oldStart;"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":23,"text":"    let newNumber = hunk.newStart;"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":24,"text":"    const numbered = raw.map((line) => {"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":25,"text":"      const mark = line[0];"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":26,"text":"      if (mark === \"+\") {"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":27,"text":"        return `${cell()} ${cell(newNumber++)} ${line}`;"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":28,"text":"      }"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":29,"text":"      if (mark === \"-\") {"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":30,"text":"        return `${cell(oldNumber++)} ${cell()} ${line}`;"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":31,"text":"      }"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":32,"text":"      if (mark === \"\\\\\") {"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":33,"text":"        return `${cell()} ${cell()} ${line}`;"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":34,"text":"      }"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":35,"text":"      return `${cell(oldNumber++)} ${cell(newNumber++)} ${line}`;"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":36,"text":"    });"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":37,"text":"    return [header, ...numbered];"},{"sha":"3c4f1ab88a2579824237c29e4069e0cd8589940e","author":"Máté Molnár","timestamp":1793522096,"line":38,"text":"  });"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":39,"text":"  return `${file.headerPatch}${body.join(\"\\n\")}\\n`;"},{"sha":"09e2e617932e4c45a826f39c31e4a1e9cfa0e8e9","author":"Máté Molnár","timestamp":1793520005,"line":40,"text":"}"}]}
