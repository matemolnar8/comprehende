{"path":"src/schema/anchor.ts","ref":"73fa6a3083d3566e3fdecdab0e13391332c2643b","side":"new","lines":[{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":1,"text":"import type { FocusRange, HunkRef, LineNote, SourceSide } from \"./types.ts\";"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":2,"text":""},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":3,"text":"/** A focus range or a note: lines on one side of one file. */"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":4,"text":"export type LineAnchor = { path: string; side: SourceSide; start: number; end: number };"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":5,"text":""},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":6,"text":"export type LineSpan = { start: number; end: number };"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":7,"text":""},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":8,"text":"export function focusAnchor(range: FocusRange): LineAnchor {"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":9,"text":"  return { path: range.path, side: range.side, start: range.start, end: range.end };"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":10,"text":"}"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":11,"text":""},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":12,"text":"export function noteAnchor(note: LineNote): LineAnchor {"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":13,"text":"  return { path: note.path, side: note.side, start: note.line, end: note.line };"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":14,"text":"}"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":15,"text":""},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":16,"text":"/** Lines the hunk holds on one side, inclusive. Undefined when that side has none. */"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":17,"text":"export function hunkSpan(hunk: HunkRef, side: SourceSide): LineSpan | undefined {"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":18,"text":"  const start = side === \"old\" ? hunk.oldStart : hunk.newStart;"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":19,"text":"  const count = side === \"old\" ? hunk.oldLines : hunk.newLines;"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":20,"text":"  return count === 0 ? undefined : { start, end: start + count - 1 };"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":21,"text":"}"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":22,"text":""},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":23,"text":"/** The hunk whose lines on the anchor's side hold the whole anchor. */"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":24,"text":"export function holdingHunk<Hunk extends HunkRef>("},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":25,"text":"  hunks: readonly Hunk[],"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":26,"text":"  anchor: LineAnchor,"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":27,"text":"): Hunk | undefined {"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":28,"text":"  return hunks.find((hunk) => {"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":29,"text":"    if (hunk.path !== anchor.path && hunk.oldPath !== anchor.path) {"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":30,"text":"      return false;"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":31,"text":"    }"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":32,"text":"    const span = hunkSpan(hunk, anchor.side);"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":33,"text":"    return span !== undefined && span.start <= anchor.start && anchor.end <= span.end;"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":34,"text":"  });"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":35,"text":"}"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":36,"text":""},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":37,"text":"export function formatAnchor(anchor: LineAnchor): string {"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":38,"text":"  const lines = anchor.start === anchor.end ? `${anchor.start}` : `${anchor.start}-${anchor.end}`;"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":39,"text":"  return `${anchor.path} ${anchor.side}:${lines}`;"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":40,"text":"}"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":41,"text":""},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":42,"text":"/** A, B, C: notes are lettered in the order the group lists them. */"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":43,"text":"export function noteLetter(index: number): string {"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":44,"text":"  return String.fromCharCode(65 + index);"},{"sha":"bc2d0360dfb074cfdec51970df680ee9baf4438d","author":"Máté Molnár","timestamp":1793520005,"line":45,"text":"}"}]}
