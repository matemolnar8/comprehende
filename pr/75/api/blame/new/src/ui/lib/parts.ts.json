eft?.index ?? 0) - suggestedOrder(right?.group, right?.index ?? 0) || a.localeCompare(b)"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":124,"text":"    );"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":125,"text":"  };"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":126,"text":""},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":127,"text":"  while (remaining.size > 0) {"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":128,"text":"    const ready = [...remaining].filter((id) => (indegree.get(id) ?? 0) === 0).sort(byOrder);"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":129,"text":"    const pick = ready[0];"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":130,"text":"    if (pick === undefined) {"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":131,"text":"      result.push(...[...remaining].sort(byOrder));"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":132,"text":"      break;"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":133,"text":"    }"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":134,"text":"    result.push(pick);"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":135,"text":"    remaining.delete(pick);"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":136,"text":"    for (const id of remaining) {"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":137,"text":"      if ((byId.get(id)?.group.dependsOn ?? []).includes(pick)) {"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":138,"text":"        indegree.set(id, Math.max(0, (indegree.get(id) ?? 1) - 1));"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":139,"text":"      }"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":140,"text":"    }"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":141,"text":"  }"},{"sha":"e55fb2c9294ff84b08f0e0d1b0aa7f5c158f0e06","author":"Cursor Agent","timestamp":1789285558,"line":142,"text":"  return result;"},{"sha":"aaa8ad266ed698df6cdbb8ead0d2c0de5a01f757","author":"matemolnar8","timestamp":1786996490,"line":143,"text":"}"}]}
