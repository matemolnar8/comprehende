ps), groupId);\n+}\n+\n+export function storyNavFromParts(groups: readonly StoryGroup[], parts: readonly Part[], groupId: string): StoryNav {\n+  const byId = new Map(groups.map((group) => [group.id, group]));\n+  const partIndex = parts.findIndex((part) => part.groupIds.includes(groupId));\n+  const part = parts[partIndex];\n+  if (part === undefined) {\n+    return { dependsOn: [], dependents: [] };\n+  }\n+\n+  const mixed = isMixedReview(parts);\n+  const index = part.groupIds.indexOf(groupId);\n+  const group = byId.get(groupId);\n+  const previous = groupHop(byId, part.groupIds[index - 1]);\n+  const next = groupHop(byId, part.groupIds[index + 1]);\n+  const previousPart = mixed ? partHop(byId, parts[partIndex - 1]) : undefined;\n+  const nextPart = mixed ? partHop(byId, parts[partIndex + 1]) : undefined;\n+\n+  return {\n+    ...(part.title !== undefined ? { partTitle: part.title } : {}),\n+    ...(previous !== undefined ? { previous } : {}),\n+    ...(next !== undefined ? { next } : {}),\n+    ...(previousPart !== undefined ? { previousPart } : {}),\n+    ...(nextPart !== undefined ? { nextPart } : {}),\n+    dependsOn: (group?.dependsOn ?? []).flatMap((id) => {\n+      const hop = groupHop(byId, id);\n+      return hop === undefined ? [] : [hop];\n+    }),\n+    dependents: groups.flatMap((item) => {\n+      if (!(item.dependsOn ?? []).includes(groupId)) {\n+        return [];\n+      }\n+      const hop = groupHop(byId, item.id);\n+      return hop === undefined ? [] : [hop];\n+    }),\n+  };\n+}\n+\n+export function pagerHops(nav: StoryNav): { left?: StoryHop; right?: StoryHop } {\n+  const left = nav.previous ?? nav.previousPart;\n+  const right = nav.next ?? nav.nextPart;\n+  return {\n+    ...(left !== undefined ? { left } : {}),\n+    ...(right !== undefined ? { right } : {}),\n+  };\n+}\n+\n+function groupHop(byId: Map<string, StoryGroup>, id: string | undefined): StoryHop | undefined {\n+  if (id === undefined) {\n+    return undefined;\n+  }\n+  const group = byId.get(id);\n+  if (group === undefined) {\n+    return undefined;\n+  }\n+  return { id, title: group.title, axis: \"group\" };\n+}\n+\n+function partHop(byId: Map<string, StoryGroup>, part: Part | undefined): StoryHop | undefined {\n+  const id = part?.groupIds[0];\n+  if (part === undefined || id === undefined) {\n+    return undefined;\n+  }\n+  const group = byId.get(id);\n+  if (group === undefined) {\n+    return undefined;\n+  }\n+  return {\n+    id,\n+    title: group.title,\n+    axis: \"part\",\n+    ...(part.title !== undefined ? { partTitle: part.title } : {}),\n+  };\n+}\n","complete":true,"hunks":[{"path":"src/ui/lib/story-nav.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":103,"header":"@@ -0,0 +1,103 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import { groupParts, isMixedReview, type Part } from \"./parts.ts\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":""},{"kind":"add","oldNumber":null,"newNumber":3,"text":"export type StoryGroup = {"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"  id: string;"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"  title: string;"},{"kind":"add","oldNumber":null,"newNumber":6,"text":"  part?: string;"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"  suggestedOrder?: number;"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"  dependsOn?: readonly string[];"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"};"},{"kind":"add","oldNumber":null,"newNumber":10,"text":""},{"kind":"add","oldNumber":null,"newNumber":11,"text":"export type StoryHop = {"},{"kind":"add","oldNumber":null,"newNumber":12,"text":"  id: string;"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"  title: string;"},{"kind":"add","oldNumber":null,"newNumber":14,"text":"  axis: \"group\" | \"part\";"},{"kind":"add","oldNumber":null,"newNumber":15,"text":"  partTitle?: string;"},{"kind":"add","oldNumber":null,"newNumber":16,"text":"};"},{"kind":