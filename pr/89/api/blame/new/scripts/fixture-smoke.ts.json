_LIB,"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":14,"text":"} from \"../src/test/covering-document.ts\";"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":15,"text":"import { buildExampleFixture } from \"./build-fixture.ts\";"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":16,"text":""},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":17,"text":"export const FIXTURE_SMOKE_PORT = 4579;"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":18,"text":""},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":19,"text":"type ReviewPayload = {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":20,"text":"  document: {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":21,"text":"    parts?: { name: string; summary: string }[];"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":22,"text":"    lookFor?: string[];"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":23,"text":"    groups: { id: string; dependsOn?: string[]; lookFor?: string[]; part?: string }[];"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":24,"text":"  };"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":25,"text":"};"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":26,"text":""},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":27,"text":"export async function runFixtureSmoke(packageRoot = join(dirname(fileURLToPath(import.meta.url)), \"..\")): Promise<string> {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":28,"text":"  const ui = join(packageRoot, \"dist/ui/index.html\");"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":29,"text":"  if (!existsSync(ui)) {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":30,"text":"    execFileSync(\"pnpm\", [\"build\"], { cwd: packageRoot, stdio: \"inherit\" });"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":31,"text":"  }"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":32,"text":"  const built = await buildExampleFixture(packageRoot);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":33,"text":"  const running = await startServer({"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":34,"text":"    cwd: built.repo.root,"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":35,"text":"    dataPath: built.dataPath,"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":36,"text":"    port: FIXTURE_SMOKE_PORT,"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":37,"text":"  });"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":38,"text":"  try {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":39,"text":"    const overviewUrl = `${running.url}/#overview`;"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":40,"text":"    const groupUrl = `${running.url}/#group/${MIXED_GROUP_APP}`;"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":41,"text":"    const page = await fetch(overviewUrl);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":42,"text":"    assertStatus(page, overviewUrl, 200);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":43,"text":"    const html = await page.text();"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":44,"text":"    if (!html.includes('id=\"root\"')) {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":45,"text":"      throw new Error(`${overviewUrl} HTML is missing #root`);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":46,"text":"    }"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":47,"text":""},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":48,"text":"    const groupPage = await fetch(groupUrl);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":49,"text":"    assertStatus(groupPage, groupUrl, 200);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":50,"text":""},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":51,"text":"    const reviewHref = new URL(apiHref({ kind: \"review\" }), `${running.url}/`);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":52,"text":"    const reviewRes = await fetch(reviewHref);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":53,"text":"    assertStatus(reviewRes, reviewHref.href, 200);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":54,"text":"    const review = (await reviewRes.json()) as ReviewPayload;"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":55,"text":"    const names = (review.document.parts ?? []).map((part) => part.name);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":56,"text":"    for (const name of [MIXED_PART_APP, MIXED_PART_LIB, MIXED_PART_DOCS]) {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":57,"text":"      if (!names.includes(name)) {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":58,"text":"        throw new Error(`review.json missing part ${name}`);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":59,"text":"      }"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":60,"text":"    }"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":61,"text":"    if ((review.document.lookFor ?? []).length === 0) {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":62,"text":"      throw new Error(\"review.json missing document lookFor\");"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":63,"text":"    }"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":64,"text":"    const app = review.document.groups.find((group) => group.id === MIXED_GROUP_APP);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":65,"text":"    if (app?.part !== MIXED_PART_APP) {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":66,"text":"      throw new Error(`group ${MIXED_GROUP_APP} missing part ${MIXED_PART_APP}`);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":67,"text":"    }"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":68,"text":"    if (!review.document.groups.some((group) => (group.dependsOn ?? []).length > 0)) {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":69,"text":"      throw new Error(\"review.json missing a dependsOn group\");"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":70,"text":"    }"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":71,"text":""},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":72,"text":"    const overviewMdHref = new URL(apiHref({ kind: \"agent-md\", target: \"overview\" }), `${running.url}/`);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":73,"text":"    const overviewMd = await fetch(overviewMdHref);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":74,"text":"    assertStatus(overviewMd, overviewMdHref.href, 200);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":75,"text":"    const overviewText = await overviewMd.text();"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":76,"text":"    if (!overviewText.includes(\"CHANGELOG\")) {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":77,"text":"      throw new Error(\"overview.md missing document lookFor\");"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":78,"text":"    }"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":79,"text":""},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":80,"text":"    const groupMdHref = new URL("},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":81,"text":"      apiHref({ kind: \"agent-md\", target: \"group\", group: MIXED_GROUP_APP }),"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":82,"text":"      `${running.url}/`,"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":83,"text":"    );"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":84,"text":"    const groupMd = await fetch(groupMdHref);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":85,"text":"    assertStatus(groupMd, groupMdHref.href, 200);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":86,"text":"    const groupText = await groupMd.text();"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":87,"text":"    if (!groupText.includes(MIXED_PART_APP) || !groupText.includes(\"Look for:\")) {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":88,"text":"      throw new Error(`group ${MIXED_GROUP_APP} markdown missing part or lookFor`);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":89,"text":"    }"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":90,"text":""},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":91,"text":"    console.log(`fixture-smoke ok  ${overviewUrl}  ${groupUrl}`);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":92,"text":"    return running.url;"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":93,"text":"  } finally {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":94,"text":"    await closeServer(running.server);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":95,"text":"  }"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":96,"text":"}"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":97,"text":""},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":98,"text":"function assertStatus(res: Response, href: string, expected: number): void {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":99,"text":"  if (res.status !== expected) {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":100,"text":"    throw new Error(`${href} returned ${res.status}, expected ${expected}`);"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":101,"text":"  }"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":102,"text":"}"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":103,"text":""},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":104,"text":"function closeServer(server: { close: (cb: (error?: Error) => void) => void }): Promise<void> {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":105,"text":"  return new Promise((resolve, reject) => {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":106,"text":"    server.close((error) => (error ? reject(error) : resolve()));"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":107,"text":"  });"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":108,"text":"}"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":109,"text":""},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":110,"text":"const entry = process.argv[1]?.replaceAll(\"\\\\\", \"/\");"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":111,"text":"if (entry !== undefined && /(?:^|\\/)fixture-smoke\\.(ts|js)$/.test(entry)) {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":112,"text":"  try {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":113,"text":"    await runFixtureSmoke();"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":114,"text":"  } catch (error) {"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":115,"text":"    console.error(error instanceof Error ? error.message : String(error));"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":116,"text":"    process.exitCode = 1;"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":117,"text":"  }"},{"sha":"0cca95f6572e35edba92ee70c70ee4edf20bb4cf","author":"Cursor Agent","timestamp":1789936342,"line":118,"text":"}"}]}
