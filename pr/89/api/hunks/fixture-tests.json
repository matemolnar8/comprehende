ure.test.ts\n@@ -0,0 +1,22 @@\n+import assert from \"node:assert/strict\";\n+import { describe, it } from \"node:test\";\n+import { DEFAULT_PORT } from \"../src/cli/args.ts\";\n+import { fixtureCommands } from \"./build-fixture.ts\";\n+\n+describe(\"fixture printout\", () => {\n+  it(\"prints serve and export relative to the fixture cwd\", () => {\n+    const printed = fixtureCommands({\n+      cwd: \"/proj/fixtures/repo\",\n+      packageRoot: \"/proj\",\n+      dataPath: \"/proj/fixtures/example/review.json\",\n+    });\n+    assert.equal(\n+      printed.serve,\n+      `node ../../dist/cli/main.js serve --data ../example/review.json --port ${DEFAULT_PORT}`,\n+    );\n+    assert.equal(\n+      printed.export,\n+      \"node ../../dist/cli/main.js export --data ../example/review.json --out ../site\",\n+    );\n+  });\n+});\n","complete":true,"hunks":[{"path":"scripts/build-fixture.test.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":22,"header":"@@ -0,0 +1,22 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import assert from \"node:assert/strict\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import { describe, it } from \"node:test\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import { DEFAULT_PORT } from \"../src/cli/args.ts\";"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"import { fixtureCommands } from \"./build-fixture.ts\";"},{"kind":"add","oldNumber":null,"newNumber":5,"text":""},{"kind":"add","oldNumber":null,"newNumber":6,"text":"describe(\"fixture printout\", () => {"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"  it(\"prints serve and export relative to the fixture cwd\", () => {"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"    const printed = fixtureCommands({"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"      cwd: \"/proj/fixtures/repo\","},{"kind":"add","oldNumber":null,"newNumber":10,"text":"      packageRoot: \"/proj\","},{"kind":"add","oldNumber":null,"newNumber":11,"text":"      dataPath: \"/proj/fixtures/example/review.json\","},{"kind":"add","oldNumber":null,"newNumber":12,"text":"    });"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"    assert.equal("},{"kind":"add","oldNumber":null,"newNumber":14,"text":"      printed.serve,"},{"kind":"add","oldNumber":null,"newNumber":15,"text":"      `node ../../dist/cli/main.js serve --data ../example/review.json --port ${DEFAULT_PORT}`,"},{"kind":"add","oldNumber":null,"newNumber":16,"text":"    );"},{"kind":"add","oldNumber":null,"newNumber":17,"text":"    assert.equal("},{"kind":"add","oldNumber":null,"newNumber":18,"text":"      printed.export,"},{"kind":"add","oldNumber":null,"newNumber":19,"text":"      \"node ../../dist/cli/main.js export --data ../example/review.json --out ../site\","},{"kind":"add","oldNumber":null,"newNumber":20,"text":"    );"},{"kind":"add","oldNumber":null,"newNumber":21,"text":"  });"},{"kind":"add","oldNumber":null,"newNumber":22,"text":"});"}]}]},{"path":"src/test/covering-document.test.ts","kind":"text","status":"added","patch":"diff --git a/src/test/covering-document.test.ts b/src/test/covering-document.test.ts\nnew file mode 100644\nindex 0000000..f02c3b4\n--- /dev/null\n+++ b/src/test/covering-document.test.ts\n@@ -0,0 +1,78 @@\n+import assert from \"node:assert/strict\";\n+import { mkdtemp, writeFile } from \"node:fs/promises\";\n+import { tmpdir } from \"node:os\";\n+import { join } from \"node:path\";\n+import { after, describe, it } from \"node:test\";\n+import { rmSync } from \"node:fs\";\n+import { cmdIndex, cmdValidate } from \"../cli/commands.ts\";\n+import { parseReviewDocument } from \"../schema/parse.ts\";\n+import {\n+  MIXED_GROUP_APP,\n+  MIXED_GROUP_APP_TEST,\n+  MIXED_PART_APP,\n+  MIXED_PART_DOCS,\n+  MIXED_PART_LIB,\n+  coveringDocument,\n+  mixedCoveringDocument,\n+} from \"./covering-document.ts\";\n+import { createExampleRepo } from \"./example-repo.ts\";\n+import type { ReviewDocument } from \"../schema/types.ts\";\n+\n+const roots: string[] = [];\n+\n+after(() => {\n+  for (const root of roots) {\n+    rmSync(root, { recursive: true, force: true });\n+  }\n+});\n+\n+describe(\"covering documents\", () => {\n+  it(\"keeps the unlabeled covering document as one group\", async () => {\n+    const root = await mkdtemp(join(tmpdir(), \"comprehende-cover-\"));\n+    roots.push(root);\n+    const repo = await createExampleRepo(root);\n+    const index = await cmdIndex(repo.root, repo.base, repo.head);\n+    const document = coveringDocument(index);\n+    assert.equal(document.groups.length, 1);\n+    assert.equal(document.parts, undefined);\n+    assert.equal(document.groups[0]?.part, undefined);\n+  });\n+\n+  it(\"writes a mixed covering document with parts, dependsOn, lookFor, and sources\", async () => {\n+    const root = await mkdtemp(join(tmpdir(), \"comprehende-mixed-\"));\n+    roots.push(root);\n+    const repo = await createExampleRepo(root);\n+    const index = await cmdIndex(repo.root, repo.base, repo.head);\n+    const document = mixedCoveringDocument(index);\n+    const parsed = parseReviewDocument(document);\n+    assert.equal(parsed.ok, true, parsed.ok ? \"\" : parsed.errors.join(\"\\n\"));\n+    await cmdValidate(repo.root, await writeTemp(root, document));\n+\n+    assert.ok((document.parts?.length ?? 0) >= 2);\n+    assert.deepEqual(\n+      document.parts?.map((part) => part.name),\n+      [MIXED_PART_APP, MIXED_PART_LIB, MIXED_PART_DOCS],\n+    );\n+    assert.ok(document.parts?.every((part) => part.summary.trim() !== \"\"));\n+    assert.ok((document.lookFor?.length ?? 0) >= 2);\n+    assert.ok((document.sources?.length ?? 0) >= 2);\n+    const partNames = new Set(document.groups.map((group) => group.part));\n+    assert.equal(partNames.size, 3);\n+\n+    const appTest = document.groups.find((group) => group.id === MIXED_GROUP_APP_TEST);\n+    assert.deepEqual(appTest?.dependsOn, [MIXED_GROUP_APP]);\n+    assert.equal(appTest?.part, MIXED_PART_APP);\n+    const app = document.groups.find((group) => group.id === MIXED_GROUP_APP);\n+    assert.ok((app?.lookFor?.length ?? 0) > 0);\n+    assert.equal(\n+      document.groups.reduce((sum, group) => sum + group.hunkRefs.length, 0),\n+      index.hunks.length,\n+    );\n+  });\n+});\n+\n+async function writeTemp(root: string, document: ReviewDocument): Promise<string> {\n+  const dataPath = join(root, \"review.json\");\n+  await writeFile(dataPath, `${JSON.stringify(document, null, 2)}\\n`);\n+  return dataPath;\n+}\n","complete":true,"hunks":[{"path":"src/test/covering-document.test.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":78,"header":"@@ -0,0 +1,78 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import assert from \"node:assert/strict\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import { mkdtemp, writeFile } from \"node:fs/promises\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import { tmpdir } from \"node:os\";"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"import { join } from \"node:path\";"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"import { after, describe, it } from \"node:test\";"},{"kind":"add","oldNumber":null,"newNumber":6,"text":"import { rmSync } from \"node:fs\";"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"import { cmdIndex, cmdValidate } from \"../cli/commands.ts\";"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"import { parseReviewDocument } from \"../schema/parse.ts\";"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"import {"},{"kind":"add","oldNumber":null,"newNumber":10,"text":"  MIXED_GROUP_APP,"},{"kind":"add","oldNumber":null,"newNumber":11,"text":"  MIXED_GROUP_APP_TEST,"},{"kind":"add","oldNumber":null,"newNumber":12,"text":"  MIXED_PART_APP,"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"  MIXED_PART_DOCS,"},{"kind":"add","oldNumber":null,"newNumber":14,"text":"  MIXED_PART_LIB,"},{"kind":"add","ol