ning.url}/`,"},{"kind":"add","oldNumber":null,"newNumber":83,"text":"    );"},{"kind":"add","oldNumber":null,"newNumber":84,"text":"    const groupMd = await fetch(groupMdHref);"},{"kind":"add","oldNumber":null,"newNumber":85,"text":"    assertStatus(groupMd, groupMdHref.href, 200);"},{"kind":"add","oldNumber":null,"newNumber":86,"text":"    const groupText = await groupMd.text();"},{"kind":"add","oldNumber":null,"newNumber":87,"text":"    if (!groupText.includes(MIXED_PART_APP) || !groupText.includes(\"Look for:\")) {"},{"kind":"add","oldNumber":null,"newNumber":88,"text":"      throw new Error(`group ${MIXED_GROUP_APP} markdown missing part or lookFor`);"},{"kind":"add","oldNumber":null,"newNumber":89,"text":"    }"},{"kind":"add","oldNumber":null,"newNumber":90,"text":""},{"kind":"add","oldNumber":null,"newNumber":91,"text":"    console.log(`fixture-smoke ok  ${overviewUrl}  ${groupUrl}`);"},{"kind":"add","oldNumber":null,"newNumber":92,"text":"    return running.url;"},{"kind":"add","oldNumber":null,"newNumber":93,"text":"  } finally {"},{"kind":"add","oldNumber":null,"newNumber":94,"text":"    await closeServer(running.server);"},{"kind":"add","oldNumber":null,"newNumber":95,"text":"  }"},{"kind":"add","oldNumber":null,"newNumber":96,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":97,"text":""},{"kind":"add","oldNumber":null,"newNumber":98,"text":"function assertStatus(res: Response, href: string, expected: number): void {"},{"kind":"add","oldNumber":null,"newNumber":99,"text":"  if (res.status !== expected) {"},{"kind":"add","oldNumber":null,"newNumber":100,"text":"    throw new Error(`${href} returned ${res.status}, expected ${expected}`);"},{"kind":"add","oldNumber":null,"newNumber":101,"text":"  }"},{"kind":"add","oldNumber":null,"newNumber":102,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":103,"text":""},{"kind":"add","oldNumber":null,"newNumber":104,"text":"function closeServer(server: { close: (cb: (error?: Error) => void) => void }): Pro