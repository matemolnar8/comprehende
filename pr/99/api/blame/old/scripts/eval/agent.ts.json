{"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":41,"text":"        timer = setTimeout(() => {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":42,"text":"          void run.cancel();"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":43,"text":"          reject(new Error(`agent timed out after ${timeoutMs}ms`));"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":44,"text":"        }, timeoutMs);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":45,"text":"      }),"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":46,"text":"    ]);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":47,"text":"    return {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":48,"text":"      text: result.result ?? \"\","},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":49,"text":"      status: result.status,"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":50,"text":"      durationMs: result.durationMs ?? 0,"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":51,"text":"      tokens: result.usage?.totalTokens ?? 0,"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":52,"text":"      error: result.error?.message,"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":53,"text":"    };"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":54,"text":"  } finally {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":55,"text":"    if (timer !== undefined) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":56,"text":"      clearTimeout(timer);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":57,"text":"    }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":58,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":59,"text":"}"}]}
