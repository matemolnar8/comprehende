eturn cached;\n+  }\n+  const read = readDiffUncached(cwd, baseRef, headRef);\n+  diffCache.set(key, read);\n+  read.catch(() => {\n+    if (diffCache.get(key) === read) {\n+      diffCache.delete(key);\n+    }\n+  });\n+  if (diffCache.size > DIFF_CACHE_LIMIT) {\n+    const oldest = diffCache.keys().next().value;\n+    if (oldest !== undefined) {\n+      diffCache.delete(oldest);\n+    }\n+  }\n+  return read;\n+}\n+\n+async function readDiffUncached(\n+  cwd: string,\n+  baseRef: string,\n+  headRef: string,\n+): Promise<DiffFile[]> {\n   await Promise.all([resolveCommit(cwd, baseRef), resolveCommit(cwd, headRef)]);\n   return readDiffAt(cwd, baseRef, headRef);\n }\n","complete":false,"hunks":[{"path":"src/git/diff.ts","oldStart":36,"oldLines":7,"newStart":36,"newLines":49,"header":"@@ -36,7 +36,49 @@ export async function resolveSource(","language":"typescript","lines":[{"kind":"ctx","oldNumber":36,"newNumber":36,"text":"  };"},{"kind":"ctx","oldNumber":37,"newNumber":37,"text":"}"},{"kind":"ctx","oldNumber":38,"newNumber":38,"text":""},{"kind":"del","oldNumber":39,"newNumber":null,"text":"export async function readDiff(cwd: string, baseRef: string, headRef: string): Promise<DiffFile[]> {"},{"kind":"add","oldNumber":null,"newNumber":39,"text":"const FULL_SHA = /^(?:[0-9a-f]{40}|[0-9a-f]{64})$/;"},{"kind":"add","oldNumber":null,"newNumber":40,"text":"const DIFF_CACHE_LIMIT = 4;"},{"kind":"add","oldNumber":null,"newNumber":41,"text":"const diffCache = new Map<string, Promise<readonly DiffFile[]>>();"},{"kind":"add","oldNumber":null,"newNumber":42,"text":""},{"kind":"add","oldNumber":null,"newNumber":43,"text":"/**"},{"kind":"add","oldNumber":null,"newNumber":44,"text":" * A diff between two commit SHAs never changes, and `serve` asks for the same pinned pair on every"},{"kind":"add","oldNumber":null,"newNumber":45,"text":" * request. With hundreds of binaries, rename and copy detection costs about a second per call."},{"kind":"add","oldNumber":null,"newNumber":46,"