n}\n+      onClick={() => {\n+        if (props.target !== undefined) {\n+          props.onSelect(props.target);\n+        }\n+      }}\n+    >\n+      {props.direction === \"prev\" ? <ChevronLeftIcon className=\"size-3.5\" /> : <ChevronRightIcon className=\"size-3.5\" />}\n+    </Button>\n+  );\n+  if (disabled) {\n+    return button;\n+  }\n+  return (\n+    <Tooltip>\n+      <TooltipTrigger asChild>{button}</TooltipTrigger>\n+      <TooltipContent>{hint}</TooltipContent>\n+    </Tooltip>\n+  );\n+}\n","complete":true,"hunks":[{"path":"src/ui/components/GroupNav.tsx","oldStart":0,"oldLines":0,"newStart":1,"newLines":63,"header":"@@ -0,0 +1,63 @@","language":"tsx","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import { ChevronLeftIcon, ChevronRightIcon } from \"lucide-react\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import type { ReviewMeta } from \"../api.ts\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import { Button } from \"@/components/ui/button.tsx\";"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"import { Tooltip, TooltipContent, TooltipTrigger } from \"@/components/ui/tooltip.tsx\";"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"import { neighborSelection, selectionNavLabel, type Selection } from \"../lib/selection.ts\";"},{"kind":"add","oldNumber":null,"newNumber":6,"text":""},{"kind":"add","oldNumber":null,"newNumber":7,"text":"export function GroupNav(props: {"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"  meta: ReviewMeta;"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"  selection: Selection | null;"},{"kind":"add","oldNumber":null,"newNumber":10,"text":"  onSelect: (selection: Selection) => void;"},{"kind":"add","oldNumber":null,"newNumber":11,"text":"  className?: string;"},{"kind":"add","oldNumber":null,"newNumber":12,"text":"}) {"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"  if (props.meta.groups.length === 0) {"},{"kind":"add","oldNumber":null,"newNumber":14,"