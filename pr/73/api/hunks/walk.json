auth\" },\n+      { kind: \"group\", id: \"ui\" },\n+    ]);\n+  });\n+\n+  it(\"steps to the next group and stops at the last one\", () => {\n+    assert.deepEqual(neighborSelection(stacked, { kind: \"overview\" }, 1), { kind: \"group\", id: \"auth\" });\n+    assert.deepEqual(neighborSelection(stacked, { kind: \"group\", id: \"auth\" }, 1), { kind: \"group\", id: \"ui\" });\n+    assert.equal(neighborSelection(stacked, { kind: \"group\", id: \"ui\" }, 1), undefined);\n+  });\n+\n+  it(\"steps to the previous group and stops at overview\", () => {\n+    assert.deepEqual(neighborSelection(stacked, { kind: \"group\", id: \"auth\" }, -1), { kind: \"overview\" });\n+    assert.equal(neighborSelection(stacked, { kind: \"overview\" }, -1), undefined);\n+  });\n+\n+  it(\"returns from unassigned to the last group\", () => {\n+    assert.deepEqual(neighborSelection(stacked, { kind: \"unassigned\" }, -1), { kind: \"group\", id: \"ui\" });\n+    assert.equal(neighborSelection(stacked, { kind: \"unassigned\" }, 1), undefined);\n+    assert.deepEqual(neighborSelection(stacked, { kind: \"lockfiles\" }, -1), { kind: \"group\", id: \"ui\" });\n+  });\n+\n+  it(\"does nothing when there is no source\", () => {\n+    assert.equal(neighborSelection(null, { kind: \"overview\" }, 1), undefined);\n+  });\n+\n+  it(\"has no next group when the document has none\", () => {\n+    const empty: SelectionStackSource = { groups: [], unassigned: { hunkCount: 1 } };\n+    assert.deepEqual(groupWalk(empty), [{ kind: \"overview\" }]);\n+    assert.equal(neighborSelection(empty, { kind: \"overview\" }, 1), undefined);\n+    assert.deepEqual(neighborSelection(empty, { kind: \"unassigned\" }, -1), { kind: \"overview\" });\n+  });\n+\n+  it(\"shifts through the walk without wrapping\", () => {\n+    const seen: Selection[] = [];\n+    const select = (selection: Selection) => {\n+      seen.push(selection);\n+    };\n+    shiftSelection(stacked, { kind: \"overview\" }, select, 1);\n+    shiftSelection(stacked, { kind: \"group\", id: \"ui\" }, select, 1);\n+    shiftSelection(stacked, { kind: \"overview\" }, select, -1);\n+    assert.deepEqual(seen, [{ kind: \"group\", id: \"auth\" }]);\n+  });\n });\n","complete":true,"hunks":[{"path":"src/ui/lib/selection.test.ts","oldStart":1,"oldLines":11,"newStart":1,"newLines":16,"header":"@@ -1,11 +1,16 @@","language":"typescript","lines":[{"kind":"ctx","oldNumber":1,"newNumber":1,"text":"import assert from \"node:assert/strict\";"},{"kind":"ctx","oldNumber":2,"newNumber":2,"text":"import { describe, it } from \"node:test\";"},{"kind":"ctx","oldNumber":3,"newNumber":3,"text":"import {"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"  groupWalk,"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"  neighborSelection,"},{"kind":"ctx","oldNumber":4,"newNumber":6,"text":"  parseSelection,"},{"kind":"ctx","oldNumber":5,"newNumber":7,"text":"  restoreSelection,"},{"kind":"ctx","oldNumber":6,"newNumber":8,"text":"  selectionCaption,"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"  selectionNavLabel,"},{"kind":"ctx","oldNumber":7,"newNumber":10,"text":"  selectionStorageKey,"},{"kind":"ctx","oldNumber":8,"newNumber":11,"text":"  serializeSelection,"},{"kind":"add","oldNumber":null,"newNumber":12,"text":"  shiftSelection,"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"  type Selection,"},{"kind":"ctx","oldNumber":9,"newNumber":14,"text":"  type SelectionStackSource,"},{"kind":"ctx","oldNumber":10,"newNumber":15,"text":"} from \"./selection.ts\";"},{"kind":"ctx","oldNumber":11,"newNumber":16,"text":""}]},{"path":"src/ui/lib/selection.test.ts","oldStart":81,"oldLines":4,"newStart":86,"newLines":71,"header":"@@ -81,4 +86,71 @@ describe(\"group selection storage\", () => {","language":"typescript","lines":[{"kind":"ctx","oldNumber":81,"newNumber":86,"text":"    assert.deepEqual(selectionCaption(meta, { kind: \"unassigned\" }), { title: \"Unassigned\" });"},{"kind":"ctx","oldNumber":82,"newNumber":87,"text":" 