{"path":"src/ui/lib/selection.ts","ref":"e8001407966c147fd9db26c1f4a8db24108c0ee8","side":"new","lines":[{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":1,"text":"import { REVIEW_BUCKETS, type ReviewBucket } from \"../../api/types.ts\";"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":2,"text":"import { padIndex } from \"../../schema/types.ts\";"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":3,"text":"import type { ReviewMeta } from \"../api.ts\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":4,"text":"import { readKey, writeKey } from \"./storage.ts\";"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":5,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":6,"text":"export type Selection = { kind: \"overview\" } | { kind: \"group\"; id: string } | { kind: ReviewBucket };"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":7,"text":""},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":8,"text":"export type SelectionStackSource = {"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":9,"text":"  groups: { id: string }[];"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":10,"text":"  unassigned: { hunkCount: number };"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":11,"text":"  lockfiles?: { fileCount: number };"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":12,"text":"};"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":13,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":14,"text":"export function defaultSelection(source: SelectionStackSource): Selection {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":15,"text":"  if (source.groups.length > 0) {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":16,"text":"    return { kind: \"overview\" };"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":17,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":18,"text":"  return { kind: REVIEW_BUCKETS.unassigned };"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":19,"text":"}"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":20,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":21,"text":"export function selectionStorageKey(baseSha: string, headSha: string): string {"},{"sha":"e9b20d5d583fc4d220337a9ff22e1e6bcf6373e7","author":"Cursor Agent","timestamp":1787413230,"line":22,"text":"  return `comprehende.group.${baseSha}.${headSha}`;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":23,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":24,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":25,"text":"export function parseSelection(raw: string | null): Selection | null {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":26,"text":"  if (raw === null || raw === \"\") {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":27,"text":"    return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":28,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":29,"text":"  try {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":30,"text":"    const parsed: unknown = JSON.parse(raw);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":31,"text":"    if (typeof parsed !== \"object\" || parsed === null || !(\"kind\" in parsed)) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":32,"text":"      return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":33,"text":"    }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":34,"text":"    if (parsed.kind === \"overview\") {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":35,"text":"      return { kind: \"overview\" };"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":36,"text":"    }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":37,"text":"    if (parsed.kind === REVIEW_BUCKETS.unassigned) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":38,"text":"      return { kind: REVIEW_BUCKETS.unassigned };"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":39,"text":"    }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":40,"text":"    if (parsed.kind === REVIEW_BUCKETS.lockfiles) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":41,"text":"      return { kind: REVIEW_BUCKETS.lockfiles };"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":42,"text":"    }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":43,"text":"    if (parsed.kind === \"group\" && \"id\" in parsed && typeof parsed.id === \"string\" && parsed.id !== \"\") {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":44,"text":"      return { kind: \"group\", id: parsed.id };"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":45,"text":"    }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":46,"text":"    return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":47,"text":"  } catch {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":48,"text":"    return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":49,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":50,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":51,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":52,"text":"export function serializeSelection(selection: Selection): string {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":53,"text":"  return JSON.stringify(selection);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":54,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":55,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":56,"text":"export function restoreSelection(source: SelectionStackSource, stored: Selection | null): Selection {"},{"sha":"b5e2c3e0733d804aee4f4adf06766621138e3c78","author":"Máté Molnár","timestamp":1788535976,"line":57,"text":"  // Invariant: unknown or missing buckets fall back to the default selection."},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":58,"text":"  if (stored === null) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":59,"text":"    return defaultSelection(source);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":60,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":61,"text":"  if (stored.kind === \"group\" && !source.groups.some((group) => group.id === stored.id)) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":62,"text":"    return defaultSelection(source);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":63,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":64,"text":"  if (stored.kind === REVIEW_BUCKETS.unassigned && source.unassigned.hunkCount === 0 && source.groups.length > 0) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":65,"text":"    return defaultSelection(source);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":66,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":67,"text":"  if (stored.kind === REVIEW_BUCKETS.lockfiles && (source.lockfiles?.fileCount ?? 0) === 0) {"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":68,"text":"    return defaultSelection(source);"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":69,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":70,"text":"  return stored;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":71,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":72,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":73,"text":"export function readStoredSelection(baseSha: string, headSha: string): Selection | null {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":74,"text":"  return parseSelection(readKey(sessionStorage, selectionStorageKey(baseSha, headSha)));"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":75,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":76,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":77,"text":"export function writeStoredSelection(baseSha: string, headSha: string, selection: Selection): void {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":78,"text":"  writeKey(sessionStorage, selectionStorageKey(baseSha, headSha), serializeSelection(selection));"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":79,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":80,"text":""},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":81,"text":"export function selectionStack(source: SelectionStackSource): Selection[] {"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":82,"text":"  const ids: Selection[] = [{ kind: \"overview\" }, ...source.groups.map((group) => ({ kind: \"group\" as const, id: group.id }))];"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":83,"text":"  if (source.unassigned.hunkCount > 0) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":84,"text":"    ids.push({ kind: REVIEW_BUCKETS.unassigned });"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":85,"text":"  }"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":86,"text":"  if ((source.lockfiles?.fileCount ?? 0) > 0) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":87,"text":"    ids.push({ kind: REVIEW_BUCKETS.lockfiles });"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":88,"text":"  }"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":89,"text":"  return ids;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":90,"text":"}"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":91,"text":""},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":92,"text":"/** Overview, then groups in document order. Unassigned and lockfiles stay off this walk. */"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":93,"text":"export function groupWalk(source: SelectionStackSource): Selection[] {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":94,"text":"  return [{ kind: \"overview\" }, ...source.groups.map((group) => ({ kind: \"group\" as const, id: group.id }))];"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":95,"text":"}"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":96,"text":""},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":97,"text":"export function neighborSelection("},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":98,"text":"  source: SelectionStackSource | null,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":99,"text":"  selection: Selection | null,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":100,"text":"  delta: number,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":101,"text":"): Selection | undefined {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":102,"text":"  if (source === null || delta === 0) {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":103,"text":"    return undefined;"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":104,"text":"  }"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":105,"text":"  const walk = groupWalk(source);"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":106,"text":"  const current = walk.findIndex((item) => sameSelection(item, selection));"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":107,"text":"  if (current >= 0) {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":108,"text":"    return walk[current + delta];"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":109,"text":"  }"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":110,"text":"  if (delta < 0) {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":111,"text":"    return walk[walk.length - 1];"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":112,"text":"  }"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":113,"text":"  return undefined;"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":114,"text":"}"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":115,"text":""},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":116,"text":"export function shiftSelection("},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":117,"text":"  source: SelectionStackSource | null,"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":118,"text":"  selection: Selection | null,"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":119,"text":"  setSelection: (selection: Selection) => void,"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":120,"text":"  delta: number,"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":121,"text":"): void {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":122,"text":"  const next = neighborSelection(source, selection, delta);"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":123,"text":"  if (next !== undefined) {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":124,"text":"    setSelection(next);"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":125,"text":"  }"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":126,"text":"}"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":127,"text":""},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":128,"text":"export function sameSelection(a: Selection, b: Selection | null): boolean {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":129,"text":"  if (b === null) {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":130,"text":"    return false;"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":131,"text":"  }"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":132,"text":"  if (a.kind === \"overview\") {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":133,"text":"    return b.kind === \"overview\";"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":134,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":135,"text":"  if (a.kind === REVIEW_BUCKETS.unassigned) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":136,"text":"    return b.kind === REVIEW_BUCKETS.unassigned;"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":137,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":138,"text":"  if (a.kind === REVIEW_BUCKETS.lockfiles) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":139,"text":"    return b.kind === REVIEW_BUCKETS.lockfiles;"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":140,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":141,"text":"  return a.kind === \"group\" && b.kind === \"group\" && b.id === a.id;"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":142,"text":"}"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":143,"text":""},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":144,"text":"export function selectionNavLabel("},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":145,"text":"  meta: Pick<ReviewMeta, \"document\" | \"groups\">,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":146,"text":"  selection: Selection,"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":147,"text":"): string {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":148,"text":"  const caption = selectionCaption(meta, selection);"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":149,"text":"  return caption.index !== undefined ? `${caption.index} ${caption.title}` : caption.title;"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":150,"text":"}"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":151,"text":""},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":152,"text":"export function selectionCaption("},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":153,"text":"  meta: Pick<ReviewMeta, \"document\" | \"groups\">,"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":154,"text":"  selection: Selection | null,"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":155,"text":"): { index?: string; title: string } {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":156,"text":"  if (selection === null || selection.kind === \"overview\") {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":157,"text":"    return { title: \"Overview\" };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":158,"text":"  }"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":159,"text":"  if (selection.kind === \"group\") {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":160,"text":"    const index = meta.groups.findIndex((group) => group.id === selection.id);"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":161,"text":"    const group = index >= 0 ? meta.groups[index] : undefined;"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":162,"text":"    return {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":163,"text":"      index: index >= 0 ? padIndex(index + 1) : undefined,"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":164,"text":"      title: group?.title ?? \"Group\","},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":165,"text":"    };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":166,"text":"  }"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":167,"text":"  if (selection.kind === REVIEW_BUCKETS.unassigned) {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":168,"text":"    return { title: \"Unassigned\" };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":169,"text":"  }"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":170,"text":"  return { title: \"Lockfiles\" };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":171,"text":"}"}]}
