ocument } from \"../src/test/covering-document.ts\";"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":13,"text":"import { createExampleRepo } from \"../src/test/example-repo.ts\";"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":14,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":15,"text":"const repoRoot = join(dirname(fileURLToPath(import.meta.url)), \"..\");"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":16,"text":"const roots: string[] = [];"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":17,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":18,"text":"try {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":19,"text":"  await run();"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":20,"text":"} finally {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":21,"text":"  for (const root of roots) {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":22,"text":"    rmSync(root, { recursive: true, force: true });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":23,"text":"  }"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":24,"text":"}"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":25,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":26,"text":"async function run(): Promise<vo