d18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":113,"text":"    const url = await waitForLocalhost(child);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":114,"text":"    const health = await fetch(`${url}/api/health`);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":115,"text":"    assert.equal(health.status, 200);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":116,"text":"    const page = await fetch(url);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":117,"text":"    assert.equal(page.status, 200);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":118,"text":"    const html = await page.text();"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":119,"text":"    assert.match(html, /<div id=\"root\">/);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":120,"text":"  } finally {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":121,"text":"  child.kill(\"SIGTERM\");"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":122,"text":"    await waitForExit(child);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":123,"text":"  }"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":124,"text":""},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":125,"text":"  const outDir = join(work, \"site\");"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":126,"text":"  const exportOut = execFileSync(bin, [\"export\", \"--data\", dataPath, \"--out\", outDir], {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":127,"text":"    cwd: repo.root,"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":128,"text":"    encoding: \"utf8\","},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":129,"text":"  });"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":130,"text":"  assert.equal(existsSync(join(outDir, \"index.html\")), true, \"export must copy the UI\");"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":131,"text":"  assert.equal(existsSync(join(outDir, \"api/review.json\")), true, \"export must write frozen review JSON\");"},{"sha":"4989e245a1e63c5d1629e59ebc5ff201a17874e2","author":"Cursor Agent","timestamp":1787642148,"line":132,"text":"  assert.equal(existsSync(join(outDir, \"api/agent/overview.md\")), true, \"export must write overview agent markdown\");"},{"sha":"4989e245a1e63c5d1629e59ebc5ff201a17874e2","author":"Cursor Agent","timestamp":1787642148,"line":133,"text":"  assert.equal(existsSync(join(outDir, \"api/agent/groups/all.md\")), true, \"export must write group agent markdown\");"},{"sha":"4989e245a1e63c5d1629e59ebc5ff201a17874e2","author":"Cursor Agent","timestamp":1787642148,"line":134,"text":"  const overviewMd = await readFile(join(outDir, \"api/agent/overview.md\"), \"utf8\");"},{"sha":"4989e245a1e63c5d1629e59ebc5ff201a17874e2","author":"Cursor Agent","timestamp":1787642148,"line":135,"text":"  assert.match(overviewMd, /git diff --find-renames/);"},{"sha":"fc3b218dc68b54db2ec50c36f40f47902531f6b3","author":"Cursor Agent","timestamp":1787642506,"line":136,"text":"  assert.match(overviewMd, /\\[groups\\/all\\.md\\]\\(groups\\/all\\.md\\)/);"},{"sha":"fc3b218dc68b54db2ec50c36f40f47902531f6b3","author":"Cursor Agent","timestamp":1787642506,"line":137,"text":"  assert.doesNotMatch(overviewMd, /@@ -/);"},{"sha":"4989e245a1e63c5d1629e59ebc5ff201a17874e2","author":"Cursor Agent","timestamp":1787642148,"line":138,"text":"  assert.equal(overviewMd.includes(\"+++\"), false, \"agent markdown must not include patch text\");"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":139,"text":"  assert.equal(existsSync(join(outDir, \".git\")), false, \"export must not copy git\");"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":140,"text":"  assert.match(exportOut, /\\/site/);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":141,"text":""},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":142,"text":"  const packedUi = join(installDir, \"node_modules/comprehende/dist/ui\");"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":143,"text":"  const packedManifest = JSON.parse(await readFile(join(packedUi, \"shiki-langs.json\"), \"utf8\")) as {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":144,"text":"    chunks: string[];"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":145,"text":"  };"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":146,"text":"  assert.ok(packedManifest.chunks.length > 20, \"prebuilt UI must keep every highlighter chunk\");"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":147,"text":"  assert.ok("},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":148,"text":"    packedManifest.chunks.every((file) => existsSync(join(packedUi, file))),"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":149,"text":"    \"serve UI must keep unused highlighter files on disk\","},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":150,"text":"  );"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":151,"text":"  assert.ok("},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":152,"text":"    packedManifest.chunks.some((file) => file.includes(\"shiki-lang-python\")),"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":153,"text":"    \"serve UI must still include unused languages such as python\","},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":154,"text":"  );"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":155,"text":""},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":156,"text":"  const exportedManifest = JSON.parse(await readFile(join(outDir, \"shiki-langs.json\"), \"utf8\")) as {"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":157,"text":"    chunks: string[];"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":158,"text":"  };"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":159,"text":"  const kept = exportedManifest.chunks.filter((file) => existsSync(join(outDir, file)));"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":160,"text":"  const dropped = exportedManifest.chunks.filter((file) => !existsSync(join(outDir, file)));"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":161,"text":"  assert.ok(kept.some((file) => file.includes(\"shiki-lang-typescript\")), \"export must keep typescript\");"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":162,"text":"  assert.ok(kept.some((file) => file.includes(\"shiki-lang-markdown\")), \"export must keep markdown\");"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":163,"text":"  assert.ok(dropped.some((file) => file.includes(\"shiki-lang-python\")), \"export must drop unused python\");"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":164,"text":"  assert.ok(dropped.length > kept.length, \"export must drop most highlighter files\");"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":165,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":166,"text":"  console.log(\"pack-smoke ok\");"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":167,"text":"}"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":168,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":169,"text":"function waitForLocalhost(child: ReturnType<typeof spawn>): Promise<string> {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":170,"text":"  return new Promise((resolve, reject) => {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":171,"text":"    let stdout = \"\";"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":172,"text":"    let stderr = \"\";"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":173,"text":"    const timer = setTimeout(() => {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":174,"text":"      reject(new Error(`serve timed out\\nstdout:\\n${stdout}\\nstderr:\\n${stderr}`));"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":175,"text":"    }, 15_000);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":176,"text":"    child.stdout?.on(\"data\", (chunk: Buffer) => {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":177,"text":"      stdout += chunk.toString();"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":178,"text":"      const match = stdout.match(/http:\\/\\/127\\.0\\.0\\.1:\\d+/);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":179,"text":"      if (match?.[0] !== undefined) {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":180,"text":"        clearTimeout(timer);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":181,"text":"        resolve(match[0]);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":182,"text":"      }"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":183,"text":"    });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":184,"text":"    child.stderr?.on(\"data\", (chunk: Buffer) => {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":185,"text":"      stderr += chunk.toString();"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":186,"text":"    });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":187,"text":"    child.on(\"error\", (error) => {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":188,"text":"      clearTimeout(timer);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":189,"text":"      reject(error);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":190,"text":"    });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":191,"text":"    child.on(\"exit\", (code) => {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":192,"text":"      if (code !== 0 && code !== null) {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":193,"text":"        clearTimeout(timer);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":194,"text":"        reject(new Error(`serve exited ${code}\\nstdout:\\n${stdout}\\nstderr:\\n${stderr}`));"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":195,"text":"      }"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":196,"text":"    });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":197,"text":"  });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":198,"text":"}"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":199,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":200,"text":"function waitForExit(child: ReturnType<typeof spawn>): Promise<void> {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":201,"text":"  if (child.exitCode !== null) {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":202,"text":"    return Promise.resolve();"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":203,"text":"  }"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":204,"text":"  return new Promise((resolve) => {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":205,"text":"    child.once(\"exit\", () => resolve());"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":206,"text":"  });"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":207,"text":"}"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":208,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":209,"text":"function isRecord(value: unknown): value is Record<string, unknown> {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":210,"text":"  return typeof value === \"object\" && value !== null && !Array.isArray(value);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":211,"text":"}"}]}
