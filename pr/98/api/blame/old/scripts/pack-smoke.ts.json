9588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":62,"text":"  );"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":63,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":64,"text":"  const versionOut = execFileSync(bin, [\"--version\"], { encoding: \"utf8\" });"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":65,"text":"  assert.equal(versionOut.trim(), version, `packed bin --version: ${JSON.stringify(versionOut)}`);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":66,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":67,"text":"  const work = await mkdtemp(join(tmpdir(), \"comprehende-cwd-\"));"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":68,"text":"  roots.push(work);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":69,"text":"  const repo = await createExampleRepo(work);"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":70,"text":"  const dataPath = join(work, \"review.json\");"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":71,"text":""},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":72,"text":"  const indexRaw = execFileSync(bin, [\"index\", \"--base\", repo.base, \"--head\", repo.head], {"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":73,"text":"    cwd: repo.root,"},{"sha":"c270bf95f0dfae9253d3c7611cd18799588eb6b4","author":"matemolnar8","timestamp":1786872408,"line":74,"text":"    encoding: \"utf8\","},{"sha":"c270bf95f0d