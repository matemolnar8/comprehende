{"path":"src/ui/components/QuestionList.tsx","ref":"02739aebc0a4f3928a5867376d0363b45591795d","side":"new","lines":[{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":1,"text":"import type { Questions } from \"../../schema/types.ts\";"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":2,"text":"import { askAgentPrompt } from \"../lib/agent-prompt.ts\";"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":3,"text":"import { AskAgent } from \"./AskAgent.tsx\";"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":4,"text":"import { InlineMd } from \"./InlineMd.tsx\";"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":5,"text":"import { BriefField, briefProse, briefRows } from \"./Kicker.tsx\";"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":6,"text":""},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":7,"text":"export function QuestionList(props: { groupId: string; questions: Questions }) {"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":8,"text":"  const { groupId, questions } = props;"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":9,"text":"  if (questions.length === 0) {"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":10,"text":"    return null;"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":11,"text":"  }"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":12,"text":"  return ("},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":13,"text":"    <BriefField kicker=\"Questions\">"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":14,"text":"      <ul className={briefRows}>"},{"sha":"7916fd39239ca52f88e28f63adb77d7f4901a955","author":"Máté Molnár","timestamp":1793521313,"line":15,"text":"        {questions.map((question, i) => ("},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":16,"text":"          <li"},{"sha":"7916fd39239ca52f88e28f63adb77d7f4901a955","author":"Máté Molnár","timestamp":1793521313,"line":17,"text":"            key={i}"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":18,"text":"            className=\"flex max-w-[calc(68ch+1.5rem)] items-start justify-between gap-3 py-1.5 first:pt-0 last:pb-0\""},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":19,"text":"          >"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":20,"text":"            <p className={briefProse}>"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":21,"text":"              <InlineMd text={question} />"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":22,"text":"            </p>"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":23,"text":"            <AskAgent prompt={askAgentPrompt({ group: groupId }, question)} scope=\"question\" />"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":24,"text":"          </li>"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":25,"text":"        ))}"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":26,"text":"      </ul>"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":27,"text":"    </BriefField>"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":28,"text":"  );"},{"sha":"ca0b4898bbcde5007339818c8a1082ec94dedb93","author":"Máté Molnár","timestamp":1793519660,"line":29,"text":"}"}]}
