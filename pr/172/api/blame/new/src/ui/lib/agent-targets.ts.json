{"path":"src/ui/lib/agent-targets.ts","ref":"5d59f087125233c028b0b844984838da3e3df2bf","side":"new","lines":[{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":1,"text":"import type { ApiReview } from \"../../api/types.ts\";"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":2,"text":"import { readKey, writeKey } from \"./storage.ts\";"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":3,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":4,"text":"type Repo = Pick<ApiReview[\"repo\"], \"origin\" | \"root\">;"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":5,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":6,"text":"type AgentTarget = {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":7,"text":"  label: string;"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":8,"text":"  /** A deep link that puts the prompt in the app's chat box. None of these send it. */"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":9,"text":"  link: ((prompt: string, repo: Repo) => string) | null;"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":10,"text":"};"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":11,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":12,"text":"export const AGENT_TARGETS = {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":13,"text":"  copy: { label: \"Copy prompt\", link: null },"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":14,"text":"  claude: {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":15,"text":"    label: \"Claude Code\","},{"sha":"5d59f087125233c028b0b844984838da3e3df2bf","author":"Máté Molnár","timestamp":1793556816,"line":16,"text":"    link: (prompt, repo) => deepLink(\"claude://code/new\", { q: prompt, folder: repo.root }),"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":17,"text":"  },"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":18,"text":"  codex: {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":19,"text":"    label: \"Codex\","},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":20,"text":"    link: (prompt, repo) => deepLink(\"codex://threads/new\", { prompt, path: repo.root }),"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":21,"text":"  },"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":22,"text":"  cursor: {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":23,"text":"    label: \"Cursor\","},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":24,"text":"    link: (prompt) => deepLink(\"cursor://anysphere.cursor-deeplink/prompt\", { text: prompt }),"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":25,"text":"  },"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":26,"text":"  t3code: {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":27,"text":"    label: \"T3 Code\","},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":28,"text":"    link: (prompt, repo) => deepLink(\"t3code://new\", { prompt, repo: repoSlug(repo.origin) }),"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":29,"text":"  },"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":30,"text":"} satisfies Record<string, AgentTarget>;"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":31,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":32,"text":"export type AgentTargetId = keyof typeof AGENT_TARGETS;"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":33,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":34,"text":"export const AGENT_TARGET_IDS = Object.keys(AGENT_TARGETS) as AgentTargetId[];"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":35,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":36,"text":"const STORAGE_KEY = \"comprehende.agent-target\";"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":37,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":38,"text":"function isAgentTargetId(raw: string | null): raw is AgentTargetId {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":39,"text":"  return raw !== null && Object.hasOwn(AGENT_TARGETS, raw);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":40,"text":"}"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":41,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":42,"text":"export function readStoredAgentTarget(): AgentTargetId {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":43,"text":"  const raw = readKey(localStorage, STORAGE_KEY);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":44,"text":"  return isAgentTargetId(raw) ? raw : \"copy\";"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":45,"text":"}"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":46,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":47,"text":"export function writeStoredAgentTarget(target: AgentTargetId): void {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":48,"text":"  writeKey(localStorage, STORAGE_KEY, target);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":49,"text":"}"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":50,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":51,"text":"export function agentLink(target: AgentTargetId, prompt: string, repo: Repo): string | null {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":52,"text":"  const { link } = AGENT_TARGETS[target];"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":53,"text":"  return link === null ? null : link(prompt, repo);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":54,"text":"}"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":55,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":56,"text":"/** `owner/name` from the last two path segments of a remote URL. Apps match it to a local clone. */"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":57,"text":"export function repoSlug(origin: string | null): string | null {"},{"sha":"02739aebc0a4f3928a5867376d0363b45591795d","author":"Máté Molnár","timestamp":1793549212,"line":58,"text":"  const match ="},{"sha":"02739aebc0a4f3928a5867376d0363b45591795d","author":"Máté Molnár","timestamp":1793549212,"line":59,"text":"    origin === null ? null : /[/:]([^/:]+)\\/([^/]+?)(?:\\.git)?\\/?$/i.exec(origin.trim());"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":60,"text":"  return match === null ? null : `${match[1]}/${match[2]}`;"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":61,"text":"}"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":62,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":63,"text":"/** encodeURIComponent, not URLSearchParams: some handlers read `+` as a plus sign. */"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":64,"text":"function deepLink(base: string, params: Record<string, string | null>): string {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":65,"text":"  const query = Object.entries(params)"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":66,"text":"    .flatMap(([key, value]) => (value === null ? [] : [`${key}=${encodeURIComponent(value)}`]))"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":67,"text":"    .join(\"&\");"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":68,"text":"  return query === \"\" ? base : `${base}?${query}`;"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":69,"text":"}"}]}
