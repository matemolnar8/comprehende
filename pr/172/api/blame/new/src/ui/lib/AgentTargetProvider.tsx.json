{"path":"src/ui/lib/AgentTargetProvider.tsx","ref":"5d59f087125233c028b0b844984838da3e3df2bf","side":"new","lines":[{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":1,"text":"import { createContext, useContext, useMemo, useState, type ReactNode } from \"react\";"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":2,"text":"import type { ApiReview } from \"../../api/types.ts\";"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":3,"text":"import {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":4,"text":"  readStoredAgentTarget,"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":5,"text":"  writeStoredAgentTarget,"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":6,"text":"  type AgentTargetId,"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":7,"text":"} from \"./agent-targets.ts\";"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":8,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":9,"text":"type AgentTargetContextValue = {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":10,"text":"  target: AgentTargetId;"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":11,"text":"  setTarget: (target: AgentTargetId) => void;"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":12,"text":"  repo: ApiReview[\"repo\"];"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":13,"text":"};"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":14,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":15,"text":"const AgentTargetContext = createContext<AgentTargetContextValue | null>(null);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":16,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":17,"text":"export function AgentTargetProvider(props: { repo: ApiReview[\"repo\"]; children: ReactNode }) {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":18,"text":"  const [target, setStateTarget] = useState(readStoredAgentTarget);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":19,"text":"  const { repo } = props;"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":20,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":21,"text":"  const value = useMemo("},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":22,"text":"    () => ({"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":23,"text":"      target,"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":24,"text":"      setTarget: (next: AgentTargetId) => {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":25,"text":"        writeStoredAgentTarget(next);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":26,"text":"        setStateTarget(next);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":27,"text":"      },"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":28,"text":"      repo,"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":29,"text":"    }),"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":30,"text":"    [target, repo],"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":31,"text":"  );"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":32,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":33,"text":"  return <AgentTargetContext.Provider value={value}>{props.children}</AgentTargetContext.Provider>;"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":34,"text":"}"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":35,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":36,"text":"export function useAgentTarget(): AgentTargetContextValue {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":37,"text":"  const value = useContext(AgentTargetContext);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":38,"text":"  if (value === null) {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":39,"text":"    throw new Error(\"useAgentTarget must be used within AgentTargetProvider\");"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":40,"text":"  }"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":41,"text":"  return value;"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":42,"text":"}"}]}
