{"path":"src/ui/lib/agent-targets.test.ts","ref":"02739aebc0a4f3928a5867376d0363b45591795d","side":"new","lines":[{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":1,"text":"import assert from \"node:assert/strict\";"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":2,"text":"import { describe, it } from \"vite-plus/test\";"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":3,"text":"import { AGENT_TARGET_IDS, agentLink, repoSlug } from \"./agent-targets.ts\";"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":4,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":5,"text":"const prompt ="},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":6,"text":"  \"Answer the following questions by using https://x.test/a.md: Why & how?\\nNext + more\";"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":7,"text":"const local = { origin: \"git@github.com:acme/widgets.git\", root: \"/home/me/widgets wt\" };"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":8,"text":"const hosted = { origin: \"https://github.com/acme/widgets\", root: null };"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":9,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":10,"text":"function params(link: string | null): Record<string, string> {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":11,"text":"  assert.ok(link !== null);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":12,"text":"  return Object.fromEntries(new URL(link).searchParams);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":13,"text":"}"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":14,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":15,"text":"describe(\"agentLink\", () => {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":16,"text":"  it(\"copy has no link\", () => {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":17,"text":"    assert.equal(agentLink(\"copy\", prompt, local), null);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":18,"text":"  });"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":19,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":20,"text":"  it(\"keeps the whole prompt for every app, with & + and new lines\", () => {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":21,"text":"    for (const id of AGENT_TARGET_IDS) {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":22,"text":"      const link = agentLink(id, prompt, local);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":23,"text":"      if (link === null) {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":24,"text":"        continue;"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":25,"text":"      }"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":26,"text":"      assert.ok(Object.values(params(link)).includes(prompt), id);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":27,"text":"      assert.doesNotMatch(link, /[ +\\n]/, id);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":28,"text":"    }"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":29,"text":"  });"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":30,"text":""},{"sha":"02739aebc0a4f3928a5867376d0363b45591795d","author":"Máté Molnár","timestamp":1793549212,"line":31,"text":"  it(\"opens Claude Code desktop with the prompt only, local or hosted\", () => {"},{"sha":"02739aebc0a4f3928a5867376d0363b45591795d","author":"Máté Molnár","timestamp":1793549212,"line":32,"text":"    assert.equal(agentLink(\"claude\", prompt, local), agentLink(\"claude\", prompt, hosted));"},{"sha":"02739aebc0a4f3928a5867376d0363b45591795d","author":"Máté Molnár","timestamp":1793549212,"line":33,"text":"    assert.deepEqual(params(agentLink(\"claude\", prompt, local)), { q: prompt });"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":34,"text":"  });"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":35,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":36,"text":"  it(\"gives Codex the path only when there is one\", () => {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":37,"text":"    assert.equal(params(agentLink(\"codex\", prompt, local)).path, \"/home/me/widgets wt\");"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":38,"text":"    assert.equal(params(agentLink(\"codex\", prompt, hosted)).path, undefined);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":39,"text":"  });"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":40,"text":"});"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":41,"text":""},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":42,"text":"describe(\"repoSlug\", () => {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":43,"text":"  it(\"reads owner/name from ssh and https remotes\", () => {"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":44,"text":"    assert.equal(repoSlug(\"git@github.com:acme/widgets.git\"), \"acme/widgets\");"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":45,"text":"    assert.equal(repoSlug(\"https://github.com/acme/widgets/\"), \"acme/widgets\");"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":46,"text":"    assert.equal(repoSlug(\"ssh://git@host:2222/acme/widgets.git\"), \"acme/widgets\");"},{"sha":"02739aebc0a4f3928a5867376d0363b45591795d","author":"Máté Molnár","timestamp":1793549212,"line":47,"text":"    assert.equal(repoSlug(\"git@host:acme/widgets.GIT\"), \"acme/widgets\");"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":48,"text":"    assert.equal(repoSlug(null), null);"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":49,"text":"  });"},{"sha":"199ceec0e07f4862e5c7685c846c23336a6bc70e","author":"Máté Molnár","timestamp":1793548640,"line":50,"text":"});"}]}
