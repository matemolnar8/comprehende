{"path":"src/ui/lib/file-nav.ts","ref":"d8658c1681fc92d4fa0a6d11218095be343f5219","side":"new","lines":[{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":1,"text":"import { basename } from \"../../schema/types.ts\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":2,"text":"import { readKey, writeKey } from \"./storage.ts\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":3,"text":""},{"sha":"71fb5ccfcb2df99800bd7ae54dab36187e42f215","author":"matemolnar8","timestamp":1787684722,"line":4,"text":"const RAIL_COLLAPSED_KEY = \"comprehende:rail-collapsed\";"},{"sha":"71fb5ccfcb2df99800bd7ae54dab36187e42f215","author":"matemolnar8","timestamp":1787684722,"line":5,"text":""},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":6,"text":"/** Below this width the file rail starts as the collapsed strip, unless the reader already chose. */"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":7,"text":"export const RAIL_NARROW_QUERY = \"(max-width: 1099px)\";"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":8,"text":""},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":9,"text":"/** `null` when the reader has not chosen. `\"1\"` is collapsed, `\"0\"` is open. */"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":10,"text":"export function readStoredRailCollapsed(): boolean | null {"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":11,"text":"  const raw = readKey(localStorage, RAIL_COLLAPSED_KEY);"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":12,"text":"  if (raw === \"1\") {"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":13,"text":"    return true;"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":14,"text":"  }"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":15,"text":"  if (raw === \"0\") {"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":16,"text":"    return false;"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":17,"text":"  }"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":18,"text":"  return null;"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":19,"text":"}"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":20,"text":""},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":21,"text":"/** Query wins, then a stored choice, then the narrow default. */"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":22,"text":"export function initialRailCollapsed(search: string, stored: boolean | null, narrowRail: boolean): boolean {"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":23,"text":"  const rail = new URLSearchParams(search).get(\"rail\");"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":24,"text":"  if (rail === \"collapsed\") {"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":25,"text":"    return true;"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":26,"text":"  }"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":27,"text":"  if (rail === \"open\") {"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":28,"text":"    return false;"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":29,"text":"  }"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":30,"text":"  if (stored !== null) {"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":31,"text":"    return stored;"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":32,"text":"  }"},{"sha":"857ca7f4137e7ce00c87880a7eae47952cfdfd3f","author":"Cursor Agent","timestamp":1790400390,"line":33,"text":"  return narrowRail;"},{"sha":"71fb5ccfcb2df99800bd7ae54dab36187e42f215","author":"matemolnar8","timestamp":1787684722,"line":34,"text":"}"},{"sha":"71fb5ccfcb2df99800bd7ae54dab36187e42f215","author":"matemolnar8","timestamp":1787684722,"line":35,"text":""},{"sha":"71fb5ccfcb2df99800bd7ae54dab36187e42f215","author":"matemolnar8","timestamp":1787684722,"line":36,"text":"export function writeStoredRailCollapsed(collapsed: boolean): void {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":37,"text":"  writeKey(localStorage, RAIL_COLLAPSED_KEY, collapsed ? \"1\" : \"0\");"},{"sha":"71fb5ccfcb2df99800bd7ae54dab36187e42f215","author":"matemolnar8","timestamp":1787684722,"line":38,"text":"}"},{"sha":"71fb5ccfcb2df99800bd7ae54dab36187e42f215","author":"matemolnar8","timestamp":1787684722,"line":39,"text":""},{"sha":"71fb5ccfcb2df99800bd7ae54dab36187e42f215","author":"matemolnar8","timestamp":1787684722,"line":40,"text":"/** File path helpers for display. */"},{"sha":"71fb5ccfcb2df99800bd7ae54dab36187e42f215","author":"matemolnar8","timestamp":1787684722,"line":41,"text":"export function fileBasename(path: string): string {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":42,"text":"  return basename(path);"},{"sha":"71fb5ccfcb2df99800bd7ae54dab36187e42f215","author":"matemolnar8","timestamp":1787684722,"line":43,"text":"}"},{"sha":"71fb5ccfcb2df99800bd7ae54dab36187e42f215","author":"matemolnar8","timestamp":1787684722,"line":44,"text":""},{"sha":"71fb5ccfcb2df99800bd7ae54dab36187e42f215","author":"matemolnar8","timestamp":1787684722,"line":45,"text":"export function fileDirname(path: string): string {"},{"sha":"71fb5ccfcb2df99800bd7ae54dab36187e42f215","author":"matemolnar8","timestamp":1787684722,"line":46,"text":"  const slash = path.lastIndexOf(\"/\");"},{"sha":"71fb5ccfcb2df99800bd7ae54dab36187e42f215","author":"matemolnar8","timestamp":1787684722,"line":47,"text":"  return slash === -1 ? \"\" : path.slice(0, slash);"},{"sha":"71fb5ccfcb2df99800bd7ae54dab36187e42f215","author":"matemolnar8","timestamp":1787684722,"line":48,"text":"}"}]}
