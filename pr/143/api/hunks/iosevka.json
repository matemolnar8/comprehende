- /dev/null\n+++ b/src/ui/lib/mono-font.ts\n@@ -0,0 +1,25 @@\n+import { readKey, writeKey } from \"./storage.ts\";\n+\n+export type MonoFont = \"plex\" | \"iosevka\";\n+\n+export const MONO_FONT_STORAGE_KEY = \"comprehende.mono-font\";\n+\n+export function parseMonoFont(raw: string | null): MonoFont {\n+  return raw === \"iosevka\" ? \"iosevka\" : \"plex\";\n+}\n+\n+export function nextMonoFont(font: MonoFont): MonoFont {\n+  return font === \"plex\" ? \"iosevka\" : \"plex\";\n+}\n+\n+export function applyMonoFont(font: MonoFont): void {\n+  document.documentElement.dataset.monoFont = font;\n+}\n+\n+export function readStoredMonoFont(): MonoFont {\n+  return parseMonoFont(readKey(localStorage, MONO_FONT_STORAGE_KEY));\n+}\n+\n+export function writeStoredMonoFont(font: MonoFont): void {\n+  writeKey(localStorage, MONO_FONT_STORAGE_KEY, font);\n+}\n","complete":true,"hunks":[{"path":"src/ui/lib/mono-font.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":25,"header":"@@ -0,0 +1,25 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import { readKey, writeKey } from \"./storage.ts\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":""},{"kind":"add","oldNumber":null,"newNumber":3,"text":"export type MonoFont = \"plex\" | \"iosevka\";"},{"kind":"add","oldNumber":null,"newNumber":4,"text":""},{"kind":"add","oldNumber":null,"newNumber":5,"text":"export const MONO_FONT_STORAGE_KEY = \"comprehende.mono-font\";"},{"kind":"add","oldNumber":null,"newNumber":6,"text":""},{"kind":"add","oldNumber":null,"newNumber":7,"text":"export function parseMonoFont(raw: string | null): MonoFont {"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"  return raw === \"iosevka\" ? \"iosevka\" : \"plex\";"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":10,"text":""},{"kind":"add","oldNumber":null,"newNumber":11,"text":"export function nextMonoFont(font: MonoFont): MonoFont {"},{"kind":"add","o