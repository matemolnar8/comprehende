l(parseMonoFont(\"iosevka\"), \"iosevka\");\n+  });\n+\n+  it(\"toggles between the two fonts\", () => {\n+    assert.equal(nextMonoFont(\"plex\"), \"iosevka\");\n+    assert.equal(nextMonoFont(\"iosevka\"), \"plex\");\n+  });\n+});\n","complete":true,"hunks":[{"path":"src/ui/lib/mono-font.test.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":21,"header":"@@ -0,0 +1,21 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import assert from \"node:assert/strict\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import { describe, it } from \"vite-plus/test\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import { nextMonoFont, parseMonoFont } from \"./mono-font.ts\";"},{"kind":"add","oldNumber":null,"newNumber":4,"text":""},{"kind":"add","oldNumber":null,"newNumber":5,"text":"describe(\"mono font preference\", () => {"},{"kind":"add","oldNumber":null,"newNumber":6,"text":"  it(\"treats missing or unknown values as plex\", () => {"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"    assert.equal(parseMonoFont(null), \"plex\");"},{"kind":"add","oldNumber":null,"newNumber":8,"text":"    assert.equal(parseMonoFont(\"\"), \"plex\");"},{"kind":"add","oldNumber":null,"newNumber":9,"text":"    assert.equal(parseMonoFont(\"plex\"), \"plex\");"},{"kind":"add","oldNumber":null,"newNumber":10,"text":"    assert.equal(parseMonoFont(\"courier\"), \"plex\");"},{"kind":"add","oldNumber":null,"newNumber":11,"text":"  });"},{"kind":"add","oldNumber":null,"newNumber":12,"text":""},{"kind":"add","oldNumber":null,"newNumber":13,"text":"  it(\"accepts stored iosevka\", () => {"},{"kind":"add","oldNumber":null,"newNumber":14,"text":"    assert.equal(parseMonoFont(\"iosevka\"), \"iosevka\");"},{"kind":"add","oldNumber":null,"newNumber":15,"text":"  });"},{"kind":"add","oldNumber":null,"newNumber":16,"text":""},{"kind":"add","oldNumber":null,"newNumber":17,"text":"  it(\"toggles between the two fonts\", () => {"},{"kind":"add","