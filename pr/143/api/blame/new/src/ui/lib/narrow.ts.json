{"path":"src/ui/lib/narrow.ts","ref":"dab1e44dc86529cf9d3f90ebc62ec1c59e4a92dd","side":"new","lines":[{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":1,"text":"import { useEffect, useState } from \"react\";"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":2,"text":""},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":3,"text":"export const NARROW_QUERY = \"(max-width: 799px)\";"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":4,"text":""},{"sha":"dab1e44dc86529cf9d3f90ebc62ec1c59e4a92dd","author":"Máté Molnár","timestamp":1792267388,"line":5,"text":"/** Narrow screens wrap by default so a line fits the card. An explicit toggle wins. */"},{"sha":"dab1e44dc86529cf9d3f90ebc62ec1c59e4a92dd","author":"Máté Molnár","timestamp":1792267388,"line":6,"text":"export function resolveWrap(override: boolean | null, narrow: boolean): boolean {"},{"sha":"dab1e44dc86529cf9d3f90ebc62ec1c59e4a92dd","author":"Máté Molnár","timestamp":1792267388,"line":7,"text":"  return override ?? narrow;"},{"sha":"dab1e44dc86529cf9d3f90ebc62ec1c59e4a92dd","author":"Máté Molnár","timestamp":1792267388,"line":8,"text":"}"},{"sha":"dab1e44dc86529cf9d3f90ebc62ec1c59e4a92dd","author":"Máté Molnár","timestamp":1792267388,"line":9,"text":""},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":10,"text":"export function useNarrow(): boolean {"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":11,"text":"  const [narrow, setNarrow] = useState(() => window.matchMedia(NARROW_QUERY).matches);"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":12,"text":"  useEffect(() => {"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":13,"text":"    const media = window.matchMedia(NARROW_QUERY);"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":14,"text":"    const onChange = () => setNarrow(media.matches);"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":15,"text":"    media.addEventListener(\"change\", onChange);"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":16,"text":"    return () => media.removeEventListener(\"change\", onChange);"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":17,"text":"  }, []);"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":18,"text":"  return narrow;"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":19,"text":"}"}]}
