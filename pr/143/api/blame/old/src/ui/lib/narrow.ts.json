{"path":"src/ui/lib/narrow.ts","ref":"b6874adce51508c7d7d48118445146e7b93d5d1a","side":"old","lines":[{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":1,"text":"import { useEffect, useState } from \"react\";"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":2,"text":""},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":3,"text":"export const NARROW_QUERY = \"(max-width: 799px)\";"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":4,"text":""},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":5,"text":"export function useNarrow(): boolean {"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":6,"text":"  const [narrow, setNarrow] = useState(() => window.matchMedia(NARROW_QUERY).matches);"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":7,"text":"  useEffect(() => {"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":8,"text":"    const media = window.matchMedia(NARROW_QUERY);"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":9,"text":"    const onChange = () => setNarrow(media.matches);"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":10,"text":"    media.addEventListener(\"change\", onChange);"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":11,"text":"    return () => media.removeEventListener(\"change\", onChange);"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":12,"text":"  }, []);"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":13,"text":"  return narrow;"},{"sha":"a3e4393921ed1f96a5b9fa4b5f49a89e3904befb","author":"Cursor Agent","timestamp":1788720604,"line":14,"text":"}"}]}
