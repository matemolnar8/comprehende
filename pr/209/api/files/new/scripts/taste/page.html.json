{"path":"scripts/taste/page.html","ref":"4b0585cd17d8bc17a13958e6a61bf6f5288a1d1d","side":"new","content":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\" />\n    <title>Taste Lab</title>\n    <style>\n      /* One file, no network. Colors come from the host's theme variables when it has them\n         (T3 Code sets them on an inline page), else from the system colors, so the page\n         follows light and dark with no theme of its own. */\n      :root {\n        color-scheme: light dark;\n        --fg: var(--foreground, CanvasText);\n        --dim: var(--muted-foreground, color-mix(in srgb, CanvasText 58%, Canvas));\n        --surface: var(--card, color-mix(in srgb, CanvasText 4%, Canvas));\n        --line: var(--border, color-mix(in srgb, CanvasText 14%, Canvas));\n        --pick: var(--primary, #5b5bd6);\n        --on-pick: var(--primary-foreground, #fff);\n        --good: var(--success, #2f9e6b);\n        --bad: var(--destructive, #d2504b);\n        --code: var(--code-background, color-mix(in srgb, CanvasText 6%, Canvas));\n        --r: var(--radius, 14px);\n        --sans: var(--font-sans, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif);\n        --mono: var(--font-mono, ui-monospace, \"SF Mono\", Menlo, monospace);\n      }\n      * {\n        box-sizing: border-box;\n      }\n      body {\n        margin: 0;\n        color: var(--fg);\n        font: 16px/1.5 var(--sans);\n        -webkit-text-size-adjust: 100%;\n      }\n      /* Opened on its own, the page needs the gutter a host frame would give it. */\n      .standalone body {\n        padding: max(16px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right))\n          max(24px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));\n      }\n      #app {\n        max-width: 560px;\n        margin: 0 auto;\n        display: flex;\n        flex-direction: column;\n        gap: 14px;\n      }\n      .bar {\n        display: flex;\n        gap: 3px;\n        align-items: center;\n      }\n      .bar i {\n        flex: 1;\n        height: 4px;\n        border-radius: 2px;\n        background: var(--line);\n        transition: background 0.2s;\n      }\n      .bar i.done {\n        background: color-mix(in srgb, var(--pick) 45%, var(--line));\n      }\n      .bar i.now {\n        background: var(--pick);\n      }\n      .bar span {\n        margin-left: 8px;\n        font-size: 12px;\n        color: var(--dim);\n        font-variant-numeric: tabular-nums;\n      }\n      .eyebrow {\n        font-size: 11px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        color: var(--dim);\n        overflow-wrap: anywhere;\n      }\n      .eyebrow b {\n        color: var(--pick);\n        font-weight: 600;\n      }\n      h1 {\n        font-size: 22px;\n        line-height: 1.2;\n        letter-spacing: -0.015em;\n        font-weight: 650;\n        margin: 2px 0 0;\n        text-wrap: balance;\n      }\n      .card {\n        animation: in 0.18s ease-out;\n        display: flex;\n        flex-direction: column;\n        gap: 12px;\n      }\n      @keyframes in {\n        from {\n          opacity: 0;\n          transform: translateY(6px);\n        }\n      }\n      @media (prefers-reduced-motion: reduce) {\n        .card {\n          animation: none;\n        }\n      }\n      button {\n        font: inherit;\n        color: inherit;\n        cursor: pointer;\n        -webkit-tap-highlight-color: transparent;\n      }\n      button:focus-visible {\n        outline: 2px solid var(--pick);\n        outline-offset: 2px;\n      }\n      .option {\n        display: grid;\n        grid-template-columns: auto 1fr;\n        gap: 4px 12px;\n        text-align: left;\n        width: 100%;\n        padding: 14px 16px 14px 14px;\n        background: var(--surface);\n        border: 1.5px solid var(--line);\n        border-radius: var(--r);\n        transition:\n          border-color 0.12s,\n          transform 0.12s,\n          background 0.12s;\n      }\n      .option:active {\n        transform: scale(0.985);\n      }\n      @media (hover: hover) {\n        .option:hover {\n          border-color: color-mix(in srgb, var(--pick) 55%, var(--line));\n        }\n      }\n      .option.picked {\n        border-color: var(--pick);\n        background: color-mix(in srgb, var(--pick) 9%, var(--surface));\n      }\n      .letter {\n        grid-row: span 2;\n        width: 26px;\n        height: 26px;\n        border-radius: 50%;\n        display: grid;\n        place-items: center;\n        font-size: 13px;\n        font-weight: 650;\n        border: 1.5px solid var(--line);\n        color: var(--dim);\n        transition: all 0.12s;\n      }\n      .picked .letter {\n        background: var(--pick);\n        border-color: var(--pick);\n        color: var(--on-pick);\n      }\n      .option h2 {\n        margin: 1px 0 0;\n        font-size: 16px;\n        font-weight: 650;\n        line-height: 1.3;\n      }\n      .option p {\n        margin: 0;\n        grid-column: 2;\n        white-space: pre-line;\n        overflow-wrap: anywhere;\n      }\n      /* Words both sides share step back, so the eye lands on what differs. */\n      .shared {\n        color: var(--dim);\n      }\n      code {\n        font: 0.86em var(--mono);\n        background: var(--code);\n        padding: 1px 5px;\n        border-radius: 5px;\n        overflow-wrap: anywhere;\n      }\n      .src {\n        text-decoration: underline dotted;\n        text-underline-offset: 3px;\n      }\n      pre {\n        margin: 0;\n        padding: 8px 0;\n        background: var(--code);\n        border-radius: calc(var(--r) - 4px);\n        overflow-x: auto;\n        font: 12px/1.6 var(--mono);\n      }\n      pre div {\n        padding: 0 12px;\n        white-space: pre;\n      }\n      pre div.on {\n        background: color-mix(in srgb, var(--pick) 16%, transparent);\n        box-shadow: inset 2px 0 var(--pick);\n      }\n      pre i {\n        font-style: normal;\n        color: var(--dim);\n        display: inline-block;\n        width: 3.4em;\n        user-select: none;\n      }\n      .row {\n        display: flex;\n        gap: 8px;\n        align-items: center;\n      }\n      .ghost {\n        min-height: 44px;\n        padding: 0 14px;\n        border-radius: 999px;\n        border: 1.5px solid var(--line);\n        background: transparent;\n        font-size: 14px;\n        font-weight: 550;\n      }\n      .ghost.quiet {\n        border-color: transparent;\n        color: var(--dim);\n        padding: 0 8px;\n      }\n      .ghost.bad {\n        color: var(--bad);\n      }\n      /* The answer a card already holds, shown when you step back to it. */\n      .ghost.picked,\n      .big.picked {\n        border-color: var(--pick);\n        box-shadow: inset 0 0 0 1.5px var(--pick);\n      }\n      .big {\n        flex: 1;\n        min-height: 54px;\n        border-radius: var(--r);\n        border: 1.5px solid var(--line);\n        background: var(--surface);\n        font-weight: 650;\n      }\n      .big.yes.picked {\n        box-shadow: inset 0 0 0 3px var(--on-pick);\n      }\n      .big.yes {\n        background: var(--pick);\n        border-color: var(--pick);\n        color: var(--on-pick);\n      }\n      .grow {\n        flex: 1;\n      }\n      .pair {\n        display: grid;\n        gap: 8px;\n      }\n      .pair div {\n        padding: 10px 14px;\n        border-radius: calc(var(--r) - 4px);\n        background: var(--surface);\n        border-left: 3px solid var(--line);\n        white-space: pre-line;\n        overflow-wrap: anywhere;\n      }\n      .pair .after {\n        border-left-color: var(--good);\n      }\n      .pair small {\n        display: block;\n        font-size: 11px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        color: var(--dim);\n      }\n      .score {\n        display: grid;\n        gap: 10px;\n      }\n      .score div {\n        display: grid;\n        grid-template-columns: 1fr auto;\n        gap: 4px 12px;\n        font-size: 14px;\n        overflow-wrap: anywhere;\n      }\n      .score b {\n        font-variant-numeric: tabular-nums;\n      }\n      .score i {\n        grid-column: span 2;\n        height: 6px;\n        border-radius: 3px;\n        background: var(--line);\n        overflow: hidden;\n      }\n      .score i::after {\n        content: \"\";\n        display: block;\n        height: 100%;\n        width: var(--w);\n        background: var(--pick);\n        border-radius: 3px;\n      }\n      .codebox {\n        display: flex;\n        gap: 8px;\n      }\n      .codebox input {\n        flex: 1;\n        min-width: 0;\n        font: 14px var(--mono);\n        color: inherit;\n        background: var(--code);\n        border: 1.5px solid var(--line);\n        border-radius: calc(var(--r) - 4px);\n        padding: 0 12px;\n        min-height: 48px;\n      }\n      .hint {\n        font-size: 13px;\n        color: var(--dim);\n        margin: 0;\n      }\n      .keys {\n        display: none;\n      }\n      @media (hover: hover) and (pointer: fine) {\n        .keys {\n          display: block;\n        }\n      }\n      kbd {\n        font: 11px var(--mono);\n        border: 1px solid var(--line);\n        border-radius: 4px;\n        padding: 0 4px;\n      }\n    </style>\n  </head>\n  <body>\n    <main id=\"app\"></main>\n    <script>\n      // The page builder replaces this value with the round: { id, duels, ideas, webhook }.\n      const ROUND = \"__ROUND__\";\n      if (window.self === window.top) document.documentElement.classList.add(\"standalone\");\n\n      const el = (tag, cls, html) => {\n        const node = document.createElement(tag);\n        if (cls) node.className = cls;\n        if (html != null) node.innerHTML = html;\n        return node;\n      };\n      const esc = (s) =>\n        String(s).replace(\n          /[&<>\"]/g,\n          (c) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" })[c],\n        );\n      const md = (s) =>\n        esc(s)\n          .replace(/\\[([^\\]]+)\\]\\(source:[^)]+\\)/g, '<span class=\"src\">$1</span>')\n          .replace(/`([^`]+)`/g, \"<code>$1</code>\");\n      const button = (label, cls, act) => {\n        const node = el(\"button\", cls);\n        node.type = \"button\";\n        node.textContent = label;\n        node.onclick = act;\n        return node;\n      };\n\n      const cards = [\n        ...ROUND.duels.map((duel) => ({ type: \"duel\", duel })),\n        ...ROUND.ideas.map((idea) => ({ type: \"idea\", idea })),\n      ];\n      const storeKey = \"taste.\" + ROUND.id;\n      let answers = cards.map(() => \"-\");\n      try {\n        const saved = JSON.parse(localStorage.getItem(storeKey));\n        if (Array.isArray(saved) && saved.length === cards.length) answers = saved;\n      } catch {}\n      const firstOpen = answers.indexOf(\"-\");\n      let at = firstOpen === -1 ? cards.length : firstOpen;\n      let shownAt = 0;\n      let keys = {};\n      const app = document.getElementById(\"app\");\n\n      // Half the duels show y first. The answer is stored as x or y, never as a side of the screen.\n      const flipped = (duel) => parseInt(duel.id.slice(-1), 16) % 2 === 1;\n      const code = () => {\n        const n = ROUND.duels.length;\n        return [\"taste\", ROUND.id, answers.slice(0, n).join(\"\"), answers.slice(n).join(\"\")].join(\n          \".\",\n        );\n      };\n\n      function answer(value) {\n        // One answer per card: a second tap waits for the next card, and that card waits a moment\n        // too, because the second tap of a double-tap lands on it.\n        if (leaving || Date.now() - shownAt < 350) return false;\n        leaving = true;\n        answers[at] = value;\n        try {\n          localStorage.setItem(storeKey, JSON.stringify(answers));\n        } catch {}\n        at += 1;\n        timer = setTimeout(render, 170);\n        return true;\n      }\n\n      let leaving = false;\n      let timer;\n      const held = (value) => (answers[at] === value ? \" picked\" : \"\");\n\n      function progress() {\n        const bar = el(\"div\", \"bar\");\n        cards.forEach((_, i) =>\n          bar.append(el(\"i\", i === at ? \"now\" : answers[i] !== \"-\" ? \"done\" : \"\")),\n        );\n        bar.append(el(\"span\", \"\", Math.min(at + 1, cards.length) + \" / \" + cards.length));\n        return bar;\n      }\n\n      function footer(extra) {\n        const row = el(\"div\", \"row\");\n        if (at > 0) row.append(button(\"Back\", \"ghost quiet\", () => ((at -= 1), render())));\n        row.append(el(\"span\", \"grow\"), ...extra);\n        row.append(button(\"Stop here\", \"ghost quiet\", () => ((at = cards.length), render())));\n        return row;\n      }\n\n      // In two near-equal texts, the words both hold step back. Texts that differ more read whole.\n      function dimShared(a, b) {\n        const words = (node) => new Set(node.textContent.toLowerCase().match(/[\\w'-]+/g) || []);\n        const [wa, wb] = [words(a), words(b)];\n        const common = [...wa].filter((w) => wb.has(w));\n        if (common.length < 0.6 * Math.max(wa.size, wb.size)) return;\n        for (const [node, other] of [\n          [a, wb],\n          [b, wa],\n        ]) {\n          const walker = document.createTreeWalker(node, NodeFilter.SHOW_TEXT);\n          const texts = [];\n          while (walker.nextNode()) texts.push(walker.currentNode);\n          for (const text of texts) {\n            const frag = document.createDocumentFragment();\n            for (const part of text.textContent.split(/([\\w'-]+)/)) {\n              if (other.has(part.toLowerCase())) {\n                const span = el(\"span\", \"shared\");\n                span.textContent = part;\n                frag.append(span);\n              } else frag.append(part);\n            }\n            text.replaceWith(frag);\n          }\n        }\n      }\n\n      function renderDuel(duel) {\n        const sides = flipped(duel) ? [\"y\", \"x\"] : [\"x\", \"y\"];\n        const card = el(\"section\", \"card\");\n        card.append(el(\"div\", \"eyebrow\", \"<b>\" + esc(duel.kind) + \"</b> · \" + esc(duel.context)));\n        card.append(el(\"h1\", \"\", esc(duel.question)));\n        if (duel.code) {\n          const pre = el(\"pre\");\n          for (const [n, line] of duel.code.lines) {\n            pre.append(el(\"div\", n === duel.code.on ? \"on\" : \"\", \"<i>\" + n + \"</i>\" + esc(line)));\n          }\n          card.append(pre);\n        }\n        const bodies = sides.map((side, i) => {\n          const entry = duel[side];\n          const option = el(\"button\", \"option\" + held(side));\n          option.type = \"button\";\n          option.append(el(\"span\", \"letter\", \"AB\"[i]));\n          if (entry.title) option.append(el(\"h2\", \"\", md(entry.title)));\n          const body = el(\"p\", \"\", md(entry.text));\n          option.append(body);\n          option.onclick = () => {\n            if (answer(side)) option.classList.add(\"picked\");\n          };\n          card.append(option);\n          keys[\"ab\"[i]] = option.onclick;\n          return body;\n        });\n        dimShared(bodies[0], bodies[1]);\n        keys.s = () => answer(\"s\");\n        keys.x = () => answer(\"n\");\n        card.append(\n          footer([\n            button(\"Same\", \"ghost\" + held(\"s\"), keys.s),\n            button(\"Both bad\", \"ghost bad\" + held(\"n\"), keys.x),\n          ]),\n        );\n        card.append(\n          el(\n            \"p\",\n            \"hint keys\",\n            \"<kbd>A</kbd> <kbd>B</kbd> pick · <kbd>S</kbd> same · <kbd>X</kbd> both bad · <kbd>←</kbd> back\",\n          ),\n        );\n        return card;\n      }\n\n      function renderIdea(idea) {\n        const card = el(\"section\", \"card\");\n        card.append(el(\"div\", \"eyebrow\", \"<b>idea</b> · worth a test run?\"));\n        card.append(el(\"h1\", \"\", esc(idea.idea)));\n        const pair = el(\"div\", \"pair\");\n        pair.append(\n          el(\"div\", \"\", \"<small>Now</small>\" + md(idea.before)),\n          el(\"div\", \"after\", \"<small>With the idea</small>\" + md(idea.after)),\n        );\n        card.append(pair);\n        keys.n = () => answer(\"n\");\n        keys.y = () => answer(\"y\");\n        const row = el(\"div\", \"row\");\n        row.append(\n          button(\"Skip\", \"big\" + held(\"n\"), keys.n),\n          button(\"Try it\", \"big yes\" + held(\"y\"), keys.y),\n        );\n        card.append(row, footer([]));\n        card.append(\n          el(\"p\", \"hint keys\", \"<kbd>Y</kbd> try · <kbd>N</kbd> skip · <kbd>←</kbd> back\"),\n        );\n        return card;\n      }\n\n      function renderEnd() {\n        const card = el(\"section\", \"card\");\n        const open = answers.filter((a) => a === \"-\").length;\n        card.append(el(\"div\", \"eyebrow\", open ? open + \" left open\" : \"all answered\"));\n        card.append(el(\"h1\", \"\", \"Paste this code in the thread.\"));\n\n        const box = el(\"div\", \"codebox\");\n        const input = el(\"input\");\n        input.readOnly = true;\n        input.value = code();\n        input.setAttribute(\"aria-label\", \"Answer code\");\n        input.onfocus = () => input.select();\n        const copy = button(\"Copy\", \"big yes\", async () => {\n          try {\n            await navigator.clipboard.writeText(input.value);\n            copy.textContent = \"Copied\";\n          } catch {\n            input.focus();\n            input.select();\n            copy.textContent = \"Press copy\";\n          }\n        });\n        copy.style.flex = \"none\";\n        copy.style.padding = \"0 18px\";\n        box.append(input, copy);\n        card.append(box);\n\n        // One send per code, so a reload or a second look at this screen sends nothing new.\n        let last = null;\n        try {\n          last = localStorage.getItem(storeKey + \".sent\");\n        } catch {}\n        if (ROUND.webhook && last !== code()) {\n          try {\n            localStorage.setItem(storeKey + \".sent\", code());\n          } catch {}\n          const sent = el(\"p\", \"hint\", \"Sending it to your agent…\");\n          card.append(sent);\n          // A plain text POST needs no preflight, so it also leaves a sandboxed frame.\n          fetch(ROUND.webhook, { method: \"POST\", mode: \"no-cors\", body: code() }).then(\n            () => (sent.textContent = \"Sent to your agent. The code above is a spare.\"),\n            () => (sent.textContent = \"Could not send it. Paste the code instead.\"),\n          );\n        }\n\n        const rate = (row) => (row.played ? row.wins / row.played : 0);\n        const rows = new Map();\n        ROUND.duels.forEach((duel, i) => {\n          for (const side of [\"x\", \"y\"]) {\n            const row = rows.get(duel[side].label) || { wins: 0, played: 0 };\n            if (answers[i] === \"x\" || answers[i] === \"y\") {\n              row.played += 1;\n              if (answers[i] === side) row.wins += 1;\n            }\n            rows.set(duel[side].label, row);\n          }\n        });\n        if ([...rows.values()].some((row) => row.played)) {\n          card.append(el(\"div\", \"eyebrow\", \"who you picked\"));\n          const score = el(\"div\", \"score\");\n          [...rows]\n            .sort((a, b) => rate(b[1]) - rate(a[1]) || b[1].wins - a[1].wins)\n            .forEach(([label, row]) => {\n              const line = el(\n                \"div\",\n                \"\",\n                esc(label) + \"<b>\" + row.wins + \" / \" + row.played + \"</b>\",\n              );\n              const meter = el(\"i\");\n              meter.style.setProperty(\n                \"--w\",\n                (row.played ? (100 * row.wins) / row.played : 0) + \"%\",\n              );\n              line.append(meter);\n              score.append(line);\n            });\n          card.append(score);\n        }\n        if (cards.length) {\n          const row = el(\"div\", \"row\");\n          row.append(\n            button(\"Back\", \"ghost quiet\", () => ((at = cards.length - 1), render())),\n            el(\"span\", \"grow\"),\n            button(\"From the start\", \"ghost quiet\", () => ((at = 0), render())),\n          );\n          card.append(row);\n        }\n        return card;\n      }\n\n      function render() {\n        clearTimeout(timer);\n        shownAt = Date.now();\n        leaving = false;\n        keys = {};\n        const current = cards[at];\n        app.replaceChildren(\n          progress(),\n          !current\n            ? renderEnd()\n            : current.type === \"duel\"\n              ? renderDuel(current.duel)\n              : renderIdea(current.idea),\n        );\n      }\n\n      addEventListener(\"keydown\", (event) => {\n        if (event.metaKey || event.ctrlKey || event.altKey || event.target.tagName === \"INPUT\")\n          return;\n        if (event.key === \"ArrowLeft\" && at > 0) {\n          at -= 1;\n          render();\n        } else if (keys[event.key.toLowerCase()]) keys[event.key.toLowerCase()]();\n      });\n      render();\n    </script>\n  </body>\n</html>\n","language":"html"}
