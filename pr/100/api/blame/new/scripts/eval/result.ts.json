[];"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":144,"text":"  return {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":145,"text":"    major: findings.filter((item) => item.severity === \"major\").length,"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":146,"text":"    minor: findings.filter((item) => item.severity === \"minor\").length,"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":147,"text":"  };"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":148,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":149,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":150,"text":"export function formatDuration(ms: number): string {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":151,"text":"  const seconds = Math.max(0, Math.round(ms / 1000));"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":152,"text":"  if (seconds < 60) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":153,"text":"    return `${seconds}s`;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":154,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":155,"text":"  const minutes = Math.floor(seconds / 60);"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":156,"text":"  const rest = seconds % 60;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":157,"text":"  return `${minutes}m${String(rest).padStart(2, \"0\")}s`;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":158,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":159,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":160,"text":"export function formatTokens(tokens: number): string {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":161,"text":"  if (tokens < 1000) {"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":162,"text":"    return `${tokens} tok`;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":163,"text":"  }"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":164,"text":"  return `${Math.round(tokens / 1000)}k tok`;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":165,"text":"}"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":166,"text":""},{"sha":"b7623973c7b6870f1fb718092d5776dbd6e74801","author":"Cursor Agent","timestamp":1790061987,"line":167,"text":"export function formatRunTotals(summary: RunSummary): string {"},{"sha":"b7623973c7b6870f1fb718092d5776dbd6e74801","author":"Cursor Agent","timestamp":1790061987,"line":168,"text":"  const producerTokens = sum(summary.cases, (item) => item.producer?.tokens ?? 0);"},{"sha":"b7623973c7b6870f1fb718092d5776dbd6e74801","author":"Cursor Agent","timestamp":1790061987,"line":169,"text":"  const groupingTokens = sum(summary.cases, (item) => item.grouping?.run.tokens ?? 0);"},{"sha":"b7623973c7b6870f1fb718092d5776dbd6e74801","author":"Cursor Agent"