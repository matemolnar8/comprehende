{"path":"scripts/eval/env.test.ts","ref":"ffd116fb87c2578ef771cde505ed2a73bc886eda","side":"new","lines":[{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":1,"text":"import assert from \"node:assert/strict\";"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":2,"text":"import { mkdtemp, writeFile } from \"node:fs/promises\";"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":3,"text":"import { tmpdir } from \"node:os\";"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":4,"text":"import { join } from \"node:path\";"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":5,"text":"import { describe, it } from \"node:test\";"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":6,"text":"import { loadDotEnv } from \"./env.ts\";"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":7,"text":""},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":8,"text":"const KEYS = [\"COMPREHENDE_EVAL_DOTENV_A\", \"COMPREHENDE_EVAL_DOTENV_B\", \"COMPREHENDE_EVAL_DOTENV_C\"] as const;"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":9,"text":""},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":10,"text":"function save(): Map<string, string | undefined> {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":11,"text":"  return new Map(KEYS.map((key) => [key, process.env[key]]));"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":12,"text":"}"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":13,"text":""},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":14,"text":"function restore(saved: Map<string, string | undefined>): void {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":15,"text":"  for (const [key, value] of saved) {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":16,"text":"    if (value === undefined) {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":17,"text":"      delete process.env[key];"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":18,"text":"    } else {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":19,"text":"      process.env[key] = value;"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":20,"text":"    }"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":21,"text":"  }"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":22,"text":"}"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":23,"text":""},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":24,"text":"describe(\"loadDotEnv\", () => {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":25,"text":"  it(\"loads keys, strips quotes, skips comments, and leaves real env alone\", async () => {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":26,"text":"    const saved = save();"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":27,"text":"    try {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":28,"text":"      const dir = await mkdtemp(join(tmpdir(), \"comprehende-dotenv-\"));"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":29,"text":"      await writeFile("},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":30,"text":"        join(dir, \".env\"),"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":31,"text":"        ["},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":32,"text":"          \"# comment\","},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":33,"text":"          \"\","},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":34,"text":"          \"COMPREHENDE_EVAL_DOTENV_A=abc\","},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":35,"text":"          'COMPREHENDE_EVAL_DOTENV_B=\"x y\"',"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":36,"text":"          \"COMPREHENDE_EVAL_DOTENV_C=from-file\","},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":37,"text":"          \"NOEQUALS\","},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":38,"text":"        ].join(\"\\n\"),"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":39,"text":"      );"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":40,"text":"      process.env.COMPREHENDE_EVAL_DOTENV_C = \"real-env\";"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":41,"text":"      await loadDotEnv(dir);"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":42,"text":"      assert.equal(process.env.COMPREHENDE_EVAL_DOTENV_A, \"abc\");"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":43,"text":"      assert.equal(process.env.COMPREHENDE_EVAL_DOTENV_B, \"x y\");"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":44,"text":"      assert.equal(process.env.COMPREHENDE_EVAL_DOTENV_C, \"real-env\");"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":45,"text":"    } finally {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":46,"text":"      restore(saved);"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":47,"text":"    }"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":48,"text":"  });"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":49,"text":""},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":50,"text":"  it(\"ignores a missing file\", async () => {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":51,"text":"    const dir = await mkdtemp(join(tmpdir(), \"comprehende-dotenv-empty-\"));"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":52,"text":"    await loadDotEnv(dir);"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":53,"text":"  });"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":54,"text":"});"}]}
