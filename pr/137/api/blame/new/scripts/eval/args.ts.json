{"path":"scripts/eval/args.ts","ref":"ffd116fb87c2578ef771cde505ed2a73bc886eda","side":"new","lines":[{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":1,"text":"import { DEFAULT_GRADER_MODEL, DEFAULT_PRODUCER_MODEL } from \"./constants.ts\";"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":2,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":3,"text":"export const EVAL_USAGE = `Usage: pnpm eval -- [options]"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":4,"text":""},{"sha":"d05d71698063919c5928f161ed03e5c749f26594","author":"Cursor Agent","timestamp":1789938688,"line":5,"text":"Grade Comprehende reviews. An isolated producer follows the next skill. Deterministic checks score the result. Two read-only graders also score unless --no-graders. LLM findings do not change the exit code."},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":6,"text":""},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":7,"text":"Producer and graders run in Muse Code. Both default to ${DEFAULT_PRODUCER_MODEL}."},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":8,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":9,"text":"Options:"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":10,"text":"  --case <id>             Run this case (repeatable)"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":11,"text":"  --tag <tag>             Run cases with this tag"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":12,"text":"  --baseline <dir>        Print deltas against a previous eval/runs/<stamp>"},{"sha":"ef1e688be084667a7f76ce365dfbe44bba1f7f55","author":"Cursor Agent","timestamp":1790371794,"line":13,"text":"  --rescore <dir>         Re-check eval/runs/<stamp> reviews. No producer, no graders, no API key"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":14,"text":"  --json                  Also print summary.json to stdout"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":15,"text":"  --producer-model <id>   Default ${DEFAULT_PRODUCER_MODEL}"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":16,"text":"  --grader-model <id>     Default ${DEFAULT_GRADER_MODEL}"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":17,"text":"  --cli-login             Use the muse CLI login instead of MUSE_CODE_API_KEY"},{"sha":"d05d71698063919c5928f161ed03e5c749f26594","author":"Cursor Agent","timestamp":1789938688,"line":18,"text":"  --no-graders            Skip grouping and prose graders"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":19,"text":"  -h, --help"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":20,"text":""},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":21,"text":"Needs MUSE_CODE_API_KEY in the environment or .env unless --rescore. Pass --cli-login to use the muse CLI login instead of MUSE_CODE_API_KEY. Writes eval/runs/<stamp>/index.html. Exit 1 when validate fails or a deterministic expect misses. Prose lint is advisory."},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":22,"text":"`;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":23,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":24,"text":"export const ADD_CASE_USAGE = `Usage: pnpm eval:add -- --pr <github pr url>"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":25,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":26,"text":"Fetch a pull request and write eval/cases/<repo>-<n>/ with frozen sources and empty expect."},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":27,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":28,"text":"Options:"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":29,"text":"  --pr <url>    GitHub pull request URL"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":30,"text":"  --id <id>     Case folder name (default: <repo>-<n>)"},{"sha":"a6c2a1cddfe8c0639336e5a0c5b58ee0fbb6c157","author":"Máté Molnár","timestamp":1790195924,"line":31,"text":"  --bundle      Also write repo.bundle (base tree plus base..head) so the run never clones the repo"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":32,"text":"  -h, --help"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":33,"text":"`;"},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":34,"text":""},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1789268342,"line":35,"text":"export type EvalRunRequest ="},{"sha":"11108ceae77651c0215de73990b7a73c9211ee77","author":"Cursor Agent","timestamp":1