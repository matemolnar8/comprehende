{"path":"scripts/eval/env.ts","ref":"ffd116fb87c2578ef771cde505ed2a73bc886eda","side":"new","lines":[{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":1,"text":"import { readFile } from \"node:fs/promises\";"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":2,"text":"import { join } from \"node:path\";"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":3,"text":""},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":4,"text":"/** Load KEY=VALUE lines from <packageRoot>/.env. Real environment wins. Missing file is fine. */"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":5,"text":"export async function loadDotEnv(packageRoot: string): Promise<void> {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":6,"text":"  let text: string;"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":7,"text":"  try {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":8,"text":"    text = await readFile(join(packageRoot, \".env\"), \"utf8\");"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":9,"text":"  } catch {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":10,"text":"    return;"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":11,"text":"  }"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":12,"text":"  for (const line of text.split(\"\\n\")) {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":13,"text":"    const trimmed = line.trim();"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":14,"text":"    if (trimmed === \"\" || trimmed.startsWith(\"#\")) {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":15,"text":"      continue;"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":16,"text":"    }"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":17,"text":"    const assignment = trimmed.startsWith(\"export \") ? trimmed.slice(\"export \".length).trim() : trimmed;"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":18,"text":"    const eq = assignment.indexOf(\"=\");"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":19,"text":"    if (eq === -1) {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":20,"text":"      continue;"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":21,"text":"    }"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":22,"text":"    const key = assignment.slice(0, eq).trim();"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":23,"text":"    if (key === \"\" || process.env[key] !== undefined) {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":24,"text":"      continue;"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":25,"text":"    }"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":26,"text":"    process.env[key] = unquote(assignment.slice(eq + 1).trim());"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":27,"text":"  }"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":28,"text":"}"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":29,"text":""},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":30,"text":"function unquote(value: string): string {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":31,"text":"  if (value.length >= 2) {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":32,"text":"    const first = value.at(0);"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":33,"text":"    if ((first === '\"' || first === \"'\") && value.endsWith(first)) {"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":34,"text":"      return value.slice(1, -1);"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":35,"text":"    }"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":36,"text":"  }"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":37,"text":"  return value;"},{"sha":"ffd116fb87c2578ef771cde505ed2a73bc886eda","author":"Máté Molnár","timestamp":1791485564,"line":38,"text":"}"}]}
