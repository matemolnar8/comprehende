,"author":"Cursor Agent","timestamp":1789938688,"line":42,"text":"      - run: pnpm install --frozen-lockfile"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":43,"text":"      - name: Install Muse Code (Cursor fallback)"},{"sha":"4a199f24c215f4e619d8dd75adb6dbd6abcfc603","author":"Cursor Agent","timestamp":1790497046,"line":44,"text":"        env:"},{"sha":"4a199f24c215f4e619d8dd75adb6dbd6abcfc603","author":"Cursor Agent","timestamp":1790497046,"line":45,"text":"          MUSE_CODE_API_KEY: ${{ secrets.MUSE_CODE_API_KEY }}"},{"sha":"4a199f24c215f4e619d8dd75adb6dbd6abcfc603","author":"Cursor Agent","timestamp":1790497046,"line":46,"text":"        if: env.MUSE_CODE_API_KEY != ''"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":47,"text":"        run: |"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":48,"text":"          set -euo pipefail"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":49,"text":"          mkdir -p ~/.local/bin"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":50,"text":"          curl -fsSL https://api.meta.ai/muse-launcher.sh -o ~/.local/bin/muse"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":51,"text":"          chmod +x ~/.local/bin/muse"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":52,"text":"          echo \"$HOME/.local/bin\" >> \"$GITHUB_PATH\""},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":53,"text":"          MUSE_LAUNCHER_INSTALL=1 ~/.local/bin/muse"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":54,"text":"          ~/.local/bin/muse --version"},{"sha":"7cee6d1edf39a00a1134dd69629b58e821b6b6af","author":"Máté Molnár","timestamp":1790498637,"line":55,"text":"      # The Cursor SDK calls configureRipgrepPath when rg is on PATH. ubuntu-latest has none."},{"sha":"7cee6d1edf39a00a1134dd69629b58e821b6b6af","author":"Máté Molnár","timestamp":1790498637,"line":56,"text":"      - name: Install ripgrep"},{"sha":"7cee6d1edf39a00a1134dd69629b58e821b6b6af","author":"Máté Molnár","timestamp":1790498637,"line":57,"text":"        run: sudo apt-get install -y ripgrep"},{"sha":"d05d71698063919c5928f161ed03e5c749f26594","author":"Cursor Agent","timestamp":1789938688,"line":58,"text":"      - name: Full graded eval"},{"sha":"d05d71698063919c5928f161ed03e5c749f26594","author":"Cursor Agent","timestamp":1789938688,"line":59,"text":"        env:"},{"sha":"d05d71698063919c5928f161ed03e5c749f26594","author":"Cursor Agent","timestamp":1789938688,"line":60,"text":"          CURSOR_API_KEY: ${{ secrets.CURSOR_API_KEY }}"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":61,"text":"          MUSE_CODE_API_KEY: ${{ secrets.MUSE_CODE_API_KEY }}"},{"sha":"d05d71698063919c5928f161ed03e5c749f26594","author":"Cursor Agent","timestamp":1789938688,"line":62,"text":"        run: |"},{"sha":"d05d71698063919c5928f161ed03e5c749f26594","author":"Cursor Agent","timestamp":1789938688,"line":63,"text":"          set -euo pipefail"},{"sha":"d05d71698063919c5928f161ed03e5c749f26594","author":"Cursor Agent","timestamp":1789938688,"line":64,"text":"          if [ -z \"${CURSOR_API_KEY}\" ]; then"},{"sha":"d05d71698063919c5928f161ed03e5c749f26594","author":"Cursor Agent","timestamp":1789938688,"line":65,"text":"            echo \"Repo secret CURSOR_API_KEY is not set. Skipping the full graded suite.\""},{"sha":"d05d71698063919c5928f161ed03e5c749f26594","author":"Cursor Agent","timestamp":1789938688,"line":66,"text":"            echo \"Add it under Settings → Secrets and variables → Actions.\""},{"sha":"d05d71698063919c5928f161ed03e5c749f26594","author":"Cursor Agent","timestamp":1789938688,"line":67,"text":"            echo \"::warning::CURSOR_API_KEY secret missing; full eval skipped\""},{"sha":"d05d71698063919c5928f161ed03e5c749f26594","author":"Cursor Agent","timestamp":1789938688,"line":68,"text":"            exit 0"},{"sha":"d05d71698063919c5928f161ed03e5c749f26594","author":"Cursor Agent","timestamp":1789938688,"line":69,"text":"          fi"},{"sha":"9813501532ca646e4d8cca1e91988526dd1f967c","author":"Cursor Agent","timestamp":1789939486,"line":70,"text":"          unset GITHUB_TOKEN GH_TOKEN"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":71,"text":"          flags=\"--json\""},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":72,"text":"          if [ -n \"${MUSE_CODE_API_KEY}\" ] && command -v muse >/dev/null 2>&1; then"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":73,"text":"            flags=\"$flags --cursor-fallback\""},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":74,"text":"          else"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":75,"text":"            echo \"::warning::Muse fallback unavailable (needs the MUSE_CODE_API_KEY secret and the muse CLI); cursor-only run\""},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":76,"text":"          fi"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":77,"text":"          # Word-split on purpose: flags holds separate argv words."},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":78,"text":"          # shellcheck disable=SC2086"},{"sha":"6847b9e7fc8298367d6cb