{"path":"scripts/eval/fallback.ts","ref":"59f1ceb487f0bbfa730b2919a93d1fb33c8bec19","side":"old","lines":[{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":1,"text":"import { RateLimitError } from \"@cursor/sdk\";"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":2,"text":"import { runLocalAgent, type AgentRunResult } from \"./agent.ts\";"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":3,"text":"import { GRADER_TOOLS } from \"./constants.ts\";"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":4,"text":""},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":5,"text":"export const CURSOR_PROBE_TIMEOUT_MS = 120_000;"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":6,"text":"const PROBE_PROMPT = \"Reply with exactly: OK\";"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":7,"text":""},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":8,"text":"export type CursorProbe ="},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":9,"text":"  | { ok: true }"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":10,"text":"  | { ok: false; limit: boolean; reason: string };"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":11,"text":""},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":12,"text":"export function isUsageLimitMessage(message: string): boolean {"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":13,"text":"  return /rate.?limit|usage.?limit|too many requests|\\b429\\b|quota/i.test(message);"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":14,"text":"}"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":15,"text":""},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":16,"text":"/** Thrown SDK errors and error-status results both land here. */"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":17,"text":"export function classifyCursorProbe(outcome: { thrown?: unknown; result?: AgentRunResult }): CursorProbe {"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":18,"text":"  if (outcome.thrown !== undefined) {"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":19,"text":"    const message = outcome.thrown instanceof Error ? outcome.thrown.message : String(outcome.thrown);"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":20,"text":"    return {"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":21,"text":"      ok: false,"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":22,"text":"      limit: outcome.thrown instanceof RateLimitError || isUsageLimitMessage(message),"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":23,"text":"      reason: message,"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":24,"text":"    };"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":25,"text":"  }"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":26,"text":"  const result = outcome.result;"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":27,"text":"  if (result !== undefined && result.status === \"finished\" && result.error === undefined) {"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":28,"text":"    return { ok: true };"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":29,"text":"  }"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":30,"text":"  const reason = result?.error ?? `producer status ${result?.status ?? \"unknown\"}`;"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":31,"text":"  return { ok: false, limit: isUsageLimitMessage(reason), reason };"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":32,"text":"}"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":33,"text":""},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":34,"text":"/** One tiny Cursor run. Any failure means the account cannot serve this eval. */"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":35,"text":"export async function probeCursorAgent(opts: {"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":36,"text":"  apiKey: string;"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":37,"text":"  model: string;"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":38,"text":"  cwd: string;"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":39,"text":"}): Promise<CursorProbe> {"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":40,"text":"  try {"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":41,"text":"    const result = await runLocalAgent({"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":42,"text":"      cwd: opts.cwd,"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":43,"text":"      model: opts.model,"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":44,"text":"      prompt: PROBE_PROMPT,"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":45,"text":"      apiKey: opts.apiKey,"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":46,"text":"      tools: [...GRADER_TOOLS],"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":47,"text":"      sandbox: false,"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":48,"text":"      timeoutMs: CURSOR_PROBE_TIMEOUT_MS,"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":49,"text":"    });"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":50,"text":"    return classifyCursorProbe({ result });"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":51,"text":"  } catch (error) {"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":52,"text":"    return classifyCursorProbe({ thrown: error });"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":53,"text":"  }"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":54,"text":"}"}]}
