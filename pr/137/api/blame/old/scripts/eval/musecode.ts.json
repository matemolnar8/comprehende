5,"line":13,"text":"  steps: number;"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":14,"text":"  sessionId?: string;"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":15,"text":"};"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":16,"text":""},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":17,"text":"export type MuseUsage = {"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":18,"text":"  inputTokens: number;"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":19,"text":"  outputTokens: number;"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":20,"text":"  cachedTokens: number;"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":21,"text":"  reasoningTokens: number;"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":22,"text":"  completions: number;"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":23,"text":"};"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":24,"text":""},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":25,"text":"const ZERO_USAGE: MuseUsage = {"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":26,"text":"  inputTokens: 0,"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":27,"text":"  outputTokens: 0,"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":28,"text":"  cachedTokens: 0,"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":29,"text":"  reasoningTokens: 0,"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":30,"text":"  completions: 0,"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":31,"text":"};"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":32,"text":""},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":33,"text":"type MuseEvent = {"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":34,"text":"  stream?: {"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":35,"text":"    kind?: string;"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":36,"text":"    id?: string;"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":37,"text":"  };"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":38,"text":"  payload_type?: string;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":39,"text":"  payload?: {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":40,"text":"    kind?: string;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":41,"text":"    terminal?: string;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":42,"text":"    text?: string;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":43,"text":"    reason?: string | null;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":44,"text":"    event?: { kind?: string; operation?: string };"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":45,"text":"  };"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":46,"text":"};"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":47,"text":""},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":48,"text":"export function parseMuseExecJsonl(stdout: string): MuseExecResult {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":49,"text":"  const toolCalls: ToolCallRecord[] = [];"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":50,"text":"  let steps = 0;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":51,"text":"  let terminal = \"\";"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":52,"text":"  let text = \"\";"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":53,"text":"  let reason: string | undefined;"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":54,"text":"  let sessionId: string | undefined;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":55,"text":"  for (const line of stdout.split(\"\\n\")) {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":56,"text":"    const trimmed = line.trim();"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":57,"text":"    if (trimmed === \"\") {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":58,"text":"      continue;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":59,"text":"    }"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":60,"text":"    let event: MuseEvent;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":61,"text":"    try {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":62,"text":"      event = JSON.parse(trimmed) as MuseEvent;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":63,"text":"    } catch {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":64,"text":"      continue;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":65,"text":"    }"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":66,"text":"    if (sessionId === undefined && event.stream?.kind === \"session\" && typeof event.stream.id === \"string\") {"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":67,"text":"      sessionId = event.stream.id;"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":68,"text":"    }"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":69,"text":"    const payload = event.payload;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":70,"text":"    if (payload?.kind === \"run_terminal\") {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":71,"text":"      terminal = payload.terminal ?? \"\";"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":72,"text":"      text = payload.text ?? \"\";"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":73,"text":"      reason = payload.reason ?? undefined;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":74,"text":"      continue;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":75,"text":"    }"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":76,"text":"    if (payload?.event?.kind === \"side_effect_intent\") {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":77,"text":"      const operation = payload.event.operation ?? \"\";"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":78,"text":"      if (operation.startsWith(\"tool:\")) {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":79,"text":"        toolCalls.push({ name: operation.slice(\"tool:\".length) });"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":80,"text":"      } else if (operation.startsWith(\"model.\")) {"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":81,"text":"        steps += 1;"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":82,"text":"      }"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":83,"text":"    }"},{"sha":"63907ffdaebec71cdb40c43afd7e56c24fec99f9","author":"Máté Molnár","timestamp":1790452485,"line":84,"text":"  }"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":85,"text":"  return { text, terminal, reason, toolCalls, steps, sessionId };"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":86,"text":"}"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":87,"text":""},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":88,"text":"/**"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":89,"text":" * Sum per-completion usage from a `muse export --session <id>` document."},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":90,"text":" * `muse exec --json` streams progress events only; token counters live in"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":91,"text":" * the durable session log as `model_completed` events, which the export"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":92,"text":" * carries verbatim. Echo-provider legs report zeros, which sum to zero."},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":93,"text":" */"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":94,"text":"export function parseExportUsage(document: unknown): MuseUsage {"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":95,"text":"  if (typeof document !== \"object\" || document === null || !(\"events\" in document)) {"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":96,"text":"    return { ...ZERO_USAGE };"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":97,"text":"  }"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":98,"text":"  const events = (document as { events?: unknown }).events;"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":99,"text":"  if (!Array.isArray(events)) {"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":100,"text":"    return { ...ZERO_USAGE };"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":101,"text":"  }"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":102,"text":"  const total = { ...ZERO_USAGE };"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":103,"text":"  for (const record of events) {"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":104,"text":"    if (typeof record !== \"object\" || record === null) {"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":105,"text":"      continue;"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":106,"text":"    }"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":107,"text":"    const event = (record as { envelope?: { payload?: { event?: unknown } } }).envelope?.payload?.event;"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":108,"text":"    if (typeof event !== \"object\" || event === null) {"},{"sha":"841bb778daf773ebeffe2f2d16301c3119c249a1","author":"Máté Molnár","timestamp":1791134735,"line":109,"text":"      continue;"},{"sha":"841bb778daf773ebeffe2f2d16301c31