: [],"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":14,"text":"};"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":15,"text":""},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":16,"text":"describe(\"usage limit detection\", () => {"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":17,"text":"  it(\"matches limit wording and 429\", () => {"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":18,"text":"    for (const message of ["},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":19,"text":"      \"Rate limit exceeded\","},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":20,"text":"      \"usage limits exceeded\","},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":21,"text":"      \"Too many requests\","},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":22,"text":"      \"request failed with 429\","},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":23,"text":"      \"quota exceeded for this billing period\","},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":24,"text":"    ]) {"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":25,"text":"      assert.equal(isUsageLimitMessage(message), true, message);"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line":26,"text":"    }"},{"sha":"6847b9e7fc8298367d6cbaa5d0892f88b6d67f44","author":"Máté Molnár","timestamp":1790495766,"line"