{"path":"src/git/generated.ts","ref":"e7578d9f0cfb1119b603c616c364d2bb1e2436ac","side":"new","lines":[{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":1,"text":"import { git } from \"./exec.ts\";"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":2,"text":"import { assertSafePath, assertSafeRef } from \"./repo.ts\";"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":3,"text":""},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":4,"text":"/** Generators put their marker at the top; a license header can push it down a few lines. */"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":5,"text":"const HEADER_LINES = 20;"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":6,"text":""},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":7,"text":"/** Loose so git narrows cheaply in POSIX regex; `hasGeneratedMarker` decides. */"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":8,"text":"const GIT_PATTERN = \"generated|do not (edit|modify)\";"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":9,"text":""},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":10,"text":"const MARKER ="},{"sha":"e7578d9f0cfb1119b603c616c364d2bb1e2436ac","author":"Máté Molnár","timestamp":1792776042,"line":11,"text":"  /@generated|do not (edit|modify)|auto[- ]?generated|automatically generated|file (is|was) generated|^\\W*(code )?generated (by|file)\\b/i;"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":12,"text":""},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":13,"text":"/** A line that states the file is generated, as codegen tools write it. A mention in prose is not one. */"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":14,"text":"export function hasGeneratedMarker(line: string): boolean {"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":15,"text":"  return MARKER.test(line);"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":16,"text":"}"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":17,"text":""},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":18,"text":"/** Paths whose blob at `ref` carries a generated marker in its first lines. */"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":19,"text":"export async function generatedPaths("},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":20,"text":"  cwd: string,"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":21,"text":"  ref: string,"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":22,"text":"  paths: readonly string[],"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":23,"text":"): Promise<Set<string>> {"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":24,"text":"  assertSafeRef(ref);"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":25,"text":"  for (const path of paths) {"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":26,"text":"    assertSafePath(path);"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":27,"text":"  }"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":28,"text":"  const generated = new Set<string>();"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":29,"text":"  if (paths.length === 0) {"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":30,"text":"    return generated;"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":31,"text":"  }"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":32,"text":"  const stdout = await git("},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":33,"text":"    cwd,"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":34,"text":"    ["},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":35,"text":"      \"--literal-pathspecs\","},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":36,"text":"      \"grep\","},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":37,"text":"      \"-z\","},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":38,"text":"      \"-n\","},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":39,"text":"      \"-i\","},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":40,"text":"      \"-I\","},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":41,"text":"      \"-E\","},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":42,"text":"      \"-e\","},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":43,"text":"      GIT_PATTERN,"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":44,"text":"      ref,"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":45,"text":"      \"--\","},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":46,"text":"      ...paths,"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":47,"text":"    ],"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":48,"text":"    { allowFail: true },"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":49,"text":"  );"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":50,"text":"  for (const record of stdout.split(\"\\n\")) {"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":51,"text":"    const [refPath, line, text] = record.split(\"\\0\");"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":52,"text":"    if (refPath === undefined || line === undefined || text === undefined) {"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":53,"text":"      continue;"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":54,"text":"    }"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":55,"text":"    if (Number(line) <= HEADER_LINES && hasGeneratedMarker(text)) {"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":56,"text":"      generated.add(refPath.slice(ref.length + 1));"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":57,"text":"    }"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":58,"text":"  }"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":59,"text":"  return generated;"},{"sha":"548bdd69ceed52b82d9a11e52a795220b9132841","author":"Máté Molnár","timestamp":1792773635,"line":60,"text":"}"}]}
