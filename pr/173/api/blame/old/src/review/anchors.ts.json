{"path":"src/review/anchors.ts","ref":"de6c86b23284d2dc40e2633828c3854e1e8e6b1a","side":"old","lines":[{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":1,"text":"import {"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":2,"text":"  focusAnchor,"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":3,"text":"  formatAnchor,"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":4,"text":"  holdingHunk,"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":5,"text":"  hunkSpan,"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":6,"text":"  noteAnchor,"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":7,"text":"  type LineAnchor,"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":8,"text":"} from \"../schema/anchor.ts\";"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":9,"text":"import { hunkKey } from \"../schema/identity.ts\";"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":10,"text":"import type { FocusRange, LineNote, LiveHunk, ReviewGroup, SourceSide } from \"../schema/types.ts\";"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":11,"text":"import type { ReviewCoverage } from \"./coverage.ts\";"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":12,"text":""},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":13,"text":"/** One error that lists every focus range and note outside the live hunks of its group. */"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":14,"text":"export function anchorErrors(coverage: ReviewCoverage): string[] {"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":15,"text":"  const lines: string[] = [];"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":16,"text":"  for (const { group, hunks } of coverage.groups) {"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":17,"text":"    const check = (where: string, anchor: LineAnchor): void => {"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":18,"text":"      if (holdingHunk(hunks, anchor) === undefined) {"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":19,"text":"        lines.push(`  ${group.id} ${where} ${formatAnchor(anchor)} · ${liveSpans(hunks, anchor)}`);"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":20,"text":"      }"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":21,"text":"    };"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":22,"text":"    (group.focus ?? []).forEach((range, i) => check(`focus[${i}]`, focusAnchor(range)));"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":23,"text":"    (group.notes ?? []).forEach((note, i) => check(`notes[${i}]`, noteAnchor(note)));"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":24,"text":"  }"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":25,"text":"  if (lines.length === 0) {"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":26,"text":"    return [];"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":27,"text":"  }"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":28,"text":"  return ["},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":29,"text":"    `anchor: ${lines.length} focus range(s) or note(s) do not sit inside one live hunk of their group. Copy line numbers from show:\\n${lines.join(\"\\n\")}`,"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":30,"text":"  ];"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":31,"text":"}"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":32,"text":""},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":33,"text":"function liveSpans(hunks: readonly LiveHunk[], anchor: LineAnchor): string {"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":34,"text":"  const spans = hunks"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":35,"text":"    .filter((hunk) => hunk.path === anchor.path || hunk.oldPath === anchor.path)"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":36,"text":"    .map((hunk) => hunkSpan(hunk, anchor.side))"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":37,"text":"    .filter((span) => span !== undefined)"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":38,"text":"    .map((span) => `${span.start}-${span.end}`);"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":39,"text":"  return spans.length === 0"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":40,"text":"    ? \"this group has no hunk on that side of that path\""},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":41,"text":"    : `group hunks on ${anchor.side}: ${spans.join(\", \")}`;"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":42,"text":"}"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":43,"text":""},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":44,"text":"/** Where a previous hunk went: same changed lines, or edited in place. Undefined when gone. */"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":45,"text":"export type CarriedHunk = { next: LiveHunk; kind: \"same\" | \"changed\" | \"reformat\" } | undefined;"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":46,"text":""},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":47,"text":"export type CarriedAnchors = {"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":48,"text":"  focus: FocusRange[];"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":49,"text":"  notes: LineNote[];"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":50,"text":"  /** Ranges and notes dropped because their hunk was edited. */"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":51,"text":"  changed: { focus: number; notes: number };"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":52,"text":"};"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":53,"text":""},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":54,"text":"/**"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":55,"text":" * Ranges and notes follow their hunk: a `same` hunk shifts them, an edited one drops them, and"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":56,"text":" * so does a hunk that left the diff. A shift onto context the `same` hunk no longer shows drops"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":57,"text":" * the anchor too, and counts it with the edited ones."},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":58,"text":" */"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":59,"text":"export function carryAnchors("},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":60,"text":"  group: Pick<ReviewGroup, \"focus\" | \"notes\">,"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":61,"text":"  previous: readonly LiveHunk[],"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":62,"text":"  carried: ReadonlyMap<string, CarriedHunk>,"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":63,"text":"): CarriedAnchors {"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":64,"text":"  const changed = { focus: 0, notes: 0 };"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":65,"text":"  const shiftOf = (anchor: LineAnchor, kind: keyof typeof changed): number | undefined => {"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":66,"text":"    const from = holdingHunk(previous, anchor);"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":67,"text":"    const to = from === undefined ? undefined : carried.get(hunkKey(from));"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":68,"text":"    if (from === undefined || to === undefined) {"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":69,"text":"      return undefined;"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":70,"text":"    }"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":71,"text":"    const by = changeStart(to.next, anchor.side) - changeStart(from, anchor.side);"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":72,"text":"    const moved = { ...anchor, start: anchor.start + by, end: anchor.end + by };"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":73,"text":"    if (to.kind !== \"same\" || holdingHunk([to.next], moved) === undefined) {"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":74,"text":"      changed[kind] += 1;"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":75,"text":"      return undefined;"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":76,"text":"    }"},{"sha":"c82b14b2c186e39131ee539c931583857404b7db","author":"Máté Molnár","timestamp":1793522096,"line":77,"text":"    return by;"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":78,"text":"  };"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":79,"text":"  const focus = (group.focus ?? []).flatMap((range) => {"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":80,"text":"    const by = shiftOf(focusAnchor(range), \"focus\");"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":81,"text":"    return by === undefined ? [] : [{ ...range, start: range.start + by, end: range.end + by }];"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":82,"text":"  });"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":83,"text":"  const notes = (group.notes ?? []).flatMap((note) => {"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":84,"text":"    const by = shiftOf(noteAnchor(note), \"notes\");"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":85,"text":"    return by === undefined ? [] : [{ ...note, line: note.line + by }];"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":86,"text":"  });"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":87,"text":"  return { focus, notes, changed };"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":88,"text":"}"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":89,"text":""},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":90,"text":"/**"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":91,"text":" * First changed line on one side. A `same` hunk can gain or lose leading context near the top of"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":92,"text":" * a file, so its start line alone does not say how far its lines moved."},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":93,"text":" */"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":94,"text":"function changeStart(hunk: LiveHunk, side: SourceSide): number {"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":95,"text":"  const line = hunk.lines.find((item) => item.kind === (side === \"old\" ? \"del\" : \"add\"));"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":96,"text":"  const number = side === \"old\" ? line?.oldNumber : line?.newNumber;"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":97,"text":"  return number ?? (side === \"old\" ? hunk.oldStart : hunk.newStart);"},{"sha":"6507719457d0eaeff8e9e3d247131a68ed28161d","author":"Máté Molnár","timestamp":1793520005,"line":98,"text":"}"}]}
