et {"},{"sha":"f64dc81eabb9081e44111b9e6b622c2da8a6c041","author":"Cursor Agent","timestamp":1789285713,"line":137,"text":"  if (isLinePinned(source)) {"},{"sha":"f64dc81eabb9081e44111b9e6b622c2da8a6c041","author":"Cursor Agent","timestamp":1789285713,"line":138,"text":"    const groupId = groupIdForPinnedSource(document, source);"},{"sha":"f64dc81eabb9081e44111b9e6b622c2da8a6c041","author":"Cursor Agent","timestamp":1789285713,"line":139,"text":"    if (groupId !== undefined) {"},{"sha":"f64dc81eabb9081e44111b9e6b622c2da8a6c041","author":"Cursor Agent","timestamp":1789285713,"line":140,"text":"      return { selection: { kind: \"group\", id: groupId }, commentId: source.id };"},{"sha":"f64dc81eabb9081e44111b9e6b622c2da8a6c041","author":"Cursor Agent","timestamp":1789285713,"line":141,"text":"    }"},{"sha":"f64dc81eabb9081e44111b9e6b622c2da8a6c041","author":"Cursor Agent","timestamp":1789285713,"line":142,"text":"  }"},{"sha":"f64dc81eabb9081e44111b9e6b622c2da8a6c041","author":"Cursor Agent","timestamp":1789285713,"line":143,"text":"  const claim = claims.find((item) => item.sourceIds.includes(source.id));"},{"sha":"f64dc81eabb9081e44111b9e6b622c2da8a6c041","author":"Cursor Agent","timestamp":1789285713,"line":144,"text":"  if (claim !== undefined) {"},{"sha":"f64dc81eabb9081e44111b9e6b622c2da8a6c041","author":"Cursor Agent","timestamp":1789285713,"line":145,"text":"    return { selection: selectionForLookFor(claim.owner), lookForKey: claim.key };"},{"sha":"f64dc81eabb9081e44111b9e6b622c2da8a6c041","author":"Cursor Agent","timestamp":1789285713,"line":146,"text":"  }"},{"sha":"f64dc81eabb9081e44111b9e6b622c2da8a6c041","author":"Cursor Agent","timestamp":1789285713,"line":147,"text":"  const named = document.groups.find((group) => (group.sources ?? []).includes(source.id));"},{"sha":"f64dc81eabb9081e44111b9e6b622c2da8a6c041","author":"Cursor Agent","timestamp":1789285713,"line":148,"text":"  if (named !== undefined) {"},{"sha":"f64dc81eabb9081e44111b9e6b622c2da8a6c041","author":"Cursor Agent","timestamp":1789285713,"line":149,"text":"    return { selection: { kind: \"group\", id: named.id } };"},{"sha":"f64dc81eabb9081e44111b9e6b622c2da8a6c041","author":"Cursor Agent","timestamp":1789285713,"line":150,"text":"  }"},{"sha":"f64dc81eabb9081e44111b9e6b622c2da8a6c041","author":"Cursor Agent","timestamp":1789285713,"line":151,"text":"  return { selection: { kind: \"overview\" } };"},{"sha":"f64dc81eabb9081e44111b9e6b622c2da8a6c041","author":"Cursor Agent","timestamp":1789285713,"line":152,"text":"}"}]}
