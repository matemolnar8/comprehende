ind":"add","oldNumber":null,"newNumber":127,"text":"    const result = await prunePagesReviews({ repo: ctx.repo, pr: 1, ttlDays: 30 });"},{"kind":"add","oldNumber":null,"newNumber":128,"text":"    assert.deepEqual(result, { removed: [], pushed: false });"},{"kind":"add","oldNumber":null,"newNumber":129,"text":"  });"},{"kind":"add","oldNumber":null,"newNumber":130,"text":""},{"kind":"add","oldNumber":null,"newNumber":131,"text":"  it(\"publishes and prunes through the CLI\", async () => {"},{"kind":"add","oldNumber":null,"newNumber":132,"text":"    const ctx = await setupRemoteRepo();"},{"kind":"add","oldNumber":null,"newNumber":133,"text":"    const site = await writeExport(ctx.root, \"cli\", \"cli\");"},{"kind":"add","oldNumber":null,"newNumber":134,"text":"    assert.equal(await runPagesReview([\"publish\", \"--repo\", ctx.repo, \"--dir\", site, \"--pr\", \"9\"]), 0);"},{"kind":"add","oldNumber":null,"newNumber":135,"text":"    const pages = await checkoutPages(ctx);"},{"kind":"add","oldNumber":null,"newNumber":136,"text":"    assert.equal(existsSync(join(pages, \"pr/9/index.html\")), true);"},{"kind":"add","oldNumber":null,"newNumber":137,"text":"    assert.equal(await runPagesReview([\"prune\", \"--repo\", ctx.repo, \"--pr\", \"9\"]), 0);"},{"kind":"add","oldNumber":null,"newNumber":138,"text":"  });"},{"kind":"add","oldNumber":null,"newNumber":139,"text":"});"},{"kind":"add","oldNumber":null,"newNumber":140,"text":""},{"kind":"add","oldNumber":null,"newNumber":141,"text":"type RemoteRepo = {"},{"kind":"add","oldNumber":null,"newNumber":142,"text":"  root: string;"},{"kind":"add","oldNumber":null,"newNumber":143,"text":"  repo: string;"},{"kind":"add","oldNumber":null,"newNumber":144,"text":"  bare: string;"},{"kind":"add","oldNumber":null,"newNumber":145,"text":"};"},{"kind":"add","oldNumber":null,"newNumber":146,"text":""},{"kind":"add","oldNumber":null,"newNumber":147,"text":"async function setupRemoteRepo(): Promise<RemoteRepo> {"},{"kind":"add","oldNumber":null,"newNumber":148,"text":"  const root = await mkdtemp(join(tmpdir(), \"comprehende-pages-test-\"));"},{"kind":"add","oldNumber":null,"newNumber":149,"text":"  roots.push(root);"},{"kind":"add","oldNumber":null,"newNumber":150,"text":"  const repo = join(root, \"repo\");"},{"kind":"add","oldNumber":null,"newNumber":151,"text":"  const bare = join(root, \"remote.git\");"},{"kind":"add","oldNumber":null,"newNumber":152,"text":"  await initEmptyRepo(repo);"},{"kind":"add","oldNumber":null,"newNumber":153,"text":"  await writeFile(join(repo, \"README.md\"), \"# test\\n\");"},{"kind":"add","oldNumber":null,"newNumber":154,"text":"  await git(repo, [\"add\", \".\"]);"},{"kind":"add","oldNumber":null,"newNumber":155,"text":"  await git(repo, [\"commit\", \"-m\", \"init\"]);"},{"kind":"add","oldNumber":null,"newNumber":156,"text":"  await mkdir(bare, { recursive: true });"},{"kind":"add","oldNumber":null,"newNumber":157,"text":"  await git(bare, [\"init\", \"--bare\", \"-b\", \"main\"]);"},{"kind":"add","oldNumber":null,"newNumber":158,"text":"  await git(repo, [\"remote\", \"add\", \"origin\", bare]);"},{"kind":"add","oldNumber":null,"newNumber":159,"text":"  await git(repo, [\"push\", \"-u\", \"origin\", \"main\"]);"},{"kind":"add","oldNumber":null,"newNumber":160,"text":"  return { root, repo, bare };"},{"kind":"add","oldNumber":null,"newNumber":161,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":162,"text":""},{"kind":"add","oldNumber":null,"newNumber":163,"text":"async function writeExport(root: string, name: string, body: string): Promise<string> {"},{"kind":"add","oldNumber":null,"newNumber":164,"text":"  const dir = join(root, name);"},{"kind":"add","oldNumber":null,"newNumber":165,"text":"  await mkdir(dir, { recursive: true });"},{"kind":"add","oldNumber":null,"newNumber":166,"text":"  await writeFile(join(dir, \"index.html\"), `<p>${body}</p>\\n`);"},{"kind":"add","oldNumber":null,"newNumber":167,"text":"  await mkdir(join(dir, \"api\"), { recursive: true });"},{"kind":"add","oldNumber":null,"newNumber":168,"text":"  await writeFile(join(dir, \"api/review.json\"), \"{}\\n\");"},{"kind":"add","oldNumber":null,"newNumber":169,"text":"  return dir;"},{"kind":"add","oldNumber":null,"newNumber":170,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":171,"text":""},{"kind":"add","oldNumber":null,"newNumber":172,"text":"async function checkoutPages(ctx: RemoteRepo): Promise<string> {"},{"kind":"add","oldNumber":null,"newNumber":173,"text":"  const dest = join(ctx.root, `pages-${crypto.randomUUID()}`);"},{"kind":"add","oldNumber":null,"newNumber":174,"text":"  await git(ctx.root, [\"clone\", \"--branch\", \"gh-pages\", \"--single-branch\", ctx.bare, dest]);"},{"kind":"add","oldNumber":null,"newNumber":175,"text":"  return dest;"},{"kind":"add","oldNumber":null,"newNumber":176,"text":"}"}]},{"path":"package.json","oldStart":15,"oldLines":7,"newStart":15,"newLines":7,"header":"@@ -15,7 +15,7 @@","language":"json","lines":[{"kind":"ctx","oldNumber":15,"newNumber":15,"text":"    \"prepack\": \"pnpm run build\","},{"kind":"ctx","oldNumber":16,"newNumber":16,"text":"    \"dev\": \"tsx src/cli/main.ts\","},{"kind":"ctx","oldNumber":17,"newNumber":17,"text":"    \"typecheck\": \"tsc --noEmit && tsc --noEmit -p src/ui/tsconfig.json\","},{"kind":"del","oldNumber":18,"newNumber":null,"text":"    \"test\": \"tsx --test \\\"src/**/*.test.ts\\\"\","},{"kind":"add","oldNumber":null,"newNumber":18,"text":"    \"test\": \"tsx --test \\\"src/**/*.test.ts\\\" \\\"scripts/**/*.test.ts\\\"\","},{"kind":"ctx","oldNumber":19,"newNumber":19,"text":"    \"fixture\": \"tsx scripts/build-fixture.ts\","},{"kind":"ctx","oldNumber":20,"newNumber":20,"text":"    \"generate:schema\": \"tsx scripts/generate-review-schema.ts\","},{"kind":"ctx","oldNumber":21,"newNumber":21,"text":"    \"sync:skill\": \"tsx scripts/sync-skill.ts\","}]}],"files":[{"path":"scripts/pages-review.test.ts","kind":"text","status":"added","patch":"diff --git a/scripts/pages-review.test.ts b/scripts/pages-review.test.ts\nnew file mode 100644\nindex 0000000..e76e589\n--- /dev/null\n+++ b/scripts/pages-review.test.ts\n@@ -0,0 +1,176 @@\n+import assert from \"node:assert/strict\";\n+import { mkdtemp, mkdir, readFile, writeFile } from \"node:fs/promises\";\n+import { existsSync, rmSync } from \"node:fs\";\n+import { tmpdir } from \"node:os\";\n+import { join } from \"node:path\";\n+import { after, describe, it } from \"node:test\";\n+import { git } from \"../src/git/exec.ts\";\n+import { initEmptyRepo } from \"../src/test/init-repo.ts\";\n+import {\n+  githubPagesReviewUrl,\n+  parseGithubRepo,\n+  parsePrNumber,\n+  prunePagesReviews,\n+  publishPagesReview,\n+  runPagesReview,\n+} from \"./pages-review.ts\";\n+\n+const roots: string[] = [];\n+\n+after(() => {\n+  for (const root of roots) {\n+    rmSync(root, { recursive: true, force: true });\n+  }\n+});\n+\n+describe(\"pages-review urls\", () => {\n+  it(\"parses GitHub remotes and builds project Pages URLs\", () => {\n+    assert.deepEqual(parseGithubRepo(\"https://github.com/matemolnar8/comprehende.git\"), {\n+      owner: \"matemolnar8\",\n+      repo: \"comprehende\",\n+    });\n+    assert.deepEqual(parseGithubRepo(\"https://x-access-token:tok@github.com/matemolnar8/comprehende\"), {\n+      owner: \"matemolnar8\",\n+      repo: \"comprehende\",\n+    });\n+    assert.deepEqual(parseGithubRepo(\"git@github.com:matemolnar8/comprehende.git\"), {\n+      owner: \"matemolnar8\",\n+      repo: \"comprehende\",\n+    });\n+    assert.equal(\n+      githubPagesReviewUrl(\"https://github.com/matemolnar8/comprehende.git\", 12),\n+      \"https://matemolnar8.github.io/comprehende/pr/12/\",\n+    );\n+    assert.equal(\n+      githubPagesReviewUrl(\"git@github.com:alice/alice.github.io.git\", 3),\n+      \"https://alice.github.io/pr/3/\",\n+    );\n+  });\n+\n+  it(\"rejects junk PR numbers\", () => {\n+    assert.equal(parsePrNumber(\"12\"), 12);\n+    assert.throws(() => parsePrNumber(\"0\"));\n+    assert.throws(() => parsePrNumber(\"../etc\"));\n+    assert.throws(() => parsePrNumber(\"12abc\"));\n+  });\n+});\n+\n+describe(\"pages-review publish and prune\", () => {\n+  it(\"publishes to pr/<n>/, keeps sibling reviews, then prunes on close and TTL\", async () => {\n+    const ctx = await setupRemoteRepo();\n+    const siteA = await writeExport(ctx.root, \"site-a\", \"alpha\");\n+    const siteB = await writeExport(ctx.root, \"site-b\", \"beta\");\n+    const t0 = new Date(\"2026-08-01T00:00:00.000Z\");\n+    const t1 = new Date(\"2026-09-01T00:00:00.000Z\");\n+    const now = new Date(\"2026-09-12T00:00:00.000Z\");\n+\n+    const publishedA = await publishPagesReview({\n+      repo: ctx.repo,\n+      dir: siteA,\n+      pr: 12,\n+      now: t0,\n+    });\n+    assert.equal(publishedA.pushed, true);\n+\n+    const publishedB = await publishPagesReview({\n+      repo: ctx.repo,\n+      dir: siteB,\n+      pr: 13,\n+      now: t1,\n+    });\n+    assert.equal(publishedB.pushed, true);\n+\n+    let pages = await checkoutPages(ctx);\n+    assert.equal(existsSync(join(pages, \".nojekyll\")), true);\n+    assert.equal(await readFile(join(pages, \"pr/12/index.html\"), \"utf8\"), \"<p>alpha</p>\\n\");\n+    assert.equal(await readFile(join(pages, \"pr/13/index.html\"), \"utf8\"), \"<p>beta</p>\\n\");\n+    const listing = await readFile(join(pages, \"index.html\"), \"utf8\");\n+    assert.match(listing, /PR #13/);\n+    assert.match(listing, /PR #12/);\n+    assert.equal(existsSync(join(pages, \"pr/12/published.json\")), true);\n+\n+    const closed = await prunePagesReviews({ repo: ctx.repo, pr: 12 });\n+    assert.deepEqual(closed.removed, [12]);\n+\n+    pages = await checkoutPages(ctx);\n+    assert.equal(existsSync(join(pages, \"pr/12\")), false);\n+    assert.equal(existsSync(join(pages, \"pr/13/index.html\")), true);\n+    assert.doesNotMatch(await readFile(join(pages, \"index.html\"), \"utf8\"), /PR #12/);\n+\n+    const expired = await prunePagesReviews({ repo: ctx.repo, ttlDays: 30, now });\n+    assert.deepEqual(expired.removed, []);\n+\n+    const later = await prunePagesReviews({\n+      repo: ctx.repo,\n+      ttlDays: 10,\n+      now: new Date(\"2026-09-20T00:00:00.000Z\"),\n+    });\n+    assert.deepEqual(later.removed, [13]);\n+\n+    pages = await checkoutPages(ctx);\n+    assert.equal(existsSync(join(pages, \"pr/13\")), false);\n+    assert.match(await readFile(join(pages, \"index.html\"), \"utf8\"), /No published reviews right now/);\n+  });\n+\n+  it(\"replaces an existing PR folder on republish\", async () => {\n+    const ctx = await setupRemoteRepo();\n+    const first = await writeExport(ctx.root, \"v1\", \"one\");\n+    const second = await writeExport(ctx.root, \"v2\", \"two\");\n+    await publishPagesReview({ repo: ctx.repo, dir: first, pr: 4 });\n+    await publishPagesReview({ repo: ctx.repo, dir: second, pr: 4 });\n+    const pages = await checkoutPages(ctx);\n+    assert.equal(await readFile(join(pages, \"pr/4/index.html\"), \"utf8\"), \"<p>two</p>\\n\");\n+  });\n+\n+  it(\"prunes nothing when gh-pages is missing\", async () => {\n+    const ctx = await setupRemoteRepo();\n+    const result = await prunePagesReviews({ repo: ctx.repo, pr: 1, ttlDays: 30 });\n+    assert.deepEqual(result, { removed: [], pushed: false });\n+  });\n+\n+  it(\"publishes and prunes through the CLI\", async () => {\n+    const ctx = await setupRemoteRepo();\n+    const site = await writeExport(ctx.root, \"cli\", \"cli\");\n+    assert.equal(await runPagesReview([\"publish\", \"--repo\", ctx.repo, \"--dir\", site, \"--pr\", \"9\"]), 0);\n+    const pages = await checkoutPages(ctx);\n+    assert.equal(existsSync(join(pages, \"pr/9/index.html\")), true);\n+    assert.equal(await runPagesReview([\"prune\", \"--repo\", ctx.repo, \"--pr\", \"9\"]), 0);\n+  });\n+});\n+\n+type RemoteRepo = {\n+  root: string;\n+  repo: string;\n+  bare: string;\n+};\n+\n+async function setupRemoteRepo(): Promise<RemoteRepo> {\n+  const root = await mkdtemp(join(tmpdir(), \"comprehende-pages-test-\"));\n+  roots.push(root);\n+  const repo = join(root, \"repo\");\n+  const bare = join(root, \"remote.git\");\n+  await initEmptyRepo(repo);\n+  await writeFile(join(repo, \"README.md\"), \"# test\\n\");\n+  await git(repo, [\"add\", \".\"]);\n+  await git(repo, [\"commit\", \"-m\", \"init\"]);\n+  await mkdir(bare, { recursive: true });\n+  await git(bare, [\"init\", \"--bare\", \"-b\", \"main\"]);\n+  await git(repo, [\"remote\", \"add\", \"origin\", bare]);\n+  await git(repo, [\"push\", \"-u\", \"origin\", \"main\"]);\n+  return { root, repo, bare };\n+}\n+\n+async function writeExport(root: string, name: string, body: string): Promise<string> {\n+  const dir = join(root, name);\n+  await mkdir(dir, { recursive: true });\n+  await writeFile(join(dir, \"index.html\"), `<p>${body}</p>\\n`);\n+  await mkdir(join(dir, \"api\"), { recursive: true });\n+  await writeFile(join(dir, \"api/review.json\"), \"{}\\n\");\n+  return dir;\n+}\n+\n+async function checkoutPages(ctx: RemoteRepo): Promise<string> {\n+  const dest = join(ctx.root, `pages-${crypto.randomUUID()}`);\n+  await git(ctx.root, [\"clone\", \"--branch\", \"gh-pages\", \"--single-branch\", ctx.bare, dest]);\n+  return dest;\n+}\n","complete":true,"hunks":[{"path":"scripts/pages-review.test.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":176,"header":"@@ -0,0 +1,176 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import assert from \"node:assert/strict\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import { mkdtemp, mkdir, readFile, writeFile } from \"node:fs/promises\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import { existsSync, rmSync } from \"node:fs\";"},{"kind":"add","oldNumber":null,"newNumber":4,"text":"import { tmpdir } from \"node:os\";"},{"kind":"add","oldNumber":null,"newNumber":5,"text":"import { join } from \"node:path\";"},{"kind":"add","oldNumber":null,"ne