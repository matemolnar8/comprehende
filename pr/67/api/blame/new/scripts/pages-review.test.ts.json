lse });"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":129,"text":"  });"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":130,"text":""},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":131,"text":"  it(\"publishes and prunes through the CLI\", async () => {"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":132,"text":"    const ctx = await setupRemoteRepo();"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":133,"text":"    const site = await writeExport(ctx.root, \"cli\", \"cli\");"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":134,"text":"    assert.equal(await runPagesReview([\"publish\", \"--repo\", ctx.repo, \"--dir\", site, \"--pr\", \"9\"]), 0);"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":135,"text":"    const pages = await checkoutPages(ctx);"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":136,"text":"    assert.equal(existsSync(join(pages, \"pr/9/index.html\")), true);"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":137,"text":"    assert.equal(await runPagesReview([\"prune\", \"--repo\", ctx.repo, \"--pr\", \"9\"]), 0);"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":138,"text":"  });"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":139,"text":"});"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":140,"text":""},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":141,"text":"type RemoteRepo = {"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":142,"text":"  root: string;"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":143,"text":"  repo: string;"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":144,"text":"  bare: string;"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":145,"text":"};"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":146,"text":""},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":147,"text":"async function setupRemoteRepo(): Promise<RemoteRepo> {"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":148,"text":"  const root = await mkdtemp(join(tmpdir(), \"comprehende-pages-test-\"));"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":149,"text":"  roots.push(root);"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":150,"text":"  const repo = join(root, \"repo\");"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":151,"text":"  const bare = join(root, \"remote.git\");"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":152,"text":"  await initEmptyRepo(repo);"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":153,"text":"  await writeFile(join(repo, \"README.md\"), \"# test\\n\");"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":154,"text":"  await git(repo, [\"add\", \".\"]);"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":155,"text":"  await git(repo, [\"commit\", \"-m\", \"init\"]);"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":156,"text":"  await mkdir(bare, { recursive: true });"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":157,"text":"  await git(bare, [\"init\", \"--bare\", \"-b\", \"main\"]);"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":158,"text":"  await git(repo, [\"remote\", \"add\", \"origin\", bare]);"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":159,"text":"  await git(repo, [\"push\", \"-u\", \"origin\", \"main\"]);"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":160,"text":"  return { root, repo, bare };"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":161,"text":"}"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":162,"text":""},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":163,"text":"async function writeExport(root: string, name: string, body: string): Promise<string> {"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":164,"text":"  const dir = join(root, name);"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":165,"text":"  await mkdir(dir, { recursive: true });"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":166,"text":"  await writeFile(join(dir, \"index.html\"), `<p>${body}</p>\\n`);"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":167,"text":"  await mkdir(join(dir, \"api\"), { recursive: true });"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":168,"text":"  await writeFile(join(dir, \"api/review.json\"), \"{}\\n\");"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":169,"text":"  return dir;"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":170,"text":"}"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":171,"text":""},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":172,"text":"async function checkoutPages(ctx: RemoteRepo): Promise<string> {"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":173,"text":"  const dest = join(ctx.root, `pages-${crypto.randomUUID()}`);"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":174,"text":"  await git(ctx.root, [\"clone\", \"--branch\", \"gh-pages\", \"--single-branch\", ctx.bare, dest]);"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":175,"text":"  return dest;"},{"sha":"16565def6a52a638a09689dc5f6ddfe45cab1504","author":"Cursor Agent","timestamp":1789225656,"line":176,"text":"}"}]}
