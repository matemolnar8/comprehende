ursor Agent","timestamp":1788035496,"line":26,"text":"  });"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":27,"text":"  if (rows.length === 0) {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":28,"text":"    return null;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":29,"text":"  }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":30,"text":"  return ("},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":31,"text":"    <section className={cn(\"mb-5\", className)} aria-label=\"Sources\">"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":32,"text":"      <Kicker className=\"mb-2\">Sources</Kicker>"},{"sha":"bd60dba27116225ee1ab6af1124102192cbfd878","author":"Cursor Agent","timestamp":1789319345,"line":33,"text":"      <ul className=\"m-0 list-none divide-y divide-border border-y border-border p-0\">"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":34,"text":"        {rows.map((source) => {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":35,"text":"          const strand = mixed ? parts.find((part) => part.title === source.part) : undefined;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":36,"text":"          const detail = source.gist ?? source.title;"},{"sha":"bd60dba27116225ee1ab6af1124102192cbfd878","author":"Cursor Agent","timestamp":1789319345,"line":37,"text":"          const jump ="},{"sha":"bd60dba27116225ee1ab6af1124102192cbfd878","author":"Cursor Agent","timestamp":1789319345,"line":38,"text":"            onOpenSource !== undefined &&"},{"sha":"bd60dba27