Cursor Agent","timestamp":1789285713,"line":12,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":13,"text":"export type LookForOwner ="},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":14,"text":"  | { kind: \"document\" }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":15,"text":"  | { kind: \"group\"; id: string; title: string; index: number; part?: string };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":16,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":17,"text":"export type LookForClaim = {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":18,"text":"  key: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":19,"text":"  owner: LookForOwner;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":20,"text":"  index: number;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":21,"text":"  tag?: LookForTag;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":22,"text":"  text: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":23,"text":"  body: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":24,"text":"  sourceIds: string[];"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":25,"text":"};"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":26,"text":""},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":27,"text":"export type LookForGroup = PartGroup & {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":28,"text":"  title: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":29,"text":"  lookFor?: readonly string[];"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":30,"text":"};"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":31,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":32,"text":"export function parseLookForBullet(text: string): { tag?: LookForTag; body: string } {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":33,"text":"  const match = LOOK_FOR_TAG_RE.exec(text);"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":34,"text":"  if (match === null) {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":35,"text":"    return { body: text };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":36,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":37,"text":"  const tag = match[1];"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":38,"text":"  const body = match[2];"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":39,"text":"  if (tag === undefined || body === undefined || body === \"\") {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":40,"text":"    return { body: text };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":41,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":42,"text":"  return { tag: tag as LookForTag, body };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":43,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":44,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":45,"text":"export function lookForKey(owner: LookForOwner, index: number): string {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":46,"text":"  return owner.kind === \"document\" ? `document:${index}` : `group:${owner.id}:${index}`;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":47,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":48,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":49,"text":"export function lookForOwnerLabel(owner: LookForOwner): string {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":50,"text":"  if (owner.kind === \"document\") {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":51,"text":"    return \"Overview\";"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":52,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":53,"text":"  return `${padIndex(owner.index)} ${owner.title}`;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":54,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":55,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":56,"text":"export function selectionForLookFor(owner: LookForOwner): Selection {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":57,"text":"  return owner.kind === \"document\" ? { kind: \"overview\" } : { kind: \"group\", id: owner.id };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":58,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":59,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":60,"text":"export function claimsFromLookFor(owner: LookForOwner, items: readonly string[] | undefined): LookForClaim[] {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":61,"text":"  return (items ?? []).map((text, index) => {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":62,"text":"    const parsed = parseLookForBullet(text);"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":63,"text":"    const claim: LookForClaim = {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":64,"text":"      key: lookForKey(owner, index),"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":65,"text":"      owner,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":66,"text":"      index,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":67,"text":"      text,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":68,"text":"      body: parsed.body,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":69,"text":"      sourceIds: citationIds(text),"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":70,"text":"    };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":71,"text":"    if (parsed.tag !== undefined) {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":72,"text":"      claim.tag = parsed.tag;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":73,"text":"    }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":74,"text":"    return claim;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":75,"text":"  });"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":76,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":77,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":78,"text":"export function lookForClaims(document: { lookFor?: readonly string[] }, groups: readonly LookForGroup[]): LookForClaim[] {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":79,"text":"  const claims = claimsFromLookFor({ kind: \"document\" }, document.lookFor);"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":80,"text":"  const parts = groupParts(groups);"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":81,"text":"  const byId = new Map(groups.map((group) => [group.id, group]));"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":82,"text":"  for (const part of parts) {"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":83,"text":"    for (const id of part.groupIds) {"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":84,"text":"      const group = byId.get(id);"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":85,"text":"      if (group === undefined) {"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":86,"text":"        continue;"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":87,"text":"      }"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":88,"text":"      const owner: LookForOwner = {"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":89,"text":"        kind: \"group\","},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":90,"text":"        id: group.id,"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":91,"text":"        title: group.title,"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":92,"text":"        index: groupOrderIndex(parts, group.id),"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":93,"text":"      };"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":94,"text":"      if (group.part !== undefined) {"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":95,"text":"        owner.part = group.part;"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":96,"text":"      }"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":97,"text":"      claims.push(...claimsFromLookFor(owner, group.lookFor));"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":98,"text":"    }"},{"sha":"15b7ca8bf3767b65dc44625d98b1c1aa662e3bc8","author":"Cursor Agent","timestamp":1789295438,"line":99,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":100,"text":"  return claims;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":101,"text":"}"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":102,"text":""},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":103,"text":"export type LookForBucket = {"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":104,"text":"  owner: LookForOwner;"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":105,"text":"  claims: LookForClaim[];"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":106,"text":"  tags: LookForTag[];"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":107,"text":"};"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":108,"text":""},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":109,"text":"export function lookForBuckets(claims: readonly LookForClaim[]): LookForBucket[] {"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":110,"text":"  const buckets: LookForBucket[] = [];"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":111,"text":"  for (const claim of claims) {"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":112,"text":"    const last = buckets[buckets.length - 1];"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":113,"text":"    const sameOwner ="},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":114,"text":"      last !== undefined &&"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":115,"text":"      ((claim.owner.kind === \"document\" && last.owner.kind === \"document\") ||"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":116,"text":"        (claim.owner.kind === \"group\" && last.owner.kind === \"group\" && last.owner.id === claim.owner.id));"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":117,"text":"    if (sameOwner && last !== undefined) {"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":118,"text":"      last.claims.push(claim);"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":119,"text":"      if (claim.tag !== undefined && !last.tags.includes(claim.tag)) {"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":120,"text":"        last.tags.push(claim.tag);"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":121,"text":"      }"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":122,"text":"      continue;"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":123,"text":"    }"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":124,"text":"    buckets.push({"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":125,"text":"      owner: claim.owner,"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":126,"text":"      claims: [claim],"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":127,"text":"      tags: claim.tag !== undefined ? [claim.tag] : [],"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":128,"text":"    });"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":129,"text":"  }"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":130,"text":"  return buckets;"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":131,"text":"}"},{"sha":"e3983805f618f19a8e583e9a5289bf96dae19232","author":"Cursor Agent","timestamp":1789293830,"line":132,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":133,"text":"export type SourceOpenTarget = {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":134,"text":"  selection: Selection;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":135,"text":"  lookForKey?: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":136,"text":"  commentId?: string;"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":137,"text":"};"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":138,"text":""},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":139,"text":"export function openTargetForSource("},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":140,"text":"  source: Source,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":141,"text":"  claims: readonly LookForClaim[],"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":142,"text":"  document: ReviewDocument,"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":143,"text":"): SourceOpenTarget {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":144,"text":"  if (isLinePinned(source)) {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":145,"text":"    const groupId = groupIdForPinnedSource(document, source);"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":146,"text":"    if (groupId !== undefined) {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":147,"text":"      return { selection: { kind: \"group\", id: groupId }, commentId: source.id };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":148,"text":"    }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":149,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":150,"text":"  const claim = claims.find((item) => item.sourceIds.includes(source.id));"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":151,"text":"  if (claim !== undefined) {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":152,"text":"    return { selection: selectionForLookFor(claim.owner), lookForKey: claim.key };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":153,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":154,"text":"  const named = document.groups.find((group) => (group.sources ?? []).includes(source.id));"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":155,"text":"  if (named !== undefined) {"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":156,"text":"    return { selection: { kind: \"group\", id: named.id } };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":157,"text":"  }"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":158,"text":"  return { selection: { kind: \"overview\" } };"},{"sha":"1e6ae76116f72458a00ff9c5b45da451f135dccf","author":"Cursor Agent","timestamp":1789285713,"line":159,"text":"}"}]}
