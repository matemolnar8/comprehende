e","author":"Cursor Agent","timestamp":1790105734,"line":202,"text":"  const logPath = join(root, \"git.log\");"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":203,"text":"  await mkdir(bin, { recursive: true });"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":204,"text":"  await writeFile(logPath, \"\");"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":205,"text":"  await writeFile("},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":206,"text":"    join(bin, \"git\"),"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":207,"text":"    `#!/bin/bash\\nprintf '%s\\\\0' \"$@\" >> ${shellQuote(logPath)}\\nprintf '\\\\n' >> ${shellQuote(logPath)}\\nexec ${shellQuote(REAL_GIT)} \"$@\"\\n`,"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":208,"text":"  );"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":209,"text":"  await chmod(join(bin, \"git\"), 0o755);"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":210,"text":"  const previousPath = process.env.PATH;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":211,"text":"  process.env.PATH = `${bin}${delimiter}${previousPath ?? \"\"}`;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":212,"text":"  try {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":213,"text":"    await fn({"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":214,"text":"      read: async () => parseGitLog(await readFile(logPath, \"utf8\")),"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":215,"text":"      clear: () => writeFile(logPath, \"\"),"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":216,"text":"    });"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":217,"text":"  } finally {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":218,"text":"    if (previousPath === undefined) {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":219,"text":"      delete process.env.PATH;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":220,"text":"    } else {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":221,"text":"      process.env.PATH = previousPath;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":222,"text":"    }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":223,"text":"  }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":224,"text":"}"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":225,"text":""},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":226,"text":"function parseGitLog(text: string): string[][] {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":227,"text":"  return text"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":228,"text":"    .split(\"\\n\")"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":229,"text":"    .filter((line) => line.length > 0)"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":230,"text":"    .map((line) => line.split(\"\\0\").filter((arg) => arg.length > 0));"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":231,"text":"}"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":232,"text":""},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":233,"text":"function gitCommand(argv: string[]): string | undefined {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":234,"text":"  for (let i = 0; i < argv.length; i += 1) {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":235,"text":"    const arg = argv[i];"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":236,"text":"    if (arg === \"-c\") {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":237,"text":"      i += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":238,"text":"      continue;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":239,"text":"    }"},{"sha":"511489f774dfeab593a53dc40d0905e0a06d0ad2","author":"Máté Molnár","timestamp":1792778687,"line":240,"text":"    if (arg === \"--literal-pathspecs\") {"},{"sha":"511489f774dfeab593a53dc40d0905e0a06d0ad2","author":"Máté Molnár","timestamp":1792778687,"line":241,"text":"      continue;"},{"sha":"511489f774dfeab593a53dc40d0905e0a06d0ad2","author":"Máté Molnár","timestamp":1792778687,"line":242,"text":"    }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":243,"text":"    return arg;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":244,"text":"  }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":245,"text":"  return undefined;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":246,"text":"}"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":247,"text":""},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":248,"text":"function tally(calls: string[][]): {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":249,"text":"  revParse: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":250,"text":"  nameStatus: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":251,"text":"  unified: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":252,"text":"  numstat: number;"},{"sha":"511489f774dfeab593a53dc40d0905e0a06d0ad2","author":"Máté Molnár","timestamp":1792778687,"line":253,"text":"  grep: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":254,"text":"  mergeBase: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":255,"text":"  other: number;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":256,"text":"} {"},{"sha":"511489f774dfeab593a53dc40d0905e0a06d0ad2","author":"Máté Molnár","timestamp":1792778687,"line":257,"text":"  const counts = {"},{"sha":"511489f774dfeab593a53dc40d0905e0a06d0ad2","author":"Máté Molnár","timestamp":1792778687,"line":258,"text":"    revParse: 0,"},{"sha":"511489f774dfeab593a53dc40d0905e0a06d0ad2","author":"Máté Molnár","timestamp":1792778687,"line":259,"text":"    nameStatus: 0,"},{"sha":"511489f774dfeab593a53dc40d0905e0a06d0ad2","author":"Máté Molnár","timestamp":1792778687,"line":260,"text":"    unified: 0,"},{"sha":"511489f774dfeab593a53dc40d0905e0a06d0ad2","author":"Máté Molnár","timestamp":1792778687,"line":261,"text":"    numstat: 0,"},{"sha":"511489f774dfeab593a53dc40d0905e0a06d0ad2","author":"Máté Molnár","timestamp":1792778687,"line":262,"text":"    grep: 0,"},{"sha":"511489f774dfeab593a53dc40d0905e0a06d0ad2","author":"Máté Molnár","timestamp":1792778687,"line":263,"text":"    mergeBase: 0,"},{"sha":"511489f774dfeab593a53dc40d0905e0a06d0ad2","author":"Máté Molnár","timestamp":1792778687,"line":264,"text":"    other: 0,"},{"sha":"511489f774dfeab593a53dc40d0905e0a06d0ad2","author":"Máté Molnár","timestamp":1792778687,"line":265,"text":"  };"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":266,"text":"  for (const argv of calls) {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":267,"text":"    const command = gitCommand(argv);"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":268,"text":"    if (command === \"rev-parse\") {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":269,"text":"      counts.revParse += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":270,"text":"    } else if (command === \"merge-base\") {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":271,"text":"      counts.mergeBase += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":272,"text":"    } else if (command === \"diff\" && argv.includes(\"--name-status\")) {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":273,"text":"      counts.nameStatus += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":274,"text":"    } else if (command === \"diff\" && argv.includes(\"--numstat\")) {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":275,"text":"      counts.numstat += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":276,"text":"    } else if (command === \"diff\") {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":277,"text":"      counts.unified += 1;"},{"sha":"511489f774dfeab593a53dc40d0905e0a06d0ad2","author":"Máté Molnár","timestamp":1792778687,"line":278,"text":"    } else if (command === \"grep\") {"},{"sha":"511489f774dfeab593a53dc40d0905e0a06d0ad2","author":"Máté Molnár","timestamp":1792778687,"line":279,"text":"      counts.grep += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":280,"text":"    } else {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":281,"text":"      counts.other += 1;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":282,"text":"    }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":283,"text":"  }"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":284,"text":"  return counts;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":285,"text":"}"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":286,"text":""},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":287,"text":"function shellQuote(value: string): string {"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":288,"text":"  return `'${value.replaceAll(\"'\", `'\\\\''`)}'`;"},{"sha":"013dce421e370fe39773e74a03d7cd640b38397e","author":"Cursor Agent","timestamp":1790105734,"line":289,"text":"}"}]}
