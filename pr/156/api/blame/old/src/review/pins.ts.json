{"path":"src/review/pins.ts","ref":"7346f9664030764a93e78942373251c29a5f4803","side":"old","lines":[{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":1,"text":"import { showFile } from \"../git/show.ts\";"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":2,"text":"import { isLinePinned, textLineCount } from \"../schema/source.ts\";"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":3,"text":"import type { LinePinnedSource, ReviewDocument, SourceSide } from \"../schema/types.ts\";"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":4,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":5,"text":"export type StaleCommentPin = {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":6,"text":"  id: string;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":7,"text":"  path: string;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":8,"text":"  side: SourceSide;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":9,"text":"  line: number;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":10,"text":"};"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":11,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":12,"text":"export async function staleCommentPins("},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":13,"text":"  cwd: string,"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":14,"text":"  document: ReviewDocument,"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":15,"text":"  range: { baseSha: string; headSha: string },"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":16,"text":"): Promise<StaleCommentPin[]> {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":17,"text":"  const stale: StaleCommentPin[] = [];"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":18,"text":"  for (const source of document.sources ?? []) {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":19,"text":"    if (!isLinePinned(source)) {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":20,"text":"      continue;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":21,"text":"    }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":22,"text":"    if (!(await commentPinMatches(cwd, source, range))) {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":23,"text":"      stale.push({ id: source.id, path: source.path, side: source.side, line: source.line });"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":24,"text":"    }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":25,"text":"  }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":26,"text":"  return stale;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":27,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":28,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":29,"text":"export function commentPinErrors(pins: readonly StaleCommentPin[]): string[] {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":30,"text":"  if (pins.length === 0) {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":31,"text":"    return [];"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":32,"text":"  }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":33,"text":"  const lines = pins.map((pin) => `  ${pin.id} ${pin.path} ${pin.side}:${pin.line}`);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":34,"text":"  return [`stale: ${pins.length} comment pin(s) do not match live git:\\n${lines.join(\"\\n\")}`];"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":35,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":36,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":37,"text":"async function commentPinMatches("},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":38,"text":"  cwd: string,"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":39,"text":"  source: LinePinnedSource,"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":40,"text":"  range: { baseSha: string; headSha: string },"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":41,"text":"): Promise<boolean> {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":42,"text":"  const sha = source.side === \"old\" ? range.baseSha : range.headSha;"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":43,"text":"  let content: string;"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":44,"text":"  try {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":45,"text":"    content = await showFile(cwd, sha, source.path);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":46,"text":"  } catch {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":47,"text":"    return false;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":48,"text":"  }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":49,"text":"  const count = textLineCount(content);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":50,"text":"  return source.line >= 1 && source.line <= count;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":51,"text":"}"}]}
