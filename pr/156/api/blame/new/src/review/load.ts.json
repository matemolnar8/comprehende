{"path":"src/review/load.ts","ref":"a476ce89308f686f4349f0c94cb750a094e8b51b","side":"new","lines":[{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":1,"text":"import { readFile } from \"node:fs/promises\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":2,"text":"import { isAbsolute, resolve } from \"node:path\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":3,"text":"import { parseReviewJson } from \"../schema/parse.ts\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":4,"text":"import type { ReviewDocument } from \"../schema/types.ts\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":5,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":6,"text":"export async function loadDocument(dataPath: string): Promise<ReviewDocument> {"},{"sha":"a476ce89308f686f4349f0c94cb750a094e8b51b","author":"Máté Molnár","timestamp":1792904646,"line":7,"text":"  const parsed = parseReviewJson(decodeText(await readFile(dataPath)));"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":8,"text":"  if (!parsed.ok) {"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":9,"text":"    throw new Error("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":10,"text":"      `invalid review document:\\n${parsed.errors.map((error) => `  - ${error}`).join(\"\\n\")}`,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":11,"text":"    );"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":12,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":13,"text":"  return parsed.document;"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":14,"text":"}"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":15,"text":""},{"sha":"a476ce89308f686f4349f0c94cb750a094e8b51b","author":"Máté Molnár","timestamp":1792904646,"line":16,"text":"/** PowerShell 5.1 writes UTF-8 with a BOM, and its `>` writes UTF-16LE. TextDecoder drops the BOM. */"},{"sha":"a476ce89308f686f4349f0c94cb750a094e8b51b","author":"Máté Molnár","timestamp":1792904646,"line":17,"text":"function decodeText(bytes: Uint8Array): string {"},{"sha":"a476ce89308f686f4349f0c94cb750a094e8b51b","author":"Máté Molnár","timestamp":1792904646,"line":18,"text":"  const utf16 = bytes[0] === 0xff && bytes[1] === 0xfe;"},{"sha":"a476ce89308f686f4349f0c94cb750a094e8b51b","author":"Máté Molnár","timestamp":1792904646,"line":19,"text":"  return new TextDecoder(utf16 ? \"utf-16le\" : \"utf-8\").decode(bytes);"},{"sha":"a476ce89308f686f4349f0c94cb750a094e8b51b","author":"Máté Molnár","timestamp":1792904646,"line":20,"text":"}"},{"sha":"a476ce89308f686f4349f0c94cb750a094e8b51b","author":"Máté Molnár","timestamp":1792904646,"line":21,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":22,"text":"export function resolveDataPath(data: string | undefined, cwd: string): string {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":23,"text":"  return resolveCliPath(data, cwd, \"--data <review.json>\");"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":24,"text":"}"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":25,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":26,"text":"export function resolveCliPath(value: string | undefined, cwd: string, flag: string): string {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":27,"text":"  if (value === undefined) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":28,"text":"    throw new Error(`missing ${flag}`);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":29,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":30,"text":"  return isAbsolute(value) ? value : resolve(cwd, value);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":31,"text":"}"}]}
