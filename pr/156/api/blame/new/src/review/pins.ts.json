{"path":"src/review/pins.ts","ref":"a476ce89308f686f4349f0c94cb750a094e8b51b","side":"new","lines":[{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":1,"text":"import { showFile } from \"../git/show.ts\";"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":2,"text":"import { isLinePinned, textLineCount } from \"../schema/source.ts\";"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":3,"text":"import type { LinePinnedSource, ReviewDocument, SourceSide } from \"../schema/types.ts\";"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":4,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":5,"text":"export type StaleCommentPin = {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":6,"text":"  id: string;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":7,"text":"  path: string;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":8,"text":"  side: SourceSide;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":9,"text":"  line: number;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":10,"text":"};"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":11,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":12,"text":"export async function staleCommentPins("},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":13,"text":"  cwd: string,"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":14,"text":"  document: ReviewDocument,"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":15,"text":"  range: { baseSha: string; headSha: string },"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":16,"text":"): Promise<StaleCommentPin[]> {"},{"sha":"a476ce89308f686f4349f0c94cb750a094e8b51b","author":"Máté Molnár","timestamp":1792904646,"line":17,"text":"  const pinned = (document.sources ?? []).filter(isLinePinned);"},{"sha":"a476ce89308f686f4349f0c94cb750a094e8b51b","author":"Máté Molnár","timestamp":1792904646,"line":18,"text":"  const matches = await Promise.all(pinned.map((source) => commentPinMatches(cwd, source, range)));"},{"sha":"a476ce89308f686f4349f0c94cb750a094e8b51b","author":"Máté Molnár","timestamp":1792904646,"line":19,"text":"  return pinned"},{"sha":"a476ce89308f686f4349f0c94cb750a094e8b51b","author":"Máté Molnár","timestamp":1792904646,"line":20,"text":"    .filter((_, index) => !matches[index])"},{"sha":"a476ce89308f686f4349f0c94cb750a094e8b51b","author":"Máté Molnár","timestamp":1792904646,"line":21,"text":"    .map((source) => ({ id: source.id, path: source.path, side: source.side, line: source.line }));"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":22,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":23,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":24,"text":"export function commentPinErrors(pins: readonly StaleCommentPin[]): string[] {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":25,"text":"  if (pins.length === 0) {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":26,"text":"    return [];"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":27,"text":"  }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":28,"text":"  const lines = pins.map((pin) => `  ${pin.id} ${pin.path} ${pin.side}:${pin.line}`);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":29,"text":"  return [`stale: ${pins.length} comment pin(s) do not match live git:\\n${lines.join(\"\\n\")}`];"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":30,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":31,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":32,"text":"async function commentPinMatches("},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":33,"text":"  cwd: string,"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":34,"text":"  source: LinePinnedSource,"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":35,"text":"  range: { baseSha: string; headSha: string },"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":36,"text":"): Promise<boolean> {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":37,"text":"  const sha = source.side === \"old\" ? range.baseSha : range.headSha;"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":38,"text":"  let content: string;"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":39,"text":"  try {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":40,"text":"    content = await showFile(cwd, sha, source.path);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":41,"text":"  } catch {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":42,"text":"    return false;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":43,"text":"  }"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":44,"text":"  const count = textLineCount(content);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":45,"text":"  return source.line >= 1 && source.line <= count;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":46,"text":"}"}]}
