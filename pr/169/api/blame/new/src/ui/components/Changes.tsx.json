sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":228,"text":"/** \"2 new · 1 changed hunks\", or null when no hunk moved. */"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":229,"text":"export function hunkCountsLabel(counts: ApiHunkCounts & { gone?: number }): string | null {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":230,"text":"  const counted = ([\"new\", \"changed\", \"reformat\", \"gone\"] as const)"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":231,"text":"    .map((key) => [key, counts[key] ?? 0] as const)"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":232,"text":"    .filter(([, n]) => n > 0);"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":233,"text":"  if (counted.length === 0) {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":234,"text":"    return null;"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":235,"text":"  }"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":236,"text":"  const total = counted.reduce((sum, [, n]) => sum + n, 0);"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":237,"text":"  const label = counted.map(([key, n]) => `${n} ${key}`).join(\" · \");"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":238,"text":"  return `${label} ${total === 1 ? \"hunk\" : \"hunks\"}`;"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":239,"text":"}"}]}
