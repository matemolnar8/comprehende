{"path":"src/ui/components/QuestionList.tsx","ref":"213dd6b92c2db8437786bfa0b20327632ea942bd","side":"new","lines":[{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":1,"text":"import type { Questions } from \"../../schema/types.ts\";"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":2,"text":"import { askAgentPrompt } from \"../lib/agent-prompt.ts\";"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":3,"text":"import { CopyPrompt } from \"./CopyPrompt.tsx\";"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":4,"text":"import { InlineMd } from \"./InlineMd.tsx\";"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":5,"text":"import { BriefField, briefProse, briefRows } from \"./Kicker.tsx\";"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":6,"text":""},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":7,"text":"export function QuestionList(props: { groupId: string; questions: Questions }) {"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":8,"text":"  const { groupId, questions } = props;"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":9,"text":"  if (questions.length === 0) {"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":10,"text":"    return null;"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":11,"text":"  }"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":12,"text":"  return ("},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":13,"text":"    <BriefField kicker=\"Questions\">"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":14,"text":"      <ul className={briefRows}>"},{"sha":"213dd6b92c2db8437786bfa0b20327632ea942bd","author":"Máté Molnár","timestamp":1793521313,"line":15,"text":"        {questions.map((question, i) => ("},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":16,"text":"          <li"},{"sha":"213dd6b92c2db8437786bfa0b20327632ea942bd","author":"Máté Molnár","timestamp":1793521313,"line":17,"text":"            key={i}"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":18,"text":"            className=\"flex max-w-[calc(68ch+1.5rem)] items-start justify-between gap-3 py-1.5 first:pt-0 last:pb-0\""},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":19,"text":"          >"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":20,"text":"            <p className={briefProse}>"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":21,"text":"              <InlineMd text={question} />"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":22,"text":"            </p>"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":23,"text":"            <CopyPrompt prompt={askAgentPrompt({ group: groupId }, question)} scope=\"question\" />"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":24,"text":"          </li>"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":25,"text":"        ))}"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":26,"text":"      </ul>"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":27,"text":"    </BriefField>"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":28,"text":"  );"},{"sha":"2e72adb6dcab26975f4ceccd1a70744d07c1381d","author":"Máté Molnár","timestamp":1793519660,"line":29,"text":"}"}]}
