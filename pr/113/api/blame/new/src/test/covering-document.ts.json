4d88a73e76eed","author":"Cursor Agent","timestamp":1789936335,"line":223,"text":"  if (missed.length > 0) {"},{"sha":"98be82dff6b4e35c6bfb1c5c3be4d88a73e76eed","author":"Cursor Agent","timestamp":1789936335,"line":224,"text":"    throw new Error(`mixed covering document missed ${missed.map((hunk) => hunk.path).join(\", \")}`);"},{"sha":"98be82dff6b4e35c6bfb1c5c3be4d88a73e76eed","author":"Cursor Agent","timestamp":1789936335,"line":225,"text":"  }"},{"sha":"98be82dff6b4e35c6bfb1c5c3be4d88a73e76eed","author":"Cursor Agent","timestamp":1789936335,"line":226,"text":"}"}]}
