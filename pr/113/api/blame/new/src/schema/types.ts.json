{"path":"src/schema/types.ts","ref":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","side":"new","lines":[{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":1,"text":"import type { HunkRef, ReviewSource, Source } from \"./review.ts\";"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":2,"text":""},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":3,"text":"export type { HunkRef, ReviewDocument, ReviewGroup, ReviewHunkRef, ReviewPart, ReviewSource, Source } from \"./review.ts\";"},{"sha":"ee0c6c0d32a18ee271d9a1947d5d21a2fc71cd7b","author":"Máté Molnár","timestamp":1788718047,"line":4,"text":""},{"sha":"5c713233ac7998a896201cef62027b5b4e3a2bd7","author":"matemolnar8","timestamp":1786706250,"line":5,"text":"export const REVIEW_SIZES = [\"trivial\", \"small\", \"medium\", \"large\", \"very-large\"] as const;"},{"sha":"5c713233ac7998a896201cef62027b5b4e3a2bd7","author":"matemolnar8","timestamp":1786706250,"line":6,"text":""},{"sha":"5c713233ac7998a896201cef62027b5b4e3a2bd7","author":"matemolnar8","timestamp":1786706250,"line":7,"text":"export type ReviewSize = (typeof REVIEW_SIZES)[number];"},{"sha":"5c713233ac7998a896201cef62027b5b4e3a2bd7","author":"matemolnar8","timestamp":1786706250,"line":8,"text":""},{"sha":"5c713233ac7998a896201cef62027b5b4e3a2bd7","author":"matemolnar8","timestamp":1786706250,"line":9,"text":"export function isReviewSize(value: unknown): value is ReviewSize {"},{"sha":"5c713233ac7998a896201cef62027b5b4e3a2bd7","author":"matemolnar8","timestamp":1786706250,"line":10,"text":"  return typeof value === \"string\" && (REVIEW_SIZES as readonly string[]).includes(value);"},{"sha":"5c713233ac7998a896201cef62027b5b4e3a2bd7","author":"matemolnar8","timestamp":1786706250,"line":11,"text":"}"},{"sha":"5c713233ac7998a896201cef62027b5b4e3a2bd7","author":"matemolnar8","timestamp":1786706250,"line":12,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":13,"text":"export function padIndex(index: number): string {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":14,"text":"  return String(index).padStart(2, \"0\");"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":15,"text":"}"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":16,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":17,"text":"export function sizeLabel(size: ReviewSize): string {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":18,"text":"  return size.replace(\"-\", \" \");"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":19,"text":"}"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":20,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":21,"text":"export function shortSha(sha: string): string {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":22,"text":"  return sha.slice(0, 7);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":23,"text":"}"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":24,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":25,"text":"/** Last slash segment of a git path. Git paths use forward slashes. */"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":26,"text":"export function basename(path: string): string {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":27,"text":"  const slash = path.lastIndexOf(\"/\");"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":28,"text":"  return slash === -1 ? path : path.slice(slash + 1);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":29,"text":"}"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":30,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":31,"text":"export const SOURCE_KINDS = [\"ticket\", \"pr\", \"pr-comment\", \"commit\", \"transcript\"] as const;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":32,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":33,"text":"export type SourceKind = (typeof SOURCE_KINDS)[number];"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":34,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":35,"text":"export function isSourceKind(value: unknown): value is SourceKind {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":36,"text":"  return typeof value === \"string\" && (SOURCE_KINDS as readonly string[]).includes(value);"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":37,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":38,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":39,"text":"export type SourceSide = \"old\" | \"new\";"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":40,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":41,"text":"export function isSourceSide(value: unknown): value is SourceSide {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":42,"text":"  return value === \"old\" || value === \"new\";"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":43,"text":"}"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":44,"text":""},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":45,"text":"export type LinePinnedSource = Source & {"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":46,"text":"  kind: \"pr-comment\";"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":47,"text":"  path: string;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":48,"text":"  side: SourceSide;"},{"sha":"7f143a7b7989e4bdf8ab8dbdafd7255fe3ac2a88","author":"Cursor Agent","timestamp":1788035496,"line":49,"text":"  line: number;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":50,"text":"};"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":51,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":52,"text":"export type HunkIndex = {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":53,"text":"  source: ReviewSource;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":54,"text":"  hunks: HunkRef[];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":55,"text":"  skipped: SkippedFile[];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":56,"text":"};"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":57,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":58,"text":"export type SkippedFile = {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":59,"text":"  path: string;"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":60,"text":"  reason: \"binary\" | \"lockfile\";"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":61,"text":"};"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":62,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":63,"text":"export type DiffLineKind = \"ctx\" | \"add\" | \"del\";"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":64,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":65,"text":"export type DiffLine = {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":66,"text":"  kind: DiffLineKind;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":67,"text":"  oldNumber: number | null;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":68,"text":"  newNumber: number | null;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":69,"text":"  text: string;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":70,"text":"  /** Other side of a block git would mark with `--color-moved`. */"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":71,"text":"  moved?: { path: string; line: number };"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":72,"text":"};"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":73,"text":""},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":74,"text":"/** Git rename or copy. `similarity` is the similarity index, 0–100. */"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":75,"text":"export type Relocation = {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":76,"text":"  kind: \"rename\" | \"copy\";"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":77,"text":"  similarity?: number;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":78,"text":"};"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":79,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":80,"text":"export type LiveHunk = HunkRef & {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":81,"text":"  header: string;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":82,"text":"  lines: DiffLine[];"},{"sha":"1f1e301f288d02ec4e059e0a4e94e71f9ae389fc","author":"Cursor Agent","timestamp":1786690181,"line":83,"text":"  patch: string;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":84,"text":"};"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":85,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":86,"text":"export type FileStatus = \"added\" | \"deleted\" | \"modified\" | \"renamed\";"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":87,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":88,"text":"export type DiffFile = {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":89,"text":"  path: string;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":90,"text":"  oldPath?: string;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":91,"text":"  status: FileStatus;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":92,"text":"  binary: boolean;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":93,"text":"  image: boolean;"},{"sha":"1f1e301f288d02ec4e059e0a4e94e71f9ae389fc","author":"Cursor Agent","timestamp":1786690181,"line":94,"text":"  headerPatch: string;"},{"sha":"1f1e301f288d02ec4e059e0a4e94e71f9ae389fc","author":"Cursor Agent","timestamp":1786690181,"line":95,"text":"  patch: string;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":96,"text":"  hunks: LiveHunk[];"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":97,"text":"  /** Present when git printed `rename from`/`to` or `copy from`/`to`. */"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":98,"text":"  relocation?: Relocation;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":99,"text":"  /** Present on lockfile stubs that never loaded patch text. */"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":100,"text":"  added?: number;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":101,"text":"  removed?: number;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":102,"text":"};"}]}
