{"path":"src/git/moved.ts","ref":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","side":"new","lines":[{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":1,"text":"import type { DiffFile, LiveHunk } from \"../schema/types.ts\";"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":2,"text":""},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":3,"text":"/** Git `--color-moved=plain` ignores a block under 20 alphanumeric characters. */"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":4,"text":"const MOVED_MIN_ALNUM = 20;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":5,"text":""},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":6,"text":"type Slot = {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":7,"text":"  path: string;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":8,"text":"  line: number;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":9,"text":"  text: string;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":10,"text":"  hunk: LiveHunk;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":11,"text":"  index: number;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":12,"text":"};"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":13,"text":""},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":14,"text":"/**"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":15,"text":" * Mark add/delete lines that are the same block elsewhere in this diff."},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":16,"text":" * Same rule as `git diff --color-moved=plain`: exact text, at least 20"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":17,"text":" * alphanumeric characters in the block. Does not change patch text."},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":18,"text":" */"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":19,"text":"export function markMovedLines(files: readonly DiffFile[]): void {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":20,"text":"  const deleted = runs(files, \"del\");"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":21,"text":"  const added = runs(files, \"add\");"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":22,"text":"  const delAt = indexByText(deleted);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":23,"text":"  const usedDel = new Set<Slot>();"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":24,"text":"  const usedAdd = new Set<Slot>();"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":25,"text":""},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":26,"text":"  type Match = { dels: Slot[]; adds: Slot[]; score: number };"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":27,"text":"  const matches: Match[] = [];"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":28,"text":""},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":29,"text":"  for (const addRun of added) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":30,"text":"    for (let ai = 0; ai < addRun.length; ai++) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":31,"text":"      const start = addRun[ai];"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":32,"text":"      if (start === undefined) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":33,"text":"        continue;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":34,"text":"      }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":35,"text":"      const candidates = delAt.get(start.text);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":36,"text":"      if (candidates === undefined) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":37,"text":"        continue;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":38,"text":"      }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":39,"text":"      for (const candidate of candidates) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":40,"text":"        const delRun = candidate.run;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":41,"text":"        const di = candidate.index;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":42,"text":"        let len = 0;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":43,"text":"        let score = 0;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":44,"text":"        while (ai + len < addRun.length && di + len < delRun.length) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":45,"text":"          const add = addRun[ai + len];"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":46,"text":"          const del = delRun[di + len];"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":47,"text":"          if (add === undefined || del === undefined || add.text !== del.text) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":48,"text":"            break;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":49,"text":"          }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":50,"text":"          score += alnumCount(add.text);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":51,"text":"          len += 1;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":52,"text":"        }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":53,"text":"        if (len > 0 && score >= MOVED_MIN_ALNUM) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":54,"text":"          matches.push({"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":55,"text":"            dels: delRun.slice(di, di + len),"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":56,"text":"            adds: addRun.slice(ai, ai + len),"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":57,"text":"            score,"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":58,"text":"          });"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":59,"text":"        }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":60,"text":"      }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":61,"text":"    }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":62,"text":"  }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":63,"text":""},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":64,"text":"  matches.sort((a, b) => b.score - a.score || b.adds.length - a.adds.length);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":65,"text":"  for (const match of matches) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":66,"text":"    if (match.dels.some((slot) => usedDel.has(slot)) || match.adds.some((slot) => usedAdd.has(slot))) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":67,"text":"      continue;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":68,"text":"    }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":69,"text":"    for (let i = 0; i < match.adds.length; i++) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":70,"text":"      const add = match.adds[i];"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":71,"text":"      const del = match.dels[i];"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":72,"text":"      if (add === undefined || del === undefined) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":73,"text":"        continue;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":74,"text":"      }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":75,"text":"      usedAdd.add(add);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":76,"text":"      usedDel.add(del);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":77,"text":"      const addLine = add.hunk.lines[add.index];"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":78,"text":"      const delLine = del.hunk.lines[del.index];"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":79,"text":"      if (addLine !== undefined) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":80,"text":"        addLine.moved = { path: del.path, line: del.line };"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":81,"text":"      }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":82,"text":"      if (delLine !== undefined) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":83,"text":"        delLine.moved = { path: add.path, line: add.line };"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":84,"text":"      }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":85,"text":"    }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":86,"text":"  }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":87,"text":"}"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":88,"text":""},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":89,"text":"function runs(files: readonly DiffFile[], kind: \"add\" | \"del\"): Slot[][] {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":90,"text":"  const out: Slot[][] = [];"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":91,"text":"  for (const file of files) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":92,"text":"    for (const hunk of file.hunks) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":93,"text":"      let current: Slot[] | undefined;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":94,"text":"      for (let index = 0; index < hunk.lines.length; index++) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":95,"text":"        const line = hunk.lines[index];"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":96,"text":"        if (line === undefined || line.kind !== kind) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":97,"text":"          current = undefined;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":98,"text":"          continue;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":99,"text":"        }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":100,"text":"        const number = kind === \"add\" ? line.newNumber : line.oldNumber;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":101,"text":"        if (number === null) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":102,"text":"          current = undefined;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":103,"text":"          continue;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":104,"text":"        }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":105,"text":"        const slot: Slot = {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":106,"text":"          path: kind === \"del\" ? (file.oldPath ?? file.path) : file.path,"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":107,"text":"          line: number,"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":108,"text":"          text: line.text,"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":109,"text":"          hunk,"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":110,"text":"          index,"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":111,"text":"        };"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":112,"text":"        if (current === undefined) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":113,"text":"          current = [];"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":114,"text":"          out.push(current);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":115,"text":"        }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":116,"text":"        current.push(slot);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":117,"text":"      }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":118,"text":"    }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":119,"text":"  }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":120,"text":"  return out;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":121,"text":"}"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":122,"text":""},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":123,"text":"function indexByText(runs: Slot[][]): Map<string, { run: Slot[]; index: number }[]> {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":124,"text":"  const out = new Map<string, { run: Slot[]; index: number }[]>();"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":125,"text":"  for (const run of runs) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":126,"text":"    for (let index = 0; index < run.length; index++) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":127,"text":"      const slot = run[index];"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":128,"text":"      if (slot === undefined) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":129,"text":"        continue;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":130,"text":"      }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":131,"text":"      const list = out.get(slot.text);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":132,"text":"      const hit = { run, index };"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":133,"text":"      if (list === undefined) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":134,"text":"        out.set(slot.text, [hit]);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":135,"text":"      } else {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":136,"text":"        list.push(hit);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":137,"text":"      }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":138,"text":"    }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":139,"text":"  }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":140,"text":"  return out;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":141,"text":"}"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":142,"text":""},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":143,"text":"function alnumCount(text: string): number {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":144,"text":"  let count = 0;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":145,"text":"  for (let i = 0; i < text.length; i++) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":146,"text":"    const code = text.charCodeAt(i);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":147,"text":"    if ((code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":148,"text":"      count += 1;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":149,"text":"    }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":150,"text":"  }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":151,"text":"  return count;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":152,"text":"}"}]}
