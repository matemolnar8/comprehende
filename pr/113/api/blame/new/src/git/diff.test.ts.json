":237,"text":"    assert.equal(app.patch.includes(APP_SECRET), true);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":238,"text":""},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":239,"text":"    const bun = files.find((file) => file.path === \"bun.lockb\");"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":240,"text":"    assert.ok(bun);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":241,"text":"    assert.equal(bun.binary, true);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":242,"text":"    assert.equal(bun.hunks.length, 0);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":243,"text":""},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":244,"text":"    const live = await readPathDiff(repo.root, repo.base, repo.head, \"package-lock.json\");"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":245,"text":"    assert.ok(live);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":246,"text":"    assert.equal(live.patch.includes(LOCKFILE_SECRET), true);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":247,"text":"    assert.equal(live.patch.startsWith(\"diff --git \"), true);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":248,"text":""},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":249,"text":"    const index = await readHunkIndex(repo.root, repo.base, repo.head);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":250,"text":"    assert.equal(JSON.stringify(index).includes(LOCKFILE_SECRET), false);"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":251,"text":"    assert.equal(index.hunks.some((hunk) => hunk.path === \"package-lock.json\"), false);"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":252,"text":"    assert.ok(index.skipped.some((item) => item.path === \"package-lock.json\" && item.reason === \"lockfile\"));"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":253,"text":"    assert.ok(index.skipped.some((item) => item.path === \"apps/web/yarn.lock\" && item.reason === \"lockfile\"));"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":254,"text":"    assert.ok(index.skipped.some((item) => item.path === \"bun.lockb\"));"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":255,"text":"  });"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":256,"text":"});"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":257,"text":""},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":258,"text":"describe(\"findDiffFile\", () => {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":259,"text":"  const copy = { path: \"src/beta.copy.ts\", oldPath: \"src/beta.ts\" };"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":260,"text":"  const source = { path: \"src/beta.ts\" };"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":261,"text":""},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":262,"text":"  it(\"keeps the source when a copy is listed first\", () => {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":263,"text":"    assert.equal(findDiffFile([copy, source], \"src/beta.ts\"), source);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":264,"text":"    assert.equal(findDiffFile([copy, source], \"src/beta.copy.ts\"), copy);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":265,"text":"  });"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":266,"text":""},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":267,"text":"  it(\"follows a unique old path\", () => {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":268,"text":"    assert.equal(findDiffFile([copy], \"src/beta.ts\"), copy);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":269,"text":"  });"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":270,"text":"});"}]}
