{"path":"src/git/name-status.ts","ref":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","side":"new","lines":[{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":1,"text":"import type { FileStatus } from \"../schema/types.ts\";"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":2,"text":""},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":3,"text":"export type NameStatusEntry = {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":4,"text":"  status: FileStatus;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":5,"text":"  path: string;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":6,"text":"  oldPath?: string;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":7,"text":"  /** Similarity index from `R075` / `C100`. */"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":8,"text":"  similarity?: number;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":9,"text":"  /** True when the status letter is `C` (copy), not `R` (rename). */"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":10,"text":"  copy?: boolean;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":11,"text":"};"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":12,"text":""},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":13,"text":"export type NumstatEntry = {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":14,"text":"  path: string;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":15,"text":"  oldPath?: string;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":16,"text":"  added: number | null;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":17,"text":"  removed: number | null;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":18,"text":"};"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":19,"text":""},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":20,"text":"export function parseNameStatus(stdout: string): NameStatusEntry[] {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":21,"text":"  const parts = stdout.split(\"\\0\").filter((part) => part !== \"\");"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":22,"text":"  const entries: NameStatusEntry[] = [];"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":23,"text":"  let index = 0;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":24,"text":"  while (index < parts.length) {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":25,"text":"    const code = parts[index];"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":26,"text":"    index += 1;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":27,"text":"    if (code === undefined) {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":28,"text":"      break;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":29,"text":"    }"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":30,"text":"    if (code.startsWith(\"R\") || code.startsWith(\"C\")) {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":31,"text":"      const oldPath = parts[index];"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":32,"text":"      const path = parts[index + 1];"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":33,"text":"      index += 2;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":34,"text":"      if (oldPath === undefined || path === undefined) {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":35,"text":"        break;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":36,"text":"      }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":37,"text":"      const entry: NameStatusEntry = { status: \"renamed\", path, oldPath };"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":38,"text":"      const score = /^[RC](\\d+)/.exec(code);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":39,"text":"      if (score?.[1] !== undefined) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":40,"text":"        entry.similarity = Number(score[1]);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":41,"text":"      }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":42,"text":"      if (code.startsWith(\"C\")) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":43,"text":"        entry.copy = true;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":44,"text":"      }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":45,"text":"      entries.push(entry);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":46,"text":"      continue;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":47,"text":"    }"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":48,"text":"    const path = parts[index];"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":49,"text":"    index += 1;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":50,"text":"    if (path === undefined) {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":51,"text":"      break;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":52,"text":"    }"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":53,"text":"    entries.push({ status: statusFrom(code), path });"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":54,"text":"  }"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":55,"text":"  return entries;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":56,"text":"}"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":57,"text":""},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":58,"text":"/** Git `--numstat -z`: `added\\\\tdeleted\\\\tpath\\\\0`, or `added\\\\tdeleted\\\\t\\\\0old\\\\0new\\\\0` for a rename. */"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":59,"text":"export function parseNumstat(stdout: string): Map<string, NumstatEntry> {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":60,"text":"  const parts = stdout.split(\"\\0\");"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":61,"text":"  const out = new Map<string, NumstatEntry>();"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":62,"text":"  let index = 0;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":63,"text":"  while (index < parts.length) {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":64,"text":"    const field = parts[index];"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":65,"text":"    if (field === undefined || field === \"\") {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":66,"text":"      index += 1;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":67,"text":"      continue;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":68,"text":"    }"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":69,"text":"    const match = /^(-|\\d+)\\t(-|\\d+)\\t(.*)$/.exec(field);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":70,"text":"    if (match === null || match[1] === undefined || match[2] === undefined || match[3] === undefined) {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":71,"text":"      break;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":72,"text":"    }"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":73,"text":"    index += 1;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":74,"text":"    const added = parseCount(match[1]);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":75,"text":"    const removed = parseCount(match[2]);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":76,"text":"    if (match[3] !== \"\") {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":77,"text":"      out.set(match[3], { path: match[3], added, removed });"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":78,"text":"      continue;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":79,"text":"    }"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":80,"text":"    const oldPath = parts[index];"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":81,"text":"    const path = parts[index + 1];"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":82,"text":"    index += 2;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":83,"text":"    if (oldPath === undefined || path === undefined || oldPath === \"\" || path === \"\") {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":84,"text":"      break;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":85,"text":"    }"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":86,"text":"    out.set(path, { path, oldPath, added, removed });"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":87,"text":"  }"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":88,"text":"  return out;"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":89,"text":"}"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":90,"text":""},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":91,"text":"function parseCount(value: string): number | null {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":92,"text":"  return value === \"-\" ? null : Number(value);"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":93,"text":"}"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":94,"text":""},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":95,"text":"function statusFrom(code: string): FileStatus {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":96,"text":"  if (code.startsWith(\"A\")) {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":97,"text":"    return \"added\";"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":98,"text":"  }"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":99,"text":"  if (code.startsWith(\"D\")) {"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":100,"text":"    return \"deleted\";"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":101,"text":"  }"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":102,"text":"  return \"modified\";"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":103,"text":"}"}]}
