b\\/(.+)$/.exec(stripAnsi(line));"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":128,"text":"    if (header?.[2] !== undefined) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":129,"text":"      path = header[2];"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":130,"text":"      continue;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":131,"text":"    }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":132,"text":"    const added = /^(?:\\x1b\\[36m\\+\\x1b\\[m\\x1b\\[36m|\\x1b\\[36m\\+)(.*)\\x1b\\[m$/.exec(line);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":133,"text":"    if (added?.[1] !== undefined && !added[1].startsWith(\"@\")) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":134,"text":"      keys.push(`${path}\\0add\\0${added[1]}`);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":135,"text":"      continue;"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":136,"text":"    }"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":137,"text":"    const deleted = /^(?:\\x1b\\[35m-\\x1b\\[m\\x1b\\[35m|\\x1b\\[35m-)(.*)\\x1b\\[m$/.exec(line);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":138,"text":"    if (deleted?.[1] !== undefined) {"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb0a07aa9c","author":"Cursor Agent","timestamp":1790140935,"line":139,"text":"      keys.push(`${path}\\0del\\0${deleted[1]}`);"},{"sha":"1bba6a0cb51530dfa5f8c9f5ee3707bb