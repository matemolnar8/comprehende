{"path":"src/ui/lib/relocation.ts","ref":"955f062a0d58d886e1dd09ce1bcfbb6d9e2857ae","side":"new","lines":[{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":1,"text":"import { basename } from \"../../schema/types.ts\";"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":2,"text":"import type { Relocation } from \"../../schema/types.ts\";"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":3,"text":"import type { DiffLine } from \"../../schema/types.ts\";"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":4,"text":""},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":5,"text":"export type RelocationWord = \"Copied\" | \"Moved\" | \"Renamed\";"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":6,"text":""},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":7,"text":"export function relocationWord(file: {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":8,"text":"  path: string;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":9,"text":"  oldPath?: string;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":10,"text":"  relocation?: Relocation;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":11,"text":"}): RelocationWord | undefined {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":12,"text":"  const relocation = file.relocation;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":13,"text":"  if (relocation === undefined) {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":14,"text":"    return undefined;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":15,"text":"  }"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":16,"text":"  if (relocation.kind === \"copy\") {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":17,"text":"    return \"Copied\";"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":18,"text":"  }"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":19,"text":"  const oldPath = file.oldPath;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":20,"text":"  if (oldPath !== undefined && oldPath !== file.path && basename(oldPath) === basename(file.path)) {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":21,"text":"    return \"Moved\";"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":22,"text":"  }"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":23,"text":"  return \"Renamed\";"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":24,"text":"}"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":25,"text":""},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":26,"text":"/** A rename or copy with no added or removed lines. The header is the whole change. */"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":27,"text":"export function isPureRelocation(file: {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":28,"text":"  kind: string;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":29,"text":"  added: number;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":30,"text":"  removed: number;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":31,"text":"  relocation?: Relocation;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":32,"text":"}): boolean {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":33,"text":"  return file.kind === \"text\" && file.relocation !== undefined && file.added === 0 && file.removed === 0;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":34,"text":"}"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":35,"text":""},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":36,"text":"export type MovedMark = {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":37,"text":"  side: \"old\" | \"new\";"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":38,"text":"  line: number;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":39,"text":"  peerPath: string;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":40,"text":"  peerLine: number;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":41,"text":"};"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":42,"text":""},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":43,"text":"/** First line of each contiguous moved block. */"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":44,"text":"export function movedMarks(hunks: readonly { lines: readonly DiffLine[] }[]): MovedMark[] {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":45,"text":"  const marks: MovedMark[] = [];"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":46,"text":"  let prev: MovedMark | undefined;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":47,"text":"  for (const hunk of hunks) {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":48,"text":"    for (const line of hunk.lines) {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":49,"text":"      if (line.moved === undefined || (line.kind !== \"add\" && line.kind !== \"del\")) {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":50,"text":"        prev = undefined;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":51,"text":"        continue;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":52,"text":"      }"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":53,"text":"      const side = line.kind === \"add\" ? \"new\" : \"old\";"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":54,"text":"      const lineNo = side === \"new\" ? line.newNumber : line.oldNumber;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":55,"text":"      if (lineNo === null) {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":56,"text":"        prev = undefined;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":57,"text":"        continue;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":58,"text":"      }"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":59,"text":"      const continues ="},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":60,"text":"        prev !== undefined &&"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":61,"text":"        prev.side === side &&"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":62,"text":"        prev.peerPath === line.moved.path &&"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":63,"text":"        lineNo === prev.line + 1 &&"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":64,"text":"        line.moved.line === prev.peerLine + 1;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":65,"text":"      const mark: MovedMark = { side, line: lineNo, peerPath: line.moved.path, peerLine: line.moved.line };"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":66,"text":"      if (!continues) {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":67,"text":"        marks.push(mark);"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":68,"text":"      }"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":69,"text":"      prev = mark;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":70,"text":"    }"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":71,"text":"  }"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":72,"text":"  return marks;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":73,"text":"}"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":74,"text":""},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":75,"text":"export function movedMarkLabel(filePath: string, mark: MovedMark): string {"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":76,"text":"  const where = mark.peerPath === filePath ? `line ${mark.peerLine}` : `${mark.peerPath}:${mark.peerLine}`;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":77,"text":"  return mark.side === \"new\" ? `from ${where}` : `to ${where}`;"},{"sha":"905f33c81c96a57d247e15d174f374ad0f994525","author":"Cursor Agent","timestamp":1790140935,"line":78,"text":"}"}]}
