"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":219,"text":"    selection.kind === REVIEW_BUCKETS.unassigned ||"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":220,"text":"    selection.kind === REVIEW_BUCKETS.lockfiles"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":221,"text":"  ) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":222,"text":"    return;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":223,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":224,"text":"  const parts = groupParts(meta.groups);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":225,"text":"  if (!isMixedReview(parts)) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":226,"text":"    return;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":227,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":228,"text":"  const current ="},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":229,"text":"    selection.kind === \"group\""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":230,"text":"      ? parts.findIndex((part) => part.groupIds.includes(selection.id))"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":231,"text":"      : delta > 0"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":232,"text":"        ? -1"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":233,"text":"        : parts.length;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":234,"text":"  if (selection.kind === \"group\" && current < 0) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":235,"text":"    return;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":236,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":237,"text":"  const next = parts[(current + delta + parts.length) % parts.length];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":238,"text":"  const id = next?.groupIds[0];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":239,"text":"  if (id !== undefined && (selection.kind !== \"group\" || id !== selection.id)) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":240,"text":"    setSelection({ kind: \"group\", id });"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":241,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":242,"text":"}"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":243,"text":""},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":244,"text":"export function sameSelection(a: Selection, b: Selection | null): boolean {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":245,"text":"  if (b === null) {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":246,"text":"    return false;"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":247,"text":"  }"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":248,"text":"  if (a.kind === \"group\") {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":249,"text":"    return b.kind === \"group\" && b.id === a.id;"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":250,"text":"  }"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":251,"text":"  return a.kind === b.kind;"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":252,"text":"}"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":253,"text":""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":254,"text":"export function selectionNavLabel(meta: SelectionCaptionMeta, selection: Selection): string {"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":255,"text":"  const caption = selectionCaption(meta, selection);"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":256,"text":"  return caption.index !== undefined ? `${caption.index} ${caption.title}` : caption.title;"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":257,"text":"}"},{"sha":"e8f9455cedd00c1d9849edece23a810faeb25d51","author":"Cursor Agent","timestamp":1789285243,"line":258,"text":""},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":259,"text":"export function selectionCaption("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":260,"text":"  meta: SelectionCaptionMeta,"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":261,"text":"  selection: Selection | null,"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":262,"text":"): { index?: string; title: string } {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":263,"text":"  if (selection === null || selection.kind === \"overview\") {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":264,"text":"    return { title: \"Overview\" };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":265,"text":"  }"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":266,"text":"  if (selection.kind === \"group\") {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":267,"text":"    const parts = groupParts(meta.groups);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":268,"text":"    const index = groupOrderIndex(parts, selection.id);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":269,"text":"    const group = meta.groups.find((item) => item.id === selection.id);"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":270,"text":"    return {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":271,"text":"      index: index > 0 ? padIndex(index) : undefined,"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":272,"text":"      title: group?.title ?? \"Group\","},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":273,"text":"    };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":274,"text":"  }"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":275,"text":"  if (selection.kind === \"changes\") {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":276,"text":"    return { title: \"What changed\" };"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":277,"text":"  }"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":278,"text":"  if (selection.kind === REVIEW_BUCKETS.unassigned) {"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":279,"text":"    return { title: \"Unassigned\" };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":280,"text":"  }"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":281,"text":"  return { title: \"Lockfiles\" };"},{"sha":"75c9b51c279610d6940509e54678c11276ca7431","author":"Cursor Agent","timestamp":1788721409,"line":282,"text":"}"}]}
