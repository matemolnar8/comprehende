stamp":1792651383,"line":13,"text":"  changes?: object;"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":14,"text":"  unassigned: { hunkCount: number };"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":15,"text":"  lockfiles?: { fileCount: number };"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":16,"text":"};"},{"sha":"80cb3feae5f6ecde8489a68774c9e759e539be2d","author":"matemolnar8","timestamp":1787000184,"line":17,"text":""},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":18,"text":"export type PartShiftSource = {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":19,"text":"  groups: PartGroup[];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":20,"text":"};"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":21,"text":""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":22,"text":"// Only the group id and title feed the selection caption, so tests can pass a"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":23,"text":"// minimal meta instead of a full review."},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":24,"text":"export type SelectionCaptionMeta = {"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":25,"text":"  document: { title: string };"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":26,"text":"  groups: readonly { id: string; title: string }[];"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":27,"text":"};"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":28,"text":""},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":29,"text":"export function defaultSelection(source: SelectionStackSource): Selection {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":30,"text":"  if (source.groups.length > 0) {"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":31,"text":"    return { kind: \"overview\" };"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":32,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":33,"text":"  return { kind: REVIEW_BUCKETS.unassigned };"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":34,"text":"}"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":35,"text":""},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":36,"text":"const GROUP_HASH_PREFIX = \"group/\";"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":37,"text":""},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":38,"text":"export function parseHash(hash: string): Selection | null {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":39,"text":"  const trimmed = hash.startsWith(\"#\") ? hash.slice(1) : hash;"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":40,"text":"  const path = trimmed.replace(/^\\/+/, \"\");"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":41,"text":"  if (path === \"\") {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":42,"text":"    return null;"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":43,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":44,"text":"  if (path === \"overview\") {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":45,"text":"    return { kind: \"overview\" };"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":46,"text":"  }"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":47,"text":"  if (path === \"changes\") {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":48,"text":"    return { kind: \"changes\" };"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":49,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":50,"text":"  if (path === REVIEW_BUCKETS.unassigned) {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":51,"text":"    return { kind: REVIEW_BUCKETS.unassigned };"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":52,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":53,"text":"  if (path === REVIEW_BUCKETS.lockfiles) {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":54,"text":"    return { kind: REVIEW_BUCKETS.lockfiles };"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":55,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":56,"text":"  if (!path.startsWith(GROUP_HASH_PREFIX)) {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":57,"text":"    return null;"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":58,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":59,"text":"  const rawId = path.slice(GROUP_HASH_PREFIX.length);"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":60,"text":"  if (rawId === \"\") {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":61,"text":"    return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":62,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":63,"text":"  try {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":64,"text":"    const id = decodeURIComponent(rawId);"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":65,"text":"    if (id === \"\") {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":66,"text":"      return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":67,"text":"    }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":68,"text":"    return { kind: \"group\", id };"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":69,"text":"  } catch {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":70,"text":"    return null;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":71,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":72,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":73,"text":""},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":74,"text":"export function serializeHash(selection: Selection): string {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":75,"text":"  if (selection.kind === \"group\") {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":76,"text":"    return `#${GROUP_HASH_PREFIX}${encodeURIComponent(selection.id)}`;"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":77,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":78,"text":"  return `#${selection.kind}`;"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":79,"text":"}"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":80,"text":""},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":81,"text":"export function selectionFromHash(source: SelectionStackSource, hash: string): Selection {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":82,"text":"  return restoreSelection(source, parseHash(hash));"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":83,"text":"}"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":84,"text":""},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":85,"text":"export function urlWithSelection(href: string, selection: Selection): string {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":86,"text":"  const url = new URL(href);"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":87,"text":"  url.hash = serializeHash(selection);"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":88,"text":"  return url.href;"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":89,"text":"}"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":90,"text":""},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":91,"text":"export function hashWriteMode("},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":92,"text":"  source: SelectionStackSource,"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":93,"text":"  currentHash: string,"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":94,"text":"  selection: Selection,"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":95,"text":"  initialized: boolean,"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":96,"text":"): \"skip\" | \"replace\" | \"push\" {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":97,"text":"  const parsed = parseHash(currentHash);"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":98,"text":"  if (parsed !== null && sameSelection(parsed, selection)) {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":99,"text":"    return \"skip\";"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":100,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":101,"text":"  const parsedIsLive = parsed !== null && sameSelection(restoreSelection(source, parsed), parsed);"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":102,"text":"  if (!initialized || !parsedIsLive) {"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":103,"text":"    return \"replace\";"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":104,"text":"  }"},{"sha":"975dd4ec32ab0bb3bfd68cc753683e2cefa04430","author":"Cursor Agent","timestamp":1789295672,"line":105,"text":"  return \"push\";"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":106,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":107,"text":""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":108,"text":"export function restoreSelection("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":109,"text":"  source: SelectionStackSource,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":110,"text":"  stored: Selection | null,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":111,"text":"): Selection {"},{"sha":"b5e2c3e0733d804aee4f4adf06766621138e3c78","author":"Máté Molnár","timestamp":1788535976,"line":112,"text":"  // Invariant: unknown or missing buckets fall back to the default selection."},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":113,"text":"  if (stored === null) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":114,"text":"    return defaultSelection(source);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":115,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":116,"text":"  if (stored.kind === \"group\" && !source.groups.some((group) => group.id === stored.id)) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":117,"text":"    return defaultSelection(source);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":118,"text":"  }"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":119,"text":"  if (stored.kind === \"changes\" && source.changes === undefined) {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":120,"text":"    return defaultSelection(source);"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":121,"text":"  }"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":122,"text":"  if ("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":123,"text":"    stored.kind === REVIEW_BUCKETS.unassigned &&"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":124,"text":"    source.unassigned.hunkCount === 0 &&"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":125,"text":"    source.groups.length > 0"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":126,"text":"  ) {"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":127,"text":"    return defaultSelection(source);"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":128,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":129,"text":"  if (stored.kind === REVIEW_BUCKETS.lockfiles && (source.lockfiles?.fileCount ?? 0) === 0) {"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":130,"text":"    return defaultSelection(source);"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":131,"text":"  }"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":132,"text":"  return stored;"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":133,"text":"}"},{"sha":"6030a8c71d74e1ead1c935b6773a93d2637596ee","author":"matemolnar8","timestamp":1787000897,"line":134,"text":""},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":135,"text":"/** Overview, then groups in part / dependsOn order. Unassigned and lockfiles stay off this walk. */"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":136,"text":"export function groupWalk(source: SelectionStackSource): Selection[] {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Curs