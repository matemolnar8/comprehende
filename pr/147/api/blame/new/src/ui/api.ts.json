Agent","timestamp":1786673228,"line":14,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":15,"text":"// UI LiveHunk is ApiHunk (adds language, omits patch), not schema LiveHunk (adds patch, omits language)."},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":16,"text":"export type { ApiHunk as LiveHunk, ApiGroupFile, FileKind, FileStatus };"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":17,"text":""},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":18,"text":"/** The review payload with its document's hunk refs parsed. */"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":19,"text":"export type ReviewMeta = Omit<ApiReview, \"document\"> & { document: ReviewDocument };"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":20,"text":"export { shortSha } from \"../schema/types.ts\";"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":21,"text":""},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":22,"text":"export function resourceHref(resource: ApiResource): string {"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":23,"text":"  return new URL(apiHref(resource), new URL(\"./\", document.baseURI)).href;"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":24,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":25,"text":""},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":26,"text":"async function getJson<T>(resource: ApiResource): Promise<T> {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":27,"text":"  const path = resourceHref(resource);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":28,"text":"  const response = await fetch(path);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":29,"text":"  const text = await response.text();"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":30,"text":"  if (!response.ok) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":31,"text":"    let message = text;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":32,"text":"    try {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":33,"text":"      const parsed: unknown = JSON.parse(text);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":34,"text":"      if (isRecord(parsed) && typeof parsed.error === \"string\") {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":35,"text":"        message = parsed.error;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":36,"text":"      }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":37,"text":"    } catch {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":38,"text":"      // keep raw text"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":39,"text":"    }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":40,"text":"    throw new Error(message);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":41,"text":"  }"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":42,"text":"  const data: unknown = JSON.parse(text);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":43,"text":"  return data as T;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":44,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":45,"text":""},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":46,"text":"export async function fetchReview(): Promise<ReviewMeta> {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":47,"text":"  const review = await getJson<ApiReview>({ kind: \"review\" });"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":48,"text":"  return {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":49,"text":"    ...review,"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":50,"text":"    document: {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":51,"text":"      ...review.document,"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":52,"text":"      groups: review.document.groups.map((group) => ({"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":53,"text":"        ...group,"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":54,"text":"        hunkRefs: group.hunkRefs.map(parseStoredHunkRef),"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":55,"text":"      })),"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":56,"text":"    },"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":57,"text":"  };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":58,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":59,"text":""},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":60,"text":"export function fetchHunks(group: string): Promise<ApiHunks> {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":61,"text":"  return getJson<ApiHunks>({ kind: \"hunks\", group });"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":62,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":63,"text":""},{"sha":"e9b20d5d583fc4d220337a9ff22e1e6bcf6373e7","author":"Cursor Agent","timestamp":1787413230,"line":64,"text":"export function fetchPatch(path: string): Promise<ApiGroupFile> {"},{"sha":"e9b20d5d583fc4d220337a9ff22e1e6bcf6373e7","author":"Cursor Agent","timestamp":1787413230,"line":65,"text":"  return getJson<ApiGroupFile>({ kind: \"patch\", path });"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":66,"text":"}"},{"sha":"d1cf5ba568f77bae16c1091079d400996eac3fe9","author":"Cursor Agent","timestamp":1787254525,"line":67,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":68,"text":"export function fetchFile(path: string, side: FileSide): Promise<ApiFile> {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":69,"text":"  return getJson<ApiFile>({ kind: \"file\", path, side });"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":70,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":71,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":72,"text":"export function fetchBlame(path: string, side: FileSide): Promise<ApiBlame> {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":73,"text":"  return getJson<ApiBlame>({ kind: \"blame\", path, side });"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":74,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":75,"text":""},{"sha":"e9b20d5d583fc4d220337a9ff22e1e6bcf6373e7","author":"Cursor Agent","timestamp":1787413230,"line":76,"text":"export function groupIndex(groups: { id: string }[], id: string): number {"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":77,"text":"  return groups.findIndex((group) => group.id === id) + 1;"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":78,"text":"}"},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":79,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":80,"text":"function isRecord(value: unknown): value is Record<string, unknown> {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":81,"text":"  return typeof value === \"object\" && value !== null && !Array.isArray(value);"},{"sha":"a04632dfdabd0dee2bbd73550b82188d290f11a3","author":"matemolnar8","timestamp":1786729597,"line":82,"text":"}"}]}
