ha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":54,"text":"      if (isUnavailableSnapshot(error)) {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":55,"text":"        continue;"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":56,"text":"      }"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":57,"text":"      throw error;"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":58,"text":"    }"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":59,"text":"    const rel = apiFsRel(resource);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":60,"text":"    const abs = join(outDir, ...rel.split(\"/\"));"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":61,"text":"    await mkdir(dirname(abs), { recursive: true });"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":62,"text":"    if (body.encoding === \"json\") {"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":63,"text":"      await writeFile(abs, snapshotJson(body.body));"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":64,"text":"    } else {"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":65,"text":"      await writeFile(abs, Buffer.from(body.body));"},{"sha":"11a02aab6c7232775b74d6856e8d87d7742d3b6c","author":"Cursor Agent","timestamp":1787081813,"line":66,"text":"    }"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":67,"text":"    apiFiles.push(rel);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":68,"text":"  }"},{"sha":"3baf4513f82964e72dd155b5acd42120350a7539","author":"Cursor Agent","timestamp":1788235031,"line":69,"text":"  await pruneUnusedHighlighterChunks(outDir, highlightPathsFromFiles(ctx.files));"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":70,"text":"  return { outDir, apiFiles };"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":71,"text":"}"}]}
