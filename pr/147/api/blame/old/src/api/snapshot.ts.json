2024","author":"Cursor Agent","timestamp":1787035272,"line":28,"text":"};"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":29,"text":""},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":30,"text":"export async function exportStaticSite(opts: ExportOptions): Promise<ExportResult> {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":31,"text":"  const outDir = resolve(opts.outDir);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":32,"text":"  const uiRoot = opts.uiRoot ?? join(findPackageRoot(), \"dist/ui\");"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":33,"text":"  if (!existsSync(uiRoot)) {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":34,"text":"    throw new Error("},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":35,"text":"      \"UI is missing from this install. Reinstall comprehende from npm, or from a git checkout run `pnpm build`.\","},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":36,"text":"    );"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":37,"text":"  }"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":38,"text":"  if (existsSync(join(outDir, \".git\"))) {"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":39,"text":"    throw new Error(`refusing to write export into a git repository: ${outDir}`);"},{"sha":"af78242f250d3c3499db381b21d0053d2b712024","author":"Cursor Agent","timestamp":1787035272,"line":40,"text":"  }"},{"sha":"af78242f2