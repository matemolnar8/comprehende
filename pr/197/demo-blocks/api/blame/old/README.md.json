{"path":"README.md","ref":"58e78d97ae799b828addec2375c1bce324dc7628","side":"old","lines":[{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":1,"text":"<p align=\"center\"><img src=\"docs/logo.png\" alt=\"Relay logo\" width=\"96\"></p>"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":2,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":3,"text":"# Relay"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":4,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":5,"text":"Relay moves jobs from a queue to workers. It retries a failed job three times, then parks it."},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":6,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":7,"text":"<details>"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":8,"text":"<summary>Why not a cron job?</summary>"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":9,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":10,"text":"A cron job cannot see that a worker died. Relay does, and gives the job to another worker."},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":11,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":12,"text":"</details>"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":13,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":14,"text":"## Install"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":15,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":16,"text":"```sh"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":17,"text":"npm install relay"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":18,"text":"```"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":19,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":20,"text":"## Use"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":21,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":22,"text":"Create a queue, then start a worker. Press <kbd>Ctrl</kbd>+<kbd>C</kbd> to stop it."},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":23,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":24,"text":"```ts"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":25,"text":"import { createQueue } from \"relay\";"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":26,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":27,"text":"const queue = createQueue({"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":28,"text":"  name: \"mail\","},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":29,"text":"  retries: 3,"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":30,"text":"  backoff: \"fixed\","},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":31,"text":"});"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":32,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":33,"text":"queue.add({ to: \"team@example.com\" });"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":34,"text":"```"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":35,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":36,"text":"The config file is JSON:"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":37,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":38,"text":"```json"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":39,"text":"{ \"workers\": 4, \"park\": true }"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":40,"text":"```"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":41,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":42,"text":"![Architecture](docs/arch.png)"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":43,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":44,"text":"See the [API notes](docs/api.md), the [install steps](#install) and the [changelog](https://example.com/changelog)."},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":45,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":46,"text":"<!-- keep this list short -->"},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":47,"text":""},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":48,"text":"- Jobs run at least once."},{"sha":"58e78d97ae799b828addec2375c1bce324dc7628","author":"Fixture","timestamp":1794374652,"summary":"base","line":49,"text":"- A parked job waits for a person."}]}
