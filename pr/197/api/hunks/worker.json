event: MessageEvent<MarkdownReply>) => {\n+    waiting.get(event.data.id)?.(event.data.rows);\n+    waiting.delete(event.data.id);\n+  });\n+  // The worker did not load, or it stopped. No answer will come for the jobs it holds.\n+  started.addEventListener(\"error\", (event) => {\n+    console.error(event);\n+    started.terminate();\n+    worker = undefined;\n+    settleAll();\n+  });\n+  return started;\n+}\n","complete":true,"hunks":[{"path":"src/ui/lib/markdown-rows.ts","oldStart":0,"oldLines":0,"newStart":1,"newLines":50,"header":"@@ -0,0 +1,50 @@","language":"typescript","lines":[{"kind":"add","oldNumber":null,"newNumber":1,"text":"import type { MdRow } from \"./markdown-diff.ts\";"},{"kind":"add","oldNumber":null,"newNumber":2,"text":"import MarkdownWorker from \"./markdown.worker.ts?worker\";"},{"kind":"add","oldNumber":null,"newNumber":3,"text":"import type { MarkdownJob, MarkdownReply, MarkdownRequest } from \"./markdown.worker.ts\";"},{"kind":"add","oldNumber":null,"newNumber":4,"text":""},{"kind":"add","oldNumber":null,"newNumber":5,"text":"let worker: Worker | undefined;"},{"kind":"add","oldNumber":null,"newNumber":6,"text":"let nextId = 0;"},{"kind":"add","oldNumber":null,"newNumber":7,"text":"const waiting = new Map<number, (rows: MdRow[] | null) => void>();"},{"kind":"add","oldNumber":null,"newNumber":8,"text":""},{"kind":"add","oldNumber":null,"newNumber":9,"text":"function settleAll(): void {"},{"kind":"add","oldNumber":null,"newNumber":10,"text":"  for (const settle of waiting.values()) {"},{"kind":"add","oldNumber":null,"newNumber":11,"text":"    settle(null);"},{"kind":"add","oldNumber":null,"newNumber":12,"text":"  }"},{"kind":"add","oldNumber":null,"newNumber":13,"text":"  waiting.clear();"},{"kind":"add","oldNumber":null,"newNumber":14,"text":"}"},{"kind":"add","oldNumber":null,"newNumber":15,"text":""},{"kind":"add","oldNumber":null,"newNumber":16,"text":"/**"},{"kind":"add","oldNumber":null,"newNumber":17,"text":" * Reads Markdown into row