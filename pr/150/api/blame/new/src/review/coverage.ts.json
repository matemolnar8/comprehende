 files: Awaited<ReturnType<typeof readDiff>>; coverage: ReviewCoverage }> {"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":43,"text":"  const range = pin ?? (await pinRange(cwd, document.source.baseRef, document.source.headRef));"},{"sha":"52381446ccaf265004ad5e5074949ef8b1f9c3f3","author":"Cursor Agent","timestamp":1787518251,"line":44,"text":"  const files = await readDiff(cwd, range.baseSha, range.headSha);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":45,"text":"  const live = flattenHunks(files);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":46,"text":"  return { files, coverage: joinCoverage(document, live) };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":47,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":48,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":49,"text":"export function joinCoverage(document: ReviewDocument, live: LiveHunk[]): ReviewCoverage {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":50,"text":"  const liveByKey = new Map<string, LiveHunk>();"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":51,"text":"  const liveByPath = new Map<string, LiveHunk[]>();"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":52,"text":"  for (const hunk of live) {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":53,"text":"    const key = hunkKey(hunk);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":54,"text":"    liveByKey.set(key, hunk);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":55,"text":"    const atPath = liveByPath.get(hunk.path);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":56,"text":"    if (atPath === undefined) {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":57,"text":"      liveByPath.set(hunk.path, [hunk]);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":58,"text":"    } else {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":59,"text":"      atPath.push(hunk);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":60,"text":"    }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":61,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":62,"text":""},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":63,"text":"  const dirOf = dirOwners(document, live, liveByKey, liveByPath);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":64,"text":"  const assignedKeys = new Set<string>();"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":65,"text":"  const allStale: ReviewHunkRef[] = [];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":66,"text":"  const groups: GroupCoverage[] = document.groups.map((group) => {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":67,"text":"    const hunks: LiveHunk[] = [];"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":68,"text":"    const dirHunks: LiveHunk[] = [];"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":69,"text":"    const seen = new Set<string>();"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":70,"text":"    const stale: ReviewHunkRef[] = [];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":71,"text":"    for (const ref of group.hunkRefs) {"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":72,"text":"      if (!isDirHunkRef(ref) && isLockfilePath(ref.path)) {"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":73,"text":"        continue;"},{"sha":"8264d5c85250ee113b709a137522b98486b96056","author":"Cursor Agent","timestamp":1787255475,"line":74,"text":"      }"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":75,"text":"      const matches = isDirHunkRef(ref)"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":76,"text":"        ? live.filter((hunk) => dirOf.get(hunkKey(hunk)) === ref.dir)"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":77,"text":"        : refMatches(ref, liveByKey, liveByPath);"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":78,"text":"      if (isDirHunkRef(ref)) {"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":79,"text":"        dirHunks.push(...matches);"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":80,"text":"      }"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":81,"text":"      if (matches.length === 0) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":82,"text":"        stale.push(ref);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":83,"text":"        allStale.push(ref);"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":84,"text":"        continue;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":85,"text":"      }"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":86,"text":"      for (const match of matches) {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":87,"text":"        const key = hunkKey(match);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":88,"text":"        assignedKeys.add(key);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":89,"text":"        if (seen.has(key)) {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":90,"text":"          continue;"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":91,"text":"        }"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":92,"text":"        seen.add(key);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":93,"text":"        hunks.push(match);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":94,"text":"      }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":95,"text":"    }"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":96,"text":"    return { group, hunks, dirHunks, stale };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":97,"text":"  });"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":98,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":99,"text":"  const unassigned = live.filter((hunk) => {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":100,"text":"    const key = hunkKey(hunk);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":101,"text":"    return !assignedKeys.has(key);"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":102,"text":"  });"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":103,"text":"  return {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":104,"text":"    groups,"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":105,"text":"    unassigned,"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":106,"text":"    stale: allStale,"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":107,"text":"    totalHunks: live.length,"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":108,"text":"    assignedHunks: assignedKeys.size,"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":109,"text":"  };"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":110,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":111,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":112,"text":"export function coverageErrors(coverage: ReviewCoverage): string[] {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":113,"text":"  const errors: string[] = [];"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":114,"text":"  if (coverage.unassigned.length > 0) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":115,"text":"    errors.push("},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":116,"text":"      `coverage: ${coverage.unassigned.length} hunk(s) are not referenced by any group:\\n${formatRefs("},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":117,"text":"        coverage.unassigned.map(toHunkRef),"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":118,"text":"      )}`,"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":119,"text":"    );"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":120,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":121,"text":"  if (coverage.stale.length > 0) {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":122,"text":"    errors.push("},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":123,"text":"      `stale: ${coverage.stale.length} ref(s) do not match the live git diff:\\n${formatRefs(coverage.stale)}`,"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":124,"text":"    );"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":125,"text":"  }"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":126,"text":"  return errors;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":127,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":128,"text":""},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":129,"text":"function refMatches("},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":130,"text":"  ref: FileHunkRef | LocatedHunkRef,"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":131,"text":"  liveByKey: Map<string, LiveHunk>,"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":132,"text":"  liveByPath: Map<string, LiveHunk[]>,"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":133,"text":"): LiveHunk[] {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":134,"text":"  if (!isLocatedHunkRef(ref)) {"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":135,"text":"    return liveByPath.get(ref.path) ?? [];"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":136,"text":"  }"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":137,"text":"  const match = liveByKey.get(hunkKey(ref));"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":138,"text":"  return match === undefined ? [] : [match];"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":139,"text":"}"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":140,"text":""},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":141,"text":"/**"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":142,"text":" * The most specific ref wins: a directory ref holds a hunk only when no path or hunk ref in any"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":143,"text":" * group names it, and then only the deepest directory ref above it does. Keys are hunk keys."},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":144,"text":" */"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":145,"text":"function dirOwners("},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":146,"text":"  document: ReviewDocument,"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":147,"text":"  live: LiveHunk[],"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":148,"text":"  liveByKey: Map<string, LiveHunk>,"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":149,"text":"  liveByPath: Map<string, LiveHunk[]>,"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":150,"text":"): Map<string, string> {"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":151,"text":"  const named = new Set<string>();"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":152,"text":"  const dirs: string[] = [];"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":153,"text":"  for (const ref of document.groups.flatMap((group) => group.hunkRefs)) {"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":154,"text":"    if (isDirHunkRef(ref)) {"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":155,"text":"      dirs.push(ref.dir);"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":156,"text":"      continue;"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":157,"text":"    }"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":158,"text":"    for (const hunk of refMatches(ref, liveByKey, liveByPath)) {"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":159,"text":"      named.add(hunkKey(hunk));"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":160,"text":"    }"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":161,"text":"  }"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":162,"text":"  const owners = new Map<string, string>();"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":163,"text":"  if (dirs.length === 0) {"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":164,"text":"    return owners;"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":165,"text":"  }"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":166,"text":"  for (const hunk of live) {"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":167,"text":"    const key = hunkKey(hunk);"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":168,"text":"    if (named.has(key) || isLockfilePath(hunk.path)) {"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":169,"text":"      continue;"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":170,"text":"    }"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":171,"text":"    const deepest = dirs"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":172,"text":"      .filter((dir) => refCoversPath({ dir }, hunk.path))"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":173,"text":"      .reduce<string | undefined>("},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":174,"text":"        (best, dir) => (best === undefined || dir.length > best.length ? dir : best),"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":175,"text":"        undefined,"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":176,"text":"      );"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":177,"text":"    if (deepest !== undefined) {"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":178,"text":"      owners.set(key, deepest);"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":179,"text":"    }"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":180,"text":"  }"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":181,"text":"  return owners;"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":182,"text":"}"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":183,"text":""},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":184,"text":"/**"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":185,"text":" * A directory ref stands for mechanical files only. Each other file under it needs a path ref"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":186,"text":" * in the group of its concern, which takes it out of the directory ref."},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":187,"text":" */"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":188,"text":"export function dirRefErrors(coverage: ReviewCoverage, files: DiffFile[]): string[] {"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":189,"text":"  const kinds = new Map(buildDigest(files).files.map((file) => [file.path, file.kind]));"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":190,"text":"  const errors: string[] = [];"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":191,"text":"  for (const { group, dirHunks } of coverage.groups) {"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":192,"text":"    const paths = ["},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":193,"text":"      ...new Set("},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":194,"text":"        dirHunks"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":195,"text":"          .map((hunk) => hunk.path)"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":196,"text":"          .filter((path) => {"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":197,"text":"            const kind = kinds.get(path);"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":198,"text":"            return kind !== undefined && !isMechanicalKind(kind);"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":199,"text":"          }),"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":200,"text":"      ),"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":201,"text":"    ];"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":202,"text":"    if (paths.length > 0) {"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":203,"text":"      errors.push("},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":204,"text":"        `dir ref: group ${group.id} holds files that are not mechanical through a directory ref. Name each path in the group of its concern:\\n${paths.map((path) => `  ${path}`).join(\"\\n\")}`,"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":205,"text":"      );"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":206,"text":"    }"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":207,"text":"  }"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":208,"text":"  return errors;"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":209,"text":"}"},{"sha":"885f5d551634c9c40408bdb65f7fbd58a5b29134","author":"Máté Molnár","timestamp":1792664421,"line":210,"text":""},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":211,"text":"function formatRefs(refs: ReviewHunkRef[]): string {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":212,"text":"  return refs.map((ref) => `  ${formatStoredHunkRef(ref)}`).join(\"\\n\");"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":213,"text":"}"}]}
