{"path":"src/schema/identity.ts","ref":"046cae0b9eba180c36d3e474dd24e1d9aff78852","side":"new","lines":[{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":1,"text":"const COMPACT_SUFFIX = /@(\\d+)\\+(\\d+)$/;"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":2,"text":"const RENAME_MARK = \" -> \";"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":3,"text":""},{"sha":"d1b750af867843425e6cf5733667a60ee32b20f6","author":"Cursor Agent","timestamp":1790112075,"line":4,"text":"/** Live git hunk. Identity is `(path, oldStart, newStart)`, plus `oldPath` when renamed. */"},{"sha":"d1b750af867843425e6cf5733667a60ee32b20f6","author":"Cursor Agent","timestamp":1790112075,"line":5,"text":"export type HunkRef = {"},{"sha":"d1b750af867843425e6cf5733667a60ee32b20f6","author":"Cursor Agent","timestamp":1790112075,"line":6,"text":"  path: string;"},{"sha":"d1b750af867843425e6cf5733667a60ee32b20f6","author":"Cursor Agent","timestamp":1790112075,"line":7,"text":"  oldPath?: string;"},{"sha":"d1b750af867843425e6cf5733667a60ee32b20f6","author":"Cursor Agent","timestamp":1790112075,"line":8,"text":"  oldStart: number;"},{"sha":"d1b750af867843425e6cf5733667a60ee32b20f6","author":"Cursor Agent","timestamp":1790112075,"line":9,"text":"  oldLines: number;"},{"sha":"d1b750af867843425e6cf5733667a60ee32b20f6","author":"Cursor Agent","timestamp":1790112075,"line":10,"text":"  newStart: number;"},{"sha":"d1b750af867843425e6cf5733667a60ee32b20f6","author":"Cursor Agent","timestamp":1790112075,"line":11,"text":"  newLines: number;"},{"sha":"d1b750af867843425e6cf5733667a60ee32b20f6","author":"Cursor Agent","timestamp":1790112075,"line":12,"text":"};"},{"sha":"d1b750af867843425e6cf5733667a60ee32b20f6","author":"Cursor Agent","timestamp":1790112075,"line":13,"text":""},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":14,"text":"/** Every live hunk of `path`. */"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":15,"text":"export type FileHunkRef = {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":16,"text":"  path: string;"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":17,"text":"};"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":18,"text":""},{"sha":"d1b750af867843425e6cf5733667a60ee32b20f6","author":"Cursor Agent","timestamp":1790112075,"line":19,"text":"/** One hunk, written as `path@oldStart+newStart`. */"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":20,"text":"export type LocatedHunkRef = {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":21,"text":"  path: string;"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":22,"text":"  oldPath?: string;"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":23,"text":"  oldStart: number;"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":24,"text":"  newStart: number;"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":25,"text":"};"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":26,"text":""},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":27,"text":"/** Every live hunk under `dir`, written as a path ending in `/`. */"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":28,"text":"export type DirHunkRef = {"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":29,"text":"  dir: string;"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":30,"text":"};"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":31,"text":""},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":32,"text":"export type ReviewHunkRef = FileHunkRef | LocatedHunkRef | DirHunkRef;"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":33,"text":""},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":34,"text":"export type ParsedHunkString ="},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":35,"text":"  | { kind: \"file\"; path: string }"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":36,"text":"  | { kind: \"dir\"; dir: string }"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":37,"text":"  | { kind: \"hunk\"; path: string; oldPath?: string; oldStart: number; newStart: number };"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":38,"text":""},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":39,"text":"export function isLocatedHunkRef(ref: ReviewHunkRef): ref is LocatedHunkRef {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":40,"text":"  return \"oldStart\" in ref;"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":41,"text":"}"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":42,"text":""},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":43,"text":"export function isDirHunkRef(ref: ReviewHunkRef): ref is DirHunkRef {"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":44,"text":"  return \"dir\" in ref;"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":45,"text":"}"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":46,"text":""},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":47,"text":"/** Whether `ref` covers hunks at `path`. A hunk ref covers its path and its old path. */"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":48,"text":"export function refCoversPath(ref: ReviewHunkRef, path: string): boolean {"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":49,"text":"  if (isDirHunkRef(ref)) {"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":50,"text":"    return path.startsWith(ref.dir);"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":51,"text":"  }"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":52,"text":"  return ref.path === path || (isLocatedHunkRef(ref) && ref.oldPath === path);"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":53,"text":"}"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":54,"text":""},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":55,"text":"/**"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":56,"text":" * The groups that hold `path`: a path or hunk ref in any group beats a directory ref, and the"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":57,"text":" * deepest directory ref beats a shallower one."},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":58,"text":" */"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":59,"text":"export function groupsHoldingPath<Group extends { hunkRefs: readonly ReviewHunkRef[] }>("},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":60,"text":"  groups: readonly Group[],"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":61,"text":"  path: string,"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":62,"text":"): Group[] {"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":63,"text":"  const named = groups.filter((group) =>"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":64,"text":"    group.hunkRefs.some((ref) => !isDirHunkRef(ref) && refCoversPath(ref, path)),"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":65,"text":"  );"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":66,"text":"  if (named.length > 0) {"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":67,"text":"    return named;"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":68,"text":"  }"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":69,"text":"  const dirs = groups.flatMap((group) =>"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":70,"text":"    group.hunkRefs.flatMap((ref) =>"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":71,"text":"      isDirHunkRef(ref) && refCoversPath(ref, path) ? [ref.dir] : [],"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":72,"text":"    ),"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":73,"text":"  );"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":74,"text":"  const deepest = dirs.reduce<string | undefined>("},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":75,"text":"    (best, dir) => (best === undefined || dir.length > best.length ? dir : best),"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":76,"text":"    undefined,"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":77,"text":"  );"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":78,"text":"  return deepest === undefined"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":79,"text":"    ? []"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":80,"text":"    : groups.filter((group) =>"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":81,"text":"        group.hunkRefs.some((ref) => isDirHunkRef(ref) && ref.dir === deepest),"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":82,"text":"      );"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":83,"text":"}"},{"sha":"046cae0b9eba180c36d3e474dd24e1d9aff78852","author":"Máté Molnár","timestamp":1792729426,"line":84,"text":""},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":85,"text":"export function hunkKey(ref: Pick<HunkRef, \"path\" | \"oldPath\" | \"oldStart\" | \"newStart\">): string {"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":86,"text":"  const oldPath = ref.oldPath ?? \"\";"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":87,"text":"  return `${oldPath}\\0${ref.path}\\0${ref.oldStart}\\0${ref.newStart}`;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":88,"text":"}"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":89,"text":""},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":90,"text":"export function formatHunkRef(ref: HunkRef): string {"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":91,"text":"  const rename = ref.oldPath !== undefined ? `${ref.oldPath} -> ` : \"\";"},{"sha":"431bbd9d4abbdb444888974b26eb3d5dd75fce33","author":"Máté Molnár","timestamp":1788535715,"line":92,"text":"  return `${rename}${ref.path} @@ -${ref.oldStart},${ref.oldLines} +${ref.newStart},${ref.newLines} @@`;"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":93,"text":"}"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":94,"text":""},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":95,"text":"/** A ref as review.json writes it, read back. Throws on a string the schema would reject. */"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":96,"text":"export function parseStoredHunkRef(value: string): ReviewHunkRef {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":97,"text":"  const parsed = parseHunkRefString(value);"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":98,"text":"  if (parsed === undefined) {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":99,"text":"    throw new Error(`invalid hunk ref string: ${value}`);"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":100,"text":"  }"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":101,"text":"  if (parsed.kind === \"file\") {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":102,"text":"    return { path: parsed.path };"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":103,"text":"  }"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":104,"text":"  if (parsed.kind === \"dir\") {"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":105,"text":"    return { dir: parsed.dir };"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":106,"text":"  }"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":107,"text":"  if (parsed.oldPath === undefined) {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":108,"text":"    return { path: parsed.path, oldStart: parsed.oldStart, newStart: parsed.newStart };"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":109,"text":"  }"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":110,"text":"  return {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":111,"text":"    path: parsed.path,"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":112,"text":"    oldPath: parsed.oldPath,"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":113,"text":"    oldStart: parsed.oldStart,"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":114,"text":"    newStart: parsed.newStart,"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":115,"text":"  };"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":116,"text":"}"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":117,"text":""},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":118,"text":"/** Path string, `dir/`, `path@oldStart+newStart`, or `old -> new@oldStart+newStart`. */"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":119,"text":"export function parseHunkRefString(value: string): ParsedHunkString | undefined {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":120,"text":"  const text = value.trim();"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":121,"text":"  if (text === \"\") {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":122,"text":"    return undefined;"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":123,"text":"  }"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":124,"text":"  const suffix = COMPACT_SUFFIX.exec(text);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":125,"text":"  if (suffix === null) {"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":126,"text":"    if (!text.endsWith(\"/\")) {"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":127,"text":"      return { kind: \"file\", path: text };"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":128,"text":"    }"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":129,"text":"    return text === \"/\" ? undefined : { kind: \"dir\", dir: text };"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":130,"text":"  }"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":131,"text":"  const oldStart = Number(suffix[1]);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":132,"text":"  const newStart = Number(suffix[2]);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":133,"text":"  if (!Number.isSafeInteger(oldStart) || !Number.isSafeInteger(newStart)) {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":134,"text":"    return undefined;"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":135,"text":"  }"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":136,"text":"  const head = text.slice(0, suffix.index);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":137,"text":"  const arrow = head.lastIndexOf(RENAME_MARK);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":138,"text":"  if (arrow === -1) {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":139,"text":"    if (head === \"\") {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":140,"text":"      return undefined;"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":141,"text":"    }"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":142,"text":"    return { kind: \"hunk\", path: head, oldStart, newStart };"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":143,"text":"  }"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":144,"text":"  const oldPath = head.slice(0, arrow);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":145,"text":"  const path = head.slice(arrow + RENAME_MARK.length);"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":146,"text":"  if (oldPath === \"\" || path === \"\") {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":147,"text":"    return undefined;"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":148,"text":"  }"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":149,"text":"  return { kind: \"hunk\", path, oldPath, oldStart, newStart };"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":150,"text":"}"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":151,"text":""},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":152,"text":"export function formatStoredHunkRef(ref: ReviewHunkRef): string {"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":153,"text":"  if (isDirHunkRef(ref)) {"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":154,"text":"    return ref.dir;"},{"sha":"2ad30354754b06177228f35cbe3757e0b0e57bab","author":"Máté Molnár","timestamp":1792661326,"line":155,"text":"  }"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":156,"text":"  if (!isLocatedHunkRef(ref)) {"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":157,"text":"    return ref.path;"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":158,"text":"  }"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":159,"text":"  const rename = ref.oldPath !== undefined ? `${ref.oldPath} -> ` : \"\";"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":160,"text":"  return `${rename}${ref.path}@${ref.oldStart}+${ref.newStart}`;"},{"sha":"9d04c1fada6972361ceeb2f8af6a3646322033e4","author":"Cursor Agent","timestamp":1790107747,"line":161,"text":"}"}]}
