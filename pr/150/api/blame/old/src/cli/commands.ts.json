"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":105,"text":"  const parsed ="},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":106,"text":"    request.hunk === undefined"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":107,"text":"      ? ({ kind: \"file\", path: target } as const)"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":108,"text":"      : parseHunkRefString(target);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":109,"text":"  if (parsed === undefined) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":110,"text":"    throw new Error(`invalid hunk ref: ${target}`);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":111,"text":"  }"},{"sha":"d188fa0f1286a75bbbd55fe30467468bac4e6cb3","author":"Máté Molnár","timestamp":1792609944,"line":112,"text":"  const file = await readPathDiff("},{"sha":"d188fa0f1286a75bbbd55fe30467468bac4e6cb3","author":"Máté Molnár","timestamp":1792609944,"line":113,"text":"    cwd,"},{"sha":"d188fa0f1286a75bbbd55fe30467468bac4e6cb3","author":"Máté Molnár","timestamp":1792609944,"line":114,"text":"    baseRef,"},{"sha":"d188fa0f1286a75bbbd55fe30467468bac4e6cb3","author":"Máté Molnár","timestamp":1792609944,"line":115,"text":"    headRef,"},{"sha":"d188fa0f1286a75bbbd55fe30467468bac4e6cb3","author":"Máté Molnár","timestamp":1792609944,"line":116,"text":"    parsed.path,"},{"sha":"d188fa0f1286a75bbbd55fe30467468bac4e6cb3","author":"Máté Molnár","timestamp":1792609944,"line":117,"text":"    parsed.kind === \"hunk\" ? parsed.oldPath : undefined,"},{"sha":"d188fa0f1286a75bbbd55fe30467468bac4e6cb3","author":"Máté Molnár","timestamp":1792609944,"line":118,"text":"  );"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":119,"text":"  if (file === undefined) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":120,"text":"    throw new Error(`no diff for path: ${parsed.path}`);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":121,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":122,"text":"  if (parsed.kind === \"file\") {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":123,"text":"    return file.patch;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":124,"text":"  }"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":125,"text":"  const hunk = file.hunks.find("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":126,"text":"    (item) => item.oldStart === parsed.oldStart && item.newStart === parsed.newStart,"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":127,"text":"  );"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":128,"text":"  if (hunk === undefined) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":129,"text":"    throw new Error(`no hunk matches: ${target}`);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":130,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":131,"text":"  return filePatchFromGit(file, [hunk]);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":132,"text":"}"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":133,"text":""},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":134,"text":"/**"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":135,"text":" * Draft review.json from deterministic rules: identical-copy clusters,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":136,"text":" * mechanical files (rename, copy, move, generated), and one change group"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":137,"text":" * for the rest. The skill accepts, splits, and writes the prose."},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":138,"text":" */"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":139,"text":"export async function cmdPregroup("},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":140,"text":"  cwd: string,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":141,"text":"  dataPath: string,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":142,"text":"  base: string | undefined,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":143,"text":"  head: string | undefined,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":144,"text":"): Promise<{ document: ReviewDocument; index: HunkIndex }> {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":145,"text":"  const baseRef = base ?? (await defaultBaseRef(cwd));"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":146,"text":"  const headRef = head ?? \"HEAD\";"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":147,"text":"  const { source, baseSha, headSha } = await resolveSource(cwd, baseRef, headRef);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":148,"text":"  const files = await readDiff(cwd, baseSha, headSha);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":149,"text":"  const { files: digests } = buildDigest(files);"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":150,"text":"  const mirrorRoots = new Set("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":151,"text":"    digests"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":152,"text":"      .filter((digest) => digest.mirrorOf !== undefined)"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":153,"text":"      .map((digest) => digest.mirrorOf as string),"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":154,"text":"  );"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":155,"text":"  const mirrors = new Map<string, string[]>();"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":156,"text":"  const mechanical: string[] = [];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":157,"text":"  const change: string[] = [];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":158,"text":"  for (const digest of digests) {"},{"sha":"d188fa0f1286a75bbbd55fe30467468bac4e6cb3","author":"Máté Molnár","timestamp":1792609944,"line":159,"text":"    if (isLockfilePath(digest.path)) {"},{"sha":"d188fa0f1286a75bbbd55fe30467468bac4e6cb3","author":"Máté Molnár","timestamp":1792609944,"line":160,"text":"      continue;"},{"sha":"d188fa0f1286a75bbbd55fe30467468bac4e6cb3","author":"Máté Molnár","timestamp":1792609944,"line":161,"text":"    }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":162,"text":"    const refs = digestHunkRefs(digest);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":163,"text":"    if (digest.mirrorOf !== undefined || mirrorRoots.has(digest.path)) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":164,"text":"      const root = digest.mirrorOf ?? digest.path;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":165,"text":"      const cluster = mirrors.get(root) ?? [];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":166,"text":"      cluster.push(...refs);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":167,"text":"      mirrors.set(root, cluster);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":168,"text":"      continue;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":169,"text":"    }"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":170,"text":"    if ("},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":171,"text":"      digest.kind === \"rename\" ||"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":172,"text":"      digest.kind === \"copy\" ||"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":173,"text":"      digest.kind === \"move\" ||"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":174,"text":"      digest.kind === \"generated\""},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":175,"text":"    ) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":176,"text":"      mechanical.push(...refs);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":177,"text":"      continue;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":178,"text":"    }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":179,"text":"    change.push(...refs);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":180,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":181,"text":"  const index = await readHunkIndex(cwd, baseRef, headRef);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":182,"text":"  const skeleton = skeletonDocument(index);"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":183,"text":"  const groups: {"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":184,"text":"    id: string;"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":185,"text":"    title: string;"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":186,"text":"    why: string;"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":187,"text":"    summary: string;"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":188,"text":"    suggestedOrder: number;"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":189,"text":"    hunkRefs: string[];"},{"sha":"95eead41cd590f8647f927db4e913282779cf179","author":"Máté Molnár","timestamp":1791576459,"line":190,"text":"  }[] = [];"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":191,"text":"  if (change.length > 0 || (mirrors.size === 0 && mechanical.length === 0)) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":192,"text":"    groups.push({"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":193,"text":"      id: \"change\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":194,"text":"      title: \"Change\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":195,"text":"      why: \"Draft: the change minus copies and mechanical files. Split by concern.\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":196,"text":"      summary: \"Fill this group.\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":197,"text":"      suggestedOrder: 0,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":198,"text":"      hunkRefs: change,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":199,"text":"    });"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":200,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":201,"text":"  let order = 1;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":202,"text":"  for (const [root, paths] of mirrors) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":203,"text":"    groups.push({"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":204,"text":"      id: `mirrors-${order}`,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":205,"text":"      title: \"Synced copies\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":206,"text":"      why: `Draft: identical copies of ${root}. Read one, skip the rest.`,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":207,"text":"      summary: \"Fill this group.\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":208,"text":"      suggestedOrder: order,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":209,"text":"      hunkRefs: [...new Set(paths)],"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":210,"text":"    });"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":211,"text":"    order += 1;"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":212,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":213,"text":"  if (mechanical.length > 0) {"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":214,"text":"    groups.push({"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":215,"text":"      id: \"mechanical\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":216,"text":"      title: \"Mechanical\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":217,"text":"      why: \"Draft: renames, copies, moves, or generated output. Say what the reader can skip.\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":218,"text":"      summary: \"Fill this group.\","},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":219,"text":"      suggestedOrder: order,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":220,"text":"      hunkRefs: mechanical,"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":221,"text":"    });"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":222,"text":"  }"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":223,"text":"  const document = { ...skeleton, source, groups };"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":224,"text":"  await mkdir(dirname(dataPath), { recursive: true });"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":225,"text":"  await writeFile(dataPath, `${JSON.stringify(document, null, 2)}\\n`);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":226,"text":"  const loaded = await loadDocument(dataPath);"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":227,"text":"  return { document: loaded, index };"},{"sha":"4436eb9e832e4c208e49426536711663295397f4","author":"Máté Molnár","timestamp":1791134736,"line":228,"text":"}"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":229,"text":""},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":230,"text":"/**"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":231,"text":" * Carry an existing review over to the range's current commits. Refs follow their hunks,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":232,"text":" * refs whose hunk left the diff are dropped, and new hunks land in a draft update group."},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":233,"text":" * The old document is kept beside it under its head SHA, and `previous` names that file."},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":234,"text":" * Returns the report; `changed` is false when both commits are the ones the document names."},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":235,"text":" */"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":236,"text":"export async function cmdRefresh("},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":237,"text":"  cwd: string,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":238,"text":"  dataPath: string,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":239,"text":"  base: string | undefined,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":240,"text":"  head: string | undefined,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":241,"text":"): Promise<{ document: ReviewDocument; report: string; changed: boolean }> {"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":242,"text":"  const document = await loadDocument(dataPath);"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":243,"text":"  const previous = document.source;"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":244,"text":"  if (previous.baseSha === undefined || previous.headSha === undefined) {"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":245,"text":"    throw new Error("},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":246,"text":"      `refresh needs source.baseSha and source.headSha in ${dataPath}; an older comprehende wrote this document. Run pregroup again.`,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":247,"text":"    );"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":248,"text":"  }"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":249,"text":"  const { source, baseSha, headSha } = await resolveSource("},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":250,"text":"    cwd,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":251,"text":"    base ?? previous.baseRef,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":252,"text":"    head ?? previous.headRef,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":253,"text":"  );"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":254,"text":"  if (baseSha === previous.baseSha && headSha === previous.headSha) {"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":255,"text":"    return {"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":256,"text":"      document,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":257,"text":"      report: `nothing to refresh: ${source.range} still resolves to ${shortSha(baseSha)}...${shortSha(headSha)}`,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":258,"text":"      changed: false,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":259,"text":"    };"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":260,"text":"  }"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":261,"text":"  const previousFiles = await readDiff(cwd, previous.baseSha, previous.headSha);"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":262,"text":"  const nextFiles = await readDiff(cwd, baseSha, headSha);"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":263,"text":"  const result = refreshDocument(document, previousFiles, nextFiles, source);"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":264,"text":"  const commits = await listNewSubjects(cwd, previous.headSha, baseSha, headSha);"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":265,"text":"  const stalePins = (await staleCommentPins(cwd, result.document, { baseSha, headSha })).map("},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":266,"text":"    (pin) => pin.id,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":267,"text":"  );"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":268,"text":"  const kept = `${basename(dataPath, \".json\")}.${shortSha(previous.headSha)}.json`;"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":269,"text":"  await copyFile(dataPath, join(dirname(dataPath), kept));"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":270,"text":"  const refreshed = { ...result.document, previous: kept };"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":271,"text":"  await writeDocument(dataPath, refreshed);"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":272,"text":"  return {"},{"sha":"d86dd9523f70c2245948726ae8a7ea36aaf31b5f","author":"Máté Molnár","timestamp":1792651383,"line":273,"text":"    document: refreshed,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":274,"text":"    report: formatRefresh(result, nextFiles, { commits, stalePins }),"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":275,"text":"    changed: true,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":276,"text":"  };"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":277,"text":"}"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":278,"text":""},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":279,"text":"/** A note when the refs no longer resolve to the commits the document was written for. */"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":280,"text":"export function sourceDrift("},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":281,"text":"  source: ReviewSource,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":282,"text":"  live: { baseSha: string; headSha: string },"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":283,"text":"  dataPath: string,"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":284,"text":"): string | undefined {"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":285,"text":"  const moved: string[] = [];"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":286,"text":"  if (source.baseSha !== undefined && source.baseSha !== live.baseSha) {"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":287,"text":"    moved.push(`base ${shortSha(source.baseSha)} -> ${shortSha(live.baseSha)}`);"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":288,"text":"  }"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":289,"text":"  if (source.headSha !== undefined && source.headSha !== live.headSha) {"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":290,"text":"    moved.push(`head ${shortSha(source.headSha)} -> ${shortSha(live.headSha)}`);"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":291,"text":"  }"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":292,"text":"  if (moved.length === 0) {"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":293,"text":"    return undefined;"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":294,"text":"  }"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":295,"text":"  return `${moved.join(\", \")} since this review was written. Run: comprehende refresh --data ${dataPath}`;"},{"sha":"98f0fc86e7a373cabf4c55004f7e66825a40b5a6","author":"Máté Molnár","timestamp":1792606395,"line":296,"text":"}"}]}
