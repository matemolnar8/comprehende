[] {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":125,"text":"  const idSet = new Set(ids);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":126,"text":"  const remaining = new Set(ids);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":127,"text":"  const indegree = new Map<string, number>();"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":128,"text":"  for (const id of ids) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":129,"text":"    const deps = (byId.get(id)?.group.dependsOn ?? []).filter((dep) => idSet.has(dep));"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":130,"text":"    indegree.set(id, deps.length);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":131,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":132,"text":"  const result: string[] = [];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":133,"text":"  const byOrder = (a: string, b: string): number => {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":134,"text":"    const left = byId.get(a);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":135,"text":"    const right = byId.get(b);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":136,"text":"    return ("},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":137,"text":"      suggestedOrder(left?.group, left?.index ?? 0) - suggestedOrder(right?.group, right?.index ?? 0) || a.localeCompare(b)"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":138,"text":"    );"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":139,"text":"  };"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":140,"text":""},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":141,"text":"  while (remaining.size > 0) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":142,"text":"    const ready = [...remaining].filter((id) => (indegree.get(id) ?? 0) === 0).sort(byOrder);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":143,"text":"    const pick = ready[0];"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":144,"text":"    if (pick === undefined) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":145,"text":"      result.push(...[...remaining].sort(byOrder));"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":146,"text":"      break;"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":147,"text":"    }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":148,"text":"    result.push(pick);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":149,"text":"    remaining.delete(pick);"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":150,"text":"    for (const id of remaining) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":151,"text":"      if ((byId.get(id)?.group.dependsOn ?? []).includes(pick)) {"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":152,"text":"        indegree.set(id, Math.max(0, (indegree.get(id) ?? 1) - 1));"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":153,"text":"      }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":154,"text":"    }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":155,"text":"  }"},{"sha":"f4700b241a01a39ca25be886a3d73974750b4f61","author":"Cursor Agent","timestamp":1789285558,"line":156,"text":"  return result;"},{"sha":"aaa8ad266ed698df6cdbb8ead0d2c0de5a01f757","author":"matemolnar8","timestamp":1786996490,"line":157,"text":"}"}]}
