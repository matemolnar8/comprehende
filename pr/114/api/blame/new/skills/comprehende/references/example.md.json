hor":"Cursor Agent","timestamp":1789328214,"line":47,"text":"  ],"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":48,"text":"  \"groups\": ["},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":49,"text":"    {"},{"sha":"485af33aa95c0814b0966b01eb39fce2377d2f3b","author":"matemolnar8","timestamp":1787548159,"line":50,"text":"      \"id\": \"cookie\","},{"sha":"485af33aa95c0814b0966b01eb39fce2377d2f3b","author":"matemolnar8","timestamp":1787548159,"line":51,"text":"      \"title\": \"Session cookie helper\","},{"sha":"485af33aa95c0814b0966b01eb39fce2377d2f3b","author":"matemolnar8","timestamp":1787548159,"line":52,"text":"      \"why\": \"The login route needs one helper to apply the session cookie options.\","},{"sha":"485af33aa95c0814b0966b01eb39fce2377d2f3b","author":"matemolnar8","timestamp":1787548159,"line":53,"text":"      \"summary\": \"`setSessionCookie` applies the required options to session cookies.\","},{"sha":"485af33aa95c0814b0966b01eb39fce2377d2f3b","author":"matemolnar8","timestamp":1787548159,"line":54,"text":"      \"part\": \"Session cookie\","},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":55,"text":"      \"lookFor\": ["},{"sha":"485af33aa95c0814b0966b01eb39fce2377d2f3b","author":"matemolnar8","timestamp":1787548159,"line":56,"text":"        \"Breaking. `setSessionCookie` throws when the caller passes `httpOnly: false`.\""},{"sha":"c79b7ad6953c4380fed29e7c05284249b5b3fa53","author":"Cursor Agent","timestamp":1786683085,"line":57,"text":"      ],"},{"sha":"86df412493076d5477c9117ade661ca6b37cc0a3","author":"Cursor Agent","timestamp":1786673228,"line":58,"text":"      \"suggestedOrder\": 0,"},{"sha":"d5011fce325fb0b8497129914cd9f56404c53218","author":"Cursor Agent","timestamp":1790142358,"line":59,"text":"      \"hunkRefs\": [\"src/auth/session.ts\"]"},{"sha":"86df412493076d5477c91